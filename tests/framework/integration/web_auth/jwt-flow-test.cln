// Integration: JWT login → verify → logout inside a single request.

// Fixed: was unescaped `{` / `}` inside JSON string literals, grammar.ebnf §1.6
// reads `{...}` in a string as interpolation; literal braces are `\{` / `\}`.

// Fixed: added missing plugin declarations — plugin-contract.md §9 only auto-detects by path
plugins:
	frame.server
	frame.auth

server:
	port: 3400

// Fixed: was `auth:` settings written as `key: value`, frame-auth.ebnf §1
// requires `key = value` (session_cookie_field, session_timeout_field).
// Fixed: was a hardcoded `secret:` literal, frame-auth.ebnf jwt_secret_field
// requires `env.get("VAR")` (AUTH-C004); the test runner exports JWT_SECRET.
auth:
	session:
		cookie = "test.sid"
		timeoutMinutes = 5
	jwt:
		secret = env.get("JWT_SECRET")
		alg = "HS256"
		ttlMinutes = 15

start:
	printl("[boot] integration-jwt-flow server ready")

endpoints:
	GET "/test":
		string token = auth.jwt.sign("\{\"sub\":\"user1\",\"role\":\"user\"\}")
		boolean ok_sign = token.length() > 0

		string payload = auth.jwt.verify(token)
		boolean ok_verify = payload.length() > 0

		boolean ok_set = auth.setSession(payload)
		boolean ok_auth = auth.isAuthenticated()

		if ok_sign and ok_verify and ok_set and ok_auth
			printl("PASS: integration-jwt-flow")
		else
			printl("FAIL: integration-jwt-flow")
		return json({ok: true})
