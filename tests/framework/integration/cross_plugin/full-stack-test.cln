// Integration: auth + data + server — full request lifecycle.
// Fixed: `first` returns `Model?` (frame-data DAT-Q001) and only a `T?` holds
// none (type-system.md §8), so a `first` result is held in a `T?` and
// unwrapped with `!` before its fields are used.

// Fixed: was unescaped `{` / `}` inside JSON string literals, grammar.ebnf §1.6
// reads `{...}` in a string as interpolation; literal braces are `\{` / `\}`.

// Fixed: added missing plugin declarations — plugin-contract.md §9 only auto-detects by path
plugins:
	frame.server
	frame.data
	frame.auth

server:
	port: 3400

// Fixed: was `auth:` settings written as `key: value`, frame-auth.ebnf §1
// requires `key = value` (session_cookie_field, session_timeout_field).
auth:
	session:
		cookie = "test.sid"
		timeoutMinutes = 5

roles:
	user: ["notes.write"]

// Fixed: was a bare-field `data Note:` block, frame-data.ebnf v2 requires
// the `fields:` sub-block (DAT-M015).
data Note:
	fields:
		integer id primary generated
		integer authorId required
		string title required

start:
	printl("[boot] integration-full-stack server ready")

endpoints:
	GET "/test":
		auth.setSession("\{\"user_id\":1,\"role\":\"user\"\}")
		boolean ok_auth = auth.isAuthenticated() and auth.can(auth.getCurrentUser(), "notes.write")

		// Table creation: `Model.migrate()` (DAT-C005).
		Note.migrate()

		// Fixed: was `Note.insert_id:`, frame-data.ebnf v2 requires
		// `Database.save(entity)` then reading `entity.id` (DAT-Q014).
		Note note = Note()
		note.authorId = auth.userId()
		note.title = "my note"
		Database.save(note)
		integer nid = note.id
		boolean ok_insert = nid > 0

		Note? foundN = Note.first:
			where:
				id == nid
		Note n = foundN!
		boolean ok_read = n.title == "my note"

		if ok_auth and ok_insert and ok_read
			printl("PASS: integration-full-stack")
		else
			printl("FAIL: integration-full-stack")
		return json({noteId: nid, title: n.title})
