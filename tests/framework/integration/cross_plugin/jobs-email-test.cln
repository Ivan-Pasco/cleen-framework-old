// Integration: jobs + email — enqueue a job that would send email on run.

// Fixed: added missing plugin declarations — plugin-contract.md §9 only auto-detects by path
plugins:
	frame.jobs
	frame.server

server:
	port: 3400
	mail:
		host: "localhost"
		port: 2525
		secure: false
		username: ""
		password: ""
		from: "test@example.com"

start:
	printl("[boot] integration-jobs-email server ready")

jobs:
	SendWelcome:
		// Fixed: was a variable named `to`, spec reserves `to` as a keyword
		// (grammar.ebnf keyword list).
		string recipient = job.args()
		if email.send(recipient, "Welcome", "<b>hi</b>", "hi")
			job.succeed("{\"sent\":true}")
		else
			job.fail(email.lastError())

endpoints:
	GET "/test":
		string jid = queue.enqueue("SendWelcome", "\"a@b.com\"")
		boolean ok = jid.length() > 0
		if ok
			printl("PASS: integration-jobs-email")
		else
			printl("FAIL: integration-jobs-email")
		return json({jobId: jid})
