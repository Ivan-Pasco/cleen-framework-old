// Integration: auth + data — protected endpoint reads model backed by DB.
// Fixed: `first` returns `Model?` (frame-data DAT-Q001) and only a `T?` holds
// none (type-system.md §8), so a `first` result is held in a `T?` and
// unwrapped with `!` before its fields are used.

// Fixed: was unescaped `{` / `}` inside JSON string literals, grammar.ebnf §1.6
// reads `{...}` in a string as interpolation; literal braces are `\{` / `\}`.

// Fixed: added missing plugin declarations — plugin-contract.md §9 only auto-detects by path
plugins:
	frame.server
	frame.data
	frame.auth

server:
	port: 3400

// Fixed: was `auth:` settings written as `key: value`, frame-auth.ebnf §1
// requires `key = value` (session_cookie_field, session_timeout_field).
auth:
	session:
		cookie = "test.sid"
		timeoutMinutes = 5

roles:
	user: ["profile.view"]

// Fixed: was a bare-field `data Profile:` block, frame-data.ebnf v2 requires
// the `fields:` sub-block (DAT-M015).
data Profile:
	fields:
		integer id primary generated
		integer userId required
		string bio required

start:
	printl("[boot] integration-auth-data server ready")

endpoints:
	GET "/test":
		// Table creation: `Model.migrate()` (DAT-C005).
		Profile.migrate()

		// Fixed: was `Profile.insert:`, frame-data.ebnf v2 requires
		// `Database.save(entity)` (DAT-S001).
		Profile profile = Profile()
		profile.userId = 1
		profile.bio = "user 1 profile"
		Database.save(profile)
		auth.setSession("\{\"user_id\":1,\"role\":\"user\"\}")
		boolean ok_auth = auth.isAuthenticated() and auth.can(auth.getCurrentUser(), "profile.view")

		Profile? foundP = Profile.first:
			where:
				userId == auth.userId()
		Profile p = foundP!
		boolean ok_read = p.bio == "user 1 profile"

		if ok_auth and ok_read
			printl("PASS: integration-auth-data")
		else
			printl("FAIL: integration-auth-data")
		return json({bio: p.bio})
