// Test: frame.locale — detection = "query" picks the ?locale= parameter
// Spec: foundation/spec/framework/grammar/frame-locale.ebnf §1 (locale_block,
//       detection_strategy); HOST_BRIDGE.md _i18n_configure.
//
// The locale: block loads every <tag>.json of its path (en, fr, de, es here —
// not only the default and the fallback). The /test request carries all three
// locale sources; the detection strategy decides which one counts.
// test-request-header: Accept-Language: de-DE,de;q=0.9
// test-request-header: Cookie: theme=dark; cl_locale=fr
// test-request-query: locale=es

plugins:
	frame.locale
	frame.server

locale:
	default = "en"
	fallback = "fr"
	detection = "query"
	path = "tests/framework/unit/plugins/locale/translations"

endpoints:
	GET "/test":
		integer failures = 0
		string got_current = locale.current()
		if got_current != "es"
			printl("FAIL: current: expected es, got " + got_current)
			failures = failures + 1
		string got_hello = t("hello", "{}")
		if got_hello != "Hola"
			printl("FAIL: hello: expected Hola, got " + got_hello)
			failures = failures + 1
		if failures == 0
			printl("PASS: locale-detection-query")
		else
			printl("FAIL: locale-detection-query")
		return json({locale: locale.current()})
