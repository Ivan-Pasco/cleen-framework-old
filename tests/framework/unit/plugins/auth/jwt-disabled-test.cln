// Test: frame.auth — `jwt: enabled = false` turns JWT off.
// Grammar: frame-auth.ebnf jwt_enabled_field
// Regression: enabled = false was stored and never read; auth.jwt.sign kept
// issuing tokens and auth.jwt.verify kept accepting them.

plugins:
	frame.server
	frame.auth

server:
	port: 3400

auth:
	jwt:
		enabled = false

endpoints:
	GET "/test":
		// A token signed with the application's secret, as auth.jwt.sign would
		// have issued it before JWT was turned off.
		string minted = jwt.sign("{\"sub\":7,\"jti\":\"j1\",\"exp\":4102444800}", env.get("JWT_SECRET"), "HS256")
		boolean ok_minted = minted.length() > 0

		boolean ok_sign = auth.jwt.sign("{\"sub\":7}") == ""
		boolean ok_verify = auth.jwt.verify(minted) == ""
		boolean ok_refresh = auth.jwt.refresh(minted) == ""

		if ok_minted and ok_sign and ok_verify and ok_refresh
			printl("PASS: auth-jwt-disabled")
		else
			printl("FAIL: auth-jwt-disabled minted=" + ok_minted.toString() + " sign=" + ok_sign.toString() + " verify=" + ok_verify.toString() + " refresh=" + ok_refresh.toString())
		return json({ok: true})

start:
	printl("[boot] auth-jwt-disabled server ready")
