// Test: frame.auth — roles: block and hasRole / can(user, permission) checks.
// Server-shaped: runner drives /test to enter request context.

// Fixed: added missing plugin declarations — plugin-contract.md §9 only auto-detects by path
plugins:
	frame.server
	frame.auth

server:
	port: 3400

// Fixed: was `cookie: "test.sid"` / `timeoutMinutes: 5`; frame-auth.ebnf
// session_field requires `key = value` (the colon form was silently ignored).
auth:
	session:
		cookie = "test.sid"
		timeoutMinutes = 5

roles:
	admin: ["users.create", "users.delete"]
	user: ["profile.view"]

endpoints:
	GET "/test":
		auth.setSession("{\"user_id\":1,\"role\":\"admin\"}")

		boolean ok_role = auth.hasRole("admin")
		boolean ok_not = not auth.hasRole("user")

		// auth.can(user, permission) — frame-auth.ebnf auth_ns_can_call.
		string user = auth.getCurrentUser()

		// admin has users.create per roles: block above.
		boolean ok_can = auth.can(user, "users.create")

		// admin does NOT have an unlisted permission.
		boolean ok_cant = not auth.can(user, "nonexistent.permission")

		// The check uses the user passed in, not the current session:
		// a "user"-role principal has profile.view but not users.create.
		string other = "{\"user_id\":2,\"role\":\"user\"}"
		boolean ok_other_can = auth.can(other, "profile.view")
		boolean ok_other_cant = not auth.can(other, "users.create")

		// No user (unauthenticated) has no permissions.
		boolean ok_anon = not auth.can("", "profile.view")

		if ok_role and ok_not and ok_can and ok_cant and ok_other_can and ok_other_cant and ok_anon
			printl("PASS: auth-role-check")
		else
			printl("FAIL: auth-role-check")
		return json({ok: true})

start:
	printl("[boot] auth-role-check server ready")
