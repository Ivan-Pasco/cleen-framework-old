// Test: frame.ui — `.html` pages rendered by the host render components.
//
// clean-server renders an `.html` page template (`_ui_render_page`, used by
// render() / renderWith() and companion routes) and hands every custom tag
// to the component's render export with the tag's attributes JSON-encoded
// (bridge-host-classes.md §4.1 `component_tag_render`). Regression: frame.ui
// emitted no such export, so the tag was passed through unrendered, and the
// host called exports without the attributes. Attributes become typed inputs
// and `class` lands on the outer element, exactly as in `html:` blocks. The
// file declares a component and endpoints together, which also checks that
// the browser build (frontend.wasm) leaves the endpoint handlers out.
// An empty integer attribute (`count=""`) keeps the input's default.
// Regression: the generated setInput converted it with toInteger(), which
// raises on "" (compiler 0.33.184).

plugins:
	frame.ui
	frame.server

server:
	port: 3400

component: tag="ui-badge"
	inputs:
		string label
		integer count

	html:
		<span class="badge">{label} x{count.toString()}</span>

endpoints:
	GET "/test":
		string path = "/tmp/frame-ui-request-time-components-test.html"
		boolean written = file.write(path, "<main><ui-badge label=\"new\" count=\"2\" class=\"big\"></ui-badge></main>")
		string body = _ui_render_page(path, "{}")
		boolean ok = body.contains("<main><span class='big badge'>new x2</span></main>")
		string empty_path = "/tmp/frame-ui-request-time-components-empty-test.html"
		boolean empty_written = file.write(empty_path, "<main><ui-badge label=\"none\" count=\"\"></ui-badge></main>")
		string empty_body = _ui_render_page(empty_path, "{}")
		boolean ok_empty = empty_body.contains("none x0")
		if written and ok and empty_written and ok_empty
			printl("PASS: ui-request-time-page-components")
		else
			printl("FAIL: ui-request-time-page-components " + body + " / " + empty_body)
		return http.respond(200, "text/html", body)

start:
	printl("[boot] ui-request-time-page-components ready")
