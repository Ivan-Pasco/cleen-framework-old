// Test: frame.jobs — retry: block without delay: uses the default base
// delay of 1 second. Time values in frame.jobs are seconds, the same unit
// as time.now().
//
// The handler fails attempts 1-3 and runs attempt 4. With exponential
// backoff and a 1 s base, the waits are 1 + 2 + 4 s, so at least 7 s pass
// between enqueue and attempt 4. A default that the runtime reads as a
// few milliseconds retries on every worker poll and reaches attempt 4 in
// under 5 s; a default read as 1000 s never reaches attempt 4.

plugins:
	frame.jobs
	frame.server

server:
	port: 3400

start:
	printl("[boot] jobs-retry-default-delay server ready")

jobs:
	DefaultDelay:
		retry:
			maxAttempts: 4
			backoff: exponential
		integer attempt = job.attempt()
		if attempt < 4
			error("planned failure on attempt " + attempt.toString())
		integer started = job.args().toInteger()
		integer now = time.now()
		integer elapsed = now - started
		printl("[jobs-retry-default-delay] attempt 4 after " + elapsed.toString() + " s")
		if elapsed >= 6
			printl("PASS: jobs-retry-default-delay")
		else
			printl("FAIL: jobs-retry-default-delay — retries ran after " + elapsed.toString() + " s, expected >= 6 s (default delay is 1 s)")
		job.succeed("{\"ok\":true}")

endpoints:
	GET "/test":
		string jid = queue.enqueue("DefaultDelay", time.now().toString())
		if jid.length() == 0
			printl("FAIL: jobs-retry-default-delay — queue.enqueue returned no id")
		return json({ok: true, jobId: jid})
