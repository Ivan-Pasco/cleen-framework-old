// Test: frame.jobs — every job is registered, with its whole body.
// Spec: frame-jobs.ebnf §2 (job_handler = identifier ":" ...; the identifier
// is the job name used in queue.enqueue), §2.1 (retry config keys).
// Regression: a job whose name started with retry, queue, delay, timeout,
// backoff or maxAttempts was skipped, so queue.enqueue reported it unknown;
// a job body longer than 300 lines was cut off silently.

plugins:
	frame.jobs
	frame.server

server:
	port: 3400

start:
	printl("[boot] jobs-entry-names server ready")

state:
	integer counter = 0

jobs:
	retryPayments:
		job.succeed("{}")

	queueCleanup:
		queue: "maintenance"
		job.succeed("{}")

	delayedMail:
		job.succeed("{}")

	timeoutWatch:
		timeout: 5
		job.succeed("{}")

	backoffReport:
		retry:
			maxAttempts: 2
			backoff: exponential
			delay: 1
		job.succeed("{}")

	maxAttemptsProbe:
		job.succeed("{}")

	longBody:
		counter = counter + 1
		counter = counter + 1
		counter = counter + 1
		counter = counter + 1
		counter = counter + 1
		counter = counter + 1
		counter = counter + 1
