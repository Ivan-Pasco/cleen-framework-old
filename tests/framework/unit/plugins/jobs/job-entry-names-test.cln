endpoints:
	GET "/test":
		list<string> names = ["retryPayments", "queueCleanup", "delayedMail", "timeoutWatch", "backoffReport", "maxAttemptsProbe", "longBody"]
		integer registered = 0
		iterate n in names
			string jid = queue.enqueue(n, "{}")
			if jid.length() > 0
				registered = registered + 1
			else
				printl("not registered: " + n)
		boolean ok_names = registered == 7

		// The handler runs all 320 statements of its body.
		counter = 0
		__job_handler_longBody()
		boolean ok_body = counter == 320

		if ok_names and ok_body
			printl("PASS: jobs-entry-names")
		else
			printl("FAIL: jobs-entry-names registered=" + registered.toString() + " body=" + counter.toString())
		return json({ok: true})
