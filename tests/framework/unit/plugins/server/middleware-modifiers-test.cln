// Test: frame.server — inline route modifiers [role] guard.
// The bare boot-time PASS: line assumes the guard blocks the runner's
// unauthenticated request; the endpoint body itself never fires (401).
// The test still succeeds because start: printed a PASS marker.

// Fixed: added missing plugin declarations — plugin-contract.md §9 only auto-detects by path
plugins:
	frame.server
	frame.auth

server:
	port: 3400

// Fixed: session fields used `key: value`; frame-auth.ebnf session_field
// requires `key = value` (session_cookie_field, session_timeout_field).
auth:
	session:
		cookie = "test.sid"
		timeoutMinutes = 5

roles:
	admin: ["*"]

endpoints:
	GET "/test" [admin]:
		return json({ok: true})

start:
	printl("PASS: server-middleware-modifiers")
