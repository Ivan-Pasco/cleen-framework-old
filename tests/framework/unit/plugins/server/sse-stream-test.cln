// Test: frame.server — Server-Sent Events endpoint (FEED method).

// Fixed: added missing plugin declarations — plugin-contract.md §9 only auto-detects by path
plugins:
	frame.server

server:
	port: 3400

endpoints:
	FEED "/test":
		feed.emit("{\"tick\":1}")
		feed.emitEvent("hello", "{\"msg\":\"hi\"}")
		feed.close()
		printl("PASS: server-sse-stream")
		return json({ok: true})

start:
	printl("[boot] server-sse-stream server ready")
