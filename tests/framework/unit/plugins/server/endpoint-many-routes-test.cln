// Test: frame.server — an endpoints: block with more than 100 routes.
// Grammar: frame-server.ebnf §2 endpoints_block = "endpoints" ":" { route_declaration } —
// no limit on the number of routes. Before the fix the expansion stopped
// after 100 routes, silently dropping the rest (GET "/test" is route 101).

plugins:
	frame.server

server:
	port: 3400

endpoints:
