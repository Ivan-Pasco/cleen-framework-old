// Test: frame.data — Model.cursor: cursor pagination shape.

// Fixed: added missing plugin declarations — plugin-contract.md §9 only auto-detects by path
plugins:
	frame.server
	frame.data

server:
	port: 3400

// Fixed: was a bare-field `data Item:` block and `Item.insert:` block
// mutations, frame-data.ebnf v2 requires the `fields:` sub-block (DAT-M015)
// and writes through `Database.save(entity)` (DAT-S001).
data Item:
	fields:
		integer id primary generated
		string name required

endpoints:
	GET "/test":
		// Table creation: `Model.migrate()` (DAT-C005).
		Item.migrate()

		iterate i in 1 to 12
			Item item = Item()
			item.name = "item-" + i.toString()
			Database.save(item)

		CursorResult<Item> first = Item.cursor:
			cursor:
				perPage 5
				after ""
				by "id"

		boolean ok_first = first.items.length() == 5
		boolean ok_next = first.nextCursor.length() > 0

		CursorResult<Item> second = Item.cursor:
			cursor:
				perPage 5
				after first.nextCursor
				by "id"

		boolean ok_second_len = second.items.length() == 5
		boolean ok_hasPrev = second.hasPrev

		if ok_first and ok_next and ok_second_len and ok_hasPrev
			printl("PASS: data-pagination-cursor")
		else
			printl("FAIL: data-pagination-cursor")
		return json({ok: true})

start:
	printl("[boot] data-pagination-cursor server ready")
