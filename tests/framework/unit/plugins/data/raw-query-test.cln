// Test: frame.data — raw db.query for cases the ORM cannot express.
// Rule A (Quick Reference): raw SQL is justified for COUNT aliases,
// aggregates, and multi-table joins. This test exercises COUNT.
// The db.query: block form (frame-data.ebnf §8) is exercised from a
// function; inside an endpoint handler, and for db.queryAs(Model):, the
// compiler does not parse the block form yet.

// Fixed: added missing plugin declarations — plugin-contract.md §9 only auto-detects by path
plugins:
	frame.server
	frame.data

server:
	port: 3400

// Fixed: was a bare-field `data Item:` block and `Item.insert:` block
// mutations, frame-data.ebnf v2 requires the `fields:` sub-block (DAT-M015)
// and writes through `Database.save(entity)` (DAT-S001).
data Item:
	fields:
		integer id primary generated
		string name required
		integer qty required

start:
	printl("[boot] data-raw-query server ready")

functions:
	string namesAbove(integer minQty)
		return db.query:
			sql: "SELECT name FROM items WHERE qty > ? ORDER BY name"
			params: [minQty]

endpoints:
	GET "/test":
		// Table creation: `Model.migrate()` (DAT-C005).
		Item.migrate()

		Item apple = Item()
		apple.name = "apple"
		apple.qty = 10
		Database.save(apple)
		Item banana = Item()
		banana.name = "banana"
		banana.qty = 5
		Database.save(banana)
		Item cherry = Item()
		cherry.name = "cherry"
		cherry.qty = 12
		Database.save(cherry)

		// Raw query — COUNT alias, ORM-inexpressible.
		string result = db.query("SELECT COUNT(*) as cnt FROM items WHERE qty > 6", "")
		// Fixed: only checked that some text came back (a failed query also
		// answers with JSON text); the count must be 2 (apple, cherry).
		boolean ok_shape = json.get(result, "data.rows.0.cnt") == "2"

		string names = namesAbove(6)
		boolean ok_block = json.get(names, "data.rows.1.name") == "cherry"

		if ok_shape and ok_block
			printl("PASS: data-raw-query")
		else
			printl("FAIL: data-raw-query")
		return json({ok: true})
