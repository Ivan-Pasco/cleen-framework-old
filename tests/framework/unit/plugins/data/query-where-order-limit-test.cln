// Test: frame.data — find with where, order, limit clauses.

// Fixed: added missing plugin declarations — plugin-contract.md §9 only auto-detects by path
plugins:
	frame.server
	frame.data

server:
	port: 3400

// Fixed: was a bare-field `data Post:` block and `Post.insert:` block
// mutations, frame-data.ebnf v2 requires the `fields:` sub-block (DAT-M015)
// and writes through `Database.save(entity)` (DAT-S001).
data Post:
	fields:
		integer id primary generated
		string title required
		integer views required

endpoints:
	GET "/test":
		// Table creation: `Model.migrate()` (DAT-C005).
		Post.migrate()

		Post a = Post()
		a.title = "A"
		a.views = 5
		Database.save(a)
		Post b = Post()
		b.title = "B"
		b.views = 100
		Database.save(b)
		Post c = Post()
		c.title = "C"
		c.views = 50
		Database.save(c)
		Post d = Post()
		d.title = "D"
		d.views = 3
		Database.save(d)

		// Top 2 hot posts (views > 10, ordered desc, limit 2).
		list<Post> hot = Post.find:
			where:
				views > 10
			order:
				views desc
			limit:
				2
		boolean ok_len = hot.length() == 2
		boolean ok_order = hot[0].title == "B" and hot[1].title == "C"

		// where alone: all posts with views >= 5.
		list<Post> some = Post.find:
			where:
				views >= 5
		boolean ok_some = some.length() == 3

		if ok_len and ok_order and ok_some
			printl("PASS: data-query-where-order-limit")
		else
			printl("FAIL: data-query-where-order-limit")
		return json({ok: true})

start:
	printl("[boot] data-query-where-order-limit server ready")
