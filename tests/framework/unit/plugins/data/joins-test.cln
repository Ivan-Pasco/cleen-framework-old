// Test: frame.data — multi-table joins (raw query — Rule A).

// Fixed: added missing plugin declarations — plugin-contract.md §9 only auto-detects by path
plugins:
	frame.server
	frame.data

server:
	port: 3400

// Fixed: was bare-field `data` blocks and `Model.insert:` block mutations,
// frame-data.ebnf v2 requires the `fields:` sub-block (DAT-M015) and writes
// through `Database.save(entity)` (DAT-S001).
data Category:
	fields:
		integer id primary generated
		string name required

data Product:
	fields:
		integer id primary generated
		string title required
		integer categoryId required

endpoints:
	GET "/test":
		// Table creation: `Model.migrate()` (DAT-C005).
		Category.migrate()
		Product.migrate()

		Category electronics = Category()
		electronics.name = "electronics"
		Database.save(electronics)
		Category cat = Category.first:
			where:
				name == "electronics"

		Product phone = Product()
		phone.title = "phone"
		phone.categoryId = cat.id
		Database.save(phone)
		Product laptop = Product()
		laptop.title = "laptop"
		laptop.categoryId = cat.id
		Database.save(laptop)

		// Raw multi-table INNER JOIN.
		// Fixed: joined on `products.category_id`, but the column is named
		// after the field, `categoryId` (DAT-M017), and only checked that some
		// text came back — a failed query also answers with JSON text.
		string joined = db.query("SELECT products.title, categories.name FROM products INNER JOIN categories ON products.categoryId = categories.id ORDER BY products.title", "")
		boolean ok_shape = json.get(joined, "data.rows.1.title") == "phone" and json.get(joined, "data.rows.0.name") == "electronics"

		// The same join through the query DSL (frame-data.ebnf §5.6, DAT-Q017).
		list<Product> inCategory = Product.find:
			join:
				Category as c:
					on:
						c.id == Product.categoryId
			where:
				c.name == "electronics"
			order: title
		boolean ok_dsl = inCategory.length() == 2 and inCategory[0].title == "laptop"

		if ok_shape and ok_dsl
			printl("PASS: data-joins")
		else
			printl("FAIL: data-joins")
		return json({ok: true})

start:
	printl("[boot] data-joins server ready")
