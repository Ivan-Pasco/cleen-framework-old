// Test: frame.data — multi-table joins (raw query — Rule A).

// Fixed: added missing plugin declarations — plugin-contract.md §9 only auto-detects by path
plugins:
	frame.server
	frame.data

server:
	port: 3400

// Fixed: was bare-field `data` blocks and `Model.insert:` block mutations,
// frame-data.ebnf v2 requires the `fields:` sub-block (DAT-M015) and writes
// through `Database.save(entity)` (DAT-S001).
data Category:
	fields:
		integer id primary generated
		string name required

data Product:
	fields:
		integer id primary generated
		string title required
		integer categoryId required

endpoints:
	GET "/test":
		// Table creation: `Model.migrate()` (DAT-C005).
		Category.migrate()
		Product.migrate()

		Category electronics = Category()
		electronics.name = "electronics"
		Database.save(electronics)
		Category cat = Category.first:
			where:
				name == "electronics"

		Product phone = Product()
		phone.title = "phone"
		phone.categoryId = cat.id
		Database.save(phone)
		Product laptop = Product()
		laptop.title = "laptop"
		laptop.categoryId = cat.id
		Database.save(laptop)

		// Multi-table INNER JOIN is ORM-inexpressible today — raw SQL is justified.
		string joined = db.query("SELECT products.title, categories.name FROM products INNER JOIN categories ON products.category_id = categories.id", "")
		boolean ok_shape = joined.length() > 0

		if ok_shape
			printl("PASS: data-joins")
		else
			printl("FAIL: data-joins")
		return json({ok: true})

start:
	printl("[boot] data-joins server ready")
