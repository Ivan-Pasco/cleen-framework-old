// Test: frame.data — transaction: block commits atomically.
// SQLite :memory: — no external DB required.

// Fixed: added missing plugin declarations — plugin-contract.md §9 only auto-detects by path
plugins:
	frame.server
	frame.data

server:
	port: 3400

// Fixed: was a bare-field `data Account:` block, frame-data.ebnf v2 requires
// the `fields:` sub-block (DAT-M015).
data Account:
	fields:
		integer id primary generated
		string owner required
		integer balance required

endpoints:
	GET "/test":
		// Table creation: `Model.migrate()` (DAT-C005).
		Account.migrate()

		// Fixed: was `Account.insert:`, frame-data.ebnf v2 requires
		// `Database.save(entity)` (DAT-S001).
		Account aliceNew = Account()
		aliceNew.owner = "alice"
		aliceNew.balance = 100
		Database.save(aliceNew)
		Account bobNew = Account()
		bobNew.owner = "bob"
		bobNew.balance = 50
		Database.save(bobNew)

		// Commit path: transfer 30 from alice to bob within a transaction.
		// Fixed: was `Account.update:` with set:/where:, frame-data.ebnf v2
		// requires load-mutate-save via `Database.save(entity)` (DAT-S001).
		transaction:
			Account payer = Account.first:
				where:
					owner == "alice"
			payer.balance = 70
			Database.save(payer)
			Account payee = Account.first:
				where:
					owner == "bob"
			payee.balance = 80
			Database.save(payee)

		Account alice = Account.first:
			where:
				owner == "alice"
		Account bob = Account.first:
			where:
				owner == "bob"
		boolean ok_alice = alice.balance == 70
		boolean ok_bob = bob.balance == 80

		// Invariant: total balance conserved by transaction.
		boolean ok_total = alice.balance + bob.balance == 150

		if ok_alice and ok_bob and ok_total
			printl("PASS: data-transaction")
		else
			printl("FAIL: data-transaction")
		return json({ok: true})

start:
	printl("[boot] data-transaction server ready")
