// Test: frame.data — one-to-many via a foreign key, and many-to-many through
// a junction model with link: (frame-data.ebnf §5.5, DAT-Q010, DAT-Q011).

// Fixed: added missing plugin declarations — plugin-contract.md §9 only auto-detects by path
plugins:
	frame.server
	frame.data

server:
	port: 3400

// Fixed: was bare-field `data` blocks and `Model.insert:` block mutations,
// frame-data.ebnf v2 requires the `fields:` sub-block (DAT-M015) and writes
// through `Database.save(entity)` (DAT-S001).
data Author:
	fields:
		integer id primary generated
		string name required

data Book:
	fields:
		integer id primary generated
		string title required
		integer authorId required

data BookTag:
	fields:
		integer id primary generated
		integer bookId required
		integer tagId required

endpoints:
	GET "/test":
		// Table creation: `Model.migrate()` (DAT-C005).
		Author.migrate()
		Book.migrate()
		BookTag.migrate()

		Author newAuthor = Author()
		newAuthor.name = "Alice"
		Database.save(newAuthor)
		Author alice = Author.first:
			where:
				name == "Alice"

		Book bookOne = Book()
		bookOne.title = "Book One"
		bookOne.authorId = alice.id
		Database.save(bookOne)
		Book bookTwo = Book()
		bookTwo.title = "Book Two"
		bookTwo.authorId = alice.id
		Database.save(bookTwo)

		list<Book> alicesBooks = Book.find:
			where:
				authorId == alice.id
			order:
				id asc
		boolean ok_count = alicesBooks.length() == 2
		boolean ok_titles = alicesBooks[0].title == "Book One" and alicesBooks[1].title == "Book Two"

		// Tag 7 is on Book Two only.
		BookTag link1 = BookTag()
		link1.bookId = bookOne.id
		link1.tagId = 3
		Database.save(link1)
		BookTag link2 = BookTag()
		link2.bookId = bookTwo.id
		link2.tagId = 7
		Database.save(link2)
		list<Book> tagged = Book.find:
			link:
				BookTag bookId == id
			where:
				BookTag.tagId == 7
		boolean ok_link = tagged.length() == 1 and tagged[0].title == "Book Two"

		if ok_count and ok_titles and ok_link
			printl("PASS: data-junction-link")
		else
			printl("FAIL: data-junction-link")
		return json({ok: true})

start:
	printl("[boot] data-junction-link server ready")
