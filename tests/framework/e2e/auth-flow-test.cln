// E2E: full auth flow — hash password, sign JWT, set session, log out.
// Fixed: `first` returns `Model?` (frame-data DAT-Q001) and only a `T?` holds
// none (type-system.md §8), so a `first` result is held in a `T?` and
// unwrapped with `!` before its fields are used.

// Fixed: was unescaped `{` / `}` inside JSON string literals, grammar.ebnf §1.6
// reads `{...}` in a string as interpolation; literal braces are `\{` / `\}`.

// Fixed: added missing plugin declarations — plugin-contract.md §9 only auto-detects by path
plugins:
	frame.server
	frame.data
	frame.auth

server:
	port: 3400

// Fixed: was `auth:` settings written as `key: value`, frame-auth.ebnf §1
// requires `key = value` (session_cookie_field, session_timeout_field).
// Fixed: was a hardcoded `secret:` literal, frame-auth.ebnf jwt_secret_field
// requires `env.get("VAR")` (AUTH-C004); the test runner exports JWT_SECRET.
auth:
	session:
		cookie = "test.sid"
		timeoutMinutes = 5
	jwt:
		secret = env.get("JWT_SECRET")
		alg = "HS256"
		ttlMinutes = 15

// Fixed: was bare-field `data` blocks and `Model.insert:` / `.insert_id:` /
// `.update:` / `.delete:` block mutations, frame-data.ebnf v2 requires the
// `fields:` sub-block (DAT-M015) and writes through `Database.save(entity)` /
// `Database.delete(entity)`; the new id is read from `entity.id` (DAT-S001,
// DAT-S003, DAT-Q014). Tables are created with `Model.migrate()` (DAT-C005).
data User:
	fields:
		integer id primary generated
		string email required
		string passwordHash required

start:
	printl("[boot] e2e-auth-flow server ready")

endpoints:
	GET "/test":
		// Register
		string hash = crypto.hashPassword("hunter2")
		User.migrate()
		User account = User()
		account.email = "alice@example.com"
		account.passwordHash = hash
		Database.save(account)
		integer uid = account.id
		boolean ok_register = uid > 0

		// Login: fetch by email, verify password, set session.
		User? foundU = User.first:
			where:
				email == "alice@example.com"
		User u = foundU!
		boolean ok_verify = crypto.verifyPassword("hunter2", u.passwordHash)
		auth.setSession("\{\"user_id\":" + uid.toString() + ",\"role\":\"user\"\}")
		boolean ok_auth = auth.isAuthenticated() and auth.userId() == uid

		// Sign a JWT for the same subject.
		string token = auth.jwt.sign("\{\"sub\":\"" + uid.toString() + "\"\}")
		string decoded = auth.jwt.verify(token)
		boolean ok_jwt = token.length() > 0 and decoded.length() > 0

		// Log out.
		auth.clearSession()
		boolean ok_logout = not auth.isAuthenticated()

		if ok_register and ok_verify and ok_auth and ok_jwt and ok_logout
			printl("PASS: e2e-auth-flow")
		else
			printl("FAIL: e2e-auth-flow")
		return json({ok: true})
