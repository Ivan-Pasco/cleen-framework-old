// E2E: REST API server — JSON-only endpoints with error handling.
// Fixed: `first` returns `Model?` (frame-data DAT-Q001) and only a `T?` holds
// none (type-system.md §8), so a `first` result is held in a `T?` and
// unwrapped with `!` before its fields are used.

// Fixed: added missing plugin declarations — plugin-contract.md §9 only auto-detects by path
plugins:
	frame.server
	frame.data

server:
	port: 3400
	handle:
		NotFound:
			return json({error: "not_found"})
		_:
			return json({error: "internal"})

// Fixed: was bare-field `data` blocks and `Model.insert:` / `.insert_id:` /
// `.update:` / `.delete:` block mutations, frame-data.ebnf v2 requires the
// `fields:` sub-block (DAT-M015) and writes through `Database.save(entity)` /
// `Database.delete(entity)`; the new id is read from `entity.id` (DAT-S001,
// DAT-S003, DAT-Q014). Tables are created with `Model.migrate()` (DAT-C005).
data Widget:
	fields:
		integer id primary generated
		string sku required
		integer qty required

start:
	printl("[boot] e2e-api-server server ready")

endpoints:
	GET "/test":
		Widget.migrate()

		Widget widget = Widget()
		widget.sku = "W-001"
		widget.qty = 100
		Database.save(widget)
		integer widgetId = widget.id

		Widget? foundW = Widget.first:
			where:
				id == widgetId
		Widget w = foundW!

		Widget? foundStock = Widget.first:
			where:
				id == widgetId
		Widget stock = foundStock!
		stock.qty = 90
		Database.save(stock)

		Widget? foundUpdated = Widget.first:
			where:
				id == widgetId
		Widget updated = foundUpdated!

		boolean ok = w.sku == "W-001" and updated.qty == 90
		if ok
			printl("PASS: e2e-api-server")
		else
			printl("FAIL: e2e-api-server")
		return json({sku: w.sku, qty: updated.qty})
