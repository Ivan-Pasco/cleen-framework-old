// Test: bugfixes/1befe125d2bd — vanilla data Widget: block with primitive fields only
// Component: framework/frame.data
// Grammar: (data DSL — plugin-owned)
// Fixed in: framework v3.0.12
// Expected output: compiles cleanly, no PLUGIN013

plugins:
	frame.data

// Fixed: was a bare-field `data Widget:` block, frame-data.ebnf v2 requires
// the `fields:` sub-block (DAT-M015).
data Widget:
	fields:
		integer id primary generated
		string name
		boolean is_active

start:
	printl("PASS: 1befe125d2bd")
