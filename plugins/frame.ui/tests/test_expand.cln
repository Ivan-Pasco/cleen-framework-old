// Tests for the frame.ui plugin's source generators (plugin-internal).
// scripts/test-plugins.sh combines this file with src/main.cln, so the
// functions below call the plugin's own string-level helpers directly: the
// Clean source each block expands to, and the assemble path helpers.

start:
	test_html_block_returns_markup()
	test_html_block_var_mode()
	test_html_block_doctype()
	test_text_interpolation_escaped_and_raw()
	test_attribute_values()
	test_structural_directives()
	test_page_mode_events_and_forms()
	test_component_tag()
	test_state_prefix()
	test_page_companion_calls()
	test_styles_block_css()
	test_assemble_paths()
	test_hydration_screens()
	test_validate_block()
	test_component_header_attrs()
	test_event_handler_names()
	test_html_and_page_headers()
	test_attribute_lookup()
	test_template_errors()
	test_validate_rules()
	test_routes_guards()
	test_page_access()
	test_head_links()
	test_decode_json_string()

functions:
	// html: without var= builds __html and returns it (UI-P004).
	void test_html_block_returns_markup()
		string src = expand_html_block("\{\}", "<p>hi</p>")
		assert(src.startsWith("string __html = \"\"\n"))
		assert(src.contains("__html = __html + \"<p>\"\n"))
		assert(src.contains("__html = __html + \"hi\"\n"))
		assert(src.endsWith("return __html + \"\"\n"))

	// html: var="name" assigns to the variable and does not return (UI-P005).
	void test_html_block_var_mode()
		string src = expand_html_block("\{\"var\":\"card\"\}", "<b>x</b>")
		assert(src.startsWith("string card = \"\"\n"))
		assert(src.contains("card = card + \"<b>\"\n"))
		assert(src.contains("return") == false)

	// <!DOCTYPE html> is copied as written, with no closing tag.
	void test_html_block_doctype()
		string src = expand_html_block("\{\}", "<!DOCTYPE html><html><body>x</body></html>")
		assert(src.contains("__html = __html + \"<!DOCTYPE html>\"\n"))
		assert(src.contains("</!DOCTYPE") == false)

	// {expr} is escaped (UI-P006), {!expr} is raw (UI-P007), \{ is a brace.
	void test_text_interpolation_escaped_and_raw()
		assert(text_expr("Hi \{name\}!", false, false) == "\"Hi \" + _html_escape((name).toString()) + \"!\"")
		assert(text_expr("\{!body\}", false, false) == "\"\" + body + \"\"")
		assert(text_expr("\{x\}", true, false) == "\"\" + _html_escape(data.x) + \"\"")
		assert(text_expr("a \\\{b\\\}", false, false) == "\"a \\\{b\\\}\"")

	// Attribute values: quotes are escaped, {expr} closes and reopens the literal.
	void test_attribute_values()
		assert(html_attributes("a href=\"\{url\}\"", false) == "href='\" + _html_escape((url).toString()) + \"'")
		assert(html_attributes("p title=\"Don't\"", false) == "title='Don&#39;t'")
		assert(html_attributes("p data-x='say \"hi\"'", false) == "data-x='say &quot;hi&quot;'")
		assert(html_attributes("input disabled class=\"c\"", false) == "disabled class='c'")
		// `{name}` is `name={name}` (frame-ui.ebnf interpolation_attribute);
		// a braced value may hold spaces.
		assert(html_attributes("p \{title\}", false) == "title='\" + _html_escape((title).toString()) + \"'")
		assert(html_attributes("p data-n=\{a + b\} id=\"x\"", false) == "data-n='\" + _html_escape((a + b).toString()) + \"' id='x'")
		// Raw HTML in attribute position is marked for FRAME-UI-E003.
		assert(template_error_code(html_attributes("option \{!sel\}", false)) == "E003")
		assert(template_error_code(expand_html_block("\{\}", "<option value=\"1\" \{!sel\}>1</option>")) == "E003")

	// cl-if / cl-else / cl-iterate / cl-show nest the whole element (UI-B001..B004).
	void test_structural_directives()
		// The braced form is the expression itself.
		string braced_if = html_to_stmts("<p cl-if=\{ok and n > 1\}>a</p>", "h", false, "\{\}", false)
		assert(braced_if.startsWith("if ok and n > 1\n"))
		string if_src = html_to_stmts("<p cl-if=\"ok\">a</p><p cl-else>b</p>", "h", false, "\{\}", false)
		assert(if_src == "if ok\n\th = h + \"<p>\"\n\th = h + \"a\"\n\th = h + \"</p>\"\nelse\n\th = h + \"<p>\"\n\th = h + \"b\"\n\th = h + \"</p>\"\n")
		string it_src = html_to_stmts("<li cl-iterate=\"x in xs\">\{x\}</li>", "h", false, "\{\}", false)
		assert(it_src.startsWith("iterate x in xs\n\th = h + \"<li>\"\n"))
		string show_src = html_to_stmts("<p cl-show=\"ok\" style=\"color:red\">a</p>", "h", false, "\{\}", false)
		assert(show_src.contains("else\n\th = h + \"<p style='display:none;color:red'>\"\n"))

	// Page mode: events become data-on-* markers, only non-GET forms get CSRF (UI-B011).
	void test_page_mode_events_and_forms()
		assert(html_attributes("button onclick.stop=\"save\"", true) == "data-on-click='save' data-on-click-stop='true'")
		string get_form = html_to_stmts("<form action=\"/s\"></form>", "html", true, "\{\}", false)
		assert(get_form.contains("_csrf") == false)
		// Fixed: asserted the old csrf_generate() call — a frame.auth-only
		// helper that also replaced the token on every render; the input
		// now carries the session's current token.
		string post_form = html_to_stmts("<form method=\"post\"></form>", "html", true, "\{\}", false)
		assert(post_form.contains("name='_csrf' value='\" + _html_escape(_session_get_csrf()) + \"'"))
		assert(post_form.contains("csrf_generate") == false)

	// A component tag builds the component and passes its attributes (UI-C010).
	void test_component_tag()
		string src = html_to_stmts("<user-card user-name=\"ann\" count=\"\{n\}\"></user-card>", "h", false, "\{\}", false)
		assert(src.contains("\tUserCard _comp = UserCard()\n"))
		assert(src.contains("\t_comp.setInput(\"user-name\", \"ann\")\n"))
		assert(src.contains("\t_comp.count = n\n"))
		assert(src.contains("\th = h + _comp.render()\n"))
		string with_flag = html_to_stmts("<user-card hidden label=\"a\"></user-card>", "h", false, "\{\}", false)
		assert(with_flag.contains("\t_comp.setInput(\"label\", \"a\")\n"))
		assert(with_flag.contains("hidden") == false)

	// `state.` is dropped from code, not from template text.
	void test_state_prefix()
		assert(remove_state_dot("state.count + estate.x") == "count + estate.x")
		assert(template_strip_state("<p title=\"\{state.a\}\">Real estate. \{state.b\}</p>") == "<p title=\"\{a\}\">Real estate. \{b\}</p>")

	// An HTML entry page calls its companion through the names assemble gives
	// them: <module>_load(any) / <module>_guard(any).
	void test_page_companion_calls()
		string body = page_render_body("", "html = html + \"x\"\n", "\{\"has_guard\":true,\"has_load\":true,\"module_name\":\"pages_index\"\}")
		assert(body.contains("any guard_result = pages_index_guard(null)\n"))
		assert(body.contains("any data = pages_index_load(null)\n"))
		assert(body.endsWith("return html\n"))

	// styles <Name>: → CSS custom properties on :root plus global rules.
	void test_styles_block_css()
		string css = styles_block_to_css("Theme", "variables:\n\tcolor-primary: \"#123\"\nglobal:\n\t\"body \{ margin: 0; \}\"\n")
		assert(css.contains(":root \{\n\t--color-primary: #123;\n\}\n"))
		assert(css.contains("body \{ margin: 0; \}\n"))
		assert(styles_block_to_css("Theme", "colors:\n").startsWith("!"))

	// File path → URL / module / template path (UI-R001..R003).
	void test_assemble_paths()
		assert(derive_url_path("app/ui/web/pages/index.cln") == "/")
		assert(derive_url_path("app/ui/web/pages/blog/[slug].cln") == "/blog/:slug")
		assert(derive_url_path("app/ui/web/pages/blog/index.cln") == "/blog")
		assert(derive_module_name("app/ui/web/pages/my-page.cln") == "pages_my_page")
		assert(derive_html_path("app/ui/web/pages/about.cln") == "app/ui/web/pages/about.html")

	// <screen name="X" client="..."> entries; client defaults to off.
	void test_hydration_screens()
		string entries = collect_screens_from_html("<screen name=\"Counter\" client=\"on\"></screen><screen name=\"List\"></screen><screen name=\"Counter\"></screen>")
		assert(entries == "Counter=on\nList=off\nCounter=off\n")
		assert(entries_to_screens_json(entries) == "\{\"Counter\":\"on\",\"List\":\"off\"\}")

	void test_validate_block()
		assert(validate_block("page", "\{\}", "") == "page: a class name (`page Name:`) is required")
		assert(validate_block("page", "\{\"model_name\":\"Home\"\}", "") == "")
		assert(validate_block("component", "\{\"tag\":\"x-y\"\}", "html:\n\t<p>x</p>") == "")
		assert(validate_block("component", "\{\"model_name\":\"X\",\"client\":\"sometimes\"\}", "html:") == "component: client must be one of off, on, visible, idle, only")

	// `component: tag="x" client="on"` — the header-line attributes are read
	// from the block text (frame-ui.ebnf component_tag_attr): an unindented
	// first line made only of key="value" pairs. Anything else is body.
	void test_component_header_attrs()
		string body = "tag=\"site-header\" client=\"off\"\n\thtml:\n"
		assert(header_attr_members(body) == "\"tag\":\"site-header\",\"client\":\"off\"")
		assert(header_body(body) == "\thtml:\n")
		assert(header_attr_members("tag=\"site-header\", client=\"off\"\n\thtml:\n") == "\"tag\":\"site-header\",\"client\":\"off\"")
		assert(header_attr_members("tag=\"a\\\"b\\\\c\"\n\tbody") == "\"tag\":\"a\\\"b\\\\c\"")
		// An indented first line is body, even when it looks like an attribute.
		string indented = "\tname=\"x\"\n\tage=\"3\"\n"
		assert(header_attr_members(indented) == "")
		assert(header_body(indented) == indented)
		list<string> not_attrs = ["tag=\"x\" stray", "tag=\"x\"other=\"y\"", "tag=\"x\",", "tag = \"x\"", "list<User> rows =", "tag=\"unterminated", "<div>", ""]
		integer i = 0
		while i < not_attrs.length()
			string content = not_attrs[i] + "\n\tbody"
			assert(header_attr_members(content) == "")
			assert(header_body(content) == content)
			i = i + 1
		// Merged after the block attributes; validate_block reads them too.
		assert(header_attrs_json("", body) == "\{\"tag\":\"site-header\",\"client\":\"off\"\}")
		assert(header_attrs_json("\{\"name\":\"X\"\}", body) == "\{\"name\":\"X\",\"tag\":\"site-header\",\"client\":\"off\"\}")
		assert(header_attrs_json("\{\"tag\":\"x-y\"\}", "\thtml:\n") == "\{\"tag\":\"x-y\"\}")
		assert(validate_block("component", "", "tag=\"x-y\"\n\thtml:\n\t\t<p>x</p>") == "")
		assert(validate_block("component", "", "tag=\"x-y\" client=\"sometimes\"\n\thtml:") == "component: client must be one of off, on, visible, idle, only")
		assert(validate_block("component", "", "\n\thtml:") == "component: a class name (`component Name:`) or tag=\"...\" is required")

	// Parameterless events: handlers get a top-level export (UI-B006); a
	// handler with parameters and the onMount() lifecycle hook do not.
	void test_event_handler_names()
		string text = "\tevents:\n\t\tonMount():\n\t\t\tn = 1\n\t\tbump():\n\t\t\tn = n + 1\n\t\tpick(i: integer):\n\t\t\tn = i\n\t\treset_all():\n\t\t\tn = 0\n"
		assert(component_event_handler_names(text) == "bump\nreset_all\n")
		assert(component_event_handler_names("\tstate:\n\t\tinteger n\n") == "")

	// `html: var="name"` is read from the header line (frame-ui.ebnf
	// html_var_attribute); any other header attribute on html: and any on
	// page: (page_block has none) is an error. Unindented text that is not
	// key="value" pairs stays template text.
	void test_html_and_page_headers()
		string body = "var=\"card\"\n\t<b>x</b>"
		string src = expand_html_block(header_attrs_json("", body), header_body(body))
		assert(src.startsWith("string card = \"\"\n"))
		assert(src.contains("var=") == false)
		assert(src.contains("return") == false)
		assert(header_attr_keys("var=\"m\", id=\"x\"\n\t<p></p>") == ",var,id,")
		assert(header_attr_keys("\t<p></p>") == "")
		assert(validate_block("html", "", body) == "")
		assert(validate_block("html", "", "id=\"m\"\n\t<p></p>") == html_header_error())
		assert(validate_block("html", "", "<p>x</p>") == "")
		assert(validate_block("page", "\{\"model_name\":\"Home\"\}", "path=\"/\" layout=\"Main\"\n\t<p></p>") == page_header_error())
		assert(validate_block("page", "\{\"model_name\":\"Home\"\}", "\n\t<p></p>") == "")

	// Attributes match by whole name, outside other attributes' values.
	void test_attribute_lookup()
		assert(extract_attr_value("<screen data-name=\"W\" name=\"R\">", "name") == "R")
		assert(extract_attr_value("<p title=\"cl-if=x\">", "cl-if") == "")
		assert(has_attr("<p title=\"cl-else\">", "cl-else") == false)
		assert(has_attr("<p class=\"a\" cl-else>", "cl-else"))
		assert(extract_attr_value("<p cl-if=\{a > b\} id='x'>", "id") == "x")
		assert(extract_attr_value("<a href=/x/y>", "href") == "/x/y")
		assert(extract_attr_value("<page auth=\"required\" />", "auth") == "required")

	// <script> (UI-C001) and an unknown cl-validate rule (UI-B012) are
	// compile errors, not markup.
	void test_template_errors()
		assert(template_error_code(html_to_stmts("<div><script>x()</script></div>", "h", true, "\{\}", false)) == "E004")
		assert(template_error_code(expand_html_block("\{\}", "<SCRIPT src=\"/a.js\"></SCRIPT>")) == "E004")
		assert(template_error_code(html_to_stmts("<input cl-validate=\"zip\" cl-bind=\"z\">", "h", true, "\{\}", false)) == "E005")
		assert(template_error_code(html_to_stmts("<p>ok</p>", "h", true, "\{\}", false)) == "")

	void test_validate_rules()
		string req = html_to_stmts("<input cl-validate=\"required\" cl-bind=\"name\">", "h", true, "\{\}", false)
		assert(req.contains("if name.trim().length() == 0\n"))
		string email = html_to_stmts("<input cl-validate=\"email\" cl-bind=\"mail\">", "h", true, "\{\}", false)
		assert(email.contains("if mail.indexOf(\"@\") == -1 or mail.indexOf(\".\") == -1\n"))

	// routes: guard: lines are read from decoded source (real tabs).
	void test_routes_guards()
		string table = scan_routes_guards("routes:\n\tguard: \"/admin/*\" [admin, ops]\n\tguard: \"/a/**\" [x]\n", "")
		assert(table == "/admin/*|admin,ops;/a/**|x")
		assert(lookup_routes_guard("/admin/panel", table) == "admin,ops")
		assert(lookup_routes_guard("/admin", table) == "")
		assert(lookup_routes_guard("/a/b/c", table) == "x")
		string fn = page_render_fn("pages_admin_panel", "/admin/panel", "app/ui/web/pages/admin/panel.html", false, false, table, "")
		assert(fn.contains("\t\tif _auth_require_role(\"ops\") == 1\n"))
		assert(fn.contains("\t\t\treturn unauthorized()\n"))

	// <page auth / roles> checks (UI-B015 / UI-B016) and their validation.
	void test_page_access()
		string required = emit_page_access_check("required", "")
		assert(required == "\tif _auth_require_auth() == 0\n\t\treturn redirect(\"/login\")\n")
		string guest = emit_page_access_check("guest", "")
		assert(guest == "\tif _auth_require_auth() == 1\n\t\treturn redirect(\"/\")\n")
		string roles = emit_page_access_check("", "editor, admin")
		assert(roles.contains("\tif _auth_require_role(\"editor\") == 1\n\t\t__page_role_ok = true\n"))
		assert(roles.contains("\tif _auth_require_role(\"admin\") == 1\n"))
		assert(roles.endsWith("\tif __page_role_ok == false\n\t\treturn redirect(\"/forbidden\")\n"))
		assert(emit_page_access_check("none", "") == "")
		string page = "<page auth=\"required\" roles=\"admin\" /><html><body>x</body></html>"
		string fn = page_render_fn("pages_secret", "/secret", "app/ui/web/pages/secret.html", false, false, "", page)
		assert(fn.indexOf("redirect(\"/login\")") != -1 and fn.indexOf("redirect(\"/login\")") < fn.indexOf("_ui_render_page"))
		assert(page_access_error(page, true) == "")
		assert(page_access_error(page, false).contains("needs frame.server"))
		assert(page_access_error("<page auth=\"maybe\" />", true).contains("auth must be required, guest or none"))
		assert(page_access_error("<page roles=\"a\\\"b\" />", true).contains("each role must be a name"))
		assert(page_access_error("<p>no page tag</p>", false) == "")

	// _ui_head_links: the theme link with a styles block (UI-S009); with
	// frame.client in the build, /frame-client.js right after /loader.js.
	void test_head_links()
		assert(head_links_body(false, false) == "string out = page\nreturn out\n")
		string themed = head_links_body(true, false)
		assert(themed.contains("/theme.css") and themed.contains("frame-client") == false)
		string client = head_links_body(false, true)
		assert(client.contains("integer loader_at = out.indexOf(\"/loader.js\")\n"))
		assert(client.contains("out.indexOf(\"/frame-client.js\") == -1"))
		assert(client.contains("<script src=\\\"/frame-client.js\\\" defer></script>"))

	// decode_json_string turns the JSON-escaped file content assemble
	// receives back into source text. Every escape it knows is decoded once,
	// an unknown one keeps its backslash, and a site-sized file (~160 KB
	// escaped, the shape of a page shell with many tab-indented lines)
	// decodes in linear memory: building the result one character at a time
	// allocated every prefix and ran the plugin heap out on a ~50-file site.
	void test_decode_json_string()
		assert(decode_json_string("plain") == "plain")
		assert(decode_json_string("a\\nb\\tc\\r\\\"d\\\\e\\/f") == "a\nb\tc\r\"d\\e/f")
		assert(decode_json_string("\\\\n") == "\\n")
		assert(decode_json_string("x\\u0041") == "x\\u0041")
		assert(decode_json_string("end\\") == "end\\")
		string line = "\\t\\t<div class=\\\"card\\\">\{title\}</div>\\n"
		string raw_line = "\t\t<div class=\"card\">\{title\}</div>\n"
		string esc = line
		integer doublings = 0
		while doublings < 12
			esc = esc + esc
			doublings = doublings + 1
		string raw = decode_json_string(esc)
		assert(raw.length() == raw_line.length() * 4096)
		assert(raw.startsWith(raw_line + raw_line))
		assert(raw.endsWith(raw_line + raw_line))
