// Pattern: live-search
// Use when: a search or filter input that should narrow results as the user types
// Anti-pattern: re-fetching on every keystroke — debounce the input (search only
//   300ms after the user stops typing) and render the results with cl-iterate
//   into the result list, without a full page reload.
// Target: browser (compile with --target browser). The server side is an
//   ordinary endpoint, e.g. GET "/api/search/users?q=..." returning
//   {"results":[{"id":1,"name":"Ann","email":"ann@example.com"}]} with at most 10 rows.

plugins:
	frame.ui
	frame.client

start:
	integer s = ui.updateElement("#search-host", renderSearch())

state:
	string query = ""
	integer pendingTimers = 0

functions:
	string renderSearch()
		html:
			<div class="live-search">
				<input class="search-input" type="search" placeholder="Search users" oninput="queryChanged">
				<p id="search-status"></p>
				<ul id="search-results"></ul>
			</div>

	// Debounce: every keystroke starts a 300ms timer and counts it. Only the
	// timer of the last keystroke finds the count back at zero and searches.
	void queryChanged()
		query = ui.eventValue()
		pendingTimers = pendingTimers + 1
		integer t = ui.setTimeout("runSearch", 300)

	void runSearch()
		pendingTimers = pendingTimers - 1
		if pendingTimers > 0
			return
		if query.trim().length() < 2
			showResults("", "")
			return
		showStatus("Searching...")
		later res = api.get("/api/search/users?q=" + http.encodeUrl(query))
		if res.ok
			showResults(renderResults(res.body), "")
		else
			showResults("", "Search failed (" + res.status.toString() + ")")

	// cl-iterate renders one <li> per result; only the list is replaced.
	string renderResults(string body)
		list<any> results = json.textToData(body).results
		html:
			<li cl-iterate="user in results">
				<a href="/users/{user.id}">{user.name}</a>
				<span class="email">{user.email}</span>
			</li>
			<li cl-if="results.length() == 0" class="no-results">No matches</li>

	void showResults(string items, string status)
		integer s = ui.updateElement("#search-results", items)
		showStatus(status)

	void showStatus(string text)
		integer s = ui.updateElement("#search-status", text)
