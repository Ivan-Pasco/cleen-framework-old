// Pattern: css-and-theming
// Use when: styling any app — where CSS files live, where theme values are
//   declared (public/css/theme.css) and how they are consumed; read this before
//   writing any .css or adding class names to an html: block.
// Anti-pattern: <style> tags or style="..." attributes in pages or html: blocks,
//   theme values declared in .cln files, colors and spacing hard-coded in
//   stylesheets instead of declared once on :root in public/css/theme.css, CSS
//   files outside public/css/, or <style> elements injected at runtime.
// Target: browser (compile with --target browser) for the runtime part below.
//
// ─── FILES ────────────────────────────────────────────────────────────────────
//   public/css/theme.css   theme values only: CSS custom properties on :root
//   public/css/app.css     layout, utilities and component styles, via var(--...)
//   ./public is served at /public/, so a page shell links both in its <head>:
//     <link rel="stylesheet" href="/public/css/theme.css">
//     <link rel="stylesheet" href="/public/css/app.css">
//
//   /* public/css/theme.css */
//   :root {
//       --color-primary: #2563eb;  --color-text: #0f172a;  --color-bg: #ffffff;
//       --color-error: #dc2626;    --color-success: #16a34a;
//       --space-sm: 0.5rem;        --space-md: 1rem;        --radius: 4px;
//   }
//
//   /* public/css/app.css: consume theme values, never repeat them */
//   body { background: var(--color-bg); color: var(--color-text); }
//   .alert-banner { padding: var(--space-md); border-radius: var(--radius); }
//   .alert-banner.alert-error   { background: var(--color-error); }
//   .alert-banner.alert-success { background: var(--color-success); }
//   .progress-fill { background: var(--color-primary); height: var(--space-sm); }
//
// Prefix class names with the component tag (.alert-banner .title, not .title):
// frame.ui has no Shadow DOM, so unprefixed classes collide across components.

plugins:
	frame.ui

start:
	integer s = ui.updateElement("#app", renderDashboard())
	setProgress(40)

state:
	boolean dark = false

// Markup carries class names only — every visual value comes from the stylesheets.
functions:
	string alertBanner(string message, string severity)
		html:
			<div class="alert-banner alert-{severity}">
				<p class="alert-banner-text">{message}</p>
			</div>

	string renderDashboard()
		string banner = alertBanner("Settings saved", "success")
		html:
			<main class="dashboard">
				{!banner}
				<div class="progress-track"><div class="progress-fill"></div></div>
				<button class="btn-primary" onclick="toggleTheme">Toggle theme</button>
			</main>

	// Runtime theme change: overwrite the custom properties on :root.
	// Never swap stylesheets or inject a <style> element.
	void toggleTheme()
		dark = not dark
		if dark
			ui.setCssVar("--color-bg", "#0f172a")
			ui.setCssVar("--color-text", "#f1f5f9")
		else
			ui.setCssVar("--color-bg", "#ffffff")
			ui.setCssVar("--color-text", "#0f172a")

	// The only acceptable inline style: a value that changes at runtime, set
	// from Clean with ui.setStyle — never written into the markup.
	void setProgress(integer percent)
		integer s = ui.setStyle(".progress-fill", "width", percent.toString() + "%")
