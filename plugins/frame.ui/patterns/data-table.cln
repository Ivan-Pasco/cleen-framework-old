// Pattern: data-table
// Use when: displaying a queryable, sortable, filterable list of records
// Anti-pattern: fetching all rows into the page and filtering or sorting them
//   client-side — for large tables that is slow and leaks data. Paginate, sort
//   and filter on the server; page, sort, dir and q travel as query params.
//
// The table is plain server-rendered HTML: the sort headers and pager are links
// and the filter is a GET form, so every change is a new request that reads
// only one page of rows. No client code is needed.

plugins:
	frame.ui
	frame.server
	frame.data

data User:
	fields:
		integer id primary generated
		string name required
		string email required

endpoints:
	GET "/users":
		string q = req.query("q")
		string sort = req.query("sort")
		string dir = req.query("dir")
		integer page = req.query("page").toInteger()
		if sort != "email"
			sort = "name"
		if dir != "desc"
			dir = "asc"
		if page < 1
			page = 1
		PagedResult<User> result = usersPage("%" + q + "%", sort, dir, page)
		return html(renderTable(result, q, sort, dir))

functions:
	// order: takes a column name, not a value, so each allowed column and
	// direction is its own query — this also whitelists what users can sort by.
	PagedResult<User> usersPage(string pattern, string sort, string dir, integer page)
		if sort == "email" and dir == "desc"
			return User.paginate:
				where:
					name like pattern
				order: email desc
				paginate:
					page: page
					perPage: 20
		if sort == "email"
			return User.paginate:
				where:
					name like pattern
				order: email asc
				paginate:
					page: page
					perPage: 20
		if dir == "desc"
			return User.paginate:
				where:
					name like pattern
				order: name desc
				paginate:
					page: page
					perPage: 20
		return User.paginate:
			where:
				name like pattern
			order: name asc
			paginate:
				page: page
				perPage: 20

	// Clicking the active column flips the direction.
	string flip(string column, string sort, string dir)
		if column == sort and dir == "asc"
			return "desc"
		return "asc"

	string renderTable(PagedResult<User> result, string q, string sort, string dir)
		string nameDir = flip("name", sort, dir)
		string emailDir = flip("email", sort, dir)
		string qs = http.encodeUrl(q)
		string base = "/users?q=" + qs + "&sort=" + sort + "&dir=" + dir + "&page="
		string prevUrl = base + (result.currentPage - 1).toString()
		string nextUrl = base + (result.currentPage + 1).toString()
		html:
			<section class="data-table">
				<form method="get" action="/users">
					<input type="search" name="q" value="{q}" placeholder="Filter by name">
					<button type="submit">Filter</button>
				</form>
				<table>
					<thead>
						<tr>
							<th><a href="/users?q={qs}&sort=name&dir={nameDir}">Name</a></th>
							<th><a href="/users?q={qs}&sort=email&dir={emailDir}">Email</a></th>
						</tr>
					</thead>
					<tbody>
						<tr cl-iterate="user in result.items">
							<td>{user.name}</td>
							<td>{user.email}</td>
						</tr>
					</tbody>
				</table>
				<nav class="pagination">
					<a cl-if="result.hasPrev" href="{prevUrl}">Previous</a>
					<span>Page {result.currentPage.toString()} of {result.totalPages.toString()}</span>
					<a cl-if="result.hasNext" href="{nextUrl}">Next</a>
				</nav>
			</section>
