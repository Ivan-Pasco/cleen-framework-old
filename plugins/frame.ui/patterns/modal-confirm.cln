// Pattern: modal-confirm
// Use when: any destructive action (delete, deactivate, cancel subscription)
//   triggered by a button click
// Anti-pattern: triggering the destructive action immediately on click — the
//   Delete button only opens a confirm modal that names what will be destroyed;
//   the request is sent only from the modal's explicit confirm button.
// Target: browser (compile with --target browser).
//
// The server-rendered list carries the record on each button:
//   <li id="user-42">Ann <button onclick="askDelete" data-id="42" data-name="Ann">Delete</button></li>
//   <div id="confirm-modal"></div>

plugins:
	frame.ui
	frame.client

state:
	string targetId = ""
	string targetName = ""

// The destructive request itself: deleteUser() is generated, with the
// deleteUserPending double-click guard and deleteUserError.
send: deleteUser delete "/api/users/{targetId}"
	on success: emit "userDeleted"
	on error: emit "deleteFailed"

functions:
	// Step 1: the Delete button only remembers the target and opens the modal.
	void askDelete()
		targetId = ui.eventAttr("data-id")
		targetName = ui.eventAttr("data-name")
		integer s = ui.updateElement("#confirm-modal", renderModal(targetName))
		s = ui.focus("#confirm-cancel")

	// Cancel is focused first, so Enter never confirms by accident; Escape closes.
	string renderModal(string name)
		html:
			<div class="modal-overlay">
				<div class="modal-dialog" role="alertdialog" aria-modal="true" onkeydown.escape="closeModal">
					<h2>Delete user?</h2>
					<p>This permanently removes <strong>{name}</strong> and all their data.</p>
					<p id="confirm-error" class="error"></p>
					<div class="modal-actions">
						<button id="confirm-cancel" class="btn-secondary" onclick="closeModal">Cancel</button>
						<button class="btn-danger" onclick="deleteUser">Yes, delete {name}</button>
					</div>
				</div>
			</div>

	void closeModal()
		targetId = ""
		integer s = ui.updateElement("#confirm-modal", "")

	// Step 2 happened (deleteUser ran from the modal): update the list.
	void userDeleted()
		integer s = ui.updateElement("#user-" + targetId, "")
		closeModal()

	void deleteFailed()
		integer s = ui.updateElement("#confirm-error", deleteUserError)
