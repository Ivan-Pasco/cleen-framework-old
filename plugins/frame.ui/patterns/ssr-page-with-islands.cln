// Pattern: ssr-page-with-islands
// Use when: building any page — this is the foundational structure pattern, read it first
// Anti-pattern: putting logic or data loading in the HTML file, or making every
//   component interactive — the HTML is a static shell, all data comes from the
//   page's companion load(), and most content stays client="off" (server-rendered,
//   zero JS). Only the few parts that need interactivity are hydrated islands.
//
// ─── THREE LAYERS ─────────────────────────────────────────────────────────────
// 1. app/ui/web/pages/products/[category].html — static shell. {name} values and
//    cl-if / cl-else / cl-iterate are filled on the server from load()'s result;
//    custom tags render components; no <script>, no logic:
//
//    <!DOCTYPE html>
//    <html>
//    <head><title>{category}</title><link rel="stylesheet" href="/public/css/app.css"></head>
//    <body>
//        <site-header></site-header>
//        <screen name="StockFilter" client="on"></screen>
//        <main class="product-grid">
//            <h1>{category} ({count})</h1>
//            <p cl-if="count == 0">No products in this category.</p>
//            <product-card cl-iterate="p in products" name="{p.name}" price="{p.price}" stock="{p.stock}"></product-card>
//        </main>
//    </body>
//    </html>
//
// 2. app/ui/web/pages/products/[category].cln — companion: load() (and an
//    optional guard()) run on the server for every request. Below.
// 3. app/ui/web/components/*.cln and screens — the tags used by the shell. Below.
//
// Hydration (client= on the tag): off (default) = server HTML only, no JS;
// on = hydrate at load; visible = when scrolled into view; idle = when the
// browser is idle. frame.ui adds the browser runtime only to pages with a
// hydrated island.

plugins:
	frame.ui
	frame.server
	frame.data

data Product:
	fields:
		integer id primary generated
		string category required
		string name required
		string price required
		integer stock default: 0

// ─── 2. COMPANION: the only source of the shell's {values} ────────────────────
functions:
	any load(Request request)
		string category = request.params.category
		list<Product> products = Product.find:
			where:
				category == category
			order: name asc
		return { category: category, count: products.length(), products: products }

// ─── 3a. STATIC COMPONENTS (client="off"): plain HTML, zero JS ────────────────
component: tag="site-header"
	html:
		<header class="site-header">
			<a href="/" class="logo">My Store</a>
			<nav><a href="/products/all">All products</a></nav>
		</header>

component: tag="product-card"
	inputs:
		string name
		string price
		integer stock

	html:
		<article class="product-card" data-stock="{stock.toString()}">
			<h2 class="product-card-name">{name}</h2>
			<p class="product-card-price">{price}</p>
			<p class="product-card-stock" cl-if="stock == 0">Sold out</p>
		</article>

// ─── 3b. ONE ISLAND: placed with <screen name="StockFilter" client="on"> ──────
// Its handlers run in the browser (StockFilter.toggle); it changes the
// server-rendered grid through ui.* calls instead of re-rendering it.
screen StockFilter:
	state:
		boolean onlyInStock = false

	functions:
		string render()
			html:
				<label class="stock-filter"><input type="checkbox" onchange="toggle"> In stock only</label>

		void toggle()
			onlyInStock = not onlyInStock
			if onlyInStock
				integer s = ui.queryAddClass(".product-card[data-stock='0']", "is-hidden")
			else
				integer s = ui.queryRemoveClass(".product-card[data-stock='0']", "is-hidden")
