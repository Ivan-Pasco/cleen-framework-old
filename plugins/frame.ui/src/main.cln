// frame.ui plugin — HTML-first UI framework
// ABI: Plugin Contracts v3 — typed AST emission
//   (foundation/spec/framework/contracts/typed-emission.md)
//
// Blocks handled (frame-ui.ebnf): component, page, html, styles.
// Exports (plugin.toml [exports]): expand_block_typed, process_html_typed,
// assemble_typed, lint_project, validate_block,
// get_keywords, plus the three [lifecycle] slots.
//
// Emission strategy: the HTML/component emitters build Clean SOURCE strings
// (`html = html + "..."` statement sequences) and hand them to the compiler
// through _emit_stmt_from_source; classes go through _emit_class_full with
// those parsed bodies as method body handles.

// ============================================================================
// TYPED-EMISSION BRIDGE DECLARATIONS
// ============================================================================
// Underscore aliases required (Clean Language external: rejects dots in names).
// These are env imports from the compiler's typed-emission sandbox — they
// MUST NOT appear in plugin.toml [bridge].functions.

external:
	// ---- Declaration emitters (§3.4, §3.5, §3.11, §3.13) ----
	integer _emit_function(integer ctx, string name, string params_json, integer return_type, integer body_stmt_handle, integer flags)
	integer _emit_class_full(integer ctx, integer class_spec_handle_or_lp, integer flags)
	integer _emit_state_block(integer ctx, string fields_json)
	integer _emit_statement_inline(integer ctx, integer stmt_handle)
	integer _emit_stmt_from_source(integer ctx, string source, integer origin_offset)
	// assemble.md §6.1 — the ONLY typed-emission bridge legal inside
	// assemble_typed. Registers one synthetic Clean source file with the
	// compilation unit; the injected content flows through the same parser,
	// resolver, type checker, and MIR lowering as user-authored files.
	integer _inject_source_file(integer ctx, string virtual_path, string content)
	// assemble.md §6.1a — records replacement content for an existing
	// discovered source file. Used by assemble_typed to rename companion page
	// symbols (any load / any guard) to per-page names so multiple companions
	// can coexist without a global-symbol collision.
	integer _transform_source_file(integer ctx, string path, string new_content)
	// ---- AST type/expression constructors (§3.9, §3.10) ----
	integer _type_class_ref(integer ctx, string name)
	integer _type_string(integer ctx)
	integer _type_boolean(integer ctx)
	integer _expr_call(integer ctx, string callee, string args_json)
	// ---- Diagnostics (§5) ----
	integer _emit_error(integer ctx, integer severity, string code, string message, string span)
	// ---- Sticky-error context (§3.15) ----
	integer _ctx_set_error_context(integer ctx, string code, string message)
	integer _ctx_clear_error(integer ctx)
	// ---- Expression builders (§3.14) ----
	integer _batch_stringLit(integer ctx, string value)
	// ---- Build-state keystore (lifecycle.md §2.5) ----
	string _build_state_get(string key)
	void _build_state_set(string key, string value)
	// ---- Contract 5 Phase C — read-only AST accessors for lint_project ----
	// Spec: foundation/spec/framework/contracts/lint-extension.md §4.
	// Each accessor returns a JSON LP-string; `list_blocks` returns entries
	// shaped {file, line, content, attributes:{...}}.
	string _ast_list_functions(integer handle)
	string _ast_list_blocks(integer handle, string block_name)

// ============================================================================
// LIFECYCLE SLOTS (typed-emission.md §7)
// ============================================================================
//   - emit_ui_helpers_typed: SSR helpers (render, renderWith) and the small
//     runtime helpers the emitted page/component code calls.
//   - emit_ui_client_init_typed: for each component with client != "off",
//     emits the hydration statements into the synthetic client _start body.

functions:
	// module_helpers lifecycle slot: emits the SSR response helpers (render,
	// renderWith) and the runtime helpers emitted page/component code calls,
	// each as a top-level function via _emit_function.
	integer emit_ui_helpers_typed(integer ctx, string ctx_json)
		_ctx_set_error_context(ctx, "PLUGIN_UI_HELPERS", "emit_ui_helpers")
		// Type handles are single-consumption per typed-emission.md §4 clause 2:
		// each _emit_function consumes one handle per parameter plus one for the
		// return type, so every use-site allocates fresh handles.
		//
		// render(name: string) -> string
		integer render_p_str = _type_string(ctx)
		integer render_r_str = _type_string(ctx)
		string render_params = "[{\"name\":\"name\",\"type_handle\":" + render_p_str.toString() + "}]"
		string render_body = "return _ui_head_links(_ui_render_page(\"app/ui/web/pages/\" + name + \".html\", \"{}\"))\n"
		ui_helper_function(ctx, "render", render_params, render_r_str, render_body, 1)
		// renderWith(name: string, data: string) -> string
		integer rw_p_name = _type_string(ctx)
		integer rw_p_data = _type_string(ctx)
		integer rw_r_str = _type_string(ctx)
		string rw_params = "[{\"name\":\"name\",\"type_handle\":" + rw_p_name.toString() + "},{\"name\":\"data\",\"type_handle\":" + rw_p_data.toString() + "}]"
		string rw_body = "return _ui_head_links(_ui_render_page(\"app/ui/web/pages/\" + name + \".html\", data))\n"
		ui_helper_function(ctx, "renderWith", rw_params, rw_r_str, rw_body, 1)
		// _ui_add_root_class(markup: string, cls: string) -> string
		// Adds `cls` to the class list of the first element in `markup` — the
		// outer element of a rendered component (UI-C009, `class=` on a
		// component tag). Merges into an existing class="..." / class='...'.
		integer arc_p_markup = _type_string(ctx)
		integer arc_p_cls = _type_string(ctx)
		integer arc_r_str = _type_string(ctx)
		string arc_params = "[{\"name\":\"markup\",\"type_handle\":" + arc_p_markup.toString() + "},{\"name\":\"cls\",\"type_handle\":" + arc_p_cls.toString() + "}]"
		ui_helper_function(ctx, "_ui_add_root_class", arc_params, arc_r_str, add_root_class_body(), 1)
		// _ui_attr_has(attrs, name) / _ui_attr_get(attrs, name): read one
		// attribute from the JSON object of tag attributes the host passes to
		// a component render export (string values only).
		integer ah_p_attrs = _type_string(ctx)
		integer ah_p_name = _type_string(ctx)
		integer ah_r = _type_boolean(ctx)
		string ah_params = "[{\"name\":\"attrs\",\"type_handle\":" + ah_p_attrs.toString() + "},{\"name\":\"name\",\"type_handle\":" + ah_p_name.toString() + "}]"
		ui_helper_function(ctx, "_ui_attr_has", ah_params, ah_r, "return attrs.indexOf(\"\\\"\" + name + \"\\\":\\\"\") != -1\n", 1)
		integer ag_p_attrs = _type_string(ctx)
		integer ag_p_name = _type_string(ctx)
		integer ag_r = _type_string(ctx)
		string ag_params = "[{\"name\":\"attrs\",\"type_handle\":" + ag_p_attrs.toString() + "},{\"name\":\"name\",\"type_handle\":" + ag_p_name.toString() + "}]"
		ui_helper_function(ctx, "_ui_attr_get", ag_params, ag_r, attr_get_body(), 1)
		// _ui_head_links(page: string) -> string
		// UI-S009 theme auto-link: when the project declares a `styles` block,
		// adds <link rel="stylesheet" href="/theme.css"> before the page's
		// </head>. When the build includes frame.client, a page that loads the
		// browser runtime (/loader.js, which clean-server adds to pages with
		// hydration islands) also gets frame.client's /frame-client.js right
		// after it. With frame.canvas in the build, a page with a <canvas
		// data-scene="..."> gets the canvas runtime.
		integer hl_p_page = _type_string(ctx)
		integer hl_r_str = _type_string(ctx)
		string hl_params = "[{\"name\":\"page\",\"type_handle\":" + hl_p_page.toString() + "}]"
		ui_helper_function(ctx, "_ui_head_links", hl_params, hl_r_str, head_links_with_canvas(head_links_body(_build_state_get("frame.ui.has_styles") == "1", _build_state_get("frame.client.loaded") == "1"), _build_state_get("frame.canvas.loaded") == "1"), 1)
		_ctx_clear_error(ctx)
		return 0

	// Body source of the _ui_head_links helper (see emit_ui_helpers_typed).
	// The theme link is added once, before the first </head>, and only when
	// the page does not already link /theme.css itself. The client script is
	// added once, right after the </script> of the /loader.js tag (defer, as
	// that tag is, so it runs after the runtime has started).
	string head_links_body(boolean has_styles, boolean has_client)
		string b = "string out = page\n"
		if has_styles
			b = b + "integer head_end = out.indexOf(\"</head>\")\n"
			b = b + "if head_end != -1 and out.indexOf(\"href=\\\"/theme.css\\\"\") == -1 and out.indexOf(\"href='/theme.css'\") == -1\n"
			b = b + "\tout = out.substring(0, head_end) + \"<link rel=\\\"stylesheet\\\" href=\\\"/theme.css\\\">\" + out.substring(head_end, out.length())\n"
		if has_client
			b = b + "integer loader_at = out.indexOf(\"/loader.js\")\n"
			b = b + "if loader_at != -1 and out.indexOf(\"/frame-client.js\") == -1\n"
			b = b + "\tinteger loader_end = out.indexOf(\"</script>\", loader_at)\n"
			b = b + "\tif loader_end != -1\n"
			b = b + "\t\tinteger insert_at = loader_end + 9\n"
			b = b + "\t\tout = out.substring(0, insert_at) + \"<script src=\\\"/frame-client.js\\\" defer></script>\" + out.substring(insert_at, out.length())\n"
		return b + "return out\n"

	// `body` (a head_links_body) that also gives a page with a <canvas
	// data-scene="..."> frame.canvas's runtime when frame.canvas is in the
	// build: the scripts go once, before </body>, and start that scene.
	string head_links_with_canvas(string body, boolean has_canvas)
		if has_canvas == false
			return body
		string b = body.substring(0, body.length() - 11)
		b = b + "if out.indexOf(\"data-scene=\") != -1 and out.indexOf(\"/frame-canvas.js\") == -1\n"
		b = b + "\tinteger body_end = out.indexOf(\"</body>\")\n"
		b = b + "\tif body_end == -1\n"
		b = b + "\t\tbody_end = out.length()\n"
		b = b + "\tout = out.substring(0, body_end) + \"" + canvas_runtime_scripts() + "\" + out.substring(body_end, out.length())\n"
		return b + "return out\n"

	// The script tags of frame.canvas's runtime, as Clean string-literal text.
	string canvas_runtime_scripts()
		return "<script src='/frame-canvas-bridge.js'></script><script src='/frame-canvas.js'></script>"

	// Body source of the _ui_attr_get helper (see emit_ui_helpers_typed):
	// the decoded string value of key `name` in the JSON object `attrs`, or
	// "" when absent.
	string attr_get_body()
		string b = "string key = \"\\\"\" + name + \"\\\":\\\"\"\n"
		b = b + "integer at = attrs.indexOf(key)\n"
		b = b + "if at == -1\n"
		b = b + "\treturn \"\"\n"
		b = b + "integer i = at + key.length()\n"
		b = b + "string out = \"\"\n"
		b = b + "while i < attrs.length()\n"
		b = b + "\tstring c = attrs.substring(i, i + 1)\n"
		b = b + "\tif c == \"\\\"\"\n"
		b = b + "\t\treturn out\n"
		b = b + "\tif c == \"\\\\\" and i + 1 < attrs.length()\n"
		b = b + "\t\tstring e = attrs.substring(i + 1, i + 2)\n"
		b = b + "\t\tif e == \"n\"\n"
		b = b + "\t\t\tout = out + \"\\n\"\n"
		b = b + "\t\telse if e == \"t\"\n"
		b = b + "\t\t\tout = out + \"\\t\"\n"
		b = b + "\t\telse\n"
		b = b + "\t\t\tout = out + e\n"
		b = b + "\t\ti = i + 2\n"
		b = b + "\telse\n"
		b = b + "\t\tout = out + c\n"
		b = b + "\t\ti = i + 1\n"
		b = b + "return out\n"
		return b

	// Body source of the _ui_add_root_class helper (see emit_ui_helpers_typed).
	string add_root_class_body()
		string b = "if cls == \"\"\n"
		b = b + "\treturn markup\n"
		b = b + "integer open_pos = markup.indexOf(\"<\")\n"
		b = b + "if open_pos == -1\n"
		b = b + "\treturn markup\n"
		b = b + "integer close_pos = markup.indexOf(\">\", open_pos)\n"
		b = b + "if close_pos == -1\n"
		b = b + "\treturn markup\n"
		b = b + "string open_tag = markup.substring(open_pos, close_pos)\n"
		b = b + "integer dq = open_tag.indexOf(\" class=\\\"\")\n"
		b = b + "integer sq = open_tag.indexOf(\" class='\")\n"
		b = b + "integer at = -1\n"
		b = b + "if dq != -1\n"
		b = b + "\tat = open_pos + dq + 8\n"
		b = b + "else if sq != -1\n"
		b = b + "\tat = open_pos + sq + 8\n"
		b = b + "if at != -1\n"
		b = b + "\treturn markup.substring(0, at) + cls + \" \" + markup.substring(at, markup.length())\n"
		b = b + "integer insert_at = close_pos\n"
		b = b + "if close_pos > 0 and markup.substring(close_pos - 1, close_pos) == \"/\"\n"
		b = b + "\tinsert_at = close_pos - 1\n"
		b = b + "return markup.substring(0, insert_at) + \" class=\\\"\" + cls + \"\\\"\" + markup.substring(insert_at, markup.length())\n"
		return b

	// client_init lifecycle slot. Reads build_state["frame.ui:components"] and
	// emits per-component hydration statements (client-mode build only).
	integer emit_ui_client_init_typed(integer ctx, string ctx_json)
		_ctx_set_error_context(ctx, "PLUGIN_UI_CLIENT_INIT", "emit_ui_client_init")
		string source = emit_ui_client_init_source(ctx_json)
		if source.length() > 0
			// The parsed fragment must be handed to _emit_statement_inline;
			// a handle that is only allocated never reaches the client _start.
			integer stmt_h = _emit_stmt_from_source(ctx, source, 0)
			if stmt_h != 0
				integer err = _emit_statement_inline(ctx, stmt_h)
		_ctx_clear_error(ctx)
		return 0

// ============================================================================
// BLOCK EXPAND ENTRY POINT (typed-emission.md §2.2)
// ============================================================================

functions:
	integer expand_block_typed(integer ctx, string block_name, string attrs_json, string body)
		// component: block — a Clean class with render(), setSlot(),
		// renderSSR(), setInput() and the request-time render export.
		if block_name == "component"
			return expand_component_stub(ctx, attrs_json, body)

		// page <Name>: block — a Clean class whose render() returns the page.
		if block_name == "page"
			return expand_page_stub(ctx, attrs_json, body)

		// html: block — statements that build the markup in `__html` (or the
		// var= variable) and, without var=, return it (UI-P004 / UI-P005).
		if block_name == "html"
			return expand_html_block_stub(ctx, attrs_json, body)

		// styles Name: block — frame-ui.ebnf §4 styles_block. Produces no
		// Clean code; its CSS is added to the frame.ui stylesheet artifact.
		if block_name == "styles"
			return expand_styles_typed(ctx, attrs_json, body)

		return 0

// ============================================================================
// STYLES BLOCK — frame-ui.ebnf §4 (styles_block)
// ============================================================================
// `styles <Name>:` scopes design-token variables and global CSS rules to a
// named stylesheet:
//   variables:  css_variable_declaration = css_token_name ":" string_literal
//               → `--<token>: <value>;` declared on :root
//   global:     css_rule_line = string_literal | identifier | expression
//               → raw CSS rules, emitted verbatim (string literals unquoted)
// The resulting CSS is appended to build_state["frame.ui.theme.css"], the
// source of frame.ui's `theme.css` static-asset artifact (plugin.toml
// [[artifacts]]), which the server publishes at /theme.css.

functions:
	integer expand_styles_typed(integer ctx, string attrs_json, string body)
		_ctx_set_error_context(ctx, "PLUGIN_UI_STYLES", "expand_styles")
		string sheet_name = extract_json_field(attrs_json, "model_name")
		if sheet_name == ""
			return plugin_error(ctx, "FRAME-UI-E020", "styles block requires a stylesheet name, e.g. `styles Theme:`")
		string css = styles_block_to_css(sheet_name, body)
		if css.startsWith("!")
			return plugin_error(ctx, "FRAME-UI-E021", css.substring(1, css.length()))
		string existing = _build_state_get("frame.ui.theme.css")
		_build_state_set("frame.ui.theme.css", existing + css)
		// UI-S009: a styles block turns on the /theme.css auto-link.
		_build_state_set("frame.ui.has_styles", "1")
		_ctx_clear_error(ctx)
		return 0

	// Translate a styles block body into CSS. Returns the CSS text, or a
	// message prefixed with "!" when the body does not match styles_section.
	string styles_block_to_css(string sheet_name, string body)
		string vars_css = ""
		string global_css = ""
		string section = ""
		integer section_indent = -1
		integer global_base = -1
		integer pos = 0
		integer body_len = body.length()
		while pos < body_len
			integer nl = body.indexOf("\n", pos)
			if nl == -1
				nl = body_len
			string raw = body.substring(pos, nl)
			string line = raw.trim()
			pos = nl + 1
			if line.length() > 0 and line.startsWith("//") == false
				integer indent = count_leading_ws(raw)
				if section_indent == -1 or indent <= section_indent
					if line == "variables:"
						section = "variables"
					else if line == "global:"
						section = "global"
					else
						return "!styles " + sheet_name + ": unknown section `" + line + "` (expected `variables:` or `global:`)"
					section_indent = indent
				else if section == "variables"
					integer colon = line.indexOf(":")
					if colon <= 0
						return "!styles " + sheet_name + ": expected `token-name: \"value\"` in variables:, got `" + line + "`"
					string token = line.substring(0, colon).trim()
					string value = line.substring(colon + 1, line.length()).trim()
					if is_css_token_name(token) == false
						return "!styles " + sheet_name + ": `" + token + "` is not a valid CSS token name (lowercase letters, digits and '-')"
					if is_quoted_literal(value) == false
						return "!styles " + sheet_name + ": value of `" + token + "` must be a string literal"
					string decoded = decode_json_string(value.substring(1, value.length() - 1))
					vars_css = vars_css + "\t--" + token + ": " + decoded + ";\n"
				else
					if global_base == -1
						global_base = indent
					integer cut = global_base
					if indent < cut
						cut = indent
					string rule = raw.substring(cut, raw.length()).trimEnd()
					if is_quoted_literal(line)
						rule = decode_json_string(line.substring(1, line.length() - 1))
					global_css = global_css + rule + "\n"
		string css = "/* styles " + sheet_name + " */\n"
		if vars_css != ""
			css = css + ":root {\n" + vars_css + "}\n"
		return css + global_css

	// Number of leading tab/space characters.
	integer count_leading_ws(string s)
		integer i = 0
		boolean scanning = true
		while scanning and i < s.length()
			string ch = s.substring(i, i + 1)
			if ch == "\t" or ch == " "
				i = i + 1
			else
				scanning = false
		return i

	// css_token_name = ( LOWER_ALPHA | "-" ) , { ALPHANUMERIC | "-" }
	boolean is_css_token_name(string name)
		if name.length() == 0
			return false
		string lower = "abcdefghijklmnopqrstuvwxyz"
		string allowed = lower + "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-"
		string first = name.substring(0, 1)
		if first != "-" and lower.indexOf(first) == -1
			return false
		integer i = 1
		while i < name.length()
			if allowed.indexOf(name.substring(i, i + 1)) == -1
				return false
			i = i + 1
		return true

	boolean is_quoted_literal(string s)
		return s.length() >= 2 and s.startsWith("\"") and s.endsWith("\"")

// ============================================================================
// TOP-LEVEL PROCESSORS
// ============================================================================
// process_html_typed: an HTML entry page → a page class (expand_page_typed).
// assemble_typed: scans source files for page companions, renames their
//   load() / guard() functions per page, and injects the synthetic route
//   module when has_frame_server=true.

functions:
	// process_html: emit the page class for an HTML entry page. The page
	// attributes, render body and runtime injection are prepared here and
	// handed to expand_page_typed.
	integer process_html_typed(integer ctx, string ctx_json)
		_ctx_set_error_context(ctx, "PLUGIN_UI_PROCESS_HTML", "process_html")
		string html = decode_json_string(extract_json_field_escaped(ctx_json, "html"))
		string path = decode_json_string(extract_json_field_escaped(ctx_json, "path"))
		string registry_json = decode_json_string(extract_json_field_escaped(ctx_json, "registry_json"))
		string companion_json = decode_json_string(extract_json_field_escaped(ctx_json, "companion_json"))
		string layout = extract_page_attr(html, "layout")
		string auth = extract_page_attr(html, "auth")
		string roles = extract_page_attr(html, "roles")
		string body_html = extract_body(html)
		boolean has_data = false
		if companion_json != ""
			if companion_json.indexOf("\"has_load\":true") != -1
				has_data = true
		string render_code = html_to_stmts(body_html, "html", true, registry_json, has_data)
		if template_error_code(render_code) != ""
			return template_error(ctx, template_error_code(render_code))
		if needs_client_runtime(html)
			render_code = render_code + append_stmt("html", "\"<script src='/loader.js' data-wasm='/frontend.wasm'></script>\"")
			// frame.client's browser bridges (api.*, live.*, feed.*) load after
			// the runtime, which waits for them before instantiating the WASM.
			if _build_state_get("frame.client.loaded") == "1"
				render_code = render_code + append_stmt("html", "\"<script src='/frame-client.js'></script>\"")
		// A <canvas data-scene="..."> is started by frame.canvas's runtime
		// (its [[artifacts]]: the bridge, then the loader).
		if _build_state_get("frame.canvas.loaded") == "1" and html.indexOf("data-scene=") != -1
			render_code = render_code + append_stmt("html", "\"" + canvas_runtime_scripts() + "\"")
		string page_name = path_to_class_name(path)
		expand_page_typed(ctx, page_name, path, layout, auth, roles, render_code, companion_json)
		_ctx_clear_error(ctx)
		return 0

	// assemble: build one Clean source string — start: (route registrations)
	// + functions: (route render functions, hydration manifest, diagnostic
	// function) — and inject it once via _inject_source_file under
	// __plugin_frame_ui__/companion_routes.cln. _inject_source_file and
	// _transform_source_file are the only bridges legal here (assemble.md
	// §6.1 / §6.1a).
	integer assemble_typed(integer ctx, string ctx_json)
		_ctx_set_error_context(ctx, "PLUGIN_UI_ASSEMBLE", "assemble")
		boolean has_server = ctx_json.indexOf("\"has_frame_server\":true") != -1
		list<string> source_files = parse_source_files(ctx_json)

		// UI-S009: assemble sees every project file before any block is
		// expanded, so it records whether a `styles` block exists for the
		// _ui_head_links helper (module_helpers) to read.
		integer __ssi = 0
		while __ssi < source_files.length()
			if source_declares_styles(source_files[__ssi])
				_build_state_set("frame.ui.has_styles", "1")
			__ssi = __ssi + 1

		// -------- Phase 1: build routes-guard table --------
		string __routes_guard_table = ""
		integer __gsi = 0
		while __gsi < source_files.length()
			string __gsf = source_files[__gsi]
			// The content is JSON-escaped and may hold `\"`; read it whole and
			// decode it so routes: lines are real, tab-indented lines.
			string __gsc = decode_json_string(extract_json_field_escaped(__gsf, "content"))
			__routes_guard_table = scan_routes_guards(__gsc, __routes_guard_table)
			__gsi = __gsi + 1

		// -------- Phase 1b: explicit GET endpoints --------
		// "|/url|" records (":param" segments normalised to ":") for every
		// `GET "<url>"` / `FEED "<url>"` route declared in an endpoints:
		// block. A page whose URL an endpoint already declares is not routed
		// (the endpoint wins; frame-server.ebnf §2 / §10).
		string explicit_gets = "|"
		integer __esi = 0
		while __esi < source_files.length()
			string __esf = source_files[__esi]
			if extract_json_field(__esf, "path").endsWith(".cln")
				explicit_gets = scan_explicit_get_routes(extract_json_field_escaped(__esf, "content"), explicit_gets)
			__esi = __esi + 1
		// ",<module>," for every page whose companion .cln (load/guard)
		// gives it a route in Phase 2, so its .html file is not routed a
		// second time in Phase 2b.
		string routed_modules = ","
		integer __rmi = 0
		while __rmi < source_files.length()
			string __rmf = source_files[__rmi]
			string __rmp = extract_json_field(__rmf, "path")
			if __rmp.endsWith(".cln") and __rmp.indexOf("pages/") != -1 and (__rmf.indexOf("any load(") != -1 or __rmf.indexOf("any guard(") != -1)
				routed_modules = routed_modules + derive_module_name(__rmp) + ","
			__rmi = __rmi + 1

		// -------- Phase 1c: <page auth / roles> (UI-B014..B016) --------
		// The checks are emitted into the page's route render function and
		// read the session through frame.server's auth bridges, so a page that
		// declares them needs frame.server — without it nothing would enforce
		// the declaration.
		integer __pai = 0
		while __pai < source_files.length()
			string __paf = source_files[__pai]
			string __pap = extract_json_field(__paf, "path")
			if __pap.endsWith(".html") and __pap.indexOf("pages/") != -1
				string __pa_err = page_access_error(decode_json_string(extract_json_field_escaped(__paf, "content")), has_server)
				if __pa_err != ""
					plugin_error(ctx, "FRAME-UI-E006", __pap + ": " + __pa_err)
					_ctx_clear_error(ctx)
					return 0
			__pai = __pai + 1

		// -------- Phase 2: walk pages, accumulate per-kind pieces --------
		// route_registrations: source string of `_http_route(...)` statements,
		//   with one leading tab per line (start:-block body indent).
		// route_fn_defs: `\tstring name()\n\t\t<body>\n\n` fragments, one per
		//   page render function, composed inline as each page is seen (a
		//   pair of parallel list<string> re-read later trapped at runtime,
		//   fingerprint d9f480ae).
		string route_registrations = ""
		string route_fn_defs = ""
		string hydration_entries = ""
		integer page_candidates = 0
		integer pages_with_markers = 0
		integer pages_emitted = 0
		integer html_candidates = 0
		integer html_with_screen = 0
		integer fi = 0
		while fi < source_files.length()
			string file_obj = source_files[fi]
			boolean candidate = file_obj.indexOf("pages/") != -1 or file_obj.indexOf(".html") != -1
			if candidate
				string file_path = extract_json_field(file_obj, "path")
				boolean in_pages = file_path.indexOf("pages/") != -1
				boolean is_html = file_path.endsWith(".html")
				if in_pages
					page_candidates = page_candidates + 1
				if is_html
					html_candidates = html_candidates + 1
				boolean raw_has_load = false
				boolean raw_has_guard = false
				boolean raw_has_screen = false
				if in_pages
					raw_has_load = file_obj.indexOf("any load(") != -1
					raw_has_guard = file_obj.indexOf("any guard(") != -1
				if is_html
					raw_has_screen = file_obj.indexOf("<screen") != -1
				if in_pages and (raw_has_load or raw_has_guard)
					pages_with_markers = pages_with_markers + 1
				if is_html and raw_has_screen
					html_with_screen = html_with_screen + 1
				if (in_pages or is_html) and (raw_has_load or raw_has_guard or raw_has_screen)
					// Escape-aware extraction: the page source may contain
					// `\"` (quoted strings inside load/guard bodies). The plain
					// extract_json_field truncates at the first `"` regardless
					// of escaping, which would strip everything after the
					// first embedded quote and produce a malformed transform.
					string file_content = extract_json_field_escaped(file_obj, "content")
					boolean has_load = raw_has_load
					boolean has_guard = raw_has_guard
					if is_html and raw_has_screen
						hydration_entries = hydration_entries + collect_screens_from_html(decode_json_string(file_content))
					if in_pages and (has_load or has_guard)
						string module_name = derive_module_name(file_path)
						// Rename the page's `any load(...)` / `any guard(...)` to
						// per-page names via _transform_source_file (assemble.md
						// §6.1a, compiler 0.33.44+). Without this rename, every
						// companion page declares an unqualified `load` / `guard`,
						// which either produces a duplicate-symbol error or (worse,
						// as observed in fingerprint 1da1454) silently binds every
						// injected render() to whichever declaration won symbol
						// resolution — so all routes served the same context.
						// The parameter type is broadened to `any` so the render
						// body can pass `null` without a Request instance.
						//
						// extract_json_field returns the raw quoted substring
						// without decoding JSON escapes, so `\n` / `\t` arrive as
						// two-char literals. _transform_source_file expects raw
						// source (real newlines/tabs), so we decode first — else
						// the lexer trips on the stray backslashes.
						string transformed_content = decode_json_string(file_content)
						if has_load
							transformed_content = transformed_content.replace("any load(Request ", "any " + module_name + "_load(any ")
							transformed_content = transformed_content.replace("any load(", "any " + module_name + "_load(")
						if has_guard
							transformed_content = transformed_content.replace("any guard(Request ", "any " + module_name + "_guard(any ")
							transformed_content = transformed_content.replace("any guard(", "any " + module_name + "_guard(")
						_transform_source_file(ctx, file_path, transformed_content)
						if has_server
							string url = derive_url_path(file_path)
							// An explicit `GET "<url>"` endpoint owns the URL —
							// registering the page too would replace the
							// endpoint's handler in the server router.
							if explicit_gets.indexOf("|" + normalize_route(url) + "|") == -1
								string page_html_path = derive_html_path(file_path)
								string page_html = page_source(source_files, page_html_path)
								route_fn_defs = route_fn_defs + page_render_fn(module_name, url, page_html_path, has_load, has_guard, __routes_guard_table, page_html)
								route_registrations = route_registrations + "\t_http_route(\"GET\", \"" + url + "\", \"" + module_name + "_render\")\n"
								pages_emitted = pages_emitted + 1
			fi = fi + 1

		// -------- Phase 2b: plain .html pages (file-based routing) --------
		// frame-ui-semantics UI-R001..R003 / frame-server.ebnf §10: every page
		// file under the pages folder is routable — no companion, no routes:
		// declaration needed. Pages with a companion load/guard were routed
		// above; layouts and components are never pages.
		integer hi = 0
		while hi < source_files.length()
			string h_obj = source_files[hi]
			string h_path = extract_json_field(h_obj, "path")
			if has_server and h_path.endsWith(".html") and h_path.indexOf("pages/") != -1
				string h_module = derive_module_name(h_path)
				// Skip pages already routed — by a companion (Phase 2) or as a
				// repeated entry for the same file (the HTML entry page).
				if routed_modules.indexOf("," + h_module + ",") == -1 and route_registrations.indexOf("\"" + h_module + "_render\"") == -1
					string h_url = derive_url_path(h_path)
					if explicit_gets.indexOf("|" + normalize_route(h_url) + "|") == -1
						route_fn_defs = route_fn_defs + page_render_fn(h_module, h_url, derive_html_path(h_path), false, false, __routes_guard_table, decode_json_string(extract_json_field_escaped(h_obj, "content")))
						route_registrations = route_registrations + "\t_http_route(\"GET\", \"" + h_url + "\", \"" + h_module + "_render\")\n"
						pages_emitted = pages_emitted + 1
			hi = hi + 1

		// -------- Phase 3: compose one Clean source string --------
		// start: block (route registrations). Emitted only when we have
		// server routes to register, else the start: block would be empty
		// (parse error).
		string module_src = ""
		boolean has_routes = has_server and route_registrations.length() > 0
		if has_routes
			module_src = module_src + "start:\n"
			module_src = module_src + route_registrations
			module_src = module_src + "\n"

		// functions: block — the diagnostic function is always present, so the
		// block is never empty.
		module_src = module_src + "functions:\n"
		module_src = module_src + route_fn_defs

		// Hydration manifest function.
		if hydration_entries.length() > 0
			string screens_json = entries_to_screens_json(hydration_entries)
			module_src = module_src + "\tstring _ui_hydration_manifest()\n"
			module_src = module_src + "\t\treturn \"{\\\"screens\\\":" + screens_json.replace("\"", "\\\"") + "}\"\n"
			module_src = module_src + "\n"

		// Diagnostic function.
		string has_server_str = "false"
		if has_server
			has_server_str = "true"
		string counts = "files=" + source_files.length().toString() + " has_server=" + has_server_str
		counts = counts + " page_candidates=" + page_candidates.toString() + " pages_with_markers=" + pages_with_markers.toString()
		counts = counts + " pages_emitted=" + pages_emitted.toString() + " html_candidates=" + html_candidates.toString()
		counts = counts + " html_with_screen=" + html_with_screen.toString()
		module_src = module_src + "\tstring _frame_ui_assemble_diagnostics()\n"
		module_src = module_src + "\t\treturn \"frame.ui assemble: " + counts + "\"\n"

		// -------- Phase 8: inject as one synthetic source file --------
		// assemble.md §6.1 — only bridge legal inside assemble_typed.
		// The `__plugin_<plugin_name>__/` naming convention is per §9
		// recommendation. Injecting only when there is content avoids
		// PLUGIN014 on empty-content injection.
		//
		// Force a fresh allocation for the injected content. Same pattern as
		// v3.2.6 (`return __html + ""`) — routes the string through the
		// string_concat codegen so we ship a fresh buffer whose contents can't
		// be aliased by an earlier `file_content = extract_json_field(...)`
		// read of a source file (e.g. the project's main.cln manifest).
		// Guards fingerprint 6c6f3d61 (SYN001 Indent(1) — companion_routes.cln
		// content byte-for-byte matched the manifest text).
		string injected_src = module_src + ""
		// Plugin-side self-check: if the injected content ever starts with
		// `package:` we know we hit the aliasing regression again — surface a
		// clear diagnostic instead of shipping a manifest-shaped module.
		string first_line = injected_src
		integer __nl = injected_src.indexOf("\n")
		if __nl != -1
			first_line = injected_src.substring(0, __nl)
		if first_line.trim().startsWith("package:")
			plugin_error(ctx, "PLUGIN_UI_ASSEMBLE_ALIASED", "assemble_typed injected content starts with `package:` — string aliasing regression, not manifest text")
			_ctx_clear_error(ctx)
			return 0
		if injected_src.length() > 0
			_inject_source_file(ctx, "__plugin_frame_ui__/companion_routes.cln", injected_src)

		_ctx_clear_error(ctx)
		return 0

// ============================================================================
// VALIDATION / KEYWORD SURFACE
// ============================================================================

functions:
	// Block-level validation (returns an error message or ""), following
	// frame-ui.ebnf component_block / page_block.
	string validate_block(string block_name, string attributes, string body)
		string class_name = extract_json_field(attributes, "name")
		if class_name == ""
			class_name = extract_json_field(attributes, "model_name")
		if block_name == "component"
			if class_name == "" and extract_json_field(attributes, "tag") == ""
				return "component: a class name (`component Name:`) or tag=\"...\" is required"
			string client = extract_json_field(attributes, "client")
			string modes = ",off,on,visible,idle,only,"
			if client != "" and modes.indexOf("," + client + ",") == -1
				return "component: client must be one of off, on, visible, idle, only"
			if body.indexOf("html:") == -1 and body.indexOf("render") == -1
				return "component: an html: template or render: section is required"
			return ""
		if block_name == "page"
			if class_name == "" and extract_json_field(attributes, "path") == ""
				return "page: a class name (`page Name:`) is required"
			return ""
		return ""

	// IDE keyword support.
	string get_keywords()
		return "[\"component\", \"inputs\", \"state\", \"render\", \"tag\", \"client\", \"if\", \"else\", \"each\", \"bind\", \"slot\", \"html\", \"styles\", \"variables\", \"global\"]"

// ============================================================================
// JSON / HTML ATTRIBUTE UTILITIES
// ============================================================================

functions:
	// Extract a JSON string field, scanning past escaped quotes and escaped
	// backslashes so we get the FULL value even when the string contains `\"`
	// or `\\`. Used when the content field will feed a bridge that expects the
	// complete raw source (e.g. _transform_source_file). The result is still
	// escape-encoded (2-char `\n` / `\t` / `\"`); pair with decode_json_string
	// to recover raw source. The plain extract_json_field below stops at the
	// first `"` even when it is escaped; use it only for short values (paths,
	// flags, names).
	string extract_json_field_escaped(string json, string field_name)
		string search = "\"" + field_name + "\":"
		integer field_pos = json.indexOf(search)
		if field_pos == -1
			return ""
		integer value_start = field_pos + search.length()
		while value_start < json.length() and json.substring(value_start, value_start + 1) == " "
			value_start = value_start + 1
		if value_start >= json.length()
			return ""
		if json.substring(value_start, value_start + 1) != "\""
			return ""
		integer content_start = value_start + 1
		integer scan = content_start
		integer json_len = json.length()
		while scan < json_len
			string ch = json.substring(scan, scan + 1)
			if ch == "\\" and scan + 1 < json_len
				scan = scan + 2
			else
				if ch == "\""
					return json.substring(content_start, scan)
				else
					scan = scan + 1
		return ""

	// Value of a JSON field: the raw text of a quoted string value, or the
	// text of a numeric/boolean scalar.
	string extract_json_field(string json, string field_name)
		string search = "\"" + field_name + "\":"
		integer field_pos = json.indexOf(search)
		if field_pos == -1
			return ""
		integer value_start = field_pos + search.length()
		// Skip whitespace
		while value_start < json.length() and json.substring(value_start, value_start + 1) == " "
			value_start = value_start + 1
		if value_start >= json.length()
			return ""
		string first = json.substring(value_start, value_start + 1)
		if first == "\""
			// Quoted string value
			integer content_start = value_start + 1
			integer quote_end = json.indexOf("\"", content_start)
			if quote_end == -1
				return ""
			return json.substring(content_start, quote_end)
		// Non-string value: read until comma / close-brace / whitespace
		integer scan = value_start
		while scan < json.length()
			string ch = json.substring(scan, scan + 1)
			if ch == "," or ch == "}" or ch == " " or ch == "\n"
				return json.substring(value_start, scan)
			scan = scan + 1
		return json.substring(value_start, json.length())

	// Extract the tag name from a tag body (i.e. text between < and >, minus
	// the opening slash and attributes).
	string extract_tag_name(string tag_content)
		string name = tag_content
		// Strip leading slash for closing tags
		if name.length() > 0 and name.substring(0, 1) == "/"
			name = name.substring(1, name.length())
		// Split at first whitespace or trailing self-close
		integer space_pos = name.indexOf(" ")
		integer slash_pos = name.indexOf("/")
		integer cut = name.length()
		if space_pos != -1 and space_pos < cut
			cut = space_pos
		if slash_pos != -1 and slash_pos < cut
			cut = slash_pos
		return name.substring(0, cut)

	// Value of the attribute named attr_name in an opening tag ("<div a='1'>"
	// or the tag text without the angle brackets); "" when the tag has no
	// such attribute or it has no value. Attribute names match whole:
	// `name` never matches inside `data-name`, and text inside another
	// attribute's quoted value is never read as an attribute.
	string extract_attr_value(string tag_text, string attr_name)
		string found = attr_lookup(tag_text, attr_name)
		if found == ""
			return ""
		return found.substring(1, found.length())

	// True when the opening tag carries the attribute attr_name, with or
	// without a value (`<p cl-else>`).
	boolean has_attr(string tag_text, string attr_name)
		return attr_lookup(tag_text, attr_name) != ""

	boolean is_tag_space(string ch)
		return ch == " " or ch == "\t" or ch == "\n" or ch == "\r"

	// Scan the attribute list of an opening tag for attr_name. Returns ""
	// when absent, else "+" followed by the attribute's value ("+" alone for
	// an attribute without a value). Values may be "double-quoted",
	// 'single-quoted', {braced} (the expression, trimmed) or unquoted.
	string attr_lookup(string tag_text, string attr_name)
		integer n = tag_text.length()
		integer i = 0
		if tag_text.startsWith("<")
			i = 1
		// Skip the tag name.
		while i < n and is_tag_space(tag_text.substring(i, i + 1)) == false and tag_text.substring(i, i + 1) != ">" and tag_text.substring(i, i + 1) != "/"
			i = i + 1
		while i < n
			string ch = tag_text.substring(i, i + 1)
			if is_tag_space(ch) or ch == "/"
				i = i + 1
			else if ch == ">"
				return ""
			else if ch == "{"
				// interpolation_attribute `{name}`: the attribute `name`.
				integer close = matching_brace(tag_text, i)
				if close == -1
					return ""
				string bare = tag_text.substring(i + 1, close).trim()
				if bare == attr_name
					return "+" + bare
				i = close + 1
			else
				integer name_start = i
				boolean in_name = true
				while in_name and i < n
					string nc = tag_text.substring(i, i + 1)
					if is_tag_space(nc) or nc == "=" or nc == ">" or nc == "/"
						in_name = false
					else
						i = i + 1
				string name = tag_text.substring(name_start, i)
				integer j = i
				while j < n and is_tag_space(tag_text.substring(j, j + 1))
					j = j + 1
				if j < n and tag_text.substring(j, j + 1) == "="
					j = j + 1
					while j < n and is_tag_space(tag_text.substring(j, j + 1))
						j = j + 1
					string value = ""
					if j < n
						string q = tag_text.substring(j, j + 1)
						if q == "\"" or q == "'"
							integer qe = tag_text.indexOf(q, j + 1)
							if qe == -1
								value = tag_text.substring(j + 1, n)
								j = n
							else
								value = tag_text.substring(j + 1, qe)
								j = qe + 1
						else if q == "{"
							// `cl-if={expression}` (frame-ui.ebnf): the expression.
							integer be = matching_brace(tag_text, j)
							if be == -1
								value = tag_text.substring(j + 1, n).trim()
								j = n
							else
								value = tag_text.substring(j + 1, be).trim()
								j = be + 1
						else
							integer vs = j
							boolean in_value = true
							while in_value and j < n
								string vc = tag_text.substring(j, j + 1)
								if is_tag_space(vc) or vc == ">"
									in_value = false
								else if vc == "/" and j + 1 < n and tag_text.substring(j + 1, j + 2) == ">"
									in_value = false
								else
									j = j + 1
							value = tag_text.substring(vs, j)
					if name == attr_name
						return "+" + value
					i = j
				else
					if name == attr_name
						return "+"
					i = j
		return ""

	// Extract an attribute value from a <page> tag inside an HTML document.
	string extract_page_attr(string html, string attr_name)
		integer page_start = html.indexOf("<page")
		if page_start == -1
			return ""
		integer page_end = html.indexOf(">", page_start)
		if page_end == -1
			return ""
		string page_tag = html.substring(page_start, page_end + 1)
		return extract_attr_value(page_tag, attr_name)

// ============================================================================
// EMISSION HELPERS
// ============================================================================

functions:
	// Emit a plugin-scoped error (severity 2). Callers return its value.
	integer plugin_error(integer ctx, string code, string message)
		_emit_error(ctx, 2, code, message, "{\"start\":0,\"end\":0,\"source\":\"plugin\"}")
		return 1

	// Emit a class from a §3.13 class-spec JSON (LP-string path: the spec is
	// passed as a string literal handle to _emit_class_full).
	integer ui_component_class(integer ctx, string spec_json)
		integer spec_ptr = _batch_stringLit(ctx, spec_json)
		return _emit_class_full(ctx, spec_ptr, 1)

	// Emit a top-level function whose body is Clean source. params_json uses
	// the typed-emission shape [{"name":"<name>","type_handle":<int>}, ...]
	// and return_type is a type handle (_type_string / _type_boolean / ...).
	// flags: bit 1 = exported.
	integer ui_helper_function(integer ctx, string name, string params_json, integer return_type, string body_source, integer flags)
		integer body_h = _emit_stmt_from_source(ctx, body_source, 0)
		return _emit_function(ctx, name, params_json, return_type, body_h, flags)

// ============================================================================
// CLASS-SPEC JSON BUILDERS (§3.13 class spec consumed by _emit_class_full)
// ============================================================================

functions:
	// JSON-escape a string for embedding in a spec_* JSON literal.
	string spec_esc_json(string txt)
		string result = txt
		result = result.replace("\\", "\\\\")
		result = result.replace("\"", "\\\"")
		result = result.replace("\n", "\\n")
		result = result.replace("\t", "\\t")
		return result

	// Build a class-spec field entry: {"name":"...","type":"..."}
	string spec_field(string name, string type_name)
		return "{\"name\":\"" + spec_esc_json(name) + "\",\"type\":\"" + spec_esc_json(type_name) + "\"}"

	// The class-spec entry for a state: or inputs: field. Inputs are public:
	// the page that uses the component sets them (`_comp.count = {expr}`),
	// and class fields are private by default (semantic-rules.md
	// §Visibility). `default_src` is the field's initial value as Clean
	// expression text, or "" (typed-emission.md §3.13, Amendment 14).
	string spec_component_field(string name, string type_name, string default_src, string line, string input_lines)
		string visibility = ""
		string wanted = line.trim()
		string remaining = input_lines
		while remaining.length() > 0
			integer nl = remaining.indexOf("\n")
			string input_line = remaining
			if nl == -1
				remaining = ""
			else
				input_line = remaining.substring(0, nl)
				remaining = remaining.substring(nl + 1, remaining.length())
			if input_line.trim() == wanted
				visibility = ",\"visibility\":\"public\""
		string result = "{\"name\":\"" + spec_esc_json(name) + "\",\"type\":\"" + spec_esc_json(type_name) + "\"" + visibility
		if default_src.length() > 0
			result = result + ",\"default\":\"" + spec_esc_json(default_src) + "\""
		return result + "}"

	// The class-spec entry for one state: / inputs: line, or "" for a line
	// that declares nothing. Forms (frame-ui.ebnf §1.1, §1.2):
	//   type name [= expression]      typed state field
	//   name: type [= expression]     input (or typed state) field
	//   name: expression              state shorthand, type from the value
	string component_field_entry(string line, string input_lines)
		string t = line.trim()
		if t.length() == 0
			return ""
		integer colon = t.indexOf(":")
		integer eq = t.indexOf("=")
		integer sp = t.indexOf(" ")
		if colon > 0 and (eq == -1 or colon < eq)
			string name = t.substring(0, colon).trim()
			string rest = t.substring(colon + 1, t.length()).trim()
			string type_part = rest
			string default_src = ""
			integer rest_eq = rest.indexOf("=")
			if rest_eq != -1
				type_part = rest.substring(0, rest_eq).trim()
				default_src = rest.substring(rest_eq + 1, rest.length()).trim()
			if is_type_text(type_part)
				return spec_component_field(name, type_part, default_src, line, input_lines)
			return spec_component_field(name, literal_type(rest), rest, line, input_lines)
		if sp > 0
			string type_name = t.substring(0, sp)
			string after = t.substring(sp + 1, t.length()).trim()
			string name = after
			string default_src = ""
			integer after_eq = after.indexOf("=")
			if after_eq != -1
				name = after.substring(0, after_eq).trim()
				default_src = after.substring(after_eq + 1, after.length()).trim()
			return spec_component_field(name, type_name, default_src, line, input_lines)
		return ""

	// True when `t` names a type: a built-in type, a generic container
	// (`list<...>`, `pairs<...>`, `matrix<...>`), an optional `T?`, or a
	// class name (capitalized identifier).
	boolean is_type_text(string t)
		string base = t.trim()
		if base.endsWith("?")
			base = base.substring(0, base.length() - 1)
		if base == "integer" or base == "number" or base == "string" or base == "boolean" or base == "any"
			return true
		if base.startsWith("list<") or base.startsWith("pairs<") or base.startsWith("matrix<")
			return base.endsWith(">")
		if base.length() == 0 or not ui_lint_is_bare_identifier(base)
			return false
		string head = base.substring(0, 1)
		return head != head.toLowerCase()

	// The type of a state shorthand value (`label: "hits"`, `total: 40`):
	// string, boolean, number or integer for a literal, else any.
	string literal_type(string value)
		string v = value.trim()
		if v.startsWith("\"")
			return "string"
		if v == "true" or v == "false"
			return "boolean"
		string digits = v
		if digits.startsWith("-")
			digits = digits.substring(1, digits.length())
		if digits.length() == 0
			return "any"
		boolean seen_dot = false
		integer i = 0
		while i < digits.length()
			string ch = digits.substring(i, i + 1)
			if ch == "."
				if seen_dot
					return "any"
				seen_dot = true
			else if "0123456789".indexOf(ch) == -1
				return "any"
			i = i + 1
		if seen_dot
			return "number"
		return "integer"

	// Build a class-spec method entry (inline body_handle shape, Amendment 3
	// §3.13). params_json is an already-formatted JSON array like `[]` or
	// `[{"name":"content","type":"string"}]`.
	string spec_method_inline_bh(string name, string params_json, string return_type, integer body_handle)
		string result = "{\"kind\":\"inline\""
		result = result + ",\"name\":\"" + spec_esc_json(name) + "\""
		result = result + ",\"params\":" + params_json
		result = result + ",\"return_type\":\"" + spec_esc_json(return_type) + "\""
		result = result + ",\"body_handle\":" + body_handle.toString()
		result = result + "}"
		return result

	// Number of leading tabs on a line.
	integer leading_tabs(string line)
		integer n = 0
		boolean counting = true
		while counting and n < line.length()
			if line.substring(n, n + 1) == "\t"
				n = n + 1
			else
				counting = false
		return n

	// Return the lines nested under the `<section_name>:` header in a
	// component body (events: or functions:), or "" when the section is
	// absent. Lines keep their original indentation.
	string component_section_lines(string text, string section_name)
		string result = ""
		boolean in_section = false
		integer section_indent = 0
		string remaining = text
		while remaining.length() > 0
			integer nl = remaining.indexOf("\n")
			string line = ""
			if nl == -1
				line = remaining
				remaining = ""
			else
				line = remaining.substring(0, nl)
				remaining = remaining.substring(nl + 1, remaining.length())
			string trimmed = line.trim()
			if in_section
				if trimmed.length() > 0 and leading_tabs(line) <= section_indent
					in_section = false
				else
					result = result + line + "\n"
			if not in_section
				if trimmed == section_name + ":"
					in_section = true
					section_indent = leading_tabs(line)
		return result

	// Parse a parameter list ("a, b: integer" or "integer a, string b")
	// into the class-spec params JSON array.
	string component_params_json(string params_src)
		string result = "["
		boolean first = true
		string remaining = params_src.trim()
		while remaining.length() > 0
			integer comma = remaining.indexOf(",")
			string param = ""
			if comma == -1
				param = remaining.trim()
				remaining = ""
			else
				param = remaining.substring(0, comma).trim()
				remaining = remaining.substring(comma + 1, remaining.length())
			if param.length() > 0
				string p_name = param
				string p_type = "any"
				integer colon = param.indexOf(":")
				if colon != -1
					p_name = param.substring(0, colon).trim()
					p_type = param.substring(colon + 1, param.length()).trim()
				else
					integer sp = param.indexOf(" ")
					if sp != -1
						p_type = param.substring(0, sp).trim()
						p_name = param.substring(sp + 1, param.length()).trim()
				if not first
					result = result + ","
				result = result + spec_field(p_name, p_type)
				first = false
		return result + "]"

	// Turn one collected method (header line + dedented body) into a
	// class-spec method entry. Header forms: `name(params):` (events:) and
	// `ret name(params)` (functions:). Returns "" for malformed headers.
	string component_method_entry(integer ctx, string header, string body)
		string h = header.trim()
		if h.endsWith(":")
			h = h.substring(0, h.length() - 1).trim()
		integer open = h.indexOf("(")
		integer close = h.indexOf(")")
		if open <= 0 or close < open
			return ""
		string head = h.substring(0, open).trim()
		string params_src = h.substring(open + 1, close)
		string ret = "void"
		string m_name = head
		integer sp = head.indexOf(" ")
		if sp != -1
			ret = head.substring(0, sp).trim()
			m_name = head.substring(sp + 1, head.length()).trim()
		string body_src = body
		if body_src.trim().length() == 0
			body_src = "return\n"
		integer bh = _emit_stmt_from_source(ctx, body_src, 0)
		return spec_method_inline_bh(m_name, component_params_json(params_src), ret, bh)

	// Collect the methods declared in a component's events: or functions:
	// section as comma-separated class-spec method entries.
	string component_section_methods(integer ctx, string text, string section_name)
		string lines = component_section_lines(text, section_name)
		string entries = ""
		integer header_indent = -1
		string header = ""
		string body = ""
		string remaining = lines
		while remaining.length() > 0
			integer nl = remaining.indexOf("\n")
			string line = ""
			if nl == -1
				line = remaining
				remaining = ""
			else
				line = remaining.substring(0, nl)
				remaining = remaining.substring(nl + 1, remaining.length())
			string trimmed = line.trim()
			if trimmed.length() > 0
				integer ind = leading_tabs(line)
				boolean is_visibility = trimmed == "public:" or trimmed == "private:"
				if is_visibility or header_indent == -1 or ind <= header_indent
					if header != ""
						string entry = component_method_entry(ctx, header, body)
						if entry != ""
							if entries != ""
								entries = entries + ","
							entries = entries + entry
					header = ""
					body = ""
					if is_visibility
						header_indent = -1
					else
						header_indent = ind
						header = trimmed
				else
					body = body + line.substring(header_indent + 1, line.length()) + "\n"
		if header != ""
			string last_entry = component_method_entry(ctx, header, body)
			if last_entry != ""
				if entries != ""
					entries = entries + ","
				entries = entries + last_entry
		return entries

	// Build a state:-block field entry: {"name":"...","type_handle":N,"default_expr_handle":N}
	// per §3.4 fields_json_lp schema.
	string spec_state_field(string name, integer type_handle, integer default_expr_handle)
		string result = "{\"name\":\"" + spec_esc_json(name) + "\""
		result = result + ",\"type_handle\":" + type_handle.toString()
		if default_expr_handle != 0
			result = result + ",\"default_expr_handle\":" + default_expr_handle.toString()
		result = result + "}"
		return result

// ============================================================================
// COMPONENT / PAGE / HTML BLOCK EMITTERS
// ============================================================================

functions:
	// component: block → a §3.13 class (fields from state: and inputs:,
	// render() from the html: template, setSlot(), renderSSR(), setInput(),
	// events: / functions: methods) emitted via _emit_class_full, plus the
	// request-time render export. A hydrated component (tag set, client !=
	// off) also gets a module-scope state: instance.
	integer expand_component_typed(integer ctx, string attrs_json, string body)
		string tag = get_attr(attrs_json, "tag", "")
		string name = get_attr(attrs_json, "name", "")
		string client = get_attr(attrs_json, "client", "off")
		// frame-ui.ebnf component_block: `component <ClassName>:` names the class.
		if name == ""
			name = extract_json_field(attrs_json, "model_name")
		if name == "" and tag != ""
			name = tag_to_class_name(tag)
		if name == ""
			name = "Component"

		// build_state: the components registry (client_init) and the
		// components.json manifest.
		if tag != ""
			string components_state = _build_state_get("frame.ui:components")
			string entry = tag + "," + name + "," + client
			if components_state == ""
				_build_state_set("frame.ui:components", entry)
			else
				_build_state_set("frame.ui:components", components_state + ";" + entry)
			string render_export = component_render_export(tag)
			string component_obj = "{\"tag\":\"" + tag + "\",\"class\":\"" + name + "\",\"hydration\":\"" + client + "\",\"render_export\":\"" + render_export + "\"}"
			string manifest_state = _build_state_get("frame.ui.components.json")
			if manifest_state == ""
				_build_state_set("frame.ui.components.json", "[" + component_obj + "]")
			else
				string without_close = manifest_state.substring(0, manifest_state.length() - 1)
				_build_state_set("frame.ui.components.json", without_close + "," + component_obj + "]")

		// Parse the component body (before html, html content, after html, fallback).
		string parsed = parse_component_body(body)
		// Decode each section: extract_json_field returns raw escaped text and
		// stops at the first escaped quote, which truncated html at `class="`
		// and hid the state: and events: sections.
		string before_html = decode_json_string(extract_json_field_escaped(parsed, "before"))
		string html_content = decode_json_string(extract_json_field_escaped(parsed, "html"))
		string after_html = decode_json_string(extract_json_field_escaped(parsed, "after"))
		string fallback_html = decode_json_string(extract_json_field_escaped(parsed, "fallback"))
		// Sections that become methods (events:, functions:).
		string section_text = remove_state_dot(before_html + "\n" + after_html)
		// state: and inputs: entries both become class fields, so the render
		// body and handlers can reference them by bare name.
		string input_lines = component_section_lines(before_html, "inputs")
		string state_fields = component_section_lines(before_html, "state") + input_lines

		// -------- Build the class-spec `fields` array --------
		string fields_json = "["
		boolean first_field = true
		// _tag (only when tag != "")
		if tag != ""
			fields_json = fields_json + spec_field("_tag", "string")
			first_field = false
		// _hydration_mode, _slot_content
		if not first_field
			fields_json = fields_json + ","
		fields_json = fields_json + spec_field("_hydration_mode", "string")
		fields_json = fields_json + "," + spec_field("_slot_content", "string")
		first_field = false
		// _fallback (only when component has a fallback)
		if fallback_html != ""
			fields_json = fields_json + "," + spec_field("_fallback", "string")
		// State and input fields with their defaults (component_field_entry).
		string sf_remaining = state_fields
		while sf_remaining.length() > 0
			integer nl_pos = sf_remaining.indexOf("\n")
			string sf_line = sf_remaining
			if nl_pos == -1
				sf_remaining = ""
			else
				sf_line = sf_remaining.substring(0, nl_pos)
				sf_remaining = sf_remaining.substring(nl_pos + 1, sf_remaining.length())
			string sf_entry = component_field_entry(sf_line, input_lines)
			if sf_entry != ""
				fields_json = fields_json + "," + sf_entry
		fields_json = fields_json + "]"

		// -------- Build render() method body source --------
		string render_body_source = "string __html = \"\"\n"
		if html_content != ""
			if fallback_html != ""
				string escaped_fb = escape_attr_text(fallback_html)
				render_body_source = render_body_source + append_stmt("__html", "\"<div data-component='" + name + "' data-fallback='" + escaped_fb + "'>\"")
			string markup = template_strip_state(strip_block_indent(html_content))
			render_body_source = render_body_source + html_to_stmts(markup, "__html", false, "{}", false)
			if fallback_html != ""
				render_body_source = render_body_source + append_stmt("__html", "\"</div>\"")
		render_body_source = render_body_source + "return __html\n"

		// -------- Build setSlot() body source --------
		string setslot_body_source = "_slot_content = content\n"

		// -------- Build renderSSR() body source --------
		string renderssr_body_source = "return this.render()\n"

		// -------- Parse method bodies into stmt handles --------
		if template_error_code(render_body_source) != ""
			return template_error(ctx, template_error_code(render_body_source))
		integer render_bh = _emit_stmt_from_source(ctx, render_body_source, 0)
		integer setslot_bh = _emit_stmt_from_source(ctx, setslot_body_source, 0)
		integer renderssr_bh = _emit_stmt_from_source(ctx, renderssr_body_source, 0)
		// setInput(attr, value): a tag attribute written as text, converted
		// to the declared input type (UI-C010).
		integer setinput_bh = _emit_stmt_from_source(ctx, set_input_body(input_lines), 0)

		// -------- Assemble the methods array --------
		string methods_json = "["
		methods_json = methods_json + spec_method_inline_bh("render", "[]", "string", render_bh)
		methods_json = methods_json + "," + spec_method_inline_bh("setSlot", "[{\"name\":\"content\",\"type\":\"string\"}]", "void", setslot_bh)
		methods_json = methods_json + "," + spec_method_inline_bh("renderSSR", "[]", "string", renderssr_bh)
		methods_json = methods_json + "," + spec_method_inline_bh("setInput", "[{\"name\":\"attr\",\"type\":\"string\"},{\"name\":\"value\",\"type\":\"string\"}]", "void", setinput_bh)
		// User-declared events: handlers and functions: methods.
		string event_methods = component_section_methods(ctx, section_text, "events")
		if event_methods != ""
			methods_json = methods_json + "," + event_methods
		string function_methods = component_section_methods(ctx, section_text, "functions")
		if function_methods != ""
			methods_json = methods_json + "," + function_methods
		// client_init calls onMount() on every hydrated component
		// (lifecycle.md §3.3); declaring it is optional.
		if tag != "" and client != "off" and methods_json.indexOf("\"name\":\"onMount\"") == -1
			integer onmount_bh = _emit_stmt_from_source(ctx, "return\n", 0)
			methods_json = methods_json + "," + spec_method_inline_bh("onMount", "[]", "void", onmount_bh)
		methods_json = methods_json + "]"

		// -------- Assemble the class spec --------
		string class_spec = "{\"name\":\"" + spec_esc_json(name) + "\""
		class_spec = class_spec + ",\"parent\":null"
		class_spec = class_spec + ",\"fields\":" + fields_json
		class_spec = class_spec + ",\"methods\":" + methods_json
		class_spec = class_spec + "}"

		// -------- Emit module-scope state: block BEFORE the class (per plan §4) --------
		// Only when the component participates in hydration (tag set and client != off).
		if tag != "" and client != "off"
			string instance_var = "instance_" + tag.replace("-", "_")
			integer type_h = _type_class_ref(ctx, name)
			integer default_h = _expr_call(ctx, name, "[]")
			string sf_json = "[" + spec_state_field(instance_var, type_h, default_h) + "]"
			_emit_state_block(ctx, sf_json)

		// -------- Emit the class via _emit_class_full --------
		ui_component_class(ctx, class_spec)

		// -------- Request-time render export (component_tag_render) --------
		// clean-server renders a custom tag in a request-time `.html` page by
		// calling `<tag without hyphens>_render(attrs_json)` with the tag's
		// attributes (bridge-host-classes.md §4.1).
		if tag != ""
			integer rx_p_attrs = _type_string(ctx)
			integer rx_r_str = _type_string(ctx)
			string rx_params = "[{\"name\":\"attrs\",\"type_handle\":" + rx_p_attrs.toString() + "}]"
			ui_helper_function(ctx, component_render_export(tag), rx_params, rx_r_str, render_export_body(name, input_lines), 3)
		return 0

	// Export name the host looks up for a custom tag: the tag with its
	// hyphens removed, plus `_render` (`my-card` → `mycard_render`).
	string component_render_export(string tag)
		return tag.replace("-", "") + "_render"

	// (name, type) of each `inputs:` line, as "name type" lines. Accepts both
	// `type name [= default]` and `name: type [= default]`.
	string input_name_types(string input_lines)
		string result = ""
		string remaining = input_lines
		while remaining.length() > 0
			integer nl = remaining.indexOf("\n")
			string line = remaining
			if nl == -1
				remaining = ""
			else
				line = remaining.substring(0, nl)
				remaining = remaining.substring(nl + 1, remaining.length())
			string t = line.trim()
			integer eq = t.indexOf("=")
			if eq != -1
				t = t.substring(0, eq).trim()
			integer colon = t.indexOf(":")
			integer sp = t.indexOf(" ")
			if colon > 0
				result = result + t.substring(0, colon).trim() + " " + t.substring(colon + 1, t.length()).trim() + "\n"
			else if sp > 0
				result = result + t.substring(sp + 1, t.length()).trim() + " " + t.substring(0, sp) + "\n"
		return result

	// Body of setInput(attr, value): assigns the input named by the attribute
	// (camelCase name or its kebab-case form), converting the text to the
	// declared type. Attributes that are not scalar inputs are ignored.
	string set_input_body(string input_lines)
		string body = ""
		string remaining = input_name_types(input_lines)
		while remaining.length() > 0
			integer nl = remaining.indexOf("\n")
			string entry = remaining.substring(0, nl)
			remaining = remaining.substring(nl + 1, remaining.length())
			integer sp = entry.indexOf(" ")
			string input_name = entry.substring(0, sp)
			string input_type = entry.substring(sp + 1, entry.length())
			string converted = ""
			if input_type == "string"
				converted = "value"
			else if input_type == "integer"
				converted = "value.toInteger()"
			else if input_type == "number"
				converted = "value.toNumber()"
			else if input_type == "boolean"
				converted = "value.toBoolean()"
			if converted != ""
				string cond = "attr == \"" + input_name + "\""
				string kebab = camel_to_kebab(input_name)
				if kebab != input_name
					cond = cond + " or attr == \"" + kebab + "\""
				string keyword = "if "
				if body != ""
					keyword = "else if "
				body = body + keyword + cond + "\n\t" + input_name + " = " + converted + "\n"
		if body == ""
			return "return\n"
		return body

	// Body of the request-time render export: builds the component, applies
	// each attribute present in `attrs` (a JSON object of attribute name →
	// text) through setInput, and adds a `class` attribute to the outer
	// element (UI-C009).
	string render_export_body(string class_name, string input_lines)
		string body = class_name + " __comp = " + class_name + "()\n"
		string remaining = input_name_types(input_lines)
		while remaining.length() > 0
			integer nl = remaining.indexOf("\n")
			string entry = remaining.substring(0, nl)
			remaining = remaining.substring(nl + 1, remaining.length())
			string input_name = entry.substring(0, entry.indexOf(" "))
			string kebab = camel_to_kebab(input_name)
			body = body + "if _ui_attr_has(attrs, \"" + input_name + "\")\n\t__comp.setInput(\"" + input_name + "\", _ui_attr_get(attrs, \"" + input_name + "\"))\n"
			if kebab != input_name
				body = body + "if _ui_attr_has(attrs, \"" + kebab + "\")\n\t__comp.setInput(\"" + kebab + "\", _ui_attr_get(attrs, \"" + kebab + "\"))\n"
		body = body + "return _ui_add_root_class(__comp.render(), _ui_attr_get(attrs, \"class\"))\n"
		return body

	// `userName` → `user-name`.
	string camel_to_kebab(string input)
		string result = ""
		integer i = 0
		while i < input.length()
			string ch = input.substring(i, i + 1)
			string lower = ch.toLowerCase()
			if ch != lower and i > 0
				result = result + "-" + lower
			else
				result = result + lower
			i = i + 1
		return result

	// component: dispatcher arm.
	integer expand_component_stub(integer ctx, string attrs_json, string body)
		_ctx_set_error_context(ctx, "PLUGIN_UI_COMPONENT", "expand_component")
		expand_component_typed(ctx, attrs_json, body)
		_ctx_clear_error(ctx)
		return 0

	// The page class: fields _path / _layout / _auth / _roles and a render()
	// that runs render_code (statements appending to `html`), wraps the result
	// in the layout when one is set, and — for an HTML entry page with a
	// companion — calls the companion's guard and load first.
	integer expand_page_typed(integer ctx, string page_name, string path, string layout, string auth, string roles, string render_code, string companion_json)
		// -------- Build the class-spec `fields` array --------
		string fields_json = "[" + spec_field("_path", "string")
		if layout != ""
			fields_json = fields_json + "," + spec_field("_layout", "string")
		if auth != ""
			fields_json = fields_json + "," + spec_field("_auth", "string")
		if roles != ""
			fields_json = fields_json + "," + spec_field("_roles", "string")
		fields_json = fields_json + "]"

		string render_body_source = page_render_body(layout, render_code, companion_json)

		// -------- Parse render body into stmt handle --------
		if template_error_code(render_body_source) != ""
			return template_error(ctx, template_error_code(render_body_source))
		integer render_bh = _emit_stmt_from_source(ctx, render_body_source, 0)

		// -------- Assemble the methods array --------
		string methods_json = "[" + spec_method_inline_bh("render", "[]", "string", render_bh) + "]"

		// -------- Assemble the class spec --------
		string class_spec = "{\"name\":\"" + spec_esc_json(page_name) + "\""
		class_spec = class_spec + ",\"parent\":null"
		class_spec = class_spec + ",\"fields\":" + fields_json
		class_spec = class_spec + ",\"methods\":" + methods_json
		class_spec = class_spec + "}"

		// -------- Emit the class via _emit_class_full --------
		ui_component_class(ctx, class_spec)
		return 0

	// Body of a page class's render(): the companion guard / load calls (HTML
	// entry page with a companion), render_code (statements appending to
	// `html`) and the layout wrapping.
	string page_render_body(string layout, string render_code, string companion_json)
		string b = ""
		if companion_json != ""
			string module_name = extract_json_field(companion_json, "module_name")
			// assemble_typed renames the companion's load() / guard() to
			// <module>_load(any) / <module>_guard(any).
			if companion_json.indexOf("\"has_guard\":true") != -1
				b = b + "any guard_result = " + module_name + "_guard(null)\n"
				b = b + "if guard_result != null\n"
				b = b + "\treturn \"\"\n"
			if companion_json.indexOf("\"has_load\":true") != -1
				b = b + "any data = " + module_name + "_load(null)\n"
		b = b + "string html = \"\"\n"
		b = b + render_code + "\n"
		if layout != ""
			b = b + "string __page_content = html\n"
			b = b + "string __layout_html = _ui_load_layout(\"app/ui/web/layouts/" + layout + ".html\")\n"
			b = b + "if __layout_html != \"\"\n"
			b = b + "\tinteger __slot_i = 0\n"
			b = b + "\twhile __slot_i < 10\n"
			b = b + "\t\tinteger __ns_start = __page_content.indexOf(\"<slot name='\")\n"
			b = b + "\t\tif __ns_start == -1\n"
			b = b + "\t\t\t__slot_i = 10\n"
			b = b + "\t\telse\n"
			b = b + "\t\t\tinteger __name_start = __ns_start + 12\n"
			b = b + "\t\t\tinteger __name_end = __page_content.indexOf(\"'\", __name_start)\n"
			b = b + "\t\t\tif __name_end == -1\n"
			b = b + "\t\t\t\t__slot_i = 10\n"
			b = b + "\t\t\telse\n"
			b = b + "\t\t\t\tstring __slot_name = __page_content.substring(__name_start, __name_end)\n"
			b = b + "\t\t\t\tinteger __open_end = __page_content.indexOf(\">\", __ns_start)\n"
			b = b + "\t\t\t\tinteger __close_start = __page_content.indexOf(\"</slot>\", __ns_start)\n"
			b = b + "\t\t\t\tif __open_end == -1 or __close_start == -1\n"
			b = b + "\t\t\t\t\t__slot_i = 10\n"
			b = b + "\t\t\t\telse\n"
			b = b + "\t\t\t\t\tstring __slot_content = __page_content.substring(__open_end + 1, __close_start)\n"
			b = b + "\t\t\t\t\tstring __layout_placeholder = \"<slot name='\" + __slot_name + \"'></slot>\"\n"
			b = b + "\t\t\t\t\t__layout_html = __layout_html.replace(__layout_placeholder, __slot_content)\n"
			b = b + "\t\t\t\t\tstring __before = __page_content.substring(0, __ns_start)\n"
			b = b + "\t\t\t\t\tstring __after = __page_content.substring(__close_start + 7, __page_content.length())\n"
			b = b + "\t\t\t\t\t__page_content = __before + __after\n"
			b = b + "\t\t\t\t\t__slot_i = __slot_i + 1\n"
			b = b + "\t\t__layout_html = __layout_html.replace(\"<slot></slot>\", __page_content)\n"
			b = b + "\t\thtml = __layout_html\n"
		b = b + "return html\n"
		return b

	// page: dispatcher arm. Attrs carry path/layout/auth/roles; the body is
	// the page HTML.
	integer expand_page_stub(integer ctx, string attrs_json, string body)
		_ctx_set_error_context(ctx, "PLUGIN_UI_PAGE", "expand_page")
		string path = get_attr(attrs_json, "path", "/")
		string layout = get_attr(attrs_json, "layout", "")
		string auth = get_attr(attrs_json, "auth", "")
		string roles = get_attr(attrs_json, "roles", "")
		string render_code = html_to_stmts(body, "html", true, "{}", false)
		if template_error_code(render_code) != ""
			return template_error(ctx, template_error_code(render_code))
		// frame-ui.ebnf page_block: `page <ClassName>:` names the page class;
		// the path-derived name is the fallback for header-less forms.
		string page_name = extract_json_field(attrs_json, "model_name")
		if page_name == ""
			page_name = path_to_class_name(path)
		expand_page_typed(ctx, page_name, path, layout, auth, roles, render_code, "")
		_ctx_clear_error(ctx)
		return 0

	// html: dispatcher arm. expand_html_block returns the statements, which
	// are emitted inline where the block stands.
	integer expand_html_block_stub(integer ctx, string attrs_json, string body)
		_ctx_set_error_context(ctx, "PLUGIN_UI_HTML", "expand_html_block")
		string source = expand_html_block(attrs_json, body)
		if template_error_code(source) != ""
			return template_error(ctx, template_error_code(source))
		integer stmt_h = _emit_stmt_from_source(ctx, source, 0)
		if stmt_h == 0
			return plugin_error(ctx, "FRAME-UI-E001", "expand_html_block_stub: parse failed")
		integer err = _emit_statement_inline(ctx, stmt_h)
		if err != 0
			return plugin_error(ctx, "FRAME-UI-E002", "expand_html_block_stub: inline emit failed")
		_ctx_clear_error(ctx)
		return 0

// ============================================================================
// HTML PARSING UTILITIES
// ============================================================================

functions:
	string extract_body(string html)
		integer body_start = html.indexOf("<body")
		if body_start != -1
			integer body_open_end = html.indexOf(">", body_start)
			integer body_end = html.indexOf("</body>")
			if body_open_end != -1 and body_end != -1
				return html.substring(body_open_end + 1, body_end)
		string result = html
		integer doctype_end = result.indexOf(">")
		if result.indexOf("<!DOCTYPE") == 0 and doctype_end != -1
			result = result.substring(doctype_end + 1, result.length())
		result = remove_tag(result, "html")
		result = remove_tag_with_content(result, "head")
		result = remove_tag(result, "page")
		return result.trim()

	string remove_tag(string html, string tag_name)
		string result = html
		string open_start = "<" + tag_name
		integer open_pos = result.indexOf(open_start)
		if open_pos != -1
			integer open_end = result.indexOf(">", open_pos)
			if open_end != -1
				string before = result.substring(0, open_pos)
				string after = result.substring(open_end + 1, result.length())
				result = before + after
		string close_tag = "</" + tag_name + ">"
		integer close_pos = result.indexOf(close_tag)
		if close_pos != -1
			string before = result.substring(0, close_pos)
			string after = result.substring(close_pos + close_tag.length(), result.length())
			result = before + after
		return result

	string remove_tag_with_content(string html, string tag_name)
		string open_start = "<" + tag_name
		integer startIdx = html.indexOf(open_start)
		if startIdx == -1
			return html
		string close_tag = "</" + tag_name + ">"
		integer end = html.indexOf(close_tag)
		if end == -1
			return html
		string before = html.substring(0, startIdx)
		string after = html.substring(end + close_tag.length(), html.length())
		return before + after

	// The `>` that ends the tag starting at 0: not one inside a quoted value
	// or inside a braced expression (`cl-if={n > 1}`).
	integer find_tag_end(string html)
		integer pos = 1
		boolean in_string = false
		string quote_char = ""
		integer braces = 0
		while pos < html.length()
			string ch = html.substring(pos, pos + 1)
			if in_string
				if ch == quote_char
					in_string = false
			else
				if ch == "\"" or ch == "'"
					in_string = true
					quote_char = ch
				else if ch == "{"
					braces = braces + 1
				else if ch == "}" and braces > 0
					braces = braces - 1
				else if ch == ">" and braces == 0
					return pos
			pos = pos + 1
		return -1

	integer find_matching_close(string html, string tag_name)
		string open_tag = "<" + tag_name
		string close_tag = "</" + tag_name + ">"
		integer depth = 1
		integer pos = html.indexOf(">") + 1
		while pos < html.length() and depth > 0
			integer next_open = html.indexOf(open_tag, pos)
			integer next_close = html.indexOf(close_tag, pos)
			if next_close == -1
				return -1
			if next_open != -1 and next_open < next_close
				string char_after = html.substring(next_open + open_tag.length(), next_open + open_tag.length() + 1)
				if char_after == " " or char_after == ">" or char_after == "/"
					depth = depth + 1
				pos = next_open + 1
			else
				depth = depth - 1
				if depth == 0
					return next_close
				pos = next_close + 1
		return -1

	boolean is_void_element(string tag_name)
		string void_elements = ",area,base,br,col,embed,hr,img,input,link,meta,source,track,wbr,"
		return void_elements.indexOf("," + tag_name + ",") != -1

	boolean is_digit_char(string c)
		if c == "0" or c == "1" or c == "2" or c == "3" or c == "4"
			return true
		if c == "5" or c == "6" or c == "7" or c == "8" or c == "9"
			return true
		return false

	boolean is_numeric_literal(string s)
		string trimmed = s.trim()
		if trimmed.length() == 0
			return false
		string first = trimmed.substring(0, 1)
		if first == "-"
			if trimmed.length() < 2
				return false
			return is_digit_char(trimmed.substring(1, 2))
		return is_digit_char(first)

	string find_compare_op(string expr)
		if expr.indexOf("==") != -1
			return "=="
		if expr.indexOf("!=") != -1
			return "!="
		if expr.indexOf(">=") != -1
			return ">="
		if expr.indexOf("<=") != -1
			return "<="
		if expr.indexOf(">") != -1
			return ">"
		if expr.indexOf("<") != -1
			return "<"
		return ""

	string rewrite_any_int_compare(string expr)
		string op = find_compare_op(expr)
		if op == ""
			return expr
		integer pos = expr.indexOf(op)
		string lhs = expr.substring(0, pos).trim()
		string rhs = expr.substring(pos + op.length(), expr.length()).trim()
		if not is_numeric_literal(rhs)
			return expr
		if lhs.length() == 0
			return expr
		return lhs + ".toInteger() " + op + " " + rhs

	string kebab_to_camel(string input)
		string result = ""
		boolean capitalize_next = false
		integer i = 0
		while i < input.length()
			string ch = input.substring(i, i + 1)
			if ch == "-"
				capitalize_next = true
			else
				if capitalize_next
					result = result + ch.toUpperCase()
					capitalize_next = false
				else
					result = result + ch
			i = i + 1
		return result

	string tag_to_class_name(string tag_name)
		string result = ""
		boolean capitalize_next = true
		integer i = 0
		while i < tag_name.length()
			string ch = tag_name.substring(i, i + 1)
			if ch == "-"
				capitalize_next = true
			else
				if capitalize_next
					result = result + ch.toUpperCase()
					capitalize_next = false
				else
					result = result + ch
			i = i + 1
		return result

	string get_attr(string attrs, string key, string default_val)
		string pattern = "\"" + key + "\""
		integer pos = attrs.indexOf(pattern)
		if pos == -1
			return default_val
		integer colon_pos = attrs.indexOf(":", pos)
		if colon_pos == -1
			return default_val
		integer quote_start = attrs.indexOf("\"", colon_pos + 1)
		if quote_start == -1
			return default_val
		integer quote_end = attrs.indexOf("\"", quote_start + 1)
		if quote_end == -1
			return default_val
		return attrs.substring(quote_start + 1, quote_end)

	string path_to_class_name(string path)
		string result = ""
		boolean capitalize_next = true
		integer last_slash = path.lastIndexOf("/")
		string filename = path
		if last_slash != -1
			filename = path.substring(last_slash + 1, path.length())
		integer dot_pos = filename.lastIndexOf(".")
		if dot_pos != -1
			filename = filename.substring(0, dot_pos)
		if filename == "index"
			integer second_last_slash = path.lastIndexOf("/", last_slash - 1)
			if second_last_slash != -1
				filename = path.substring(second_last_slash + 1, last_slash)
			else
				filename = "Home"
		integer i = 0
		while i < filename.length()
			string ch = filename.substring(i, i + 1)
			if ch == "-" or ch == "_" or ch == "[" or ch == "]"
				capitalize_next = true
			else
				if capitalize_next
					result = result + ch.toUpperCase()
					capitalize_next = false
				else
					result = result + ch
			i = i + 1
		return result + "Page"

// ============================================================================
// COMPONENT STATE REFERENCES
// ============================================================================
// Component templates and handlers may name a state field as `state.x`; the
// field is a plain class field, so the `state.` prefix is dropped.

functions:
	// True when `c` can be part of a Clean identifier.
	boolean is_ident_char(string c)
		if c == "_"
			return true
		if c >= "a" and c <= "z"
			return true
		if c >= "A" and c <= "Z"
			return true
		return c >= "0" and c <= "9"

	// Drop every `state.` that starts an identifier path (`state.count` →
	// `count`); `estate.` and `my_state.` are left alone.
	string remove_state_dot(string s)
		string result = ""
		integer pos = 0
		integer hit = s.indexOf("state.", pos)
		while hit != -1
			boolean at_start = hit == 0
			if not at_start
				at_start = is_ident_char(s.substring(hit - 1, hit)) == false and s.substring(hit - 1, hit) != "."
			if at_start
				result = result + s.substring(pos, hit)
			else
				result = result + s.substring(pos, hit + 6)
			pos = hit + 6
			hit = s.indexOf("state.", pos)
		return result + s.substring(pos, s.length())

	// remove_state_dot applied only where a template holds code: `{...}`
	// interpolations and attribute values. Text content is left unchanged.
	string template_strip_state(string html)
		string result = ""
		integer i = 0
		integer n = html.length()
		boolean in_tag = false
		while i < n
			string c = html.substring(i, i + 1)
			if c == "{"
				integer close = html.indexOf("}", i + 1)
				if close == -1
					result = result + html.substring(i, n)
					i = n
				else
					result = result + remove_state_dot(html.substring(i, close + 1))
					i = close + 1
			else if in_tag and (c == "\"" or c == "'")
				integer end_quote = html.indexOf(c, i + 1)
				if end_quote == -1
					result = result + html.substring(i, n)
					i = n
				else
					result = result + remove_state_dot(html.substring(i, end_quote + 1))
					i = end_quote + 1
			else
				if c == "<"
					in_tag = true
				else if c == ">"
					in_tag = false
				result = result + c
				i = i + 1
		return result

// ============================================================================
// HTML → CLEAN STATEMENTS
// ============================================================================
// One emitter serves every HTML source frame.ui compiles: `html:` blocks,
// component templates, `page` blocks and HTML entry pages. It returns Clean
// statements that append the markup to the string variable `target`
// (`target = target + "..."`).
//
// page_mode is true for `page` blocks and HTML entry pages. In page mode
// event attributes become data-on-* markers, the client-side directives are
// dropped from the markup, cl-slot / cl-validate / cl-preview / cl-stream
// are rendered, `<screen>` places a screen, a non-GET form gets the CSRF
// input (UI-B011) and `<head>` gets the theme link (UI-S009). has_data
// (an HTML entry page with a companion load()) reads names from `data`.
//
// cl-if / cl-else / cl-iterate / cl-show (UI-B001..B004) work in both modes.

functions:
	// Escape text for a Clean string literal whose content is HTML text:
	// `"` becomes &quot;, line breaks become spaces, braces are escaped so the
	// literal does not interpolate. Backslashes are handled by the caller.
	string escape_string(string input)
		return escape_text(input, false)

	// escape_string for text inside <pre> / <textarea> when preserve is
	// true: line breaks and tabs are kept (as \n / \t escapes) instead of
	// being folded into spaces.
	string escape_text(string input, boolean preserve)
		string result = input
		result = result.replace("\"", "&quot;")
		if preserve
			result = result.replace("\r", "")
			result = result.replace("\n", "\\n")
			result = result.replace("\t", "\\t")
		else
			result = result.replace("\n", " ")
			result = result.replace("\t", " ")
		result = result.replace("{", "\\{")
		result = result.replace("}", "\\}")
		return result

	// Escape a literal attribute value for a single-quoted HTML attribute
	// inside a Clean string literal.
	string escape_attr_text(string input)
		string result = input.replace("\\", "\\\\")
		result = result.replace("'", "&#39;")
		return escape_string(result)

	// Escape raw text for a Clean string literal, keeping it byte-for-byte.
	string clean_literal(string input)
		string result = input.replace("\\", "\\\\")
		result = result.replace("\"", "\\\"")
		result = result.replace("\n", "\\n")
		result = result.replace("\t", "\\t")
		result = result.replace("{", "\\{")
		return result.replace("}", "\\}")

	// The Clean expression for one `{expr}` (escaped, UI-P006) or `{!expr}`
	// (raw, UI-P007) interpolation, given the text between the braces.
	string interp_expr(string inner, boolean has_data)
		if inner.startsWith("!")
			string raw = inner.substring(1, inner.length()).trim()
			if has_data
				return "data." + raw
			return raw
		string expr = inner.trim()
		if has_data
			return "_html_escape(data." + expr + ")"
		return "_html_escape((" + expr + ").toString())"

	// Text node → a quoted Clean string expression. `\{` and `\}` are literal
	// braces, any other backslash is a literal backslash, and `{{ ... }}` is
	// kept as literal text.
	string text_expr(string text, boolean has_data, boolean preserve)
		string result = "\""
		string remaining = text
		while remaining.length() > 0
			integer esc_pos = remaining.indexOf("\\")
			integer brace_start = remaining.indexOf("{")
			if esc_pos != -1 and (brace_start == -1 or esc_pos < brace_start)
				result = result + escape_text(remaining.substring(0, esc_pos), preserve)
				string escaped_char = ""
				if esc_pos + 1 < remaining.length()
					escaped_char = remaining.substring(esc_pos + 1, esc_pos + 2)
				if escaped_char == "{" or escaped_char == "}"
					result = result + escape_text(escaped_char, preserve)
					remaining = remaining.substring(esc_pos + 2, remaining.length())
				else
					result = result + "\\\\"
					remaining = remaining.substring(esc_pos + 1, remaining.length())
			else if brace_start == -1
				result = result + escape_text(remaining, preserve)
				remaining = ""
			else
				result = result + escape_text(remaining.substring(0, brace_start), preserve)
				remaining = remaining.substring(brace_start, remaining.length())
				if remaining.startsWith("{{")
					integer dbrace_end = remaining.indexOf("}}", 2)
					if dbrace_end == -1
						result = result + escape_text(remaining, preserve)
						remaining = ""
					else
						result = result + escape_text(remaining.substring(0, dbrace_end + 2), preserve)
						remaining = remaining.substring(dbrace_end + 2, remaining.length())
				else
					integer brace_end = remaining.indexOf("}", 1)
					if brace_end == -1
						result = result + escape_text(remaining, preserve)
						remaining = ""
					else
						result = result + "\" + " + interp_expr(remaining.substring(1, brace_end), has_data) + " + \""
						remaining = remaining.substring(brace_end + 1, remaining.length())
		return result + "\""

	// Attribute value → the text that goes between the single quotes of the
	// attribute, inside a Clean string literal. `{expr}` / `{!expr}` parts
	// close the literal, add the expression and reopen it.
	string attr_value_fragment(string value)
		string result = ""
		string remaining = value
		while remaining.length() > 0
			integer brace_start = remaining.indexOf("{")
			integer brace_end = -1
			if brace_start != -1
				brace_end = remaining.indexOf("}", brace_start + 1)
			if brace_start == -1 or brace_end == -1
				result = result + escape_attr_text(remaining)
				remaining = ""
			else
				result = result + escape_attr_text(remaining.substring(0, brace_start))
				result = result + "\" + " + interp_expr(remaining.substring(brace_start + 1, brace_end), false) + " + \""
				remaining = remaining.substring(brace_end + 1, remaining.length())
		return result

	// `target = target + <expr>` statement.
	string append_stmt(string target, string expr)
		return target + " = " + target + " + " + expr + "\n"

	// Prefix every line of a statement sequence with one tab.
	string indent_lines(string code)
		string result = ""
		string remaining = code
		while remaining.length() > 0
			integer nl = remaining.indexOf("\n")
			string line = remaining
			if nl == -1
				remaining = ""
			else
				line = remaining.substring(0, nl)
				remaining = remaining.substring(nl + 1, remaining.length())
			if line.length() > 0
				result = result + "\t" + line + "\n"
		return result

	string html_to_stmts(string html, string target, boolean page_mode, string registry_json, boolean has_data)
		return html_nodes(html, target, page_mode, registry_json, has_data, false)

	// html_to_stmts with whitespace preservation: inside <pre> / <textarea>
	// (preserve = true) text nodes keep their line breaks, tabs and
	// surrounding whitespace.
	string html_nodes(string html, string target, boolean page_mode, string registry_json, boolean has_data, boolean preserve)
		string result = ""
		string remaining = html
		while remaining.length() > 0
			integer tag_start = remaining.indexOf("<")
			if tag_start == -1
				string text = remaining
				if preserve == false
					text = text.trim()
				if text.length() > 0
					result = result + append_stmt(target, text_expr(text, has_data, preserve))
				remaining = ""
			else if tag_start > 0
				string text = remaining.substring(0, tag_start)
				if preserve or text.trim().length() > 0
					result = result + append_stmt(target, text_expr(text, has_data, preserve))
				remaining = remaining.substring(tag_start, remaining.length())
			else if remaining.startsWith("<!--")
				// HTML comment: source annotation, not rendered output.
				integer comment_end = remaining.indexOf("-->")
				if comment_end == -1
					remaining = ""
				else
					remaining = remaining.substring(comment_end + 3, remaining.length())
			else
				integer tag_end = find_tag_end(remaining)
				if tag_end == -1
					remaining = ""
				else
					// A tag written over several lines reads as one line.
					string tag_content = remaining.substring(1, tag_end).replace("\n", " ").replace("\t", " ")
					string tag_name = extract_tag_name(tag_content)
					if tag_content.startsWith("/")
						remaining = remaining.substring(tag_end + 1, remaining.length())
					else if tag_name.startsWith("!")
						// <!DOCTYPE ...> and other declarations are copied as written.
						result = result + append_stmt(target, "\"<" + clean_literal(tag_content) + ">\"")
						remaining = remaining.substring(tag_end + 1, remaining.length())
					else if tag_name.toLowerCase() == "script"
						// UI-C001: templates hold no JavaScript.
						result = result + template_error_marker("E004") + "\n"
						remaining = ""
					else
						string inner = ""
						integer consumed = tag_end + 1
						boolean self_closing = tag_content.endsWith("/") or is_void_element(tag_name)
						if self_closing == false
							integer close_pos = find_matching_close(remaining, tag_name)
							if close_pos != -1
								inner = remaining.substring(tag_end + 1, close_pos)
								consumed = close_pos + tag_name.length() + 3
						result = result + element_stmts(tag_content, inner, target, page_mode, registry_json, has_data, preserve)
						remaining = remaining.substring(consumed, remaining.length())
		return result

	// A directive condition / collection expression, read from `data` on a
	// page with companion data.
	string directive_expr(string expr, boolean has_data)
		if has_data
			return "data." + expr
		return expr

	// A cl-if / cl-show condition. Companion data is `any`, so a comparison
	// with a number literal reads the value as an integer; elsewhere the
	// expression is typed and used as written.
	string directive_condition(string expr, boolean has_data)
		if has_data
			return directive_expr(rewrite_any_int_compare(expr), true)
		return expr

	// Statements for one element, applying its structural directives.
	// cl-else takes the branch after the preceding cl-if; cl-iterate repeats
	// the element and, as in the host's request-time renderer, each copy
	// then applies the element's cl-if / cl-show (the condition can read the
	// item).
	string element_stmts(string tag_content, string inner, string target, boolean page_mode, string registry_json, boolean has_data, boolean preserve)
		string open_tag = "<" + tag_content + ">"
		if has_attr(open_tag, "cl-else") and has_attr(open_tag, "cl-if") == false
			return "else\n" + indent_lines(iterate_stmts(tag_content, inner, target, page_mode, registry_json, has_data, preserve))
		return iterate_stmts(tag_content, inner, target, page_mode, registry_json, has_data, preserve)

	// cl-iterate="item in coll" / "item, index in coll" (UI-B004). Clean's
	// iterate has no index form (grammar.ebnf iterate_statement), so the
	// zero-based index is a counter kept in its own `if true` scope.
	string iterate_stmts(string tag_content, string inner, string target, boolean page_mode, string registry_json, boolean has_data, boolean preserve)
		string iterate_attr = extract_attr_value("<" + tag_content + ">", "cl-iterate")
		integer in_pos = iterate_attr.indexOf(" in ")
		if in_pos == -1
			return conditional_stmts(tag_content, inner, target, page_mode, registry_json, has_data, preserve)
		string vars = iterate_attr.substring(0, in_pos).trim()
		string collection = directive_expr(iterate_attr.substring(in_pos + 4, iterate_attr.length()).trim(), has_data)
		string body = conditional_stmts(tag_content, inner, target, page_mode, registry_json, has_data, preserve)
		integer comma = vars.indexOf(",")
		if comma == -1
			return "iterate " + vars + " in " + collection + "\n" + indent_lines(body)
		string item_var = vars.substring(0, comma).trim()
		string index_var = vars.substring(comma + 1, vars.length()).trim()
		string counter = "__cl_index_" + index_var
		string loop = "integer " + counter + " = 0\n"
		loop = loop + "iterate " + item_var + " in " + collection + "\n"
		loop = loop + "\tinteger " + index_var + " = " + counter + "\n"
		loop = loop + "\t" + counter + " = " + counter + " + 1\n"
		loop = loop + indent_lines(body)
		return "if true\n" + indent_lines(loop)

	// cl-if / cl-show / cl-slot / cl-validate of one element.
	string conditional_stmts(string tag_content, string inner, string target, boolean page_mode, string registry_json, boolean has_data, boolean preserve)
		string open_tag = "<" + tag_content + ">"
		string if_attr = extract_attr_value(open_tag, "cl-if")
		if if_attr != ""
			string body = render_element(tag_content, inner, target, page_mode, registry_json, has_data, "", preserve)
			return "if " + directive_condition(if_attr, has_data) + "\n" + indent_lines(body)
		string show_attr = extract_attr_value(open_tag, "cl-show")
		if show_attr != ""
			string shown = render_element(tag_content, inner, target, page_mode, registry_json, has_data, "", preserve)
			string hidden = render_element(tag_content, inner, target, page_mode, registry_json, has_data, "hidden", preserve)
			return "if " + directive_condition(show_attr, has_data) + "\n" + indent_lines(shown) + "else\n" + indent_lines(hidden)
		if page_mode
			string slot_attr = extract_attr_value(open_tag, "cl-slot")
			if slot_attr != ""
				string slot = append_stmt(target, "\"<div data-slot='" + escape_attr_text(slot_attr) + "'>\"")
				slot = slot + html_nodes(inner, target, page_mode, registry_json, has_data, preserve)
				return slot + append_stmt(target, "\"</div>\"")
			string validate_attr = extract_attr_value(open_tag, "cl-validate")
			if validate_attr != ""
				string error_msg = extract_attr_value(open_tag, "error-message")
				if error_msg == ""
					error_msg = "Invalid value"
				string bind_attr = extract_attr_value(open_tag, "cl-bind")
				string field = render_element(tag_content, inner, target, page_mode, registry_json, has_data, "", preserve)
				return field + validation_error_stmts(bind_attr, validate_attr, error_msg, target, has_data)
		return render_element(tag_content, inner, target, page_mode, registry_json, has_data, "", preserve)

	// Statements for one element without its structural directive. variant
	// is "" or "hidden" (the cl-show false branch: display:none).
	string render_element(string tag_content, string inner, string target, boolean page_mode, string registry_json, boolean has_data, string variant, boolean preserve)
		string tag_name = extract_tag_name(tag_content)
		if page_mode and tag_name == "screen"
			return render_screen_island(tag_content, target)
		if tag_name.indexOf("-") != -1
			return render_component(tag_name, tag_content, inner, target, page_mode, registry_json, has_data)
		string attrs = html_attributes(tag_content, page_mode)
		if page_mode
			if tag_name == "iframe" and has_attr("<" + tag_content + ">", "cl-preview")
				attrs = join_attrs(attrs, "data-cl-preview='true'")
			string stream_url = extract_attr_value("<" + tag_content + ">", "cl-stream")
			if stream_url != ""
				attrs = join_attrs(attrs, "data-cl-stream='" + attr_value_fragment(stream_url) + "'")
		if variant == "hidden"
			attrs = hide_attrs(attrs)
		string result = append_stmt(target, "\"<" + join_attrs(tag_name, attrs) + ">\"")
		string lower_name = tag_name.toLowerCase()
		if lower_name == "style"
			// Raw text element: CSS braces are not interpolation, the content
			// is copied as written.
			if inner.length() > 0
				result = result + append_stmt(target, "\"" + clean_literal(inner) + "\"")
		else
			boolean inner_preserve = preserve or lower_name == "pre" or lower_name == "textarea"
			if inner_preserve or inner.trim().length() > 0
				result = result + html_nodes(inner, target, page_mode, registry_json, has_data, inner_preserve)
		if page_mode and tag_name == "form"
			// UI-B011: a non-GET form gets the CSRF input. A form without a
			// method attribute is a GET form. The value is the current
			// session's CSRF token, which the server checks on the form's
			// POST (frame.auth csrf:, AUTH-S006); without a session there is
			// no token and the request needs none.
			string method_upper = extract_attr_value("<" + tag_content + ">", "method").toUpperCase()
			if method_upper == "POST" or method_upper == "PUT" or method_upper == "PATCH" or method_upper == "DELETE"
				result = result + append_stmt(target, "\"<input type='hidden' name='_csrf' value='\" + _html_escape(_session_get_csrf()) + \"'>\"")
		if is_void_element(tag_name) == false
			result = result + append_stmt(target, "\"</" + tag_name + ">\"")
		if page_mode and tag_name == "head"
			result = result + target + " = _ui_head_links(" + target + ")\n"
		return result

	string join_attrs(string a, string b)
		if a == ""
			return b
		if b == ""
			return a
		return a + " " + b

	// Index of the `}` closing the `{` at `open_pos`, counting nested
	// braces; -1 when it is not closed.
	integer matching_brace(string s, integer open_pos)
		integer depth = 0
		integer i = open_pos
		while i < s.length()
			string ch = s.substring(i, i + 1)
			if ch == "{"
				depth = depth + 1
			else if ch == "}"
				depth = depth - 1
				if depth == 0
					return i
			i = i + 1
		return -1

	// True for a plain Clean identifier (`selected`, `is_open`).
	boolean is_plain_identifier(string s)
		if s.length() == 0
			return false
		string first = s.substring(0, 1)
		if first >= "0" and first <= "9"
			return false
		integer i = 0
		while i < s.length()
			if is_ident_char(s.substring(i, i + 1)) == false
				return false
			i = i + 1
		return true

	// Template errors found while turning HTML into statements are left in
	// the generated source as a marker; the html:, page and component
	// expansions turn the marker into a compile error instead of sending the
	// text to the browser.
	//   E003  an attribute frame-ui.ebnf does not allow
	//   E004  a <script> element (UI-C001)
	//   E005  an unknown cl-validate rule (UI-B012)
	string template_error_marker(string code)
		return "__FRAME_UI_" + code + "__"

	string bad_attribute_marker()
		return template_error_marker("E003")

	string bad_attribute_message()
		return "an attribute written in braces must be a variable name: \{name\} sets name to its value (frame-ui.ebnf interpolation_attribute). Raw HTML \{!...\} cannot stand for an attribute. To add a boolean attribute such as selected or checked only when a condition holds, put it on an element with cl-if=\{condition\} and follow it with a cl-else twin without it."

	// The code of the first template error marker in source, "" when none.
	string template_error_code(string source)
		list<string> codes = ["E003", "E004", "E005"]
		integer i = 0
		while i < codes.length()
			if source.indexOf(template_error_marker(codes[i])) != -1
				return codes[i]
			i = i + 1
		return ""

	integer template_error(integer ctx, string code)
		if code == "E004"
			return plugin_error(ctx, "FRAME-UI-E004", "<script> is not allowed in frame.ui templates (frame-ui-semantics UI-C001). Page logic goes in Clean: a companion load() for data, functions: handlers wired with onclick=\"name\" and the ui.* bridges for DOM updates.")
		if code == "E005"
			return plugin_error(ctx, "FRAME-UI-E005", "unknown cl-validate rule (frame-ui-semantics UI-B012). Supported rules: required, email.")
		return plugin_error(ctx, "FRAME-UI-E003", bad_attribute_message())

	// Add display:none to an attribute fragment, inside an existing style
	// attribute when there is one.
	string hide_attrs(string attrs)
		integer style_pos = -1
		if attrs.startsWith("style='")
			style_pos = 0
		else
			integer found = attrs.indexOf(" style='")
			if found != -1
				style_pos = found + 1
		if style_pos == -1
			return join_attrs(attrs, "style='display:none'")
		integer value_start = style_pos + 7
		return attrs.substring(0, value_start) + "display:none;" + attrs.substring(value_start, attrs.length())

	// cl-validate (UI-B012): the error span shown when the bound field
	// fails its rule. `required`: the field is empty; `email`: it has no
	// `@` or no `.`. Any other rule is FRAME-UI-E005 — an unknown rule must
	// not silently validate as something else.
	string validation_error_stmts(string field_name, string validate_type, string error_msg, string target, boolean has_data)
		string rule = validate_type.trim()
		if rule != "required" and rule != "email"
			return template_error_marker("E005") + "\n"
		if field_name == ""
			return ""
		string field_ref = directive_expr(field_name, has_data)
		string condition = field_ref + ".trim().length() == 0"
		if rule == "email"
			condition = field_ref + ".indexOf(\"@\") == -1 or " + field_ref + ".indexOf(\".\") == -1"
		return "if " + condition + "\n\t" + append_stmt(target, "\"<span class='cl-validation-error'>" + escape_string(error_msg) + "</span>\"")

	// `<screen name="X" client="...">` places the core `screen X:` block on
	// the page: it calls the screen's own scoped render function `X.render()`.
	// A screen holds one copy of its screen-scoped state (spec §23 "State in
	// Screens"), so the tag carries no state of its own — `name` and `client`
	// are its only attributes (UI-B018).
	string render_screen_island(string tag_content, string target)
		string screen_name = extract_attr_value("<" + tag_content + ">", "name")
		string client = extract_attr_value("<" + tag_content + ">", "client")
		if client == ""
			client = "off"
		string result = append_stmt(target, "\"<div id='screen-" + screen_name + "' data-screen='" + screen_name + "' data-client='" + client + "'>\"")
		result = result + append_stmt(target, screen_name + ".render()")
		return result + append_stmt(target, "\"</div>\"")

	// A component tag (UI-C010): build the component, set its inputs from the
	// tag attributes, pass the children as slot content and append render().
	string render_component(string tag_name, string tag_content, string inner, string target, boolean page_mode, string registry_json, boolean has_data)
		string class_name = lookup_component(tag_name, registry_json)
		if class_name == ""
			class_name = tag_to_class_name(tag_name)
		string client = extract_attr_value("<" + tag_content + ">", "client")
		if client == ""
			client = "off"
		string result = ""
		if client != "off"
			result = result + append_stmt(target, "\"<div data-island='" + tag_name + "' data-client='" + client + "'>\"")
		// Own scope per embedded component.
		result = result + "if true\n"
		result = result + "\t" + class_name + " _comp = " + class_name + "()\n"
		result = result + component_props(tag_content)
		if inner.trim().length() > 0
			result = result + "\tstring _slot = \"\"\n"
			result = result + indent_lines(html_to_stmts(inner, "_slot", page_mode, registry_json, has_data))
			result = result + "\t_comp.setSlot(_slot)\n"
		// `class="..."` on the component tag is added to the component's outer
		// HTML element (UI-C009), merged with any class the component's own
		// markup already sets. `{expr}` values are evaluated at render time.
		string class_attr = extract_attr_value("<" + tag_content + ">", "class")
		if class_attr != ""
			string class_expr = "\"" + clean_literal(class_attr) + "\""
			if class_attr.startsWith("{") and class_attr.endsWith("}")
				class_expr = class_attr.substring(1, class_attr.length() - 1).trim()
			result = result + "\t" + append_stmt(target, "_ui_add_root_class(_comp.render(), " + class_expr + ")")
		else
			result = result + "\t" + append_stmt(target, "_comp.render()")
		if client != "off"
			result = result + append_stmt(target, "\"</div>\"")
		return result

	// Attributes of an element as a fragment for the inside of a Clean string
	// literal: `name='value'` pairs separated by spaces. In page mode the
	// directives are dropped and event attributes become data-on-* markers;
	// in both modes the structural directives (cl-if, cl-else, cl-iterate,
	// cl-show) are dropped.
	string html_attributes(string tag_content, boolean page_mode)
		string structural = ",cl-if,cl-else,cl-iterate,cl-show,"
		string directives = ",cl-if,cl-else,cl-iterate,cl-bind,cl-client,cl-show,cl-validate,cl-slot,cl-preview,cl-stream,cl-transition,cl-boundary,error-message,"
		string dropped = structural
		if page_mode
			dropped = directives
		string result = ""
		string remaining = tag_content
		integer space_pos = remaining.indexOf(" ")
		if space_pos == -1
			return ""
		remaining = remaining.substring(space_pos + 1, remaining.length())
		if remaining.endsWith("/")
			remaining = remaining.substring(0, remaining.length() - 1)
		remaining = remaining.trim()
		while remaining.length() > 0
			integer eq_pos = remaining.indexOf("=")
			integer next_space = remaining.indexOf(" ")
			boolean has_value = eq_pos != -1
			if has_value and next_space != -1 and next_space < eq_pos
				// `name = value` is one attribute; `disabled class="x"` is two.
				has_value = remaining.substring(next_space, eq_pos).trim() == ""
			if remaining.startsWith("{")
				// interpolation_attribute: `{name}` is `name={name}`; any
				// other braced text (`{!sel}`) is not an attribute.
				integer brace_close = matching_brace(remaining, 0)
				string braced = remaining
				if brace_close == -1
					remaining = ""
				else
					braced = remaining.substring(0, brace_close + 1)
					remaining = remaining.substring(brace_close + 1, remaining.length()).trim()
				string bare = braced.substring(1, braced.length() - 1).trim()
				if brace_close != -1 and is_plain_identifier(bare)
					result = join_attrs(result, attr_fragment(bare, "{" + bare + "}", page_mode))
				else
					result = join_attrs(result, bad_attribute_marker())
			else if not has_value
				// Boolean attribute (no value).
				string attr_name = remaining
				if next_space == -1
					remaining = ""
				else
					attr_name = remaining.substring(0, next_space)
					remaining = remaining.substring(next_space + 1, remaining.length()).trim()
				if attr_name.length() > 0 and dropped.indexOf("," + attr_name + ",") == -1
					result = join_attrs(result, attr_name)
			else
				string attr_name = remaining.substring(0, eq_pos).trim()
				string attr_value = ""
				string after_eq = remaining.substring(eq_pos + 1, remaining.length()).trim()
				remaining = ""
				string quote = ""
				if after_eq.length() > 0
					quote = after_eq.substring(0, 1)
				if quote == "\"" or quote == "'"
					integer close_quote = after_eq.indexOf(quote, 1)
					if close_quote == -1
						attr_value = after_eq.substring(1, after_eq.length())
					else
						attr_value = after_eq.substring(1, close_quote)
						remaining = after_eq.substring(close_quote + 1, after_eq.length()).trim()
				else if quote == "{"
					// `name={expression}`: the expression may hold spaces.
					integer value_close = matching_brace(after_eq, 0)
					if value_close == -1
						attr_value = after_eq
					else
						attr_value = after_eq.substring(0, value_close + 1)
						remaining = after_eq.substring(value_close + 1, after_eq.length()).trim()
				else
					integer value_end = after_eq.indexOf(" ")
					if value_end == -1
						attr_value = after_eq
					else
						attr_value = after_eq.substring(0, value_end)
						remaining = after_eq.substring(value_end, after_eq.length()).trim()
				if attr_name.length() > 0 and dropped.indexOf("," + attr_name + ",") == -1
					result = join_attrs(result, attr_fragment(attr_name, attr_value, page_mode))
		return result

	// One `name='value'` attribute. In page mode an event attribute
	// (`onclick.stop="save"`) becomes `data-on-click='save'` plus one
	// `data-on-click-stop='true'` marker per modifier.
	string attr_fragment(string attr_name, string attr_value, boolean page_mode)
		string events = ",onclick,oninput,onchange,onsubmit,onfocus,onblur,onkeydown,onkeyup,onkeypress,onmouseover,onmouseenter,onmouseleave,onmousedown,onmouseup,onmousemove,oncontextmenu,ondragstart,ondragend,ondragenter,ondragover,ondragleave,ondrop,onpointerdown,onpointermove,onpointerup,onpointercancel,onpointerenter,onpointerleave,onwheel,onscroll,"
		string base_event = attr_name
		string modifier = ""
		integer dot_pos = attr_name.indexOf(".")
		if dot_pos != -1
			base_event = attr_name.substring(0, dot_pos)
			modifier = attr_name.substring(dot_pos + 1, attr_name.length())
		if page_mode == false or events.indexOf("," + base_event + ",") == -1
			return attr_name + "='" + attr_value_fragment(attr_value) + "'"
		string event_name = base_event.substring(2, base_event.length())
		string fragment = "data-on-" + event_name + "='" + escape_attr_text(attr_value) + "'"
		if modifier != ""
			list<string> modifiers = modifier.split(".")
			integer mi = 0
			while mi < modifiers.length()
				if modifiers[mi] != ""
					fragment = fragment + " data-on-" + event_name + "-" + modifiers[mi] + "='true'"
				mi = mi + 1
		return fragment

	// Input assignments for a component tag's attributes (UI-C010). `client`
	// (UI-B008) and `class` (UI-C009) are not inputs; neither are the
	// structural directives.
	string component_props(string tag_content)
		string not_props = ",client,class,cl-if,cl-else,cl-iterate,cl-bind,cl-client,cl-slot,cl-show,cl-validate,"
		string result = ""
		string remaining = tag_content
		integer space_pos = remaining.indexOf(" ")
		if space_pos == -1
			return ""
		remaining = remaining.substring(space_pos + 1, remaining.length())
		if remaining.endsWith("/")
			remaining = remaining.substring(0, remaining.length() - 1)
		remaining = remaining.trim()
		while remaining.length() > 0
			integer eq_pos = remaining.indexOf("=")
			if eq_pos == -1
				remaining = ""
			else
				// Boolean attributes before this one are not inputs.
				string attr_name = remaining.substring(0, eq_pos).trim()
				integer name_sp = attr_name.lastIndexOf(" ")
				if name_sp != -1
					attr_name = attr_name.substring(name_sp + 1, attr_name.length())
				string after_eq = remaining.substring(eq_pos + 1, remaining.length()).trim()
				string quote = ""
				if after_eq.length() > 0
					quote = after_eq.substring(0, 1)
				if quote == "\"" or quote == "'"
					integer end_quote = after_eq.indexOf(quote, 1)
					if end_quote != -1
						string attr_value = after_eq.substring(1, end_quote)
						if not_props.indexOf("," + attr_name + ",") == -1
							if attr_value.startsWith("{") and attr_value.endsWith("}")
								string expr = attr_value.substring(1, attr_value.length() - 1).trim()
								result = result + "\t_comp." + kebab_to_camel(attr_name) + " = " + expr + "\n"
							else
								result = result + "\t_comp.setInput(\"" + attr_name + "\", \"" + clean_literal(attr_value) + "\")\n"
						remaining = after_eq.substring(end_quote + 1, after_eq.length()).trim()
					else
						remaining = ""
				else
					remaining = ""
		return result

	string lookup_component(string tag_name, string registry_json)
		string pattern = "\"" + tag_name + "\":\""
		integer pos = registry_json.indexOf(pattern)
		if pos == -1
			return ""
		integer value_start = pos + pattern.length()
		integer value_end = registry_json.indexOf("\"", value_start)
		if value_end == -1
			return ""
		return registry_json.substring(value_start, value_end)

// ============================================================================
// HTML: BLOCK
// ============================================================================

functions:
	// html: block (UI-P004 / UI-P005): `string <var> = ""`, the markup
	// statements and — without var= — `return __html`.
	string expand_html_block(string attributes, string body)
		string cleaned = strip_block_indent(body)
		string var_name = get_attr(attributes, "var", "")
		string target = "__html"
		if var_name != ""
			target = var_name
		string result = "string " + target + " = \"\"\n"
		result = result + html_to_stmts(cleaned, target, false, "{}", false)
		if cleaned.indexOf("</head>") != -1
			result = result + target + " = _ui_head_links(" + target + ")\n"
		if var_name == ""
			// `+ ""` forces a fresh string so callers that keep an earlier
			// result are not affected by later appends (fp 95bdb1bb4b890c7a).
			result = result + "return __html + \"\"\n"
		return result

// ============================================================================
// COMPONENT BODY / JSON HELPERS
// ============================================================================

functions:
	// Inverse of spec_esc_json. extract_json_field returns the raw
	// characters between the JSON quotes without decoding escape sequences, so
	// `\n` / `\t` / `\"` / `\\` arrive as two-character literals. When the
	// content flows back into a source-consuming bridge (e.g.
	// _transform_source_file per assemble.md §6.1a, which expects raw Clean
	// source), these escapes must be decoded first — otherwise the lexer sees
	// a literal backslash and rejects it. Single-pass to avoid double-decoding
	// `\\n` (escaped backslash followed by n) into a newline.
	string decode_json_string(string txt)
		string result = ""
		integer i = 0
		integer n = txt.length()
		while i < n
			string ch = txt.substring(i, i + 1)
			if ch == "\\" and i + 1 < n
				string nx = txt.substring(i + 1, i + 2)
				if nx == "n"
					result = result + "\n"
					i = i + 2
				else
					if nx == "t"
						result = result + "\t"
						i = i + 2
					else
						if nx == "r"
							result = result + "\r"
							i = i + 2
						else
							if nx == "\""
								result = result + "\""
								i = i + 2
							else
								if nx == "\\"
									result = result + "\\"
									i = i + 2
								else
									if nx == "/"
										result = result + "/"
										i = i + 2
									else
										result = result + ch
										i = i + 1
			else
				result = result + ch
				i = i + 1
		return result

	string parse_component_body(string body)
		string before = ""
		string html_content = ""
		string after = ""
		string fallback_content = ""
		integer html_pos = -1
		integer search_pos = 0
		while search_pos < body.length()
			integer pos = body.indexOf("html:", search_pos)
			if pos == -1
				search_pos = body.length()
			else
				boolean valid = false
				if pos == 0
					valid = true
				else
					string char_before = body.substring(pos - 1, pos)
					if char_before == "\n" or char_before == "\t"
						valid = true
				if valid
					html_pos = pos
					search_pos = body.length()
				else
					search_pos = pos + 5
		if html_pos == -1
			return "{\"before\":\"" + spec_esc_json(body) + "\",\"html\":\"\",\"after\":\"\",\"fallback\":\"\"}"
		if html_pos > 0
			before = body.substring(0, html_pos)
		integer content_start = body.indexOf("\n", html_pos)
		if content_start == -1
			return "{\"before\":\"" + spec_esc_json(before) + "\",\"html\":\"\",\"after\":\"\",\"fallback\":\"\"}"
		content_start = content_start + 1
		integer html_line_indent = 0
		integer scan = html_pos - 1
		boolean __scan_html_indent = true
		while __scan_html_indent and scan >= 0
			string __sc_ch = body.substring(scan, scan + 1)
			if __sc_ch != "\t"
				__scan_html_indent = false
			else
				html_line_indent = html_line_indent + 1
				scan = scan - 1
		integer html_end = body.length()
		string sections = ",inputs:,state:,functions:,computed:,events:,fallback:,style:,"
		string search_remaining = body.substring(content_start, body.length())
		integer line_start = 0
		while line_start < search_remaining.length()
			integer nl = search_remaining.indexOf("\n", line_start)
			if nl == -1
				nl = search_remaining.length()
			string line = search_remaining.substring(line_start, nl)
			integer indent = 0
			boolean __count_indent_a = true
			while __count_indent_a and indent < line.length()
				string __ci_a_ch = line.substring(indent, indent + 1)
				if __ci_a_ch != "\t"
					__count_indent_a = false
				else
					indent = indent + 1
			if indent <= html_line_indent and line.trim().length() > 0
				string trimmed = line.trim()
				if trimmed.endsWith(":")
					string section_name = trimmed.substring(0, trimmed.length() - 1)
					if sections.indexOf("," + section_name + ":,") != -1
						html_end = content_start + line_start
						after = body.substring(html_end, body.length())
						line_start = search_remaining.length()
					else
						line_start = nl + 1
				else
					line_start = nl + 1
			else
				line_start = nl + 1
		html_content = body.substring(content_start, html_end)
		integer fallback_pos = body.indexOf("fallback:")
		if fallback_pos != -1
			boolean fallback_valid = false
			if fallback_pos == 0
				fallback_valid = true
			else
				string char_before_fallback = body.substring(fallback_pos - 1, fallback_pos)
				if char_before_fallback == "\n" or char_before_fallback == "\t"
					fallback_valid = true
			if fallback_valid
				integer nl_after_fallback = body.indexOf("\n", fallback_pos)
				if nl_after_fallback != -1
					integer fallback_content_start = nl_after_fallback + 1
					integer fallback_end = body.length()
					integer fallback_line_indent = 0
					integer fscan = fallback_pos - 1
					boolean __scan_fb_indent = true
					while __scan_fb_indent and fscan >= 0
						string __sfb_ch = body.substring(fscan, fscan + 1)
						if __sfb_ch != "\t"
							__scan_fb_indent = false
						else
							fallback_line_indent = fallback_line_indent + 1
							fscan = fscan - 1
					string fallback_sections = ",inputs:,state:,functions:,computed:,events:,html:,style:,"
					string fsearch = body.substring(fallback_content_start, body.length())
					integer fline_start = 0
					while fline_start < fsearch.length()
						integer fnl = fsearch.indexOf("\n", fline_start)
						if fnl == -1
							fnl = fsearch.length()
						string fline = fsearch.substring(fline_start, fnl)
						integer findent = 0
						boolean __count_findent = true
						while __count_findent and findent < fline.length()
							string __fi_ch = fline.substring(findent, findent + 1)
							if __fi_ch != "\t"
								__count_findent = false
							else
								findent = findent + 1
						if findent <= fallback_line_indent and fline.trim().length() > 0
							string ftrimmed = fline.trim()
							if ftrimmed.endsWith(":")
								string fsection_name = ftrimmed.substring(0, ftrimmed.length() - 1)
								if fallback_sections.indexOf("," + fsection_name + ":,") != -1
									fallback_end = fallback_content_start + fline_start
									fline_start = fsearch.length()
								else
									fline_start = fnl + 1
							else
								fline_start = fnl + 1
						else
							fline_start = fnl + 1
					fallback_content = body.substring(fallback_content_start, fallback_end).trim()
		return "{\"before\":\"" + spec_esc_json(before) + "\",\"html\":\"" + spec_esc_json(html_content) + "\",\"after\":\"" + spec_esc_json(after) + "\",\"fallback\":\"" + spec_esc_json(fallback_content) + "\"}"

	string strip_block_indent(string content)
		integer min_indent = 999
		string remaining = content
		while remaining.length() > 0
			integer nl = remaining.indexOf("\n")
			string line = ""
			if nl == -1
				line = remaining
				remaining = ""
			else
				line = remaining.substring(0, nl)
				remaining = remaining.substring(nl + 1, remaining.length())
			if line.trim().length() > 0
				integer indent = 0
				boolean __count_indent_b = true
				while __count_indent_b and indent < line.length()
					string __ci_b_ch = line.substring(indent, indent + 1)
					if __ci_b_ch != "\t"
						__count_indent_b = false
					else
						indent = indent + 1
				if indent < min_indent
					min_indent = indent
		if min_indent == 999
			min_indent = 0
		string result = ""
		remaining = content
		boolean first = true
		while remaining.length() > 0
			integer nl = remaining.indexOf("\n")
			string line = ""
			if nl == -1
				line = remaining
				remaining = ""
			else
				line = remaining.substring(0, nl)
				remaining = remaining.substring(nl + 1, remaining.length())
			if line.trim().length() > 0
				if first == false
					result = result + " "
				first = false
				// FRAME-UI-HTML-INTERP-CORRUPTION-AND-WS-DROP (fp 95bdb1bb4b890c7a):
				// Do NOT .trim() the content-side substring — that drops legitimate
				// spaces between an `{ident}` at end-of-line and following literal
				// text when lines are joined with a single space separator. The
				// indent-stripped substring is already free of leading tabs; any
				// remaining whitespace is intentional inter-fragment spacing.
				if line.length() > min_indent
					result = result + line.substring(min_indent, line.length())
				else
					result = result + line.trim()
		return result

	boolean needs_client_runtime(string html)
		string remaining = html
		while remaining.indexOf("<screen") != -1
			integer screen_start = remaining.indexOf("<screen")
			integer screen_end = remaining.indexOf(">", screen_start)
			if screen_end == -1
				return false
			string screen_tag = remaining.substring(screen_start, screen_end + 1)
			string client = extract_attr_value(screen_tag, "client")
			if client == "on" or client == "visible" or client == "idle"
				return true
			remaining = remaining.substring(screen_end + 1, remaining.length())
		if html.indexOf("client=\"on\"") != -1
			return true
		if html.indexOf("client=\"visible\"") != -1
			return true
		if html.indexOf("client=\"idle\"") != -1
			return true
		return false

// ============================================================================
// CLIENT_INIT SOURCE
// ============================================================================

functions:
	// Build the Clean source for the client_init lifecycle slot: per-component
	// _ui_update_element + instance.onMount() calls. Returns "" when no
	// components need hydration (no statements to emit).
	string emit_ui_client_init_source(string context_json)
		// build_state is a nested object, which extract_json_field cannot
		// return whole (it stops at the first comma). The key is unique in the
		// context JSON and its value is a plain string, so read it directly.
		string components_csv = extract_json_field(context_json, "frame.ui:components")
		if components_csv == ""
			return ""
		string statements = ""
		string remaining = components_csv
		while remaining.length() > 0
			integer sc = remaining.indexOf(";")
			string record = ""
			if sc == -1
				record = remaining
				remaining = ""
			else
				record = remaining.substring(0, sc)
				remaining = remaining.substring(sc + 1, remaining.length())
			integer c1 = record.indexOf(",")
			if c1 != -1
				string rec_tag = record.substring(0, c1)
				string rec_rest = record.substring(c1 + 1, record.length())
				integer c2 = rec_rest.indexOf(",")
				if c2 != -1
					string rec_hyd = rec_rest.substring(c2 + 1, rec_rest.length())
					if rec_hyd != "off"
						string instance_var = "instance_" + rec_tag.replace("-", "_")
						statements = statements + "_ui_update_element(\"[data-island='" + rec_tag + "']\", " + instance_var + ".render())\n"
						statements = statements + instance_var + ".onMount()\n"
		return statements

// ============================================================================
// SCREEN COLLECTION + HYDRATION MANIFEST
// ============================================================================

functions:
	string collect_screens_from_html(string html)
		string entries = ""
		string remaining = html
		integer safety = 0
		while remaining.indexOf("<screen") != -1 and safety < 1000
			safety = safety + 1
			integer screen_start = remaining.indexOf("<screen")
			integer screen_end = remaining.indexOf(">", screen_start)
			if screen_end == -1
				return entries
			string screen_tag = remaining.substring(screen_start, screen_end + 1)
			string name = extract_attr_value(screen_tag, "name")
			string mode = extract_attr_value(screen_tag, "client")
			if name.length() > 0
				if mode.length() == 0
					mode = "off"
				entries = entries + name + "=" + mode + "\n"
			remaining = remaining.substring(screen_end + 1, remaining.length())
		return entries

	string entries_to_screens_json(string entries)
		string result = "{"
		string seen = ""
		boolean first = true
		string lines = entries
		integer line_start = 0
		while line_start < lines.length()
			integer line_end = lines.indexOf("\n", line_start)
			if line_end == -1
				line_end = lines.length()
			string line = lines.substring(line_start, line_end).trim()
			if line.length() > 0
				integer eq_pos = line.indexOf("=")
				if eq_pos != -1
					string name = line.substring(0, eq_pos)
					string mode = line.substring(eq_pos + 1, line.length())
					string seen_key = "|" + name + "|"
					if seen.indexOf(seen_key) == -1
						seen = seen + seen_key
						if not first
							result = result + ","
						first = false
						result = result + "\"" + name + "\":\"" + mode + "\""
			line_start = line_end + 1
		result = result + "}"
		return result

// ============================================================================
// ASSEMBLE SUPPORT
// ============================================================================

functions:
	// True when an assemble source-file entry ({"path":..,"content":..}, content
	// JSON-escaped) is a .cln file with a top-level `styles <Name>:` block
	// (frame-ui.ebnf styles_block) — a line that starts with `styles `.
	boolean source_declares_styles(string file_obj)
		string path = extract_json_field(file_obj, "path")
		if path.endsWith(".cln") == false
			return false
		if file_obj.indexOf("\"content\":\"styles ") != -1
			return true
		return file_obj.indexOf("\\nstyles ") != -1

	list<string> parse_source_files(string input_json)
		list<string> result = []
		integer sf_start = input_json.indexOf("\"source_files\"")
		if sf_start == -1
			return result
		integer arr_start = input_json.indexOf("[", sf_start)
		if arr_start == -1
			return result
		integer pos = arr_start + 1
		integer json_len = input_json.length()
		integer outer_safety = 0
		while pos < json_len and outer_safety < 10000
			outer_safety = outer_safety + 1
			integer ch_code = input_json.charCodeAt(pos)
			if ch_code == 32 or ch_code == 10 or ch_code == 13 or ch_code == 9
				pos = pos + 1
			else if ch_code == 93
				break
			else if ch_code == 44
				pos = pos + 1
			else if ch_code == 123
				integer obj_start = pos
				integer depth = 1
				pos = pos + 1
				boolean in_str = false
				boolean escape_next = false
				while pos < json_len and depth > 0
					integer cc = input_json.charCodeAt(pos)
					if escape_next
						escape_next = false
						pos = pos + 1
					else if in_str
						if cc == 92
							escape_next = true
							pos = pos + 1
						else if cc == 34
							in_str = false
							pos = pos + 1
						else
							pos = pos + 1
					else
						if cc == 34
							in_str = true
							pos = pos + 1
						else if cc == 123
							depth = depth + 1
							pos = pos + 1
						else if cc == 125
							depth = depth - 1
							pos = pos + 1
						else
							pos = pos + 1
				string obj = input_json.substring(obj_start, pos)
				result.push(obj)
			else
				pos = pos + 1
		return result

	string derive_module_name(string file_path)
		integer pages_pos = file_path.indexOf("pages/")
		string rel = file_path
		if pages_pos != -1
			rel = file_path.substring(pages_pos + 6, file_path.length())
		integer dot_pos = rel.lastIndexOf(".")
		if dot_pos != -1
			rel = rel.substring(0, dot_pos)
		string name = rel.replace("/", "_").replace("[", "").replace("]", "").replace("-", "_").replace(".", "_")
		return "pages_" + name

	string derive_url_path(string file_path)
		integer pages_pos = file_path.indexOf("pages/")
		string rel = file_path
		if pages_pos != -1
			rel = file_path.substring(pages_pos + 6, file_path.length())
		integer dot_pos = rel.lastIndexOf(".")
		if dot_pos != -1
			rel = rel.substring(0, dot_pos)
		if rel == "index"
			return "/"
		string url = rel.replace("[", ":").replace("]", "")
		if url.endsWith("/index")
			url = url.substring(0, url.length() - 6)
		if url.length() == 0
			return "/"
		return "/" + url

	string derive_html_path(string file_path)
		integer pages_pos = file_path.indexOf("pages/")
		string rel = file_path
		if pages_pos != -1
			rel = file_path.substring(pages_pos + 6, file_path.length())
		if rel.endsWith(".cln")
			rel = rel.substring(0, rel.length() - 4) + ".html"
		return "app/ui/web/pages/" + rel

	string scan_routes_guards(string content, string accumulator)
		string result = accumulator
		integer search_from = 0
		integer outer_safety = 0
		while outer_safety < 50 and search_from < content.length()
			outer_safety = outer_safety + 1
			integer rp = content.indexOf("routes:", search_from)
			if rp == -1
				return result
			boolean at_line_head = false
			if rp == 0
				at_line_head = true
			else
				string prev = content.substring(rp - 1, rp)
				if prev == "\n"
					at_line_head = true
			if not at_line_head
				search_from = rp + 7
			else
				integer body_start = content.indexOf("\n", rp)
				if body_start == -1
					return result
				body_start = body_start + 1
				integer cursor = body_start
				integer inner_safety = 0
				boolean keep_inner = true
				while keep_inner and inner_safety < 200 and cursor < content.length()
					inner_safety = inner_safety + 1
					integer nl = content.indexOf("\n", cursor)
					string line = ""
					integer next_cursor = 0
					if nl == -1
						line = content.substring(cursor, content.length())
						next_cursor = content.length()
					else
						line = content.substring(cursor, nl)
						next_cursor = nl + 1
					cursor = next_cursor
					if line.trim().length() == 0
						inner_safety = inner_safety + 0
					else
						if not line.startsWith("\t")
							keep_inner = false
						else
							string ltrim = line.trim()
							if ltrim.startsWith("guard:")
								string g_after = ltrim.substring(6, ltrim.length()).trim()
								integer gq1 = g_after.indexOf("\"")
								if gq1 != -1
									integer gq2 = g_after.indexOf("\"", gq1 + 1)
									if gq2 != -1
										string g_pattern = g_after.substring(gq1 + 1, gq2)
										string g_rest = g_after.substring(gq2 + 1, g_after.length()).trim()
										integer g_ob = g_rest.indexOf("[")
										integer g_cb = g_rest.indexOf("]")
										if g_ob != -1 and g_cb != -1
											string g_roles = g_rest.substring(g_ob + 1, g_cb).replace(" ", "")
											if g_pattern.length() > 0 and g_roles.length() > 0
												string g_record = g_pattern + "|" + g_roles
												if result.length() == 0
													result = g_record
												else
													result = result + ";" + g_record
				search_from = cursor
		return result

	boolean path_matches_pattern(string path, string pattern)
		string rp = path
		if rp.startsWith("/")
			rp = rp.substring(1, rp.length())
		string rpat = pattern
		if rpat.startsWith("/")
			rpat = rpat.substring(1, rpat.length())
		integer safety = 0
		while safety < 50
			safety = safety + 1
			if rpat.length() == 0
				return rp.length() == 0
			integer p_slash = rpat.indexOf("/")
			string p_seg = ""
			if p_slash == -1
				p_seg = rpat
				rpat = ""
			else
				p_seg = rpat.substring(0, p_slash)
				rpat = rpat.substring(p_slash + 1, rpat.length())
			if p_seg == "**"
				return true
			if rp.length() == 0
				return false
			integer t_slash = rp.indexOf("/")
			string t_seg = ""
			if t_slash == -1
				t_seg = rp
				rp = ""
			else
				t_seg = rp.substring(0, t_slash)
				rp = rp.substring(t_slash + 1, rp.length())
			if p_seg == "*"
				safety = safety + 0
			else
				if p_seg != t_seg
					return false
		return false

	// Collect the paths of `GET "<url>"` / `FEED "<url>"` route declarations
	// from a JSON-escaped .cln source (route lines are tab-indented, so they
	// appear as `\tGET \"/url\"` in the escaped text). Each path is added
	// to the table as "|<normalised url>|".
	string scan_explicit_get_routes(string esc, string table)
		string result = table
		list<string> methods = ["GET", "FEED"]
		integer mi = 0
		while mi < methods.length()
			string needle = "\\t" + methods[mi] + " \\\""
			integer scan_from = 0
			integer safety = 0
			while safety < 1000
				safety = safety + 1
				integer at = esc.indexOf(needle, scan_from)
				if at == -1
					break
				integer p_start = at + needle.length()
				integer p_end = esc.indexOf("\\\"", p_start)
				if p_end == -1
					break
				string norm = normalize_route(esc.substring(p_start, p_end))
				if result.indexOf("|" + norm + "|") == -1
					result = result + norm + "|"
				scan_from = p_end
			mi = mi + 1
		return result

	// Route path with every ":name" segment reduced to ":" so routes that
	// differ only in parameter names compare equal ("/blog/:id" and
	// "/blog/:slug" are the same route to the server router).
	string normalize_route(string url)
		list<string> segs = url.split("/")
		string out = ""
		integer i = 0
		while i < segs.length()
			string seg = segs[i]
			if seg.startsWith(":")
				seg = ":"
			if i > 0
				out = out + "/"
			out = out + seg
			i = i + 1
		if out.length() == 0
			return "/"
		return out

	// One page render function (functions:-block indent): routes-guard role
	// check, the page's own <page auth / roles> checks (UI-B015 / UI-B016),
	// companion guard(request) / load(request), then the page rendered
	// with the load result as its data. The companion receives the current
	// request (frame-ui.ebnf companion_load_fn; frame-ui-semantics UI-C007).
	string page_render_fn(string module_name, string url, string html_path, boolean has_load, boolean has_guard, string guard_table, string page_html)
		string body = ""
		string roles = lookup_routes_guard(url, guard_table)
		if roles.length() > 0
			body = body + emit_routes_guard_check(roles)
		body = body + emit_page_access_check(extract_page_attr(page_html, "auth"), extract_page_attr(page_html, "roles"))
		if has_load or has_guard
			body = body + emit_page_request(url)
		if has_guard
			body = body + "\tany __g = " + module_name + "_guard(__req)\n"
			body = body + "\tif __g != null\n"
			body = body + "\t\treturn __g\n"
		if has_load
			body = body + "\tany __rd = " + module_name + "_load(__req)\n"
			body = body + "\tstring __d = json.encode(__rd)\n"
			body = body + "\treturn _ui_head_links(_ui_render_page(\"" + html_path + "\", __d))\n"
		else
			body = body + "\treturn _ui_head_links(_ui_render_page(\"" + html_path + "\", \"{}\"))\n"
		return "\tstring " + module_name + "_render()\n" + indent_lines(body) + "\n"

	// Statements (function-body indent) that build `__req`, the Request a
	// companion guard()/load() receives: params (one entry per ":name"
	// segment of the page URL), path, method, headers, ip, body and auth
	// (loggedIn, userId, role from the current session).
	string emit_page_request(string url)
		string params = ""
		list<string> segs = url.split("/")
		integer i = 0
		while i < segs.length()
			string seg = segs[i]
			if seg.startsWith(":") and seg.length() > 1
				string pname = seg.substring(1, seg.length())
				if params.length() > 0
					params = params + ", "
				params = params + pname + ": _req_param(\"" + pname + "\")"
			i = i + 1
		string b = ""
		if params.length() > 0
			b = b + "\tany __rp = { " + params + " }\n"
		else
			b = b + "\tany __rp = {}\n"
		b = b + "\tany __rh = json.decode(_req_headers())\n"
		b = b + "\tany __ra = { loggedIn: false, userId: null, role: \"\" }\n"
		b = b + "\tstring __rs = _auth_get_session()\n"
		b = b + "\tif __rs.length() > 0 and __rs != \"null\"\n"
		b = b + "\t\tany __rsd = json.decode(__rs)\n"
		b = b + "\t\t__ra = { loggedIn: true, userId: __rsd.user_id, role: __rsd.role }\n"
		b = b + "\tany __req = { params: __rp, path: _req_path(), method: _req_method(), headers: __rh, ip: _req_ip(), body: _req_body(), auth: __ra }\n"
		return b

	// Decoded content of the project file at rel_path (a path relative to
	// the project, e.g. app/ui/web/pages/a.html); "" when there is none.
	string page_source(list<string> source_files, string rel_path)
		integer i = 0
		while i < source_files.length()
			string f = source_files[i]
			if extract_json_field(f, "path").endsWith(rel_path)
				return decode_json_string(extract_json_field_escaped(f, "content"))
			i = i + 1
		return ""

	// Why a page's <page auth / roles> declaration cannot be compiled, ""
	// when it can (or the page declares neither).
	string page_access_error(string html, boolean has_server)
		string auth = extract_page_attr(html, "auth")
		string roles = extract_page_attr(html, "roles")
		if auth != "" and auth != "required" and auth != "guest" and auth != "none"
			return "<page auth=\"" + auth + "\"> — auth must be required, guest or none (frame-ui-semantics UI-B014)"
		list<string> role_list = roles.split(",")
		integer i = 0
		while i < role_list.length()
			string role = role_list[i].trim()
			if role.length() > 0 and is_plain_identifier(role.replace("-", "_")) == false
				return "<page roles=\"" + roles + "\"> — each role must be a name (letters, digits, _ or -)"
			i = i + 1
		boolean enforced = auth == "required" or auth == "guest" or roles.trim().length() > 0
		if enforced and has_server == false
			return "<page auth / roles> needs frame.server, whose session bridges enforce it before the page is served (frame-ui-semantics UI-B015 / UI-B016); add frame.server to the plugins"
		return ""

	// <page auth / roles> checks at the top of a page's route render function
	// (function-body indent), before the companion guard() / load():
	//   auth="required" — no session: redirect to /login (UI-B015)
	//   auth="guest"    — a session: redirect to / (UI-B015)
	//   roles="a,b"     — the user holds none of the roles: redirect to
	//                     /forbidden (UI-B016)
	string emit_page_access_check(string auth, string roles)
		string b = ""
		if auth == "required"
			b = b + "\tif _auth_require_auth() == 0\n"
			b = b + "\t\treturn redirect(\"/login\")\n"
		if auth == "guest"
			b = b + "\tif _auth_require_auth() == 1\n"
			b = b + "\t\treturn redirect(\"/\")\n"
		string role_checks = ""
		list<string> role_list = roles.split(",")
		integer i = 0
		while i < role_list.length()
			string role = role_list[i].trim()
			if role.length() > 0
				role_checks = role_checks + "\tif _auth_require_role(\"" + role + "\") == 1\n"
				role_checks = role_checks + "\t\t__page_role_ok = true\n"
			i = i + 1
		if role_checks.length() > 0
			b = b + "\tboolean __page_role_ok = false\n" + role_checks
			b = b + "\tif __page_role_ok == false\n"
			b = b + "\t\treturn redirect(\"/forbidden\")\n"
		return b

	string lookup_routes_guard(string url, string table)
		if table.length() == 0
			return ""
		string remaining = table
		integer safety = 0
		while safety < 100 and remaining.length() > 0
			safety = safety + 1
			integer semi = remaining.indexOf(";")
			string record = ""
			if semi == -1
				record = remaining
				remaining = ""
			else
				record = remaining.substring(0, semi)
				remaining = remaining.substring(semi + 1, remaining.length())
			integer pipe = record.indexOf("|")
			if pipe != -1
				string g_pattern = record.substring(0, pipe)
				string g_roles = record.substring(pipe + 1, record.length())
				if path_matches_pattern(url, g_pattern)
					return g_roles
		return ""

	// Role check emitted at the top of a generated route render() body
	// (function-body indent: one tab per line).
	string emit_routes_guard_check(string roles)
		string result = "\tboolean __routes_auth_ok = false\n"
		string mr = roles
		integer safety = 0
		while safety < 20 and mr.length() > 0
			safety = safety + 1
			integer comma = mr.indexOf(",")
			string role = ""
			if comma == -1
				role = mr.trim()
				mr = ""
			else
				role = mr.substring(0, comma).trim()
				mr = mr.substring(comma + 1, mr.length())
			if role.length() > 0
				result = result + "\tif _auth_require_role(\"" + role + "\") == 1\n"
				result = result + "\t\t__routes_auth_ok = true\n"
		result = result + "\tif not __routes_auth_ok\n"
		result = result + "\t\treturn unauthorized()\n"
		return result

// ============================================================================
// CONTRACT 5 PHASE C — lint_project
// ============================================================================
// Emits one cross-file diagnostic that requires whole-project visibility:
//
//   FRAME-UI-C005  warning  Event attribute (onclick="funcName", oninput="...",
//                           etc.) references a bare identifier that is not an
//                           exported function anywhere in the project.
//                           Inline Clean statements (e.g. onclick="doIt() and
//                           count = count + 1") are NOT flagged — only the
//                           single-identifier form.
//
// Reference:
//   foundation/spec/framework/contracts/lint-extension.md §2 (exports.lint),
//   §3 (input/output JSON), §4 (_ast_* accessors), §5 (LINT001-003 model).
//
// Scans `html:` and `component:` block content strings; the compiler exposes
// the raw pre-expansion FrameworkBlock content via _ast_list_blocks.
functions:
	// Read the next quoted string that appears after `after` in `src`,
	// starting the search at `from`. Returns "" if either the opening or
	// closing quote is missing. Mirrors frame.data's lint_next_quoted.
	// NOTE: This function is escape-blind — it stops at the first `"` and
	// does NOT unescape. Use for short attributes (name, file) that never
	// contain quotes. For `content` (which is JSON-escaped and can embed
	// `\"`), use ui_lint_next_quoted_escaped below.
	string ui_lint_next_quoted(string src, string after, integer pos)
		string tail = src.substring(pos, src.length())
		integer at = tail.indexOf(after)
		if at == -1
			return ""
		integer key_end = at + after.length()
		string rest = tail.substring(key_end, tail.length())
		integer end = rest.indexOf("\"")
		if end == -1
			return ""
		return rest.substring(0, end)

	// Read the next JSON-escaped quoted string after `after` in `src`.
	// Handles `\"`, `\\`, `\n`, `\r`, `\t`, and `\uXXXX` escapes. Terminates
	// at the first UNESCAPED `"`. Returns the decoded string.
	// Compiler `_ast_list_blocks` JSON-escapes the block content field, so
	// event attributes like onclick=\"funcName\" round-trip as
	// `onclick=\\\"funcName\\\"` in the raw payload — the escape-blind
	// ui_lint_next_quoted would truncate at the first `\"` and see empty
	// content.
	string ui_lint_next_quoted_escaped(string src, string after)
		integer at = src.indexOf(after)
		if at == -1
			return ""
		integer i = at + after.length()
		integer len = src.length()
		string out = ""
		while i < len
			string ch = src.substring(i, i + 1)
			if ch == "\""
				return out
			if ch == "\\"
				if i + 1 >= len
					return out
				string esc = src.substring(i + 1, i + 2)
				if esc == "\""
					out = out + "\""
					i = i + 2
				else if esc == "\\"
					out = out + "\\"
					i = i + 2
				else if esc == "n"
					out = out + "\n"
					i = i + 2
				else if esc == "r"
					out = out + "\r"
					i = i + 2
				else if esc == "t"
					out = out + "\t"
					i = i + 2
				else if esc == "u" and i + 5 < len
					// \uXXXX — 4 hex digits. Rare in HTML attribute values;
					// pass through as the literal char for the four common
					// ASCII cases. For anything above 0x7F we fall back to
					// leaving the escape sequence intact.
					string hex = src.substring(i + 2, i + 6)
					out = out + "\\u" + hex
					i = i + 6
				else
					out = out + esc
					i = i + 2
			else
				out = out + ch
				i = i + 1
		return out

	// Return the byte offset (in `src`) of the character just after the
	// closing `}` that matches the first `{` at or after position `pos`.
	// Depth-tracking to survive nested attributes:{...} inside a block.
	integer ui_lint_after_next_brace(string src, integer pos)
		integer i = pos
		integer depth = 0
		integer len = src.length()
		while i < len
			string ch = src.substring(i, i + 1)
			if ch == "{"
				depth = depth + 1
			if ch == "}"
				depth = depth - 1
				if depth == 0
					return i + 1
			i = i + 1
		return len

	// list<string>.contains(string) workaround (see frame.data
	// lint_string_in_list — same stdlib bug).
	boolean ui_lint_string_in_list(list<string> haystack, string needle)
		integer i = 0
		while i < haystack.length()
			if haystack.get(i) == needle
				return true
			i = i + 1
		return false

	string ui_lint_push(string buf, boolean first, string entry)
		if first
			return buf + entry
		return buf + "," + entry

	// True if `s` is a legal Clean identifier: starts with letter or
	// underscore, remaining chars letter/digit/underscore. Rejects anything
	// with `(`, `.`, `+`, whitespace — those are the signals that the
	// attribute value is an inline expression, not a bare function reference.
	boolean ui_lint_is_bare_identifier(string s)
		integer len = s.length()
		if len == 0
			return false
		string first = s.substring(0, 1)
		boolean first_ok = false
		if first == "_"
			first_ok = true
		else
			integer fc = first.toInteger()
			// Rough letter check via ranges — cheaper than iterating alphabet.
			// A-Z = 65..90, a-z = 97..122. toInteger on a single-char string
			// returns 0 when not numeric, so use string comparison instead.
			if first >= "A" and first <= "Z"
				first_ok = true
			if first >= "a" and first <= "z"
				first_ok = true
		if not first_ok
			return false
		integer i = 1
		while i < len
			string ch = s.substring(i, i + 1)
			boolean ch_ok = false
			if ch == "_"
				ch_ok = true
			if ch >= "A" and ch <= "Z"
				ch_ok = true
			if ch >= "a" and ch <= "z"
				ch_ok = true
			if ch >= "0" and ch <= "9"
				ch_ok = true
			if not ch_ok
				return false
			i = i + 1
		return true

	// Extract a JSON attribute value from a JSON string, mirroring
	// frame.data's extract_attr (main.cln:2706 in that plugin). frame.ui's
	// pre-existing extract_attr_value is HTML-attribute-shaped (name="value")
	// and cannot read JSON key-value pairs. Handles both string values
	// ("key":"value") and bare values ("key":123).
	string ui_lint_json_attr(string json_str, string key)
		string pattern = "\"" + key + "\":"
		integer pos = json_str.indexOf(pattern)
		if pos == -1
			return ""
		integer val_start = pos + pattern.length()
		while val_start < json_str.length()
			string ch = json_str.substring(val_start, val_start + 1)
			if ch != " " and ch != "\t"
				break
			val_start = val_start + 1
		if val_start >= json_str.length()
			return ""
		string first_ch = json_str.substring(val_start, val_start + 1)
		if first_ch == "\""
			integer val_end = val_start + 1
			while val_end < json_str.length()
				string ch2 = json_str.substring(val_end, val_end + 1)
				if ch2 == "\""
					break
				val_end = val_end + 1
			return json_str.substring(val_start + 1, val_end)
		integer val_end2 = val_start
		while val_end2 < json_str.length()
			string ch3 = json_str.substring(val_end2, val_end2 + 1)
			if ch3 == "," or ch3 == "}" or ch3 == " " or ch3 == "\n"
				break
			val_end2 = val_end2 + 1
		return json_str.substring(val_start, val_end2).trim()

	// Names of event attributes to inspect. Kept in sync with the event list
	// in attr_fragment.
	// Comma-delimited so we can drive the outer loop with indexOf.
	string ui_lint_event_attr_names()
		return "onclick,oninput,onchange,onsubmit,onfocus,onblur,onkeydown,onkeyup,onkeypress,onmouseover,onmouseenter,onmouseleave,onmousedown,onmouseup,onmousemove,oncontextmenu,ondragstart,ondragend,ondragenter,ondragover,ondragleave,ondrop,onpointerdown,onpointermove,onpointerup,onpointercancel,onpointerenter,onpointerleave,onwheel,onscroll"

	// Walk `content` for every occurrence of `<attr>="<val>"`. When val is
	// a bare identifier, append it (once) to `out_names`. Uses a scan
	// cursor so overlapping attributes are all seen.
	list<string> ui_lint_collect_bare_handlers(string content, string attr, list<string> out_names)
		string needle = attr + "=\""
		integer pos = 0
		integer safety = 0
		while safety < 500
			safety = safety + 1
			integer hit = content.indexOf(needle, pos)
			if hit == -1
				return out_names
			integer val_start = hit + needle.length()
			integer val_end = content.indexOf("\"", val_start)
			if val_end == -1
				return out_names
			string raw = content.substring(val_start, val_end).trim()
			if ui_lint_is_bare_identifier(raw)
				boolean already = ui_lint_string_in_list(out_names, raw)
				if not already
					out_names.add(raw)
			pos = val_end + 1
		return out_names

	// Contract 5 §2 entry point. Called once per project by `cln lint`
	// and by `cln check` after typecheck. Returns a JSON array of
	// diagnostic entries per §3.2, or "[]" for a clean run.
	string lint_project(string input_json)
		string handle_str = ui_lint_json_attr(input_json, "project_ast_handle")
		if handle_str.length() == 0
			return "[]"
		integer handle = handle_str.toInteger()

		// ------------------------------------------------------------------
		// Step 1: gather every top-level function name so we can decide
		//         which bare-identifier event values are unresolved.
		//         _ast_list_functions returns [{name, file, line, return_type?}, ...]
		// ------------------------------------------------------------------
		list<string> declared_funcs = []
		string funcs_json = _ast_list_functions(handle)
		integer fscan = 0
		while fscan < funcs_json.length()
			string ftail = funcs_json.substring(fscan, funcs_json.length())
			integer fobj_at = ftail.indexOf("{")
			if fobj_at == -1
				fscan = funcs_json.length()
			else
				integer fobj_start = fscan + fobj_at
				integer fobj_end = ui_lint_after_next_brace(funcs_json, fobj_start)
				string fentry = funcs_json.substring(fobj_start, fobj_end)
				string fname = ui_lint_next_quoted(fentry, "\"name\":\"", 0)
				if fname.length() > 0
					declared_funcs.add(fname)
				fscan = fobj_end

		// ------------------------------------------------------------------
		// Step 2: walk `html:` and `component:` block content strings.
		//         Extract every bare-identifier value from every event
		//         attribute (onclick/oninput/etc.). Emit one diagnostic per
		//         unresolved reference, anchored at the block's first line.
		// ------------------------------------------------------------------
		string diagnostics = "["
		boolean first_out = true
		list<string> block_kinds = ["html", "component", "page"]
		string events = ui_lint_event_attr_names()
		integer bki = 0
		while bki < block_kinds.length()
			string bkind = block_kinds.get(bki)
			string blocks_json = _ast_list_blocks(handle, bkind)
			integer bscan = 0
			while bscan < blocks_json.length()
				string btail = blocks_json.substring(bscan, blocks_json.length())
				integer bobj_at = btail.indexOf("{")
				if bobj_at == -1
					bscan = blocks_json.length()
				else
					integer bobj_start = bscan + bobj_at
					integer bobj_end = ui_lint_after_next_brace(blocks_json, bobj_start)
					string bentry = blocks_json.substring(bobj_start, bobj_end)
					string bfile = ui_lint_next_quoted(bentry, "\"file\":\"", 0)
					string bline_str = ui_lint_json_attr(bentry, "line")
					integer bline = 1
					if bline_str.length() > 0
						bline = bline_str.toInteger()
					string bcontent = ui_lint_next_quoted_escaped(bentry, "\"content\":\"")
					// Gather all bare-handler names from this block.
					list<string> bare_names = []
					integer eidx = 0
					integer esafety = 0
					while esafety < 100
						esafety = esafety + 1
						integer ecomma = events.indexOf(",", eidx)
						string attr = ""
						if ecomma == -1
							attr = events.substring(eidx, events.length())
							esafety = 100
						else
							attr = events.substring(eidx, ecomma)
							eidx = ecomma + 1
						if attr.length() > 0
							bare_names = ui_lint_collect_bare_handlers(bcontent, attr, bare_names)
					// For each bare name, emit UI-C005 if it isn't a
					// declared function.
					integer ni = 0
					while ni < bare_names.length()
						string nm = bare_names.get(ni)
						boolean has_it = ui_lint_string_in_list(declared_funcs, nm)
						if not has_it
							string entry = "{\"code\":\"FRAME-UI-C005\","
							entry = entry + "\"severity\":\"warning\","
							entry = entry + "\"message\":\"Event handler '" + spec_esc_json(nm) + "' is not a declared function in this project.\","
							entry = entry + "\"location\":{\"file\":\"" + spec_esc_json(bfile) + "\",\"line\":" + bline.toString() + ",\"column\":1},"
							entry = entry + "\"hint\":\"Define '" + spec_esc_json(nm) + "()' in a functions: block, or rewrite the attribute as an inline expression.\"}"
							diagnostics = ui_lint_push(diagnostics, first_out, entry)
							first_out = false
						ni = ni + 1
					bscan = bobj_end
			bki = bki + 1

		diagnostics = diagnostics + "]"
		return diagnostics
