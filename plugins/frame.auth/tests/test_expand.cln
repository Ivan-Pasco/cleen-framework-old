// Tests for the frame.auth plugin's config parsing and validation helpers.
// scripts/test-plugins.sh splices src/main.cln between this start: and the
// functions: below, then type-checks the result. The expansion entry point
// (expand_block_typed) calls compiler-provided typed-emission bridges and is
// exercised end to end by tests/framework/unit/plugins/auth/.
// Grammar: frame-auth.ebnf auth_session_block, auth_jwt_block,
//          jwt_secret_field (secret = env.get(...)), login_block

start:
	test_keywords()
	test_subblock_extraction()
	test_config_values()
	test_login_block_validation()
	test_login_clauses()
	test_string_escaping()
	test_jwt_validation()
	test_session_validation()
	test_config_spacing_and_comments()
	test_sections_end_at_any_sibling()
	test_settings_are_checked()

functions:
	void test_keywords()
		string keywords = get_keywords()
		assert(keywords.contains("\"auth\""))
		assert(keywords.contains("\"login\""))
		assert(keywords.contains("\"roles\""))
		assert(keywords.contains("\"csrf\""))

	void test_subblock_extraction()
		string cfg = "\tsession:\n\t\tcookie = \"app.sid\"\n\t\ttimeoutMinutes = 30\n\tjwt:\n\t\tsecret = env.get(\"JWT_SECRET\")\n\t\talg = \"HS512\"\n"
		// A sub-block ends where the next sibling (jwt:, roles:, ...) starts.
		string sess = extract_subblock(cfg, "session:")
		assert(sess.contains("cookie = \"app.sid\""))
		assert(not sess.contains("jwt"))
		string jwt = extract_subblock(cfg, "jwt:")
		assert(jwt.startsWith("secret = env.get("))
		assert(jwt.endsWith("alg = \"HS512\""))
		assert(extract_subblock(cfg, "tenant:") == "")

	void test_config_values()
		string sess = "cookie = \"app.sid\"\n\t\ttimeoutMinutes = 30"
		assert(get_config_value(sess, "cookie", "session") == "app.sid")
		assert(get_config_value(sess, "timeoutMinutes", "60") == "30")
		assert(get_config_value(sess, "sameSite", "Lax") == "Lax")
		// env.get("X") is unwrapped to the variable name X.
		string jwt = "secret = env.get(\"JWT_SECRET\")\n\t\talg = \"HS512\""
		assert(get_config_value(jwt, "secret", "") == "JWT_SECRET")
		assert(get_config_value(jwt, "alg", "HS256") == "HS512")

	void test_login_block_validation()
		// frame-auth.ebnf login_block: password, hash and userId are required.
		string ok_body = "password = form.password\nhash = stored  // \"\" when unknown\nuserId = u.id\n"
		assert(validate_block("login", "", ok_body) == "")
		assert(validate_block("login", "", ok_body + "claims = \"\{\}\"\nissue = \"jwt\"\n") == "")
		assert(validate_block("login", "", "password = p\nhash = h\n").contains("login: missing userId"))
		assert(validate_block("login", "", "string p = \"x\"\n").contains("missing password hash userId"))
		assert(validate_block("login", "", ok_body + "password = other\n").contains("password is set more than once"))
		assert(validate_block("login", "", ok_body + "issue = \"oauth\"\n").contains("issue must be \"session\" or \"jwt\""))
		assert(validate_block("login", "", ok_body + "claims = a +\n\tb\n").contains("the value of claims must be on one line"))
		assert(validate_block("login", "", ok_body + "claims =   // nothing\n").contains("claims has no value"))

	void test_login_clauses()
		// A field is `name = value`; `name == value` and other names are statements.
		assert(login_field_name("password = x") == "password")
		assert(login_field_name("userId=1") == "userId")
		assert(login_field_name("hash == x") == "")
		assert(login_field_name("hashed = x") == "")
		assert(login_field_name("string password = x") == "")
		// A statement clause runs to the last line indented under it.
		string body = "if u == null\n\treturn \"\"\n\n// note\nhash = h\n"
		assert(login_clause_end(body, 0, 0) == body.indexOf("\n\n"))
		assert(login_base_indent("\t\tpassword = p\n\t\t\tx\n") == 2)
		// The value of a field is the line after `=` without its comment.
		string line = "claims = \"\{\}\"   // none\n"
		assert(line.substring(login_value_start(line, 0), login_value_end(line, 0)) == "\"\{\}\"")

	void test_string_escaping()
		assert(escape_string_literal("a\"b\\c") == "a\\\"b\\\\c")
		assert(escape_string_literal("plain") == "plain")

	void test_jwt_validation()
		assert(validate_block("auth", "{}", "\tjwt:\n\t\tsecret = env.get(\"JWT_SECRET\")\n") == "")
		assert(validate_block("auth", "{}", "\tjwt:\n\t\tsecret = \"hardcoded\"\n").contains("must reference an environment variable"))
		assert(validate_block("auth", "{}", "\tjwt:\n\t\talg = \"HS256\"\n").contains("secret is required"))
		assert(validate_block("auth", "{}", "\tjwt:\n\t\tenabled = false\n") == "")
		// Only the auth: block has plugin-side validation.
		assert(validate_block("roles", "{}", "\tadmin: [\"*\"]\n") == "")

	void test_session_validation()
		assert(validate_block("auth", "{}", "\tsession:\n\t\tsameSite = \"None\"\n").contains("requires secure=true"))
		assert(validate_block("auth", "{}", "\tsession:\n\t\tsameSite = \"None\"\n\t\tsecure = true\n") == "")
		assert(validate_block("auth", "{}", "\tsession:\n\t\tsameSite = \"Lax\"\n") == "")

	void test_config_spacing_and_comments()
		// Any spacing around `=`; a trailing comment is not part of the value.
		string sess = "secure=false\nhttpOnly =  true   // inaccessible to JS\ncookie= \"a//b\"\ntimeoutMinutes = 480  // 8 hours"
		assert(get_config_value(sess, "secure", "true") == "false")
		assert(get_config_value(strip_comment("httpOnly =  true   // inaccessible to JS").trim(), "httpOnly", "") == "true")
		// extract_subblock strips comments; a `//` inside a string stays.
		string cfg = "\tsession:\n\t\tsecure=false\n\t\tcookie= \"a//b\"\n\t\ttimeoutMinutes = 480  // 8 hours\n"
		string block = extract_subblock(cfg, "session:")
		assert(get_config_value(block, "secure", "true") == "false")
		assert(get_config_value(block, "cookie", "") == "a//b")
		assert(get_config_value(block, "timeoutMinutes", "60") == "480")
		// A key does not match a longer key that starts with it.
		assert(get_config_value("secureCookie = false", "secure", "true") == "true")
		// domain? = null (frame-auth.ebnf session_domain_field)
		assert(get_config_value("domain? = null", "domain", "") == "null")
		assert(get_config_value("domain = \"example.com\"", "domain", "") == "example.com")

	void test_sections_end_at_any_sibling()
		string cfg = "\tsession:\n\t\tcookie = \"app.sid\"\n\tcsrf:\n\t\tenabled = false\n\tjwt:\n\t\tsecret = env.get(\"S\")\n\t\tenabled = false\n"
		string sess = extract_subblock(cfg, "session:")
		assert(sess == "cookie = \"app.sid\"")
		assert(extract_subblock(cfg, "csrf:") == "enabled = false")
		string jwt = extract_subblock(cfg, "jwt:")
		assert(get_config_value(jwt, "enabled", "true") == "false")
		// The session section does not pick up csrf:'s `enabled`.
		assert(get_config_value(sess, "enabled", "none") == "none")

	void test_settings_are_checked()
		// AUTH-S005: httpOnly cannot be turned off.
		assert(validate_block("auth", "{}", "\tsession:\n\t\thttpOnly = false\n").contains("httpOnly = false is not allowed"))
		assert(validate_block("auth", "{}", "\tsession:\n\t\thttpOnly = true\n\t\tdomain = \"example.com\"\n") == "")
		// `key: value` is not the setting syntax.
		assert(validate_block("auth", "{}", "\tsession:\n\t\tcookie: \"x\"\n").contains("write `key = value`"))
		assert(validate_block("auth", "{}", "\tsession:\n\t\tcokie = \"x\"\n").contains("unknown setting `cokie`"))
		assert(validate_block("auth", "{}", "\tsession:\n\t\tsecure = yes\n").contains("must be true or false"))
		assert(validate_block("auth", "{}", "\tsession:\n\t\ttimeoutMinutes = 1h\n").contains("whole number"))
		assert(validate_block("auth", "{}", "\tsession:\n\t\tsameSite = \"Loose\"\n").contains("sameSite must be"))
		assert(validate_block("auth", "{}", "\tsession:\n\t\tstore = \"redis\"\n").contains("store is not supported"))
		assert(validate_block("auth", "{}", "\tcsrf:\n\t\tenabled = maybe\n").contains("must be true or false"))
		assert(validate_block("auth", "{}", "\ttenant:\n\t\theader = \"X-Tenant\"\n").contains("header is not supported"))
		assert(validate_block("auth", "{}", "\ttenant:\n\t\tfield = \"orgId\"\n") == "")
		assert(validate_block("auth", "{}", "\tcookie = \"x\"\n").contains("unexpected line"))
		// A fully commented setting line is fine.
		assert(validate_block("auth", "{}", "\tsession:\n\t\t// cookie = \"x\"\n\t\tcookie = \"y\"   // name\n") == "")
		assert(validate_block("auth", "{}", "\tjwt:\n\t\tenabled = false\n\t\tsecret = \"plain\"\n").contains("must reference an environment variable"))
