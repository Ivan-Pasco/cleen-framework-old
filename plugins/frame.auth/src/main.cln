// frame.auth plugin - Authentication and Authorization DSL
// Provides: auth config, session handling, JWT, roles/permissions, CSRF
// Version: 2.4.5
// ABI: Plugin Contracts v3 — typed AST emission (typed-emission.md)

// ============================================================================
// TYPED EMISSION BRIDGE DECLARATIONS (Plugin Contracts v3)
// ============================================================================
// foundation/spec/plugins/contracts/typed-emission.md §2.3, §3, §5, §3.14
//
// Underscore aliases required: Clean Language external: rejects dots in names.
// Aliases registered by batch_builders.rs register_underscore_aliases.
// These are env imports from the compiler typed-emission sandbox only.
// They MUST NOT appear in plugin.toml [bridge].functions.

external:
	// Array helpers (§3.14)
	integer _batch_arrayNew(integer ctx)
	integer _batch_arrayPush(integer ctx, integer array_handle, integer item_handle)
	// Expression builders (§3.14)
	integer _batch_stringLit(integer ctx, string value)
	integer _batch_boolLit(integer ctx, integer value)
	integer _batch_ident(integer ctx, string name)
	integer _batch_intLit(integer ctx, integer value_lo, integer value_hi)
	integer _batch_call(integer ctx, string callee, integer args_array_handle)
	integer _batch_binop(integer ctx, string op, integer lhs_handle, integer rhs_handle)
	// Statement builders (§3.14)
	integer _batch_stmtAssign(integer ctx, string target, integer expr_handle)
	// Real let-declaration; required for the first introduction of a local
	// in a function body (stmtAssign only reassigns a declared variable).
	integer _batch_stmtVarDecl(integer ctx, string name, string type_lp, integer expr_handle_or_0)
	integer _batch_stmtIf(integer ctx, integer cond_handle, integer then_array_handle, integer else_array_handle)
	integer _batch_stmtReturn(integer ctx, integer expr_handle)
	integer _batch_stmtCall(integer ctx, string callee, integer args_array_handle)
	// Function and terminal builders (§3.14)
	integer _batch_param(integer ctx, string name, string type_name)
	integer _batch_func(integer ctx, string name, integer params_array_handle, string return_type, integer body_array_handle)
	// Amendment 12 (§3.14) — sibling of batch.func with a from_source path.
	// Exactly one of body_array_handle_or_0 / from_source_handle_or_0 must
	// be non-zero. Use this when the body was built via _emit_stmt_from_source
	// (§3.11), which returns a plain arena stmt handle (no BATCH_TAG) that
	// cannot be pushed into a batch array. Contract from compiler prompt
	// ad41f1b4-7bbd-11f1.
	integer _batch_func2(integer ctx, string name, integer params_array_handle, string return_type, integer body_array_handle_or_0, integer from_source_handle_or_0)
	integer _batch_spec(integer ctx, integer functions_array_handle)
	// Declaration emitters (§3.12, §3.5)
	integer _emit_helpers_batch(integer ctx, integer spec_handle_or_lp, integer flags)
	integer _emit_statement_into_start(integer ctx, integer stmt_handle)
	integer _emit_state_block(integer ctx, string fields_json)
	integer _ctx_had_error(integer ctx)
	// Type and expression handles for state declarations (§2.3, §3.4)
	integer _type_string(integer ctx)
	integer _type_integer(integer ctx)
	integer _type_boolean(integer ctx)
	integer _expr_string_lit(integer ctx, string value)
	integer _expr_int_lit(integer ctx, integer value_lo, integer value_hi)
	integer _expr_bool_lit(integer ctx, integer value)
	integer _expr_call(integer ctx, string callee, string args_json)
	// Amendment 11 (§3.11) — source-string statement emission. Used to build
	// helper bodies that need `.method()` calls or `+` operator machinery which
	// the batch expression builder cannot express directly.
	integer _emit_stmt_from_source(integer ctx, string source, integer origin_offset)
	// Amendment 6 (§3.16) — expression mirror of §3.11, for the user-authored
	// login: field values.
	integer _emit_expr_from_source(integer ctx, string source, integer origin_offset)
	// Diagnostics (§5)
	integer _emit_error(integer ctx, integer severity, string code, string message, string span)
	// Build-state keystore (lifecycle.md §2.5)
	string _build_state_get(string key)
	void _build_state_set(string key, string value)

// ============================================================================
// V3 BLOCK EXPAND ENTRY POINT
// ============================================================================

functions:
	integer expand_block_typed(integer ctx, string block_name, string attrs_json, string body)
		if block_name == "auth"
			return expand_auth_config_typed(ctx, body)
		if block_name == "login"
			return expand_login_typed(ctx, attrs_json, body)
		if block_name == "roles"
			return expand_roles_typed(ctx, body)
		return 0

// ============================================================================
// KEYWORD DISCOVERY AND VALIDATION EXPORTS
// ============================================================================

functions:
	string get_keywords()
		return "[\"auth\", \"login\", \"roles\", \"jwt\", \"session\", \"cookie\", \"sameSite\", \"secure\", \"httpOnly\", \"timeoutMinutes\", \"secret\", \"alg\", \"ttlMinutes\", \"refreshTtlMinutes\", \"csrf\", \"tenant\", \"tenantId\"]"

	string validate_block(string block_name, string attributes, string body)
		if block_name == "auth"
			return validate_auth_config(body)
		if block_name == "login"
			return check_login_body(body)
		return ""

// ============================================================================
// AUTH CONFIG EXPANSION (TYPED)
// ============================================================================

functions:
	integer expand_auth_config_typed(integer ctx, string body)
		// ── Session config defaults ──
		// validate_block (validate_auth_config) has already rejected
		// malformed lines, unknown keys and httpOnly = false (AUTH-S005).
		string session_config = extract_subblock(body, "session:")
		string cookie_name = get_config_value(session_config, "cookie", "frame.sid")
		string same_site = get_config_value(session_config, "sameSite", "Lax")
		boolean sess_secure = get_config_value(session_config, "secure", "true") == "true"
		string session_path = get_config_value(session_config, "path", "/")
		// AUTH-S010: no domain (null) scopes the cookie to the exact host.
		string session_domain = get_config_value(session_config, "domain", "")
		if session_domain == "null"
			session_domain = ""
		integer timeout_mins = get_config_value(session_config, "timeoutMinutes", "60").toInteger()

		// ── JWT config defaults ──
		string jwt_config = extract_subblock(body, "jwt:")
		boolean jwt_enabled = get_config_value(jwt_config, "enabled", "true") == "true"
		string secret_env = get_config_value(jwt_config, "secret", "JWT_SECRET")
		string alg = get_config_value(jwt_config, "alg", "HS256")
		integer jwt_ttl_mins = get_config_value(jwt_config, "ttlMinutes", "60").toInteger()
		integer jwt_refresh_mins = get_config_value(jwt_config, "refreshTtlMinutes", "43200").toInteger()

		// ── CSRF config (enabled by default) ──
		boolean csrf_on = get_config_value(extract_subblock(body, "csrf:"), "enabled", "true") == "true"

		// ── Tenant config: the session claim holding the tenant id ──
		string tenant_field = get_config_value(extract_subblock(body, "tenant:"), "field", "tenantId")

		// ── Auth configuration as module state (one state: block per expansion) ──
		string fields = string_var_field(ctx, "__session_cookie", cookie_name)
		fields = fields + "," + string_var_field(ctx, "__session_same_site", same_site)
		fields = fields + "," + bool_var_field(ctx, "__session_secure", sess_secure)
		fields = fields + "," + string_var_field(ctx, "__session_path", session_path)
		fields = fields + "," + string_var_field(ctx, "__session_domain", session_domain)
		fields = fields + "," + int_var_field(ctx, "__session_timeout", timeout_mins)
		fields = fields + "," + bool_var_field(ctx, "__jwt_enabled", jwt_enabled)
		fields = fields + "," + env_var_field(ctx, "__jwt_secret", secret_env)
		fields = fields + "," + string_var_field(ctx, "__jwt_alg", alg)
		fields = fields + "," + int_var_field(ctx, "__jwt_ttl", jwt_ttl_mins)
		fields = fields + "," + int_var_field(ctx, "__jwt_refresh_ttl", jwt_refresh_mins)
		fields = fields + "," + bool_var_field(ctx, "__csrf_enabled", csrf_on)
		fields = fields + "," + string_var_field(ctx, "__tenant_field", tenant_field)
		if _ctx_had_error(ctx) != 0
			return plugin_error(ctx, "FRAME-AUTH-E001", "auth config: building state fields failed")
		integer err = _emit_state_block(ctx, "[" + fields + "]")
		if err != 0
			return plugin_error(ctx, "FRAME-AUTH-E001", "auth config: _emit_state_block failed")

		// ── Expand roles sub-block if present ──
		string roles_config = extract_subblock(body, "roles:")
		if roles_config.length() > 0
			err = expand_roles_typed(ctx, roles_config)
			if err != 0
				return err

		return emit_auth_helpers_batch(ctx)

// ============================================================================
// CONFIG-VAR ASSIGNMENT HELPERS
// ============================================================================

functions:
	// Auth configuration lives in module state so the emitted helper
	// functions (session_get, jwt_sign, ...) can read it: a start-scope
	// assignment would only create a local of the start function. Each
	// helper returns one field of the `_emit_state_block` JSON array.
	string state_field(string varname, integer type_handle, integer default_expr)
		return "{\"name\":\"" + varname + "\",\"type_handle\":" + type_handle.toString() + ",\"default_expr_handle\":" + default_expr.toString() + "}"

	string string_var_field(integer ctx, string varname, string value)
		return state_field(varname, _type_string(ctx), _expr_string_lit(ctx, value))

	string bool_var_field(integer ctx, string varname, boolean value)
		integer bit = 0
		if value
			bit = 1
		return state_field(varname, _type_boolean(ctx), _expr_bool_lit(ctx, bit))

	string int_var_field(integer ctx, string varname, integer value)
		return state_field(varname, _type_integer(ctx), _expr_int_lit(ctx, value, 0))

	// The secret is read from the environment when the program starts.
	string env_var_field(integer ctx, string varname, string env_var_name)
		integer env_name_expr = _expr_string_lit(ctx, env_var_name)
		integer call_expr = _expr_call(ctx, "_env_get", "[" + env_name_expr.toString() + "]")
		return state_field(varname, _type_string(ctx), call_expr)

	integer plugin_error(integer ctx, string code, string message)
		_emit_error(ctx, 2, code, message, "{\"start\":0,\"end\":0,\"source\":\"plugin\"}")
		return 1

// ============================================================================
// AUTH HELPER BATCH EMISSION
// ============================================================================

functions:
	integer emit_auth_helpers_batch(integer ctx)
		integer fns_arr = _batch_arrayNew(ctx)
		if fns_arr == 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "emit_auth_helpers_batch: arrayNew failed")

		integer fn_h = 0
		integer err = 0

		fn_h = build_session_create(ctx)
		if fn_h == 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "build_session_create failed")
		err = _batch_arrayPush(ctx, fns_arr, fn_h)
		if err != 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "arrayPush session_create failed")

		fn_h = build_session_set_cookie(ctx)
		if fn_h == 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "build_session_set_cookie failed")
		err = _batch_arrayPush(ctx, fns_arr, fn_h)
		if err != 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "arrayPush session_setCookie failed")

		fn_h = build_session_get(ctx)
		if fn_h == 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "build_session_get failed")
		err = _batch_arrayPush(ctx, fns_arr, fn_h)
		if err != 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "arrayPush session_get failed")

		fn_h = build_session_destroy(ctx)
		if fn_h == 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "build_session_destroy failed")
		err = _batch_arrayPush(ctx, fns_arr, fn_h)
		if err != 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "arrayPush session_destroy failed")

		fn_h = build_jwt_sign(ctx)
		if fn_h == 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "build_jwt_sign failed")
		err = _batch_arrayPush(ctx, fns_arr, fn_h)
		if err != 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "arrayPush jwt_sign failed")

		fn_h = build_jwt_verify(ctx)
		if fn_h == 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "build_jwt_verify failed")
		err = _batch_arrayPush(ctx, fns_arr, fn_h)
		if err != 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "arrayPush jwt_verify failed")

		fn_h = build_jwt_refresh(ctx)
		if fn_h == 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "build_jwt_refresh failed")
		err = _batch_arrayPush(ctx, fns_arr, fn_h)
		if err != 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "arrayPush jwt_refresh failed")

		// Internal helpers used by session_create / session_setCookie /
		// session_destroy (string assembly runs in the generated program).
		fn_h = build_session_json_helper(ctx)
		if fn_h == 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "build_session_json_helper failed")
		err = _batch_arrayPush(ctx, fns_arr, fn_h)
		if err != 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "arrayPush __auth_build_session_json failed")

		fn_h = build_cookie_header_helper(ctx)
		if fn_h == 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "build_cookie_header_helper failed")
		err = _batch_arrayPush(ctx, fns_arr, fn_h)
		if err != 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "arrayPush __auth_build_cookie_header failed")

		fn_h = build_expire_cookie_header_helper(ctx)
		if fn_h == 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "build_expire_cookie_header_helper failed")
		err = _batch_arrayPush(ctx, fns_arr, fn_h)
		if err != 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "arrayPush __auth_build_expire_cookie_header failed")

		fn_h = build_jwt_issue_helper(ctx)
		if fn_h == 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "build_jwt_issue_helper failed")
		err = _batch_arrayPush(ctx, fns_arr, fn_h)
		if err != 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "arrayPush __auth_jwt_issue failed")

		fn_h = build_refresh_cookie_header_helper(ctx)
		if fn_h == 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "build_refresh_cookie_header_helper failed")
		err = _batch_arrayPush(ctx, fns_arr, fn_h)
		if err != 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "arrayPush __auth_build_refresh_cookie_header failed")

		// Internal helper used by __auth_jwt_issue (builds payload JSON).
		fn_h = build_jwt_build_payload_helper(ctx)
		if fn_h == 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "build_jwt_build_payload_helper failed")
		err = _batch_arrayPush(ctx, fns_arr, fn_h)
		if err != 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "arrayPush __auth_build_jwt_payload failed")

		fn_h = build_hash_password(ctx)
		if fn_h == 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "build_hash_password failed")
		err = _batch_arrayPush(ctx, fns_arr, fn_h)
		if err != 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "arrayPush hashPassword failed")

		fn_h = build_verify_password(ctx)
		if fn_h == 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "build_verify_password failed")
		err = _batch_arrayPush(ctx, fns_arr, fn_h)
		if err != 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "arrayPush verifyPassword failed")

		fn_h = build_can(ctx)
		if fn_h == 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "build_can failed")
		err = _batch_arrayPush(ctx, fns_arr, fn_h)
		if err != 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "arrayPush can failed")

		fn_h = build_has_role(ctx)
		if fn_h == 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "build_has_role failed")
		err = _batch_arrayPush(ctx, fns_arr, fn_h)
		if err != 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "arrayPush hasRole failed")

		fn_h = build_get_current_user(ctx)
		if fn_h == 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "build_get_current_user failed")
		err = _batch_arrayPush(ctx, fns_arr, fn_h)
		if err != 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "arrayPush getCurrentUser failed")

		fn_h = build_is_authenticated(ctx)
		if fn_h == 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "build_is_authenticated failed")
		err = _batch_arrayPush(ctx, fns_arr, fn_h)
		if err != 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "arrayPush isAuthenticated failed")

		fn_h = build_csrf_generate(ctx)
		if fn_h == 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "build_csrf_generate failed")
		err = _batch_arrayPush(ctx, fns_arr, fn_h)
		if err != 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "arrayPush csrf_generate failed")

		fn_h = build_csrf_validate(ctx)
		if fn_h == 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "build_csrf_validate failed")
		err = _batch_arrayPush(ctx, fns_arr, fn_h)
		if err != 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "arrayPush csrf_validate failed")

		fn_h = build_csrf_enabled_helper(ctx)
		if fn_h == 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "build_csrf_enabled_helper failed")
		err = _batch_arrayPush(ctx, fns_arr, fn_h)
		if err != 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "arrayPush __auth_csrf_enabled failed")

		fn_h = build_tenant_get_id(ctx)
		if fn_h == 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "build_tenant_get_id failed")
		err = _batch_arrayPush(ctx, fns_arr, fn_h)
		if err != 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "arrayPush tenant_getId failed")

		fn_h = build_tenant_require(ctx)
		if fn_h == 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "build_tenant_require failed")
		err = _batch_arrayPush(ctx, fns_arr, fn_h)
		if err != 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "arrayPush tenant_require failed")

		fn_h = build_tenant_matches(ctx)
		if fn_h == 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "build_tenant_matches failed")
		err = _batch_arrayPush(ctx, fns_arr, fn_h)
		if err != 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "arrayPush tenant_matches failed")

		integer spec_h = _batch_spec(ctx, fns_arr)
		if spec_h == 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "emit_auth_helpers_batch: _batch_spec failed")
		integer emit_err = _emit_helpers_batch(ctx, spec_h, 0)
		if emit_err != 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "emit_auth_helpers_batch: _emit_helpers_batch failed")
		return 0

// ============================================================================
// SHARED BUILDER UTILITIES
// ============================================================================

functions:
	// Build an array containing two params
	integer two_params(integer ctx, string p1name, string p1type, string p2name, string p2type)
		integer arr = _batch_arrayNew(ctx)
		if arr == 0
			return 0
		integer p1 = _batch_param(ctx, p1name, p1type)
		if p1 == 0
			return 0
		integer push1 = _batch_arrayPush(ctx, arr, p1)
		if push1 != 0
			return 0
		integer p2 = _batch_param(ctx, p2name, p2type)
		if p2 == 0
			return 0
		integer push2 = _batch_arrayPush(ctx, arr, p2)
		if push2 != 0
			return 0
		return arr

	// Build a one-param array
	integer one_param(integer ctx, string pname, string ptype)
		integer arr = _batch_arrayNew(ctx)
		if arr == 0
			return 0
		integer p = _batch_param(ctx, pname, ptype)
		if p == 0
			return 0
		integer push_err = _batch_arrayPush(ctx, arr, p)
		if push_err != 0
			return 0
		return arr

	// Build an empty param array
	integer no_params(integer ctx)
		return _batch_arrayNew(ctx)

	// Build a call-expression with one integer-literal argument
	integer call1_int(integer ctx, string callee, integer arg_val)
		integer arg_e = _batch_intLit(ctx, arg_val, 0)
		if arg_e == 0
			return 0
		integer args = _batch_arrayNew(ctx)
		if args == 0
			return 0
		integer push_err = _batch_arrayPush(ctx, args, arg_e)
		if push_err != 0
			return 0
		return _batch_call(ctx, callee, args)

	// Build a call-expression with one ident argument
	integer call1_ident(integer ctx, string callee, string arg_name)
		integer arg_e = _batch_ident(ctx, arg_name)
		if arg_e == 0
			return 0
		integer args = _batch_arrayNew(ctx)
		if args == 0
			return 0
		integer push_err = _batch_arrayPush(ctx, args, arg_e)
		if push_err != 0
			return 0
		return _batch_call(ctx, callee, args)

	// Build a call-expression with no arguments
	integer call0(integer ctx, string callee)
		integer args = _batch_arrayNew(ctx)
		if args == 0
			return 0
		return _batch_call(ctx, callee, args)

	// Build a call-expression with two ident arguments
	integer call2_idents(integer ctx, string callee, string a1, string a2)
		integer e1 = _batch_ident(ctx, a1)
		if e1 == 0
			return 0
		integer e2 = _batch_ident(ctx, a2)
		if e2 == 0
			return 0
		integer args = _batch_arrayNew(ctx)
		if args == 0
			return 0
		integer push1 = _batch_arrayPush(ctx, args, e1)
		if push1 != 0
			return 0
		integer push2 = _batch_arrayPush(ctx, args, e2)
		if push2 != 0
			return 0
		return _batch_call(ctx, callee, args)

	// Build a call-expression: callee(ident, str_lit)
	integer call2_ident_str(integer ctx, string callee, string ident_name, string str_val)
		integer e1 = _batch_ident(ctx, ident_name)
		if e1 == 0
			return 0
		integer e2 = _batch_stringLit(ctx, str_val)
		if e2 == 0
			return 0
		integer args = _batch_arrayNew(ctx)
		if args == 0
			return 0
		integer push1 = _batch_arrayPush(ctx, args, e1)
		if push1 != 0
			return 0
		integer push2 = _batch_arrayPush(ctx, args, e2)
		if push2 != 0
			return 0
		return _batch_call(ctx, callee, args)

	// stmtReturn an ident
	integer ret_ident(integer ctx, string name)
		integer e = _batch_ident(ctx, name)
		if e == 0
			return 0
		return _batch_stmtReturn(ctx, e)

	// stmtReturn a bool literal
	integer ret_bool(integer ctx, boolean value)
		integer bit = 0
		if value
			bit = 1
		integer e = _batch_boolLit(ctx, bit)
		if e == 0
			return 0
		return _batch_stmtReturn(ctx, e)

	// stmtReturn empty string literal
	integer ret_empty_str(integer ctx)
		integer e = _batch_stringLit(ctx, "")
		if e == 0
			return 0
		return _batch_stmtReturn(ctx, e)

	// stmtIf with empty else (else_array_handle = 0): if cond { stmts }
	integer if_no_else(integer ctx, integer cond_h, integer then_arr)
		return _batch_stmtIf(ctx, cond_h, then_arr, 0)

	// Equality binop: lhs == rhs (both idents)
	integer eq_idents(integer ctx, string lhs, string rhs)
		integer l = _batch_ident(ctx, lhs)
		if l == 0
			return 0
		integer r = _batch_ident(ctx, rhs)
		if r == 0
			return 0
		return _batch_binop(ctx, "==", l, r)

	// Equality: ident == string_lit
	integer eq_ident_str(integer ctx, string ident_name, string str_val)
		integer l = _batch_ident(ctx, ident_name)
		if l == 0
			return 0
		integer r = _batch_stringLit(ctx, str_val)
		if r == 0
			return 0
		return _batch_binop(ctx, "==", l, r)

	// Not-equal: ident != string_lit
	integer ne_ident_str(integer ctx, string ident_name, string str_val)
		integer l = _batch_ident(ctx, ident_name)
		if l == 0
			return 0
		integer r = _batch_stringLit(ctx, str_val)
		if r == 0
			return 0
		return _batch_binop(ctx, "!=", l, r)

	// Add: expr + expr (both already built handles)
	integer add_exprs(integer ctx, integer lhs_h, integer rhs_h)
		return _batch_binop(ctx, "+", lhs_h, rhs_h)

	// Logical AND: lhs and rhs (both already built handles). The operator
	// table in typed-emission.md uses the Clean spelling `and`.
	integer and_exprs(integer ctx, integer lhs_h, integer rhs_h)
		return _batch_binop(ctx, "and", lhs_h, rhs_h)

	// Build a one-stmt body array
	integer body1(integer ctx, integer s1)
		integer arr = _batch_arrayNew(ctx)
		if arr == 0
			return 0
		integer push_err = _batch_arrayPush(ctx, arr, s1)
		if push_err != 0
			return 0
		return arr

// ============================================================================
// PER-HELPER FACTORY FUNCTIONS
// ============================================================================

functions:
	// 1. session_create(userId: integer, claims: string) -> string
	// Stores {"userId":..,"claims":..} under a new random session id. The
	// blob has no expiry: timeoutMinutes is an inactivity timeout (AUTH-S008)
	// that the host session store enforces from the last request that used
	// the session, not from creation.
	integer build_session_create(integer ctx)
		string src = "string sessionId = _crypto_random_hex(32)\n"
		src = src + "string sessionData = __auth_build_session_json(userId, claims)\n"
		src = src + "_session_store(sessionId, \"\", sessionData, 0, 0)\n"
		src = src + "if __csrf_enabled\n\t_session_set_csrf(_crypto_random_hex(32))\n"
		src = src + "return sessionId\n"
		return source_helper(ctx, "session_create", "userId:integer,claims:string", "string", src)

	// 2. session_setCookie(sessionId: string, response: string) -> string
	integer build_session_set_cookie(integer ctx)
		integer params = two_params(ctx, "sessionId", "string", "response", "string")
		if params == 0
			return 0

		integer body_arr = _batch_arrayNew(ctx)
		if body_arr == 0
			return 0

		// Delegates to a generated helper __auth_build_cookie_header that encapsulates
		// the string-concat logic (same pattern as session_create's sessionData).
		// string cookie = __auth_build_cookie_header(sessionId)
		integer bch_e = call1_ident(ctx, "__auth_build_cookie_header", "sessionId")
		if bch_e == 0
			return 0
		integer s1 = _batch_stmtVarDecl(ctx, "cookie", "string", bch_e)
		if s1 == 0
			return 0
		integer p1 = _batch_arrayPush(ctx, body_arr, s1)
		if p1 != 0
			return 0

		// _http_set_header("Set-Cookie", cookie)
		integer hdr_name = _batch_stringLit(ctx, "Set-Cookie")
		if hdr_name == 0
			return 0
		integer hdr_val = _batch_ident(ctx, "cookie")
		if hdr_val == 0
			return 0
		integer hdr_args = _batch_arrayNew(ctx)
		if hdr_args == 0
			return 0
		integer hp1 = _batch_arrayPush(ctx, hdr_args, hdr_name)
		if hp1 != 0
			return 0
		integer hp2 = _batch_arrayPush(ctx, hdr_args, hdr_val)
		if hp2 != 0
			return 0
		integer hdr_stmt = _batch_stmtCall(ctx, "_http_set_header", hdr_args)
		if hdr_stmt == 0
			return 0
		integer p2 = _batch_arrayPush(ctx, body_arr, hdr_stmt)
		if p2 != 0
			return 0

		// return response
		integer ret_s = ret_ident(ctx, "response")
		if ret_s == 0
			return 0
		integer p3 = _batch_arrayPush(ctx, body_arr, ret_s)
		if p3 != 0
			return 0

		return _batch_func(ctx, "session_setCookie", params, "string", body_arr)

	// 3. session_get() -> string — the current session's data, "" without
	// one. The host resolves the session (one created earlier in this
	// request, or the request cookie) and drops sessions idle for longer
	// than timeoutMinutes.
	integer build_session_get(integer ctx)
		return source_helper(ctx, "session_get", "", "string", "return _session_get()\n")

	// 4. session_destroy() -> boolean
	integer build_session_destroy(integer ctx)
		integer params = no_params(ctx)
		if params == 0
			return 0

		integer body_arr = _batch_arrayNew(ctx)
		if body_arr == 0
			return 0

		// string sessionId = _req_cookie(__session_cookie)
		integer rc_e = call1_ident(ctx, "_req_cookie", "__session_cookie")
		if rc_e == 0
			return 0
		integer s1 = _batch_stmtVarDecl(ctx, "sessionId", "string", rc_e)
		if s1 == 0
			return 0
		integer p1 = _batch_arrayPush(ctx, body_arr, s1)
		if p1 != 0
			return 0

		// if sessionId != "" { _session_delete() }
		integer cond1 = ne_ident_str(ctx, "sessionId", "")
		if cond1 == 0
			return 0
		integer del_args = _batch_arrayNew(ctx)
		if del_args == 0
			return 0
		integer del_stmt = _batch_stmtCall(ctx, "_session_delete", del_args)
		if del_stmt == 0
			return 0
		integer del_then = body1(ctx, del_stmt)
		if del_then == 0
			return 0
		integer if1 = if_no_else(ctx, cond1, del_then)
		if if1 == 0
			return 0
		integer p2 = _batch_arrayPush(ctx, body_arr, if1)
		if p2 != 0
			return 0

		// string expireCookie = __auth_build_expire_cookie_header()
		integer bec_e = call0(ctx, "__auth_build_expire_cookie_header")
		if bec_e == 0
			return 0
		integer s3 = _batch_stmtVarDecl(ctx, "expireCookie", "string", bec_e)
		if s3 == 0
			return 0
		integer p3 = _batch_arrayPush(ctx, body_arr, s3)
		if p3 != 0
			return 0

		// _http_set_header("Set-Cookie", expireCookie)
		integer hdr_name = _batch_stringLit(ctx, "Set-Cookie")
		if hdr_name == 0
			return 0
		integer hdr_val = _batch_ident(ctx, "expireCookie")
		if hdr_val == 0
			return 0
		integer hdr_args = _batch_arrayNew(ctx)
		if hdr_args == 0
			return 0
		integer hp1 = _batch_arrayPush(ctx, hdr_args, hdr_name)
		if hp1 != 0
			return 0
		integer hp2 = _batch_arrayPush(ctx, hdr_args, hdr_val)
		if hp2 != 0
			return 0
		integer hdr_stmt = _batch_stmtCall(ctx, "_http_set_header", hdr_args)
		if hdr_stmt == 0
			return 0
		integer p4 = _batch_arrayPush(ctx, body_arr, hdr_stmt)
		if p4 != 0
			return 0

		// return true
		integer ret_s = ret_bool(ctx, true)
		if ret_s == 0
			return 0
		integer p5 = _batch_arrayPush(ctx, body_arr, ret_s)
		if p5 != 0
			return 0

		return _batch_func(ctx, "session_destroy", params, "boolean", body_arr)

	// JWT helpers (5–7). Every token carries a `typ` claim: "access" for the
	// tokens auth.jwt.sign issues, "refresh" for refresh tokens. A refresh
	// token is accepted only by auth.jwt.refresh, which consumes it
	// (single-use rotation, AUTH-J007 / AUTH-J009) and answers with a new
	// access token signed for ttlMinutes; the rotated refresh token goes to
	// the HttpOnly `frame.refresh` cookie (AUTH-J005 / AUTH-J006). jti is a
	// per-token unique id (16 random bytes -> 32 hex chars) the rotation
	// bridge needs for replay detection. With `jwt: enabled = false` the
	// helpers issue and accept nothing.

	// 5. jwt_sign(claims: string) -> string
	integer build_jwt_sign(integer ctx)
		string src = "if __jwt_enabled == false\n\treturn \"\"\n"
		src = src + "return __auth_jwt_issue(claims, \"access\", __jwt_ttl)\n"
		return source_helper(ctx, "jwt_sign", "claims:string", "string", src)

	// 6. jwt_verify(token: string) -> string — the payload of a valid access
	// token, "" otherwise. A refresh token is not an access token.
	integer build_jwt_verify(integer ctx)
		string src = "if __jwt_enabled == false\n\treturn \"\"\n"
		src = src + "string payload = _jwt_verify(token, __jwt_secret, __jwt_alg)\n"
		src = src + "if payload == \"\"\n\treturn \"\"\n"
		src = src + "string typ = json.get(json.textToData(payload), \"typ\")\n"
		src = src + "if typ == \"refresh\"\n\treturn \"\"\n"
		src = src + "return payload\n"
		return source_helper(ctx, "jwt_verify", "token:string", "string", src)

	// 7. jwt_refresh(refreshToken: string) -> string — a new access token, or
	// "" when the token is not a valid, unused refresh token (AUTH-J007).
	// _jwt_refresh_and_rotate verifies the token, consumes its jti under the
	// session store lock and re-signs it with a fresh jti / iat / exp; a
	// replayed token yields "".
	integer build_jwt_refresh(integer ctx)
		string src = "if __jwt_enabled == false\n\treturn \"\"\n"
		src = src + "string payload = _jwt_verify(refreshToken, __jwt_secret, __jwt_alg)\n"
		src = src + "if payload == \"\"\n\treturn \"\"\n"
		src = src + "any data = json.textToData(payload)\n"
		src = src + "string typ = json.get(data, \"typ\")\n"
		src = src + "if typ != \"refresh\"\n\treturn \"\"\n"
		src = src + "string rotated = _jwt_refresh_and_rotate(refreshToken, __jwt_secret, __jwt_alg, __jwt_refresh_ttl * 60)\n"
		src = src + "if rotated == \"\"\n\treturn \"\"\n"
		src = src + "_http_set_header(\"Set-Cookie\", __auth_build_refresh_cookie_header(rotated))\n"
		src = src + "return __auth_jwt_issue(json.dataToText(json.get(data, \"claims\")), \"access\", __jwt_ttl)\n"
		return source_helper(ctx, "jwt_refresh", "refreshToken:string", "string", src)

	// __auth_jwt_issue(claims, typ, ttlMinutes) -> string — a token of type
	// typ that expires ttlMinutes from now.
	integer build_jwt_issue_helper(integer ctx)
		string src = "integer iat = _time_now()\n"
		src = src + "string payload = __auth_build_jwt_payload(iat, iat + ttlMinutes * 60, _crypto_random_hex(16), typ, claims)\n"
		src = src + "return _jwt_sign(payload, __jwt_secret, __jwt_alg)\n"
		return source_helper(ctx, "__auth_jwt_issue", "claims:string,typ:string,ttlMinutes:integer", "string", src)

	// __auth_build_refresh_cookie_header(token) -> string — the Set-Cookie
	// value carrying a refresh token: HttpOnly, with the session cookie's
	// path, SameSite, Domain and Secure settings, for refreshTtlMinutes.
	integer build_refresh_cookie_header_helper(integer ctx)
		string src = "string cookie = \"frame.refresh=\" + token + \"; Path=\" + __session_path + \"; SameSite=\" + __session_same_site\n"
		src = src + "if __session_domain != \"\"\n\tcookie = cookie + \"; Domain=\" + __session_domain\n"
		src = src + "if __session_secure\n\tcookie = cookie + \"; Secure\"\n"
		src = src + "return cookie + \"; HttpOnly; Max-Age=\" + (__jwt_refresh_ttl * 60).toString()\n"
		return source_helper(ctx, "__auth_build_refresh_cookie_header", "token:string", "string", src)

	// A helper whose body is Clean source (Amendment 11 §3.11, via
	// batch.func2's from-source path). params_spec is "name:type,..." or "".
	integer source_helper(integer ctx, string name, string params_spec, string return_type, string src)
		integer params = _batch_arrayNew(ctx)
		if params == 0
			return 0
		integer pos = 0
		while pos < params_spec.length()
			integer stop = params_spec.indexOf(",", pos)
			if stop == -1
				stop = params_spec.length()
			string param = params_spec.substring(pos, stop)
			integer colon = param.indexOf(":")
			if _batch_arrayPush(ctx, params, _batch_param(ctx, param.substring(0, colon), param.substring(colon + 1, param.length()))) != 0
				return 0
			pos = stop + 1
		integer body_h = _emit_stmt_from_source(ctx, src, 0)
		if body_h == 0 or _ctx_had_error(ctx) != 0
			return 0
		return _batch_func2(ctx, name, params, return_type, 0, body_h)

	// __auth_build_session_json(userId, claims) -> string
	//   return "{\"userId\":" + userId.toString() + ",\"claims\":" + claims + "}"
	integer build_session_json_helper(integer ctx)
		string src = "return \"{\\\"userId\\\":\" + userId.toString() + \",\\\"claims\\\":\" + claims + \"}\"\n"
		return source_helper(ctx, "__auth_build_session_json", "userId:integer,claims:string", "string", src)

	// __auth_build_cookie_header(sessionId) -> string — the Set-Cookie value
	// for a new session, built from the auth: session configuration.
	integer build_cookie_header_helper(integer ctx)
		integer params = _batch_arrayNew(ctx)
		_batch_arrayPush(ctx, params, _batch_param(ctx, "sessionId", "string"))
		string src = "string cookie = __session_cookie + \"=\" + sessionId + \"; Path=\" + __session_path + \"; SameSite=\" + __session_same_site\n"
		src = src + "if __session_domain != \"\"\n\tcookie = cookie + \"; Domain=\" + __session_domain\n"
		src = src + "if __session_secure\n\tcookie = cookie + \"; Secure\"\n"
		src = src + "return cookie + \"; HttpOnly; Max-Age=\" + (__session_timeout * 60).toString()\n"
		integer body_h = _emit_stmt_from_source(ctx, src, 0)
		if body_h == 0 or _ctx_had_error(ctx) != 0
			return 0
		return _batch_func2(ctx, "__auth_build_cookie_header", params, "string", 0, body_h)

	// __auth_build_expire_cookie_header() -> string — the Set-Cookie value that
	// clears the session cookie.
	integer build_expire_cookie_header_helper(integer ctx)
		integer params = _batch_arrayNew(ctx)
		string src = "string expireCookie = __session_cookie + \"=; Path=\" + __session_path + \"; SameSite=\" + __session_same_site + \"; Max-Age=0\"\n"
		src = src + "if __session_domain != \"\"\n\texpireCookie = expireCookie + \"; Domain=\" + __session_domain\n"
		src = src + "if __session_secure\n\texpireCookie = expireCookie + \"; Secure\"\n"
		src = src + "return expireCookie + \"; HttpOnly\"\n"
		integer body_h = _emit_stmt_from_source(ctx, src, 0)
		if body_h == 0 or _ctx_had_error(ctx) != 0
			return 0
		return _batch_func2(ctx, "__auth_build_expire_cookie_header", params, "string", 0, body_h)

	// __auth_build_jwt_payload(iat, exp, jti, typ, claims) -> string — the
	// JWT payload JSON. iat/exp are integers, jti is 32 hex chars, typ is
	// "access" or "refresh", claims is the caller's JSON object (not
	// re-escaped).
	integer build_jwt_build_payload_helper(integer ctx)
		string src = "return \"{\\\"iat\\\":\" + iat.toString() + \",\\\"exp\\\":\" + exp.toString() + \",\\\"jti\\\":\\\"\" + jti + \"\\\",\\\"typ\\\":\\\"\" + typ + \"\\\",\\\"claims\\\":\" + claims + \"}\"\n"
		return source_helper(ctx, "__auth_build_jwt_payload", "iat:integer,exp:integer,jti:string,typ:string,claims:string", "string", src)

	// 8. hashPassword(password: string) -> string
	integer build_hash_password(integer ctx)
		integer params = one_param(ctx, "password", "string")
		if params == 0
			return 0
		integer body_arr = _batch_arrayNew(ctx)
		if body_arr == 0
			return 0
		integer hp_e = call1_ident(ctx, "_crypto_hash_password", "password")
		if hp_e == 0
			return 0
		integer ret_s = _batch_stmtReturn(ctx, hp_e)
		if ret_s == 0
			return 0
		integer p1 = _batch_arrayPush(ctx, body_arr, ret_s)
		if p1 != 0
			return 0
		return _batch_func(ctx, "hashPassword", params, "string", body_arr)

	// 9. verifyPassword(password: string, hash: string) -> boolean
	integer build_verify_password(integer ctx)
		integer params = two_params(ctx, "password", "string", "hash", "string")
		if params == 0
			return 0
		integer body_arr = _batch_arrayNew(ctx)
		if body_arr == 0
			return 0
		integer vp_e = call2_idents(ctx, "_crypto_verify_password", "password", "hash")
		if vp_e == 0
			return 0
		integer ret_s = _batch_stmtReturn(ctx, vp_e)
		if ret_s == 0
			return 0
		integer p1 = _batch_arrayPush(ctx, body_arr, ret_s)
		if p1 != 0
			return 0
		return _batch_func(ctx, "verifyPassword", params, "boolean", body_arr)

	// 10. can(user: string, permission: string) -> boolean
	// frame-auth.ebnf auth_ns_can_call: auth.can(user, permission). `user` is
	// the user/session JSON (e.g. from auth.getCurrentUser()); the check uses
	// that user's role, not the current request session.
	integer build_can(integer ctx)
		integer params = two_params(ctx, "user", "string", "permission", "string")
		if params == 0
			return 0
		integer body_arr = _batch_arrayNew(ctx)
		if body_arr == 0
			return 0

		// if user == "" { return false }
		integer cond1 = eq_ident_str(ctx, "user", "")
		if cond1 == 0
			return 0
		integer ret_f = ret_bool(ctx, false)
		if ret_f == 0
			return 0
		integer then1 = body1(ctx, ret_f)
		if then1 == 0
			return 0
		integer if1 = if_no_else(ctx, cond1, then1)
		if if1 == 0
			return 0
		integer p2 = _batch_arrayPush(ctx, body_arr, if1)
		if p2 != 0
			return 0

		// string role = _json_get(user, "claims.role")
		integer jg_e = call2_ident_str(ctx, "_json_get", "user", "claims.role")
		if jg_e == 0
			return 0
		integer s3 = _batch_stmtVarDecl(ctx, "role", "string", jg_e)
		if s3 == 0
			return 0
		integer p3 = _batch_arrayPush(ctx, body_arr, s3)
		if p3 != 0
			return 0

		// Sessions made by auth.setSession keep the role at the top level
		// ({"role": ...}); sessions made by session_create keep it in claims.
		// if role == "" { role = _json_get(user, "role") }
		integer cond_r = eq_ident_str(ctx, "role", "")
		integer top_role = _batch_stmtAssign(ctx, "role", call2_ident_str(ctx, "_json_get", "user", "role"))
		integer if_r = if_no_else(ctx, cond_r, body1(ctx, top_role))
		if if_r == 0 or _batch_arrayPush(ctx, body_arr, if_r) != 0
			return 0

		// return _role_has_permission(role, permission)
		integer rhp_e = call2_idents(ctx, "_role_has_permission", "role", "permission")
		if rhp_e == 0
			return 0
		integer ret_s = _batch_stmtReturn(ctx, rhp_e)
		if ret_s == 0
			return 0
		integer p4 = _batch_arrayPush(ctx, body_arr, ret_s)
		if p4 != 0
			return 0

		return _batch_func(ctx, "can", params, "boolean", body_arr)

	// 11. hasRole(requiredRole: string) -> boolean
	integer build_has_role(integer ctx)
		integer params = one_param(ctx, "requiredRole", "string")
		if params == 0
			return 0
		integer body_arr = _batch_arrayNew(ctx)
		if body_arr == 0
			return 0

		// string session = session_get()
		integer sg_e = call0(ctx, "session_get")
		if sg_e == 0
			return 0
		integer s1 = _batch_stmtVarDecl(ctx, "session", "string", sg_e)
		if s1 == 0
			return 0
		integer p1 = _batch_arrayPush(ctx, body_arr, s1)
		if p1 != 0
			return 0

		// if session == "" { return false }
		integer cond1 = eq_ident_str(ctx, "session", "")
		if cond1 == 0
			return 0
		integer ret_f = ret_bool(ctx, false)
		if ret_f == 0
			return 0
		integer then1 = body1(ctx, ret_f)
		if then1 == 0
			return 0
		integer if1 = if_no_else(ctx, cond1, then1)
		if if1 == 0
			return 0
		integer p2 = _batch_arrayPush(ctx, body_arr, if1)
		if p2 != 0
			return 0

		// string role = _json_get(session, "claims.role")
		integer jg_e = call2_ident_str(ctx, "_json_get", "session", "claims.role")
		if jg_e == 0
			return 0
		integer s3 = _batch_stmtVarDecl(ctx, "role", "string", jg_e)
		if s3 == 0
			return 0
		integer p3 = _batch_arrayPush(ctx, body_arr, s3)
		if p3 != 0
			return 0

		// Sessions made by auth.setSession keep the role at the top level
		// ({"role": ...}); sessions made by session_create keep it in claims.
		// if role == "" { role = _json_get(session, "role") }
		integer cond_r = eq_ident_str(ctx, "role", "")
		integer top_role = _batch_stmtAssign(ctx, "role", call2_ident_str(ctx, "_json_get", "session", "role"))
		integer if_r = if_no_else(ctx, cond_r, body1(ctx, top_role))
		if if_r == 0 or _batch_arrayPush(ctx, body_arr, if_r) != 0
			return 0

		// return role == requiredRole
		integer eq_e = eq_idents(ctx, "role", "requiredRole")
		if eq_e == 0
			return 0
		integer ret_s = _batch_stmtReturn(ctx, eq_e)
		if ret_s == 0
			return 0
		integer p4 = _batch_arrayPush(ctx, body_arr, ret_s)
		if p4 != 0
			return 0

		return _batch_func(ctx, "hasRole", params, "boolean", body_arr)

	// 12. getCurrentUser() -> string
	integer build_get_current_user(integer ctx)
		integer params = no_params(ctx)
		if params == 0
			return 0
		integer body_arr = _batch_arrayNew(ctx)
		if body_arr == 0
			return 0

		integer sg_e = call0(ctx, "session_get")
		if sg_e == 0
			return 0
		integer s1 = _batch_stmtVarDecl(ctx, "session", "string", sg_e)
		if s1 == 0
			return 0
		integer p1 = _batch_arrayPush(ctx, body_arr, s1)
		if p1 != 0
			return 0

		integer cond1 = eq_ident_str(ctx, "session", "")
		if cond1 == 0
			return 0
		integer ret_es = ret_empty_str(ctx)
		if ret_es == 0
			return 0
		integer then1 = body1(ctx, ret_es)
		if then1 == 0
			return 0
		integer if1 = if_no_else(ctx, cond1, then1)
		if if1 == 0
			return 0
		integer p2 = _batch_arrayPush(ctx, body_arr, if1)
		if p2 != 0
			return 0

		integer ret_s = ret_ident(ctx, "session")
		if ret_s == 0
			return 0
		integer p3 = _batch_arrayPush(ctx, body_arr, ret_s)
		if p3 != 0
			return 0

		return _batch_func(ctx, "getCurrentUser", params, "string", body_arr)

	// 13. isAuthenticated() -> boolean
	integer build_is_authenticated(integer ctx)
		integer params = no_params(ctx)
		if params == 0
			return 0
		integer body_arr = _batch_arrayNew(ctx)
		if body_arr == 0
			return 0

		// return session_get() != ""
		integer sg_e = call0(ctx, "session_get")
		if sg_e == 0
			return 0
		integer empty_e = _batch_stringLit(ctx, "")
		if empty_e == 0
			return 0
		integer ne_e = _batch_binop(ctx, "!=", sg_e, empty_e)
		if ne_e == 0
			return 0
		integer ret_s = _batch_stmtReturn(ctx, ne_e)
		if ret_s == 0
			return 0
		integer p1 = _batch_arrayPush(ctx, body_arr, ret_s)
		if p1 != 0
			return 0

		return _batch_func(ctx, "isAuthenticated", params, "boolean", body_arr)

	// 14. csrf_generate() -> string
	integer build_csrf_generate(integer ctx)
		integer params = no_params(ctx)
		if params == 0
			return 0
		integer body_arr = _batch_arrayNew(ctx)
		if body_arr == 0
			return 0

		// string token = _crypto_random_hex(32)
		integer rnd_e = call1_int(ctx, "_crypto_random_hex", 32)
		if rnd_e == 0
			return 0
		integer s1 = _batch_stmtVarDecl(ctx, "token", "string", rnd_e)
		if s1 == 0
			return 0
		integer p1 = _batch_arrayPush(ctx, body_arr, s1)
		if p1 != 0
			return 0

		// string session = session_get()
		integer sg_e = call0(ctx, "session_get")
		if sg_e == 0
			return 0
		integer s2 = _batch_stmtVarDecl(ctx, "session", "string", sg_e)
		if s2 == 0
			return 0
		integer p2 = _batch_arrayPush(ctx, body_arr, s2)
		if p2 != 0
			return 0

		// if session != "" { _session_set_csrf(token) }
		integer cond1 = ne_ident_str(ctx, "session", "")
		if cond1 == 0
			return 0
		integer csrf_args = _batch_arrayNew(ctx)
		if csrf_args == 0
			return 0
		integer tok_e = _batch_ident(ctx, "token")
		if tok_e == 0
			return 0
		integer csp = _batch_arrayPush(ctx, csrf_args, tok_e)
		if csp != 0
			return 0
		integer csrf_stmt = _batch_stmtCall(ctx, "_session_set_csrf", csrf_args)
		if csrf_stmt == 0
			return 0
		integer then1 = body1(ctx, csrf_stmt)
		if then1 == 0
			return 0
		integer if1 = if_no_else(ctx, cond1, then1)
		if if1 == 0
			return 0
		integer p3 = _batch_arrayPush(ctx, body_arr, if1)
		if p3 != 0
			return 0

		// return token
		integer ret_s = ret_ident(ctx, "token")
		if ret_s == 0
			return 0
		integer p4 = _batch_arrayPush(ctx, body_arr, ret_s)
		if p4 != 0
			return 0

		return _batch_func(ctx, "csrf_generate", params, "string", body_arr)

	// 15. csrf_validate(token: string) -> boolean
	integer build_csrf_validate(integer ctx)
		integer params = one_param(ctx, "token", "string")
		if params == 0
			return 0
		integer body_arr = _batch_arrayNew(ctx)
		if body_arr == 0
			return 0

		// if __csrf_enabled == false { return true }
		integer csrf_en = _batch_ident(ctx, "__csrf_enabled")
		if csrf_en == 0
			return 0
		integer false_e = _batch_boolLit(ctx, 0)
		if false_e == 0
			return 0
		integer cond1 = _batch_binop(ctx, "==", csrf_en, false_e)
		if cond1 == 0
			return 0
		integer ret_t = ret_bool(ctx, true)
		if ret_t == 0
			return 0
		integer then1 = body1(ctx, ret_t)
		if then1 == 0
			return 0
		integer if1 = if_no_else(ctx, cond1, then1)
		if if1 == 0
			return 0
		integer p1 = _batch_arrayPush(ctx, body_arr, if1)
		if p1 != 0
			return 0

		// string expected = _session_get_csrf()
		integer sgc_e = call0(ctx, "_session_get_csrf")
		if sgc_e == 0
			return 0
		integer s2 = _batch_stmtVarDecl(ctx, "expected", "string", sgc_e)
		if s2 == 0
			return 0
		integer p2 = _batch_arrayPush(ctx, body_arr, s2)
		if p2 != 0
			return 0

		// return expected != "" && expected == token
		integer ne_e = ne_ident_str(ctx, "expected", "")
		if ne_e == 0
			return 0
		integer eq_e = eq_idents(ctx, "expected", "token")
		if eq_e == 0
			return 0
		integer and_e = and_exprs(ctx, ne_e, eq_e)
		if and_e == 0
			return 0
		integer ret_s = _batch_stmtReturn(ctx, and_e)
		if ret_s == 0
			return 0
		integer p3 = _batch_arrayPush(ctx, body_arr, ret_s)
		if p3 != 0
			return 0

		return _batch_func(ctx, "csrf_validate", params, "boolean", body_arr)

	// __auth_csrf_enabled() -> boolean — the csrf: enabled setting. The host
	// calls it once at startup: while it is true, a POST / PUT / PATCH /
	// DELETE request authenticated by the session cookie must carry the
	// session's CSRF token in the X-CSRF-Token header or the _csrf form field
	// (AUTH-S006 / AUTH-S007), or the host answers 403 CSRF_FAIL before the
	// handler runs.
	integer build_csrf_enabled_helper(integer ctx)
		return source_helper(ctx, "__auth_csrf_enabled", "", "boolean", "return __csrf_enabled\n")

	// 16. tenant_getId() -> string
	integer build_tenant_get_id(integer ctx)
		integer params = no_params(ctx)
		if params == 0
			return 0
		integer body_arr = _batch_arrayNew(ctx)
		if body_arr == 0
			return 0

		integer sg_e = call0(ctx, "session_get")
		if sg_e == 0
			return 0
		integer s1 = _batch_stmtVarDecl(ctx, "session", "string", sg_e)
		if s1 == 0
			return 0
		integer p1 = _batch_arrayPush(ctx, body_arr, s1)
		if p1 != 0
			return 0

		integer cond1 = eq_ident_str(ctx, "session", "")
		if cond1 == 0
			return 0
		integer ret_es = ret_empty_str(ctx)
		if ret_es == 0
			return 0
		integer then1 = body1(ctx, ret_es)
		if then1 == 0
			return 0
		integer if1 = if_no_else(ctx, cond1, then1)
		if if1 == 0
			return 0
		integer p2 = _batch_arrayPush(ctx, body_arr, if1)
		if p2 != 0
			return 0

		// return _json_get(session, "claims." + __tenant_field)
		// (tenant: field = ... names the claim; default tenantId)
		integer path_e = add_exprs(ctx, _batch_stringLit(ctx, "claims."), _batch_ident(ctx, "__tenant_field"))
		integer jg_args = _batch_arrayNew(ctx)
		if path_e == 0 or jg_args == 0
			return 0
		if _batch_arrayPush(ctx, jg_args, _batch_ident(ctx, "session")) != 0 or _batch_arrayPush(ctx, jg_args, path_e) != 0
			return 0
		integer jg_e = _batch_call(ctx, "_json_get", jg_args)
		if jg_e == 0
			return 0
		integer ret_s = _batch_stmtReturn(ctx, jg_e)
		if ret_s == 0
			return 0
		integer p3 = _batch_arrayPush(ctx, body_arr, ret_s)
		if p3 != 0
			return 0

		return _batch_func(ctx, "tenant_getId", params, "string", body_arr)

	// 17. tenant_require() -> string
	integer build_tenant_require(integer ctx)
		integer params = no_params(ctx)
		if params == 0
			return 0
		integer body_arr = _batch_arrayNew(ctx)
		if body_arr == 0
			return 0

		// string tenantId = tenant_getId()
		integer tgi_e = call0(ctx, "tenant_getId")
		if tgi_e == 0
			return 0
		integer s1 = _batch_stmtVarDecl(ctx, "tenantId", "string", tgi_e)
		if s1 == 0
			return 0
		integer p1 = _batch_arrayPush(ctx, body_arr, s1)
		if p1 != 0
			return 0

		// if tenantId == "" { return "" }
		integer cond1 = eq_ident_str(ctx, "tenantId", "")
		if cond1 == 0
			return 0
		integer ret_es = ret_empty_str(ctx)
		if ret_es == 0
			return 0
		integer then1 = body1(ctx, ret_es)
		if then1 == 0
			return 0
		integer if1 = if_no_else(ctx, cond1, then1)
		if if1 == 0
			return 0
		integer p2 = _batch_arrayPush(ctx, body_arr, if1)
		if p2 != 0
			return 0

		// return tenantId
		integer ret_s = ret_ident(ctx, "tenantId")
		if ret_s == 0
			return 0
		integer p3 = _batch_arrayPush(ctx, body_arr, ret_s)
		if p3 != 0
			return 0

		return _batch_func(ctx, "tenant_require", params, "string", body_arr)

	// 18. tenant_matches(checkTenantId: string) -> boolean
	integer build_tenant_matches(integer ctx)
		integer params = one_param(ctx, "checkTenantId", "string")
		if params == 0
			return 0
		integer body_arr = _batch_arrayNew(ctx)
		if body_arr == 0
			return 0

		// string myTenantId = tenant_getId()
		integer tgi_e = call0(ctx, "tenant_getId")
		if tgi_e == 0
			return 0
		integer s1 = _batch_stmtVarDecl(ctx, "myTenantId", "string", tgi_e)
		if s1 == 0
			return 0
		integer p1 = _batch_arrayPush(ctx, body_arr, s1)
		if p1 != 0
			return 0

		// if myTenantId == "" { return false }
		integer cond1 = eq_ident_str(ctx, "myTenantId", "")
		if cond1 == 0
			return 0
		integer ret_f = ret_bool(ctx, false)
		if ret_f == 0
			return 0
		integer then1 = body1(ctx, ret_f)
		if then1 == 0
			return 0
		integer if1 = if_no_else(ctx, cond1, then1)
		if if1 == 0
			return 0
		integer p2 = _batch_arrayPush(ctx, body_arr, if1)
		if p2 != 0
			return 0

		// return myTenantId == checkTenantId
		integer eq_e = eq_idents(ctx, "myTenantId", "checkTenantId")
		if eq_e == 0
			return 0
		integer ret_s = _batch_stmtReturn(ctx, eq_e)
		if ret_s == 0
			return 0
		integer p3 = _batch_arrayPush(ctx, body_arr, ret_s)
		if p3 != 0
			return 0

		return _batch_func(ctx, "tenant_matches", params, "boolean", body_arr)

// ============================================================================
// ROLES EXPANSION (TYPED)
// ============================================================================
// Emits: string __roles_config = "<json>" and _roles_register(__roles_config).
// The roles JSON is built at expand time from the DSL body and embedded as a
// string literal — no runtime JSON assembly. The roles DSL body contains only
// plugin-authored role names and permission arrays (not user-authored handler
// bodies), so embedding them as a string literal is within the Amendment 4
// plugin-authored-template rule.

functions:
	integer expand_roles_typed(integer ctx, string body)
		// Build roles JSON the same way as v1 expand_roles, but then emit it
		// via typed bridges rather than string-concatenated Clean source.
		string json = "{"
		string lines = body
		integer line_start = 0
		boolean first = true

		while line_start < lines.length()
			integer line_end = lines.indexOf("\n", line_start)
			if line_end == -1
				line_end = lines.length()

			string line = lines.substring(line_start, line_end).trim()
			if line.length() > 0 and line.indexOf(":") != -1
				integer colon_pos = line.indexOf(":")
				string role_name = line.substring(0, colon_pos).trim()
				string permissions = line.substring(colon_pos + 1, line.length()).trim()

				if not first
					json = json + ","
				first = false

				json = json + "\"" + escape_string_literal(role_name) + "\":" + permissions

			line_start = line_end + 1

		json = json + "}"

		// Emit: string __roles_config = "<escaped json>"
		// stringLit carries the string value itself (an AST literal, not
		// source text), so the JSON is passed unescaped.
		integer rc_val = _batch_stringLit(ctx, json)
		if rc_val == 0
			return plugin_error(ctx, "FRAME-AUTH-E003", "expand_roles_typed: stringLit for __roles_config failed")
		integer rc_assign = _batch_stmtVarDecl(ctx, "__roles_config", "string", rc_val)
		if rc_assign == 0
			return plugin_error(ctx, "FRAME-AUTH-E003", "expand_roles_typed: stmtAssign for __roles_config failed")
		integer e1 = _emit_statement_into_start(ctx, rc_assign)
		if e1 != 0
			return plugin_error(ctx, "FRAME-AUTH-E003", "expand_roles_typed: emit_statement_into_start for __roles_config failed")

		// Emit: _roles_register(__roles_config)
		integer rr_ident = _batch_ident(ctx, "__roles_config")
		if rr_ident == 0
			return plugin_error(ctx, "FRAME-AUTH-E003", "expand_roles_typed: ident for _roles_register arg failed")
		integer rr_args = _batch_arrayNew(ctx)
		if rr_args == 0
			return plugin_error(ctx, "FRAME-AUTH-E003", "expand_roles_typed: arrayNew for _roles_register args failed")
		integer rr_push = _batch_arrayPush(ctx, rr_args, rr_ident)
		if rr_push != 0
			return plugin_error(ctx, "FRAME-AUTH-E003", "expand_roles_typed: arrayPush for _roles_register arg failed")
		integer rr_stmt = _batch_stmtCall(ctx, "_roles_register", rr_args)
		if rr_stmt == 0
			return plugin_error(ctx, "FRAME-AUTH-E003", "expand_roles_typed: stmtCall for _roles_register failed")
		integer e2 = _emit_statement_into_start(ctx, rr_stmt)
		if e2 != 0
			return plugin_error(ctx, "FRAME-AUTH-E003", "expand_roles_typed: emit_statement_into_start for _roles_register failed")
		return 0

// ============================================================================
// LOGIN BLOCK
// ============================================================================
// frame-auth.ebnf login_block: `login:` wires credential validation to
// session or token issuance. It emits one function, __auth_login() ->
// string, called from a login endpoint as auth.login(). The block body is
// run in source order: statements (to read the request and look the user
// up) and these field clauses:
//
//   password = <expr>   the submitted plaintext password (string, required)
//   hash = <expr>       the stored Argon2id hash, "" when there is no such
//                       user (string, required)
//   userId = <expr>     the user's id (integer, required)
//   claims = <expr>     the claims JSON object (string, default "{}")
//   issue = "session"   what a successful login issues: "session" (default)
//                       or "jwt"
//
// A field value is a one-line expression, passed to the compiler as written
// (_emit_expr_from_source) and stored in a __login_<field> local;
// statements are passed as written too (_emit_stmt_from_source). The checks
// after them are plugin-authored:
//
//   - the password is verified (AUTH-C007; against a dummy hash when hash is
//     "", so an unknown user costs the same as a wrong password; an empty
//     password fails); a failure is logged (AUTH-C003, INVALID_CREDENTIALS)
//     and returns "";
//   - issue = "session": the request's old session is deleted, a new one is
//     created for userId with claims (session_create, which also makes a new
//     CSRF token) and its cookie set; returns the session id;
//   - issue = "jwt": an access token is signed (auth.jwt.sign) with the
//     claims plus `sub` = userId as a string (AUTH-J011), and a refresh
//     token goes to the HttpOnly frame.refresh cookie (AUTH-J005/J006);
//     returns the access token.
//
// A statement may `return` early: auth.login() then answers with that
// value. Needs the auth: block, whose helpers and settings it uses.

functions:
	// The login: field names, separated and ended by ",".
	string login_fields()
		return "password,hash,userId,claims,issue,"

	// The local a field is stored in.
	string login_local(string field)
		return "__login_" + field

	string login_field_type(string field)
		if field == "userId"
			return "integer"
		return "string"

	// The smallest indent of a body line that holds code.
	integer login_base_indent(string body)
		integer base = -1
		integer pos = 0
		while pos < body.length()
			integer eol = body.indexOf("\n", pos)
			if eol == -1
				eol = body.length()
			string line = body.substring(pos, eol)
			pos = eol + 1
			if strip_comment(line).trim().length() > 0
				integer indent = indent_width(line)
				if base == -1 or indent < base
					base = indent
		if base == -1
			return 0
		return base

	// End offset (exclusive) of the clause whose first line starts at
	// line_start: that line and every following line indented deeper than
	// base.
	integer login_clause_end(string body, integer line_start, integer base)
		integer clause_end = body.indexOf("\n", line_start)
		if clause_end == -1
			return body.length()
		integer pos = clause_end + 1
		while pos < body.length()
			integer eol = body.indexOf("\n", pos)
			if eol == -1
				eol = body.length()
			string line = body.substring(pos, eol)
			if strip_comment(line).trim().length() > 0
				if indent_width(line) <= base
					return clause_end
				clause_end = eol
			pos = eol + 1
		return clause_end

	// The field a clause line sets, or "" when the line is a statement.
	string login_field_name(string text)
		string names = login_fields()
		integer pos = 0
		while pos < names.length()
			integer comma = names.indexOf(",", pos)
			string name = names.substring(pos, comma)
			pos = comma + 1
			if text.startsWith(name)
				string rest = text.substring(name.length(), text.length()).trim()
				if rest.startsWith("=") and not rest.startsWith("==")
					return name
		return ""

	// Offset in body of the first character of a field's value (the line
	// starts at line_start).
	integer login_value_start(string body, integer line_start)
		integer i = body.indexOf("=", line_start) + 1
		while i < body.length()
			string ch = body.substring(i, i + 1)
			if ch != " " and ch != "\t"
				return i
			i = i + 1
		return i

	// Offset in body just after the last character of a field's value: the
	// line without its `//` comment and trailing spaces.
	integer login_value_end(string body, integer line_start)
		integer eol = body.indexOf("\n", line_start)
		if eol == -1
			eol = body.length()
		integer stop = line_start + strip_comment(body.substring(line_start, eol)).length()
		while stop > line_start
			string ch = body.substring(stop - 1, stop)
			if ch != " " and ch != "\t" and ch != "\r"
				return stop
			stop = stop - 1
		return stop

	// "" when the login: body is well formed, otherwise the error message.
	string check_login_body(string body)
		integer base = login_base_indent(body)
		string seen = ","
		integer pos = 0
		while pos < body.length()
			integer eol = body.indexOf("\n", pos)
			if eol == -1
				eol = body.length()
			string line = body.substring(pos, eol)
			string text = strip_comment(line).trim()
			if text.length() == 0
				pos = eol + 1
				continue
			integer clause_end = login_clause_end(body, pos, base)
			string field = login_field_name(text)
			if field.length() > 0
				if seen.contains("," + field + ",")
					return "login: " + field + " is set more than once"
				seen = seen + field + ","
				if clause_end != eol
					return "login: the value of " + field + " must be on one line"
				integer value_start = login_value_start(body, pos)
				integer value_end = login_value_end(body, pos)
				if value_end <= value_start
					return "login: " + field + " has no value"
				if field == "issue"
					string issue = body.substring(value_start, value_end)
					if issue != "\"session\"" and issue != "\"jwt\""
						return "login: issue must be \"session\" or \"jwt\", got " + issue
			pos = clause_end + 1
		string missing = ""
		if not seen.contains(",password,")
			missing = missing + " password"
		if not seen.contains(",hash,")
			missing = missing + " hash"
		if not seen.contains(",userId,")
			missing = missing + " userId"
		if missing.length() > 0
			return "login: missing" + missing + " (login: needs password = <submitted password>, hash = <stored hash, \"\" when there is no such user> and userId = <user id>)"
		return ""

	integer expand_login_typed(integer ctx, string attrs_json, string body)
		string problem = check_login_body(body)
		if problem.length() > 0
			return plugin_error(ctx, "FRAME-AUTH-E004", problem)

		// One login flow per program: auth.login() names a single function.
		if _build_state_get("frame.auth:login") == "declared"
			return plugin_error(ctx, "FRAME-AUTH-E004", "login: is declared more than once; a program has one login: block (auth.login() runs it)")
		_build_state_set("frame.auth:login", "declared")

		integer body_arr = _batch_arrayNew(ctx)
		if body_arr == 0
			return plugin_error(ctx, "FRAME-AUTH-E004", "login: arrayNew failed")
		integer base = login_base_indent(body)
		string issue = "session"
		boolean has_claims = false
		integer pos = 0
		while pos < body.length()
			integer eol = body.indexOf("\n", pos)
			if eol == -1
				eol = body.length()
			string line = body.substring(pos, eol)
			string text = strip_comment(line).trim()
			if text.length() == 0
				pos = eol + 1
				continue
			integer clause_end = login_clause_end(body, pos, base)
			string field = login_field_name(text)
			integer stmt = 0
			if field == "issue"
				integer issue_start = login_value_start(body, pos)
				issue = body.substring(issue_start + 1, login_value_end(body, pos) - 1)
			else if field.length() > 0
				if field == "claims"
					has_claims = true
				integer value_start = login_value_start(body, pos)
				integer value = _emit_expr_from_source(ctx, body.substring(value_start, login_value_end(body, pos)), value_start)
				if value == 0
					return plugin_error(ctx, "FRAME-AUTH-E004", "login: the value of " + field + " is not a valid expression")
				stmt = _batch_stmtVarDecl(ctx, login_local(field), login_field_type(field), value)
			else
				integer code_start = pos + indent_width(line)
				stmt = _emit_stmt_from_source(ctx, body.substring(code_start, clause_end), code_start)
				if stmt == 0
					return plugin_error(ctx, "FRAME-AUTH-E004", "login: syntax error in statement: " + text)
			if stmt != 0
				if _batch_arrayPush(ctx, body_arr, stmt) != 0
					return plugin_error(ctx, "FRAME-AUTH-E004", "login: arrayPush failed")
			pos = clause_end + 1

		if not has_claims
			integer no_claims = _batch_stmtVarDecl(ctx, "__login_claims", "string", _batch_stringLit(ctx, "{}"))
			if _batch_arrayPush(ctx, body_arr, no_claims) != 0
				return plugin_error(ctx, "FRAME-AUTH-E004", "login: arrayPush failed")

		integer flow = _emit_stmt_from_source(ctx, login_flow_source(issue), 0)
		if flow == 0 or _ctx_had_error(ctx) != 0
			return plugin_error(ctx, "FRAME-AUTH-E004", "login: building the login flow failed")
		if _batch_arrayPush(ctx, body_arr, flow) != 0
			return plugin_error(ctx, "FRAME-AUTH-E004", "login: arrayPush failed")

		integer fn_h = _batch_func(ctx, "__auth_login", no_params(ctx), "string", body_arr)
		integer fns_arr = _batch_arrayNew(ctx)
		if fn_h == 0 or fns_arr == 0 or _batch_arrayPush(ctx, fns_arr, fn_h) != 0
			return plugin_error(ctx, "FRAME-AUTH-E004", "login: building __auth_login failed")
		integer spec_h = _batch_spec(ctx, fns_arr)
		if spec_h == 0 or _emit_helpers_batch(ctx, spec_h, 0) != 0
			return plugin_error(ctx, "FRAME-AUTH-E004", "login: emitting __auth_login failed")

		// The hash an unknown user's password is checked against, made once
		// at startup.
		integer dummy_call = _expr_call(ctx, "_crypto_hash_password", "[" + _expr_string_lit(ctx, "frame.auth login: no such user").toString() + "]")
		if _emit_state_block(ctx, "[" + state_field("__login_dummy_hash", _type_string(ctx), dummy_call) + "]") != 0
			return plugin_error(ctx, "FRAME-AUTH-E004", "login: _emit_state_block failed")
		return 0

	// The plugin-authored part of __auth_login, after the field locals.
	string login_flow_source(string issue)
		string src = "string __login_check = __login_hash\n"
		src = src + "if __login_check == \"\"\n\t__login_check = __login_dummy_hash\n"
		src = src + "boolean __login_ok = false\n"
		src = src + "if __login_password != \"\"\n\t__login_ok = _crypto_verify_password(__login_password, __login_check)\n"
		src = src + "if __login_hash == \"\" or __login_ok == false\n"
		src = src + "\tconsole_warn(\"frame.auth: login failed: INVALID_CREDENTIALS\")\n\treturn \"\"\n"
		src = src + "string __login_body = __login_claims.trim()\n"
		src = src + "if __login_body.startsWith(\"{\") == false or __login_body.endsWith(\"}\") == false\n"
		src = src + "\tconsole_warn(\"frame.auth: login failed: claims must be a JSON object\")\n\treturn \"\"\n"
		if issue == "jwt"
			src = src + "string __login_inner = __login_body.substring(1, __login_body.length() - 1).trim()\n"
			src = src + "string __login_jwt_claims = \"{\\\"sub\\\":\\\"\" + __login_userId.toString() + \"\\\"}\"\n"
			src = src + "if __login_inner != \"\"\n"
			src = src + "\t__login_jwt_claims = \"{\\\"sub\\\":\\\"\" + __login_userId.toString() + \"\\\",\" + __login_inner + \"}\"\n"
			src = src + "string __login_token = jwt_sign(__login_jwt_claims)\n"
			src = src + "if __login_token == \"\"\n"
			src = src + "\tconsole_warn(\"frame.auth: login failed: JWT is disabled (jwt: enabled = false)\")\n\treturn \"\"\n"
			src = src + "_http_set_header(\"Set-Cookie\", __auth_build_refresh_cookie_header(__auth_jwt_issue(__login_jwt_claims, \"refresh\", __jwt_refresh_ttl)))\n"
			src = src + "return __login_token\n"
			return src
		src = src + "if _req_cookie(__session_cookie) != \"\"\n\t_session_delete()\n"
		src = src + "string __login_session = session_create(__login_userId, __login_body)\n"
		src = src + "session_setCookie(__login_session, \"\")\n"
		src = src + "return __login_session\n"
		return src

// ============================================================================
// UTILITY FUNCTIONS (DSL parsing)
// ============================================================================
// The auth: body is read line by line. A section (`session:`, `jwt:`, `csrf:`,
// `roles:`, `tenant:`) is the run of lines indented under its header; each
// setting is one `key = value` line (frame-auth.ebnf session_field,
// jwt_field, csrf_field), with any spacing around `=` and an optional
// trailing `//` comment.

functions:
	// Number of leading spaces and tabs of a line.
	integer indent_width(string line)
		integer i = 0
		while i < line.length()
			string ch = line.substring(i, i + 1)
			if ch != " " and ch != "\t"
				return i
			i = i + 1
		return i

	// The line without its `//` comment (a `//` inside a string literal is
	// part of the value).
	string strip_comment(string line)
		boolean in_string = false
		integer i = 0
		while i < line.length()
			string ch = line.substring(i, i + 1)
			if ch == "\\" and in_string
				i = i + 1
			else if ch == "\""
				in_string = not in_string
			else if ch == "/" and not in_string and i + 1 < line.length()
				if line.substring(i + 1, i + 2) == "/"
					return line.substring(0, i)
			i = i + 1
		return line

	// The lines of the `<block_name>` section (block_name includes the
	// colon, e.g. "session:"), trimmed, without comments or blank lines,
	// joined with "\n". "" when the section is absent or empty.
	string extract_subblock(string body, string block_name)
		string out = ""
		integer header_indent = -1
		integer pos = 0
		while pos < body.length()
			integer eol = body.indexOf("\n", pos)
			if eol == -1
				eol = body.length()
			string line = body.substring(pos, eol)
			pos = eol + 1
			string text = strip_comment(line).trim()
			if text.length() == 0
				continue
			integer indent = indent_width(line)
			if header_indent == -1
				if text == block_name
					header_indent = indent
			else if indent <= header_indent
				return out
			else if out.length() == 0
				out = text
			else
				out = out + "\n" + text
		return out

	// The raw text after `=` on the `key = value` line of a section, or
	// "\n" (which no value can contain) when the key is not set.
	string raw_config_value(string config, string key)
		integer pos = 0
		while pos < config.length()
			integer eol = config.indexOf("\n", pos)
			if eol == -1
				eol = config.length()
			string line = config.substring(pos, eol).trim()
			pos = eol + 1
			if line.startsWith(key)
				string rest = line.substring(key.length(), line.length()).trim()
				// `domain? = null` (frame-auth.ebnf session_domain_field)
				if rest.startsWith("?")
					rest = rest.substring(1, rest.length()).trim()
				if rest.startsWith("=")
					return rest.substring(1, rest.length()).trim()
		return "\n"

	boolean has_config_value(string config, string key)
		return raw_config_value(config, key) != "\n"

	// A setting's value: string literals are unquoted, env.get("X") gives the
	// variable name X; default_val when the key is not set.
	string get_config_value(string config, string key, string default_val)
		string value = raw_config_value(config, key)
		if value == "\n"
			return default_val
		if value.startsWith("env.get(\"") and value.endsWith("\")")
			return value.substring(9, value.length() - 2)
		if value.length() >= 2 and value.startsWith("\"") and value.endsWith("\"")
			return value.substring(1, value.length() - 1)
		return value

	string escape_string_literal(string s)
		string out = ""
		integer i = 0
		while i < s.length()
			string ch = s.substring(i, i + 1)
			if ch == "\\"
				out = out + "\\\\"
			if ch == "\""
				out = out + "\\\""
			if ch != "\\" and ch != "\""
				out = out + ch
			i = i + 1
		return out

// ============================================================================
// VALIDATION
// ============================================================================
// Every line of the auth: body must be understood: a misspelled key, a
// `key: value` line or an unsupported setting is an error rather than a
// setting that silently keeps its default.

functions:
	string validate_auth_config(string body)
		string layout = check_auth_layout(body)
		if layout != ""
			return layout

		string session_block = extract_subblock(body, "session:")
		string err = check_section_keys("session", session_block, ",cookie,sameSite,secure,httpOnly,domain,path,timeoutMinutes,store,")
		if err != ""
			return err
		err = check_boolean(session_block, "session", "secure")
		if err == ""
			err = check_boolean(session_block, "session", "httpOnly")
		if err == ""
			err = check_integer(session_block, "session", "timeoutMinutes")
		if err != ""
			return err
		if has_config_value(session_block, "store")
			return "auth.session: store is not supported in this version — sessions are kept in the server's in-memory store; remove the store setting"
		// AUTH-S005: the session cookie is always HttpOnly.
		if get_config_value(session_block, "httpOnly", "true") == "false"
			return "auth.session: httpOnly = false is not allowed — the session cookie is always HttpOnly (AUTH-S005); remove the setting"
		string same_site_val = get_config_value(session_block, "sameSite", "Lax")
		if same_site_val != "Lax" and same_site_val != "Strict" and same_site_val != "None"
			return "auth.session: sameSite must be \"Lax\", \"Strict\" or \"None\""
		// AUTH-C005: sameSite = "None" needs an explicit secure = true.
		if same_site_val == "None" and get_config_value(session_block, "secure", "") != "true"
			return "auth.session: sameSite=\"None\" requires secure=true (required by browser spec)"

		string jwt_block = extract_subblock(body, "jwt:")
		err = check_section_keys("jwt", jwt_block, ",enabled,secret,alg,ttlMinutes,refreshTtlMinutes,")
		if err == ""
			err = check_boolean(jwt_block, "jwt", "enabled")
		if err == ""
			err = check_integer(jwt_block, "jwt", "ttlMinutes")
		if err == ""
			err = check_integer(jwt_block, "jwt", "refreshTtlMinutes")
		if err != ""
			return err
		if section_present(body, "jwt:") and get_config_value(jwt_block, "enabled", "true") == "true"
			if not has_config_value(jwt_block, "secret")
				return "auth.jwt: secret is required when JWT is enabled"
		if has_config_value(jwt_block, "secret")
			string raw_secret = raw_config_value(jwt_block, "secret")
			if not (raw_secret.startsWith("env.get(\"") and raw_secret.endsWith("\")"))
				return "auth.jwt: secret must reference an environment variable (use env.get(\"JWT_SECRET\")), not a hardcoded string"

		string csrf_block = extract_subblock(body, "csrf:")
		err = check_section_keys("csrf", csrf_block, ",enabled,")
		if err == ""
			err = check_boolean(csrf_block, "csrf", "enabled")
		if err != ""
			return err

		string tenant_block = extract_subblock(body, "tenant:")
		if has_config_value(tenant_block, "header")
			return "auth.tenant: header is not supported — the tenant id comes from the session claims, never from a request header (AUTH-I003); remove the header setting"
		err = check_section_keys("tenant", tenant_block, ",field,")
		if err != ""
			return err
		return ""

	// True when the body has a `<header>` section line.
	boolean section_present(string body, string header)
		integer pos = 0
		while pos < body.length()
			integer eol = body.indexOf("\n", pos)
			if eol == -1
				eol = body.length()
			if strip_comment(body.substring(pos, eol)).trim() == header
				return true
			pos = eol + 1
		return false

	// The top level of the auth: body holds section headers only.
	string check_auth_layout(string body)
		integer top_indent = -1
		integer pos = 0
		while pos < body.length()
			integer eol = body.indexOf("\n", pos)
			if eol == -1
				eol = body.length()
			string line = body.substring(pos, eol)
			pos = eol + 1
			string text = strip_comment(line).trim()
			if text.length() == 0
				continue
			integer indent = indent_width(line)
			if top_indent == -1 or indent < top_indent
				top_indent = indent
			if indent == top_indent
				if text != "session:" and text != "jwt:" and text != "csrf:" and text != "roles:" and text != "tenant:"
					return "auth: unexpected line `" + text + "` — the auth: block holds the sections session:, jwt:, csrf:, roles: and tenant:"
		return ""

	// Every line of a section is `key = value` with a key from `allowed`
	// (a comma-separated list with leading and trailing commas).
	string check_section_keys(string section, string config, string allowed)
		integer pos = 0
		while pos < config.length()
			integer eol = config.indexOf("\n", pos)
			if eol == -1
				eol = config.length()
			string line = config.substring(pos, eol)
			pos = eol + 1
			integer eq = line.indexOf("=")
			if eq <= 0
				return "auth." + section + ": `" + line + "` is not a setting — write `key = value`"
			string key = line.substring(0, eq).trim()
			if key.endsWith("?")
				key = key.substring(0, key.length() - 1).trim()
			if allowed.indexOf("," + key + ",") == -1
				return "auth." + section + ": unknown setting `" + key + "` (allowed: " + allowed.substring(1, allowed.length() - 1).replace(",", ", ") + ")"
		return ""

	string check_boolean(string config, string section, string key)
		if not has_config_value(config, key)
			return ""
		string v = raw_config_value(config, key)
		if v != "true" and v != "false"
			return "auth." + section + ": " + key + " must be true or false"
		return ""

	string check_integer(string config, string section, string key)
		if not has_config_value(config, key)
			return ""
		string v = raw_config_value(config, key)
		if v.length() == 0
			return "auth." + section + ": " + key + " must be a whole number of minutes"
		integer i = 0
		while i < v.length()
			string ch = v.substring(i, i + 1)
			if "0123456789".indexOf(ch) == -1
				return "auth." + section + ": " + key + " must be a whole number of minutes"
			i = i + 1
		return ""
