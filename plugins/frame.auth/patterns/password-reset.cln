// Pattern: password-reset
// Use when: users need a way to recover access when they forget their password
// Anti-pattern: DON'T email a plain temporary password or a short numeric code.
//   A plain password is a secret you must never generate or transmit, and a
//   short code can be brute-forced. auth.createResetToken issues a long random
//   token whose SHA-256 alone is kept server-side; auth.consumeResetToken
//   accepts it once, before its TTL (15 minutes here) runs out.

plugins:
	frame.server
	frame.auth
	frame.data

auth:
	session:
		cookie = "app.sid"

data User:
	fields:
		integer id primary generated
		string email required unique
		string password_hash required

endpoints:
	POST "/auth/forgot-password":
		any data = json.tryTextToData(req.body())
		if data == none or data.email == none
			return badRequest("email is required")
		string address = data.email.toString()
		boolean known = User.exists:
			where:
				email == address
		// Always the same answer: do not reveal which emails are registered.
		if known
			User? foundUser = User.first:
				where:
					email == address
			User user = foundUser!
			string token = auth.createResetToken(user.id, 900)
			string link = "https://example.com/reset-password?token=" + token
			email.send(address, "Reset your password", "<a href='" + link + "'>Reset your password</a>", "Reset your password: " + link)
		return json({message: "If that email exists, a reset link has been sent"})

	POST "/auth/reset-password":
		any data = json.tryTextToData(req.body())
		if data == none or data.token == none or data.password == none
			return badRequest("token and password are required")
		string password = data.password.toString()
		if password.length() < 8
			return badRequest("password must be at least 8 characters")

		// 0 when the token is unknown, expired or already used.
		integer userId = auth.consumeResetToken(data.token.toString())
		if userId == 0
			return badRequest("Reset link is invalid or has expired")

		User? foundUser = User.first:
			where:
				id == userId
		onError:
			return badRequest("Reset link is invalid or has expired")
		if foundUser == none
			return badRequest("Reset link is invalid or has expired")
		User user = foundUser!
		user.password_hash = auth.hashPassword(password)
		Database.save(user)
		return json({message: "Password updated"})
