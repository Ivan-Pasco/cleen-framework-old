// Pattern: csrf-protection
// Use when: any server-rendered form that mutates state
// Anti-pattern: DON'T turn csrf: off, or write mutating endpoints as GET routes
//   to dodge the check. A third-party page can submit a form as the logged-in
//   user (CSRF attack); the CSRF token is what tells your form from theirs.
//
// How it works (frame-auth-semantics AUTH-S006 / AUTH-S007):
//   - csrf: is on by default. Each session gets a token, stored server-side.
//   - frame.ui adds <input type="hidden" name="_csrf"> with the session's token
//     to every non-GET form it renders (UI-B011). A form you build yourself
//     embeds auth.csrf.generate() the same way.
//   - clean-server checks POST / PUT / PATCH / DELETE requests that carry the
//     session cookie before the handler runs: the token must come in the
//     _csrf form field or the X-CSRF-Token header, or the answer is
//     403 {"ok":false,"err":{"code":"CSRF_FAIL",...}}.
//   - GET and HEAD need no token, and neither do bearer-token (JWT) requests.

plugins:
	frame.server
	frame.auth
	frame.ui

auth:
	session:
		cookie = "app.sid"
		timeoutMinutes = 60
	csrf:
		enabled = true

page SettingsPage:
	<form method="post" action="/settings">
		<input type="text" name="display_name" placeholder="Display name">
		<button type="submit">Save</button>
	</form>

endpoints:
	// GET: render the form. frame.ui adds the hidden _csrf input.
	GET "/settings":
		if not auth.isAuthenticated()
			return redirect("/login")
		SettingsPage page = SettingsPage()
		return html(page.render())

	// POST: runs only when the request carried the session's CSRF token.
	POST "/settings":
		if not auth.isAuthenticated()
			return unauthorized()
		any form = json.tryTextToData(req.form())
		if form == null or form.display_name == null
			return badRequest("display_name is required")
		string displayName = form.display_name.toString()
		return json({saved: true, display_name: displayName})
