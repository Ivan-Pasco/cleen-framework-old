// Pattern: role-based-access
// Use when: different user types have different permissions to routes or features
// Anti-pattern: DON'T check roles inline: if user.role == "admin" { ... }
//   Inline checks scatter auth logic across handlers, are easy to forget, and
//   can't be audited in one place. Declare roles and their permissions in a
//   roles: block and put the allowed roles on the route header as an inline
//   [role, role] modifier — the check runs before the handler body.

plugins:
	frame.server
	frame.auth

auth:
	session:
		cookie = "app.sid"
		timeoutMinutes = 60

// Every role lists its permissions in full; roles do not inherit (AUTH-R002).
roles:
	admin: ["users.read", "users.write", "users.delete", "reports.read", "settings.write"]
	editor: ["users.read", "reports.read"]
	viewer: ["reports.read"]

endpoints:
	// Public — no role modifier
	GET "/":
		return json({message: "Welcome"})

	// Any signed-in role
	GET "/profile" [viewer, editor, admin]:
		return json({user_id: auth.userId(), role: auth.userRole()})

	// Editor or admin — the listed roles are an OR check
	GET "/reports" [editor, admin]:
		return json({reports: "[]"})

	// Admin only
	GET "/admin/users" [admin]:
		return json({users: "[]"})

	// A permission check inside the handler, for a decision the route header
	// cannot express: auth.can(user, permission) reads the user's role.
	DELETE "/admin/users/:id" [admin]:
		string user = auth.getCurrentUser()
		if not auth.can(user, "users.delete")
			return forbidden()
		return json({deleted: req.param("id")})
