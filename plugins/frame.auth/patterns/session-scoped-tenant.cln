// Pattern: session-scoped-tenant
// Use when: a multi-tenant app where each session belongs to exactly one tenant
// Anti-pattern: DON'T accept a tenant id from the request body, query string or
//   headers. An attacker can forge any value they send. Put the tenant id in
//   the session claims at login; auth.tenant.getId() reads it back from the
//   server-side session, and frame.data scopes every query of a model with a
//   tenantId field to it (AUTH-I003).

plugins:
	frame.server
	frame.auth
	frame.data

auth:
	session:
		cookie = "app.sid"
		timeoutMinutes = 480  // 8 hours of inactivity

data User:
	fields:
		integer id primary generated
		string email required unique
		string password_hash required
		string role default: "user"
		string organisation required

data Project:
	fields:
		integer id primary generated
		string tenantId                 // filled from the session on insert
		string name required

endpoints:
	POST "/auth/login":
		any data = json.tryTextToData(req.body())
		if data == none or data.email == none or data.password == none
			return badRequest("email and password are required")
		string address = data.email.toString()
		User? foundUser = User.first:
			where:
				email == address
		onError:
			return unauthorized()
		if foundUser == none
			return unauthorized()
		User user = foundUser!
		if not auth.verifyPassword(data.password.toString(), user.password_hash)
			return unauthorized()
		// The tenant id goes into the session claims — never trusted from the
		// client again.
		string sid = auth.session.create(user.id, "{\"role\":\"" + user.role + "\",\"tenantId\":\"" + user.organisation + "\"}")
		return auth.session.setCookie(sid, json({message: "Logged in"}))

	// The tenant comes from the session; frame.data adds it to the query.
	GET "/projects" [user, admin]:
		list<Project> projects = Project.find:
			order: name asc
		return json({tenant: auth.tenant.getId(), count: projects.length()})

	// tenantId is filled from the session on insert, whatever the request says.
	POST "/projects" [user, admin]:
		any data = json.tryTextToData(req.body())
		if data == none or data.name == none
			return badRequest("name is required")
		Project project = Project()
		project.name = data.name.toString()
		Database.save(project)
		return json({id: project.id, name: project.name})
