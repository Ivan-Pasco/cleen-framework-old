// Pattern: multilingual-site
// Use when: your app serves content in more than one language
// Anti-pattern: DON'T store translations as a JSON column on the content row.
//   JSON columns cannot be indexed by locale, break FK integrity, and require
//   app-side deserialization on every read. Use a separate translations
//   table — one row per (articleId, locale) pair — so SQL does the filtering.

plugins:
	frame.data

// Language-neutral metadata only — no content fields here
data Article:
	fields:
		integer id primary generated
		string slug required unique
		integer authorId required
		integer publishedAt default: 0

// One row per translation. locale IS the lookup key.
data ArticleTranslation:
	fields:
		integer id primary generated
		integer articleId required
		string locale required          // ISO 639-1: "en", "es", "fr", "pt-BR"
		string title required
		string body required
		string metaDescription

	indexes:
		(articleId, locale) unique

	relations:
		article: belongs_to Article on articleId

functions:
	// The translation for `locale`, falling back to English.
	ArticleTranslation? translationFor(string slug, string locale)
		Article article = Article.findOrFail:
			where:
				slug == slug
		ArticleTranslation translation = ArticleTranslation.first:
			where:
				articleId == article.id
				locale == locale
		if translation == null
			translation = englishTranslation(article.id)
		return translation

	ArticleTranslation? englishTranslation(integer articleId)
		return ArticleTranslation.first:
			where:
				articleId == articleId
				locale == "en"

	// Update the existing translation or create it.
	boolean saveTranslation(integer articleId, string locale, string title, string body)
		ArticleTranslation translation = ArticleTranslation.first:
			where:
				articleId == articleId
				locale == locale
		if translation == null
			translation = ArticleTranslation()
			translation.articleId = articleId
			translation.locale = locale
		translation.title = title
		translation.body = body
		return Database.save(translation)

	// Every locale that has a translation for this article.
	list<ArticleTranslation> listLocales(integer articleId)
		return ArticleTranslation.find:
			select: id, locale
			where:
				articleId == articleId
			order: locale asc
