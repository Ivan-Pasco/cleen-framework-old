// Pattern: multi-tenant
// Use when: one database instance serves multiple isolated customer organisations
// Anti-pattern: DON'T scope by hand with a tenant id taken from the request.
//   Give every tenant-owned model a `tenantId` field. frame.data then fills
//   it from the session on insert (tenant_getId(), frame.auth) and adds
//   `tenantId = <session tenant>` to every query, update and delete of that
//   model (DAT-I001). Without a session the tenant is empty, so other
//   tenants' rows stay invisible (DAT-C004).

plugins:
	frame.auth
	frame.data

auth:
	session:
		cookie = "app.sid"

data Project:
	fields:
		integer id primary generated
		string tenantId                 // filled from the session on insert
		string name required
		string summary

	indexes:
		(tenantId, name)

data ProjectMember:
	fields:
		integer id primary generated
		string tenantId
		integer projectId required
		integer userId required
		string role required            // "owner", "editor", "viewer"

	relations:
		project: belongs_to Project on projectId

functions:
	// Only the session tenant's projects are returned — no tenant filter needed.
	list<Project> listProjects()
		return Project.find:
			order: name asc

	// tenantId is taken from the session, never from the caller.
	integer createProject(string name, string summary)
		Project project = Project()
		project.name = name
		project.summary = summary
		Database.save(project)
		return project.id

	// A project id from another tenant simply matches no row.
	Project? getProject(integer projectId)
		return Project.first:
			where:
				id == projectId
