// Pattern: tree-structure
// Use when: data has a parent-child hierarchy — categories, menus, org
//   charts, comment threads, folder structures
// Anti-pattern: DON'T use recursive self-joins at query time for deep trees.
//   Recursion needs one round trip per level or a WITH RECURSIVE query that
//   re-scans the table per level. For shallow trees (≤3 levels) parentId is
//   fine. For deep or frequently-traversed trees add a closure table: one row
//   per (ancestorId, descendantId, depth), so "all descendants" is a single
//   indexed join.

plugins:
	frame.data

// Shallow tree (≤3 levels) — parentId is sufficient
data Category:
	fields:
		integer id primary generated
		integer parentId default: 0     // 0 = root category
		string name required
		string slug required unique
		integer sortOrder default: 0

	indexes:
		parentId

// Closure table for deep trees — one row per ancestor/descendant pair
data CategoryClosure:
	fields:
		integer id primary generated
		integer ancestorId required
		integer descendantId required
		integer depth required          // 0 = self, 1 = child, 2 = grandchild, ...

	indexes:
		(ancestorId, depth)

functions:
	// SHALLOW TREE: direct children (one query).
	list<Category> children(integer parentId)
		return Category.find:
			where:
				parentId == parentId
			order: sortOrder asc

	// SHALLOW TREE: root level.
	list<Category> roots()
		return Category.find:
			where:
				parentId == 0
			order: sortOrder asc

	// DEEP TREE: every descendant of a node, through the closure table.
	list<Category> descendants(integer ancestorId)
		return Category.find:
			join:
				CategoryClosure as cl:
					on:
						cl.descendantId == Category.id
			where:
				cl.ancestorId == ancestorId
				cl.depth > 0
			order: cl.depth asc

	// DEEP TREE: insert a node and its closure rows in one transaction.
	integer insertCategory(integer parentId, string name, string slug)
		Category node = Category()
		transaction:
			node.parentId = parentId
			node.name = name
			node.slug = slug
			Database.save(node)
			CategoryClosure self = CategoryClosure()
			self.ancestorId = node.id
			self.descendantId = node.id
			self.depth = 0
			Database.save(self)
			// Copy the parent's ancestors one level deeper.
			db.execute("INSERT INTO category_closures (ancestorId, descendantId, depth) SELECT ancestorId, ?, depth + 1 FROM category_closures WHERE descendantId = ?", json.dataToText([(node.id), parentId]))
		return node.id
