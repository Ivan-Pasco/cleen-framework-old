// Pattern: soft-delete
// Use when: records must be deactivatable without permanent removal
//   (compliance requirements, undo flows, audit trails)
// Anti-pattern: DON'T use a boolean isDeleted column.
//   A boolean loses the deletion time — you can never answer "when was this
//   deleted?". Store the deletion time instead: 0 means active, any other
//   value is the Unix time of the deletion.

plugins:
	frame.data

data User:
	fields:
		integer id primary generated
		string email required unique
		string name required
		integer deletedAt default: 0    // 0 = active, otherwise when it was deleted
		integer createdAt default: 0

	indexes:
		deletedAt

	queries:
		list<User> active()
			return find:
				where:
					deletedAt == 0
				order: name asc

functions:
	// Soft-delete: load, mark, save — the row stays in the table.
	boolean softDeleteUser(integer userId)
		User user = User.findOrFail:
			where:
				id == userId
		user.deletedAt = now()
		return Database.save(user)

	// Restore a soft-deleted user.
	boolean restoreUser(integer userId)
		User user = User.findOrFail:
			where:
				id == userId
		user.deletedAt = 0
		return Database.save(user)

	// Admin view: every user, deleted ones last.
	list<User> listAllUsersWithStatus()
		return User.find:
			order: deletedAt asc

	// Hard delete only when legally required (e.g. GDPR right to erasure).
	boolean hardDeleteUser(integer userId)
		User user = User.findOrFail:
			where:
				id == userId
		return Database.deleteOrFail(user)
