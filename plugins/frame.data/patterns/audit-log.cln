// Pattern: audit-log
// Use when: every state change on a record must be traceable for compliance,
//   debugging, or undo (financial transactions, account changes, orders)
// Anti-pattern: DON'T overwrite history in place.
//   The source table holds current state; an append-only *Event table holds
//   every transition. Events are only ever inserted — never updated or
//   deleted.

plugins:
	frame.data

// Current state — one row per order
data Order:
	fields:
		integer id primary generated
		integer customerId required
		string status required          // "pending", "paid", "shipped", "cancelled"
		integer totalCents required
		integer updatedAt default: 0

// Append-only history — one row per state transition
data OrderEvent:
	fields:
		integer id primary generated
		integer orderId required
		integer actorId required
		string previousStatus
		string newStatus required
		string metadata                 // JSON text for extra context
		integer occurredAt required

	indexes:
		(orderId, occurredAt)

	relations:
		order: belongs_to Order on orderId

functions:
	// Change the status and record the event in one transaction.
	boolean transitionOrder(integer orderId, integer actorId, string newStatus)
		transaction:
			Order order = Order.findOrFail:
				where:
					id == orderId
			OrderEvent event = OrderEvent()
			event.orderId = orderId
			event.actorId = actorId
			event.previousStatus = order.status
			event.newStatus = newStatus
			event.occurredAt = now()
			Database.save(event)
			order.status = newStatus
			order.updatedAt = now()
			Database.save(order)
		return true

	// Full audit trail, oldest first.
	list<OrderEvent> orderHistory(integer orderId)
		return OrderEvent.find:
			where:
				orderId == orderId
			order: occurredAt asc

	// Status at a point in time: the last event at or before it.
	string statusAt(integer orderId, integer pointInTime)
		OrderEvent? foundEvent = OrderEvent.first:
			where:
				orderId == orderId
				occurredAt <= pointInTime
			order: occurredAt desc
		if foundEvent == none
			return "unknown"
		OrderEvent event = foundEvent!
		return event.newStatus
