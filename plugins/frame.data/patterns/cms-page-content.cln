// Pattern: cms-page-content
// Use when: a website serves the same pages in multiple languages and content
//   is managed as a flat key-value table (Page × Language × fieldKey)
// Anti-pattern: DON'T store all content in a JSON blob per language per page.
//   A JSON blob can't be queried field-by-field, has no FK integrity, requires
//   full deserialization to read one string, and makes "which fields are
//   missing a translation?" unanswerable without parsing every row.
//   DON'T use dot notation in field keys — use underscores ("hero_title").
//   DON'T hardcode any user-visible string in Clean code — all copy lives in
//   PageField rows.

plugins:
	frame.data

// Language-neutral page registry — no content here
data Page:
	fields:
		integer id primary generated
		string slug required unique
		string template required
		boolean isActive default: true
		integer sortOrder default: 0

data Language:
	fields:
		integer id primary generated
		string code required unique     // ISO 639-1: "en", "es", "fr"
		string name required
		boolean isDefault default: false
		boolean isActive default: true

// One row per (page × language × field).
// fieldKey naming — underscores as path separators, never dots:
//   Scalars:  "hero_title", "hero_subtitle", "meta_description"
//   Arrays:   "features_0_title", "features_0_description", "features_1_title"
//   UI chrome lives on slug "ui": "nav_home", "footer_docs", "copy_toast"
data PageField:
	fields:
		integer id primary generated
		integer pageId required
		integer languageId required
		string fieldKey required
		string fieldValue required

	indexes:
		(pageId, languageId, fieldKey) unique

	relations:
		page: belongs_to Page on pageId
		language: belongs_to Language on languageId

functions:
	// All content of one page in one language, in a single query.
	pairs<string, string> pageContent(string slug, string lang)
		list<PageField> rows = PageField.find:
			join:
				Page as p:
					on:
						p.id == PageField.pageId
				Language as l:
					on:
						l.id == PageField.languageId
			where:
				p.slug == slug
				l.code == lang
				p.isActive == true
				l.isActive == true
		pairs<string, string> fields = {}
		iterate row in rows
			fields.set(row.fieldKey, row.fieldValue)
		return fields

	// Array fields: read "<array>_<index>_<field>" keys until one is missing.
	integer featureCount(string lang)
		pairs<string, string> c = pageContent("home", lang)
		integer i = 0
		string title = c.get("features_0_title") default ""
		while title != ""
			i = i + 1
			title = c.get("features_" + i.toString() + "_title") default ""
		return i

	// Write path: update the field translation or create it.
	boolean saveField(integer pageId, integer languageId, string fieldKey, string fieldValue)
		PageField field = PageField.first:
			where:
				pageId == pageId
				languageId == languageId
				fieldKey == fieldKey
		if field == null
			field = PageField()
			field.pageId = pageId
			field.languageId = languageId
			field.fieldKey = fieldKey
		field.fieldValue = fieldValue
		return Database.save(field)

	// Keys present in the default language but missing in `languageId`.
	string missingTranslations(integer pageId, integer languageId, integer defaultLanguageId)
		return db.query("SELECT d.fieldKey FROM page_fields d WHERE d.pageId = ? AND d.languageId = ? AND NOT EXISTS (SELECT 1 FROM page_fields t WHERE t.pageId = d.pageId AND t.languageId = ? AND t.fieldKey = d.fieldKey)", json.dataToText([pageId, defaultLanguageId, languageId]))
