// Pattern: pagination
// Use when: an endpoint returns a list that can grow — paginate: for
//   page-number UI (admin tables, search results), cursor: for infinite
//   scroll or any table that will exceed ~1M rows.
// Anti-pattern: DON'T compute offset: (page - 1) * perPage and run a
//   separate count: query. paginate: fetches the page and the total in one
//   bridge call. For very large tables DON'T use paginate: at all — its COUNT
//   scan is O(N); cursor: skips the count and seeks by an indexed column.

plugins:
	frame.data

data Post:
	fields:
		integer id primary generated
		integer authorId required
		string title required
		integer publishedAt default: 0  // 0 = draft

	indexes:
		publishedAt

functions:
	// Offset pagination — PagedResult<Post>: items, totalCount, totalPages,
	// currentPage, perPage, hasNext, hasPrev.
	PagedResult<Post> listPublishedPaged(integer page, integer perPage)
		return Post.paginate:
			where:
				publishedAt > 0
			order: publishedAt desc
			paginate:
				page: page
				perPage: perPage

	// Cursor pagination — CursorResult<Post>: items, nextCursor, hasNext,
	// hasPrev, count. Pass nextCursor back as `after` for the next page.
	CursorResult<Post> listPublishedCursor(string afterCursor, integer perPage)
		return Post.cursor:
			where:
				publishedAt > 0
			cursor:
				after: afterCursor
				perPage: perPage
				by: id
