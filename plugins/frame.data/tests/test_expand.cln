// Plugin-internal tests for frame.data: the plugin-time helpers that turn
// the data/query DSL into SQL and Clean source. scripts/test-plugins.sh
// combines this file with src/main.cln. Runtime behaviour (SQL against a
// real database) is covered by tests/framework/unit/plugins/data/.
// Fixed: called expand_block(), which v3 typed emission removed; the tests
// now exercise the helpers behind expand_block_typed.

start:
	integer failures = 0
	failures = failures + check(validate_block("data", "User", "").contains("at least one field is required"), "validate: empty data block")
	failures = failures + check(validate_block("data", "", "fields:\n\tstring name").contains("model name is required"), "validate: missing model name")
	failures = failures + check(validate_block("data", "User", "fields:\n\tstring name\nrelations:\n\tposts: has_lots Post on userId").contains("invalid cardinality"), "validate: relation cardinality")
	failures = failures + check(validate_block("data", "User", "fields:\n\tstring name\nindexes:\n\temail").contains("email"), "validate: index on unknown column")
	failures = failures + check(validate_block("migrate", "\"001\"", "up:\n\t\"CREATE TABLE t (id INTEGER)\"").contains("down:"), "validate: migrate needs down:")
	failures = failures + check(validate_block("data", "User", "fields:\n\tstring name required") == "", "validate: valid data block")

	failures = failures + check(default_table_name("User") == "users", "table: User -> users")
	failures = failures + check(default_table_name("UserData") == "users", "table: UserData -> users")
	failures = failures + check(default_table_name("AccessTokenData") == "access_tokens", "table: AccessTokenData -> access_tokens")
	failures = failures + check(default_table_name("Category") == "categories", "table: Category -> categories")

	failures = failures + check(sql_lit("SELECT * FROM \{\{T:User\}\} WHERE x = 1") == "\"SELECT * FROM \" + __User_table() + \" WHERE x = 1\"", "sql_lit: table marker")
	failures = failures + check(clean_str("a\"b\{c\}") == "\"a\\\"b\\\{c\\\}\"", "clean_str: escapes")

	string lit_where = build_where_expr("name == \"O'Brien\"", "", "sql")
	failures = failures + check(lit_where == "\"name = 'O''Brien'\"", "where: literal quote doubled")
	// Run-time values are bound: `?` in the SQL, the value in "params".
	// Fixed: also asserted an "inline" part that quoted values into the
	// paginate/cursor `__where` text; HOST_BRIDGE.md now binds those values
	// from `__params` (Decision 17), so there is no inline part any more.
	failures = failures + check(build_where_expr("name == who", "", "sql") == "\"name = ?\"", "where: runtime value is a placeholder")
	failures = failures + check(build_where_expr("name == who", "", "params") == "json.dataToText(who)", "where: runtime value is a param")
	failures = failures + check(build_where_expr("name == \"x\"", "", "params") == "", "where: literal has no param")
	failures = failures + check(build_where_expr("a == x and b in [y, \"k\"]", "", "params") == "json.dataToText(x) + \",\" + json.dataToText(y)", "where: params in placeholder order")
	failures = failures + check(build_where_expr("a in [x, \"k\"]", "", "sql") == "\"a IN (?, 'k')\"", "where: in list placeholders")
	// Parenthesised groups (DAT-Q009).
	failures = failures + check(strip_parens("(a) or (b)") == "(a) or (b)", "parens: non-matching outer pair kept")
	failures = failures + check(strip_parens("((a == 1))") == "a == 1", "parens: wrapping pairs stripped")
	failures = failures + check(strip_parens("(t == \")\")") == "t == \")\"", "parens: string literal paren ignored")
	failures = failures + check(build_where_expr("(a == 1) or (b == 2)", "", "sql") == "\"(\" + \"a = 1\" + \" OR \" + \"b = 2\" + \")\"", "where: (a) or (b)")
	failures = failures + check(build_where_expr("(a == 1 or b == 2) and c == 3", "", "sql").contains("\" AND \" + \"c = 3\""), "where: group and term")
	failures = failures + check(sql_quote_strings("x = \"it's\"") == "x = 'it''s'", "bare expression: quote doubled")
	failures = failures + check(build_where_expr("deletedAt == null", "", "sql") == "\"deletedAt IS NULL\"", "where: == null")
	failures = failures + check(build_where_expr("status in [\"a\", \"b\"]", "", "sql").contains("IN ('a', 'b')"), "where: in list")
	failures = failures + check(build_where_expr("a == 1 or b == 2", "", "sql").startsWith("\"(\""), "where: or grouped")
	failures = failures + check(build_where_expr("props.color == \"red\"", "", "sql").contains("JSON_EXTRACT(props, '$.color')"), "where: json path")
	failures = failures + check(build_where_expr("c.name == \"x\"", "c", "sql").contains("c.name = 'x'"), "where: join alias kept")
	failures = failures + check(build_where_expr("expiresAt > time.now().add_seconds(900)", "", "sql").contains("NOW() + INTERVAL '900 seconds'"), "where: datetime arithmetic")

	string find_expr = query_expr("Post", "find", "where:\n\tviews > 10\norder: views desc\nlimit: n")
	failures = failures + check(find_expr.startsWith("__parse_as_Post(_db_query("), "find: materialized as list<Post>")
	failures = failures + check(find_expr.contains("__Post_table()"), "find: table through __Post_table()")
	failures = failures + check(find_expr.contains(" ORDER BY views DESC"), "find: order")
	failures = failures + check(find_expr.contains("__frame_data_row_count(\"limit\", (n).toString())"), "find: limit expression checked as a row count")
	failures = failures + check(find_expr.contains("__frame_data_params(__Post_tenant_param(), json.dataToText(10))") == false, "find: literal where value not bound")
	// having: (frame-data.ebnf §5.7) is a bound condition like where:.
	string having_expr = query_expr("Post", "find", "group: views\nhaving: views > minViews")
	failures = failures + check(having_expr.contains(" HAVING \" + \"views > ?\""), "having: placeholder")
	failures = failures + check(having_expr.contains("__frame_data_params(__Post_tenant_param(), json.dataToText(minViews))"), "having: value bound")
	// include: (DAT-Q008/Q020) uses the declared relation helper.
	string inc_expr = query_expr("Author", "find", "include: books\nwhere:\n\tbooks.title == t")
	failures = failures + check(inc_expr.contains("__Author_include_books()"), "include: declared relation join")
	failures = failures + check(inc_expr.contains(" IN (SELECT "), "include: parents once (semi-join)")
	failures = failures + check(include_scope_error("Author", "include: books\norder: books.title") != "", "include: order by relation column rejected")
	failures = failures + check(include_scope_error("Author", "include: books\ngroup: id\norder: books.title") == "", "include: grouped query may use relation columns")
	failures = failures + check(query_expr("Post", "first", "order: id desc").contains(" LIMIT 1"), "first: LIMIT 1")
	failures = failures + check(query_expr("Post", "findOrFail", "").startsWith("__find_or_fail_as_Post("), "findOrFail helper")
	failures = failures + check(query_expr("Post", "count", "") == "__Post_count(\"\", \"\")", "count helper")
	failures = failures + check(query_expr("Post", "paginate", "paginate:\n\tpage: p\n\tperPage: 10").contains(", p, 10))"), "paginate: page/perPage")
	// paginate:/cursor: where: values travel in `__params` and are bound by
	// the host; the `__where` text has numbered placeholders, never values.
	string pag_expr = query_expr("Post", "paginate", "where:\n\ttitle == t\n\tviews > minViews\npaginate:\n\tpage: 1\n\tperPage: 10")
	failures = failures + check(pag_expr.contains("__frame_data_sql(__Post_cond(\"title = ?\" + \" AND \" + \"views > ?\"), 0)"), "paginate: where values are placeholders")
	failures = failures + check(pag_expr.contains("\",\\\"__params\\\":\" + __frame_data_params(__Post_tenant_param(), json.dataToText(t) + \",\" + json.dataToText(minViews))"), "paginate: where values in __params")
	failures = failures + check(pag_expr.contains(".replace(") == false, "paginate: no value quoted into SQL")
	string cur_expr = query_expr("Post", "cursor", "where:\n\tauthor == who\ncursor:\n\tafter: c\n\tperPage: 5")
	failures = failures + check(cur_expr.contains("__frame_data_params(__Post_tenant_param(), json.dataToText(who))") and cur_expr.contains(".replace(") == false, "cursor: where values in __params")
	// Fixed: expected `, 5, c, "id")` — the cursor column goes through
	// __Post_cols (DAT-M017 `as "column"`); this file was only type-checked
	// before, so the stale expectation never ran.
	failures = failures + check(query_expr("Post", "cursor", "cursor:\n\tafter: c\n\tperPage: 5\n\tby: id").contains(", 5, c, __Post_cols(\"id\")), c)"), "cursor: by identifier quoted, column resolved")
	string join_expr = query_expr("Post", "find", "join:\n\tUser as author left:\n\t\ton:\n\t\t\tauthor.id == Post.authorId")
	failures = failures + check(join_expr.contains("LEFT JOIN \" + __User_table() + \" author ON author.id = \" + __Post_table() + \".authorId"), "join: aliased left join")

	failures = failures + check(rewrite_query_method_body("return find:\n\twhere:\n\t\tx == 1\n", "Post").startsWith("return __parse_as_Post("), "queries: model-less find")
	failures = failures + check(rewrite_query_method_body("return db.query(\"SELECT 1\", \"[]\")\n", "Post") == "", "queries: plain body untouched")

	failures = failures + check(has_nested_transaction("a = 1\ntransaction:\n\tb = 2"), "transaction: nesting detected")
	failures = failures + check(migration_sql("\"CREATE TABLE a (id INTEGER)\"\n\"CREATE INDEX i ON a (id)\"") == "CREATE TABLE a (id INTEGER); CREATE INDEX i ON a (id)", "migrate: string-literal statements")
	// Fixed: was `migration_sql("createTable(\"a\")").startsWith("ERR:")` —
	// schema helpers (frame-data.ebnf §7 schema_helper_call) are now
	// implemented; a createTable without columns is still an error.
	failures = failures + check(migration_sql("createTable(\"a\")").startsWith("ERR:"), "migrate: createTable needs columns")
	failures = failures + check(migration_sql("createTable(\"a\", \"string code primary\", \"string name required\")") == "CREATE TABLE a (code TEXT PRIMARY KEY, name TEXT NOT NULL)", "migrate: createTable")
	failures = failures + check(migration_sql("createTable(\"a\", \"integer id primary generated\")").contains(auto_pk_marker()), "migrate: createTable generated key per engine")
	failures = failures + check(migration_sql("addColumn(\"a\", \"n\", integer, required, default(0))") == "ALTER TABLE a ADD COLUMN n INTEGER NOT NULL DEFAULT 0", "migrate: addColumn")
	failures = failures + check(migration_sql("renameColumn(\"a\", \"x\", \"y\")\ndropColumn(\"a\", \"y\")") == "ALTER TABLE a RENAME COLUMN x TO y; ALTER TABLE a DROP COLUMN y", "migrate: rename/drop column")
	failures = failures + check(migration_sql("createIndex(\"a\", [\"x\", \"y\"], unique)") == "CREATE UNIQUE INDEX uniq_a_x_y ON a (x, y)", "migrate: createIndex unique")
	failures = failures + check(migration_sql("dropIndex(\"a\", [\"x\"])") == "DROP INDEX idx_a_x", "migrate: dropIndex")
	failures = failures + check(migration_sql("addForeignKey(\"posts\", \"user_id\", \"users.id\", \"cascade\")") == "ALTER TABLE posts ADD CONSTRAINT fk_posts_user_id FOREIGN KEY (user_id) REFERENCES users (id) ON DELETE CASCADE", "migrate: addForeignKey")
	failures = failures + check(migration_sql("dropForeignKey(\"posts\", \"user_id\")") == "ALTER TABLE posts DROP CONSTRAINT fk_posts_user_id", "migrate: dropForeignKey")
	failures = failures + check(migration_sql("execute(\"DELETE FROM a\")\ndropTable(\"a\")") == "DELETE FROM a; DROP TABLE a", "migrate: execute/dropTable")
	failures = failures + check(migration_sql("dropColumn(\"a\")").startsWith("ERR:"), "migrate: helper arity checked")

	// DAT-M017 `as "column"`, DAT-E002 primary keys.
	string renamed = synthesize_v1_body_from_v2_fields("integer id primary generated\nstring passwordHash as \"password_hash\" required\n")
	failures = failures + check(extract_field_columns(renamed) == "id,password_hash", "as: column names")
	failures = failures + check(generate_field_definitions(renamed, "id", "auto") == "password_hash TEXT NOT NULL", "as: column definition")
	string keyed = synthesize_v1_body_from_v2_fields("uuid id primary generated\nstring label\n")
	failures = failures + check(pk_kind_of(keyed, pk_field_of(keyed), "uuid") == "uuid", "primary: generated uuid key")
	string assigned = synthesize_v1_body_from_v2_fields("string code primary\nstring name\n")
	failures = failures + check(pk_field_of(assigned) == "code" and pk_kind_of(assigned, "code", "string") == "assigned", "primary: assigned string key")

	// DAT-Q006: offset: without limit: warns, and still returns every
	// remaining row (SQLite needs a LIMIT before OFFSET).
	failures = failures + check(offset_without_limit("order: id asc\noffset: 2"), "offset: without limit detected")
	failures = failures + check(not offset_without_limit("limit: 5\noffset: 2"), "offset: with limit accepted")
	failures = failures + check(query_expr("Post", "find", "offset: 2").contains("LIMIT 9223372036854775807\" + \" OFFSET 2"), "offset: without limit keeps every remaining row")

	if failures == 0
		printl("PASS: frame-data-plugin-helpers")
	else
		printl("FAIL: frame-data-plugin-helpers (" + failures.toString() + " failed)")

functions:
	integer check(boolean ok, string name)
		if ok
			return 0
		printl("FAIL: " + name)
		return 1
