// Plugin-internal tests for frame.data: the plugin-time helpers that turn
// the data/query DSL into SQL and Clean source. scripts/test-plugins.sh
// combines this file with src/main.cln. Runtime behaviour (SQL against a
// real database) is covered by tests/framework/unit/plugins/data/.
// Fixed: called expand_block(), which v3 typed emission removed; the tests
// now exercise the helpers behind expand_block_typed.

start:
	integer failures = 0
	failures = failures + check(validate_block("data", "User", "").contains("at least one field is required"), "validate: empty data block")
	failures = failures + check(validate_block("data", "", "fields:\n\tstring name").contains("model name is required"), "validate: missing model name")
	failures = failures + check(validate_block("data", "User", "fields:\n\tstring name\nrelations:\n\tposts: has_lots Post on userId").contains("invalid cardinality"), "validate: relation cardinality")
	failures = failures + check(validate_block("data", "User", "fields:\n\tstring name\nindexes:\n\temail").contains("email"), "validate: index on unknown column")
	failures = failures + check(validate_block("migrate", "\"001\"", "up:\n\t\"CREATE TABLE t (id INTEGER)\"").contains("down:"), "validate: migrate needs down:")
	failures = failures + check(validate_block("data", "User", "fields:\n\tstring name required") == "", "validate: valid data block")

	failures = failures + check(default_table_name("User") == "users", "table: User -> users")
	failures = failures + check(default_table_name("UserData") == "users", "table: UserData -> users")
	failures = failures + check(default_table_name("AccessTokenData") == "access_tokens", "table: AccessTokenData -> access_tokens")
	failures = failures + check(default_table_name("Category") == "categories", "table: Category -> categories")

	failures = failures + check(sql_lit("SELECT * FROM \{\{T:User\}\} WHERE x = 1") == "\"SELECT * FROM \" + __User_table() + \" WHERE x = 1\"", "sql_lit: table marker")
	failures = failures + check(clean_str("a\"b\{c\}") == "\"a\\\"b\\\{c\\\}\"", "clean_str: escapes")

	string lit_where = build_where_expr("name == \"O'Brien\"", "")
	failures = failures + check(lit_where == "\"name = 'O''Brien'\"", "where: literal quote doubled")
	string var_where = build_where_expr("name == who", "")
	failures = failures + check(var_where.contains("(who).toString().replace(\"'\", \"''\")"), "where: runtime value quoted")
	failures = failures + check(build_where_expr("deletedAt == null", "") == "\"deletedAt IS NULL\"", "where: == null")
	failures = failures + check(build_where_expr("status in [\"a\", \"b\"]", "").contains("IN ('a', 'b')"), "where: in list")
	failures = failures + check(build_where_expr("a == 1 or b == 2", "").startsWith("\"(\""), "where: or grouped")
	failures = failures + check(build_where_expr("props.color == \"red\"", "").contains("JSON_EXTRACT(props, '$.color')"), "where: json path")
	failures = failures + check(build_where_expr("c.name == \"x\"", "c").contains("c.name = 'x'"), "where: join alias kept")
	failures = failures + check(build_where_expr("expiresAt > time.now().add_seconds(900)", "").contains("NOW() + INTERVAL '900 seconds'"), "where: datetime arithmetic")

	string find_expr = query_expr("Post", "find", "where:\n\tviews > 10\norder: views desc\nlimit: n")
	failures = failures + check(find_expr.startsWith("__parse_as_Post(_db_query("), "find: materialized as list<Post>")
	failures = failures + check(find_expr.contains("__Post_table()"), "find: table through __Post_table()")
	failures = failures + check(find_expr.contains(" ORDER BY views DESC"), "find: order")
	failures = failures + check(find_expr.contains("(n).toString()"), "find: limit expression")
	failures = failures + check(query_expr("Post", "first", "order: id desc").contains(" LIMIT 1"), "first: LIMIT 1")
	failures = failures + check(query_expr("Post", "findOrFail", "").startsWith("__find_or_fail_as_Post("), "findOrFail helper")
	failures = failures + check(query_expr("Post", "count", "") == "__Post_count(\"\")", "count helper")
	failures = failures + check(query_expr("Post", "paginate", "paginate:\n\tpage: p\n\tperPage: 10").contains(", p, 10))"), "paginate: page/perPage")
	failures = failures + check(query_expr("Post", "cursor", "cursor:\n\tafter: c\n\tperPage: 5\n\tby: id").contains(", 5, c, \"id\")"), "cursor: by identifier quoted")
	string join_expr = query_expr("Post", "find", "join:\n\tUser as author left:\n\t\ton:\n\t\t\tauthor.id == Post.authorId")
	failures = failures + check(join_expr.contains("LEFT JOIN \" + __User_table() + \" author ON author.id = \" + __Post_table() + \".authorId"), "join: aliased left join")

	failures = failures + check(rewrite_query_method_body("return find:\n\twhere:\n\t\tx == 1\n", "Post").startsWith("return __parse_as_Post("), "queries: model-less find")
	failures = failures + check(rewrite_query_method_body("return db.query(\"SELECT 1\", \"[]\")\n", "Post") == "", "queries: plain body untouched")

	failures = failures + check(has_nested_transaction("a = 1\ntransaction:\n\tb = 2"), "transaction: nesting detected")
	failures = failures + check(migration_sql("\"CREATE TABLE a (id INTEGER)\"\n\"CREATE INDEX i ON a (id)\"") == "CREATE TABLE a (id INTEGER); CREATE INDEX i ON a (id)", "migrate: string-literal statements")
	failures = failures + check(migration_sql("createTable(\"a\")").startsWith("ERR:"), "migrate: schema helper rejected")

	if failures == 0
		printl("PASS: frame-data-plugin-helpers")
	else
		printl("FAIL: frame-data-plugin-helpers (" + failures.toString() + " failed)")

functions:
	integer check(boolean ok, string name)
		if ok
			return 0
		printl("FAIL: " + name)
		return 1
