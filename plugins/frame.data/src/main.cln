// frame.data plugin — ORM / database DSL
// ABI: Plugin Contracts v3 — typed AST emission (typed-emission.md)
//
// Spec:
//   foundation/spec/framework/grammar/frame-data.ebnf      — syntax
//   foundation/spec/framework/frame-data-semantics.md      — DAT-* rules
//   foundation/spec/framework/plugin-contract.md §4.5      — instance_class
//
// What this plugin emits:
//   - `data M:`  → class M (fields, save/delete/migrate) plus top-level
//     helpers: __M_table, __M_cond, __M_where, __parse_as_M, __first_as_M,
//     __find_or_fail_as_M, __M_count, __M_exists, PagedResult_M,
//     CursorResult_M, __paged_as_M, __cursor_as_M. Methods declared in the
//     `queries:` sub-block become class methods (DAT-A006).
//   - `M.find:` / `first:` / `findOrFail:` / `count:` / `exists:` /
//     `paginate:` / `cursor:` → one Clean expression that builds the SQL at
//     run time and materializes the result through the helpers above.
//   - `transaction:`, `migrate "name":`, `db.query:`, `db.queryAs(T):`.
//   - `can Persist` + `class Database` (module helpers, DAT-S000/S011).
//
// Every query references its table through `__M_table()`, so the `table`
// sub-block (DAT-M018) holds for every query, including ones in other files.
// Runtime values are spliced into SQL as quoted literals with `'` doubled,
// and into JSON parameter arrays through json.dataToText.

external:
	// Declaration emitters (typed-emission.md §3.5, §3.11, §3.13, §3.18)
	integer _emit_function(integer ctx, string name, string params_json, integer return_type, integer body_stmt_handle, integer flags)
	integer _emit_class_full(integer ctx, integer class_spec_handle_or_lp, integer flags)
	integer _emit_statement_into_start(integer ctx, integer stmt_handle)
	integer _emit_stmt_from_source(integer ctx, string source, integer origin_offset)
	integer _emit_capability(integer ctx, string capability_spec)
	// Type constructors (§3.9)
	integer _type_string(integer ctx)
	integer _type_integer(integer ctx)
	integer _type_boolean(integer ctx)
	integer _type_array(integer ctx, integer elem_type_handle)
	integer _type_class_ref(integer ctx, string name)
	// Diagnostics (§5) and sticky-error context (§3.15)
	integer _emit_error(integer ctx, integer severity, string code, string message, string span)
	integer _ctx_set_error_context(integer ctx, string code, string message)
	integer _ctx_had_error(integer ctx)
	// Batch builders (§3.14)
	integer _batch_stringLit(integer ctx, string value)
	integer _batch_stmtCall(integer ctx, string callee, integer args_array_handle)
	integer _batch_args(integer ctx, string exprs_lp)
	// Read-only AST accessors for lint_project (lint-extension.md §4)
	string _ast_list_classes(integer handle)
	string _ast_class_fields(integer handle, string class_name)
	string _ast_list_blocks(integer handle, string block_name)

// ============================================================================
// LIFECYCLE SLOTS (typed-emission.md §7)
// ============================================================================

functions:
	// Emits the write-path contract once per file that loads frame.data
	// (identical declarations across files are merged, plugin-contract.md §3.1):
	//   can Persist:  boolean save() / boolean delete()          (DAT-S000)
	//   class Database: save, delete, deleteOrFail, saveAll, deleteAll
	//                   (DAT-S001..S006, DAT-S011)
	integer emit_module_helpers_typed(integer ctx, string ctx_json)
		// Emit `can Persist:` capability contract (Amendment 13, §3.18).
		// Contract-only in v1 of the bridge — no default bodies. Every
		// class that declares `can Persist` must implement save() and delete()
		// (SEM011 fires otherwise).
		string persist_spec = "{\"name\":\"Persist\",\"methods\":["
		persist_spec = persist_spec + "{\"name\":\"save\",\"params\":[],\"return_type\":\"boolean\"}"
		persist_spec = persist_spec + ",{\"name\":\"delete\",\"params\":[],\"return_type\":\"boolean\"}"
		persist_spec = persist_spec + "]}"
		_emit_capability(ctx, persist_spec)
		if _ctx_had_error(ctx) != 0
			return 1

		// Method body for Database.save(Persist target): return target.save()
		string save_src = "return target.save()\n"
		integer save_body_h = _emit_stmt_from_source(ctx, save_src, 0)
		if _ctx_had_error(ctx) != 0
			return 1
		if save_body_h == 0
			return 1

		// Method body for Database.delete(Persist target): return target.delete()
		string delete_src = "return target.delete()\n"
		integer delete_body_h = _emit_stmt_from_source(ctx, delete_src, 0)
		if _ctx_had_error(ctx) != 0
			return 1
		if delete_body_h == 0
			return 1

		// Method body for Database.deleteOrFail(Persist target):
		//   boolean ok = target.delete()
		//   if not ok
		//     error("NOT_FOUND")
		//   return ok
		string dof_src = "boolean ok = target.delete()\nif not ok\n\terror(\"NOT_FOUND\")\nreturn ok\n"
		integer dof_body_h = _emit_stmt_from_source(ctx, dof_src, 0)
		if _ctx_had_error(ctx) != 0
			return 1
		if dof_body_h == 0
			return 1

		// Method body for Database.saveAll(list<Persist> targets):
		//   integer count = 0
		//   iterate target in targets
		//     if target.save()
		//       count = count + 1
		//   return count
		string sa_src = "integer count = 0\niterate target in targets\n\tif target.save()\n\t\tcount = count + 1\nreturn count\n"
		integer sa_body_h = _emit_stmt_from_source(ctx, sa_src, 0)
		if _ctx_had_error(ctx) != 0
			return 1
		if sa_body_h == 0
			return 1

		// Method body for Database.deleteAll(list<Persist> targets):
		//   integer count = 0
		//   iterate target in targets
		//     if target.delete()
		//       count = count + 1
		//   return count
		string da_src = "integer count = 0\niterate target in targets\n\tif target.delete()\n\t\tcount = count + 1\nreturn count\n"
		integer da_body_h = _emit_stmt_from_source(ctx, da_src, 0)
		if _ctx_had_error(ctx) != 0
			return 1
		if da_body_h == 0
			return 1

		// Assemble the Database class spec JSON.
		string db_spec = "{\"name\":\"Database\""
		db_spec = db_spec + ",\"parent\":null"
		db_spec = db_spec + ",\"fields\":[]"
		db_spec = db_spec + ",\"methods\":["
		db_spec = db_spec + "{\"kind\":\"inline\",\"name\":\"save\",\"params\":[{\"name\":\"target\",\"type\":\"Persist\"}],\"return_type\":\"boolean\",\"body_handle\":" + save_body_h.toString() + "}"
		db_spec = db_spec + ",{\"kind\":\"inline\",\"name\":\"delete\",\"params\":[{\"name\":\"target\",\"type\":\"Persist\"}],\"return_type\":\"boolean\",\"body_handle\":" + delete_body_h.toString() + "}"
		db_spec = db_spec + ",{\"kind\":\"inline\",\"name\":\"deleteOrFail\",\"params\":[{\"name\":\"target\",\"type\":\"Persist\"}],\"return_type\":\"boolean\",\"body_handle\":" + dof_body_h.toString() + "}"
		db_spec = db_spec + ",{\"kind\":\"inline\",\"name\":\"saveAll\",\"params\":[{\"name\":\"targets\",\"type\":\"list<Persist>\"}],\"return_type\":\"integer\",\"body_handle\":" + sa_body_h.toString() + "}"
		db_spec = db_spec + ",{\"kind\":\"inline\",\"name\":\"deleteAll\",\"params\":[{\"name\":\"targets\",\"type\":\"list<Persist>\"}],\"return_type\":\"integer\",\"body_handle\":" + da_body_h.toString() + "}"
		db_spec = db_spec + "]}"

		integer db_spec_ptr = _batch_stringLit(ctx, db_spec)
		_emit_class_full(ctx, db_spec_ptr, 1)
		if _ctx_had_error(ctx) != 0
			return 1
		return emit_query_runtime_helpers(ctx)

	// Run-time helpers shared by every generated query:
	//   __frame_data_row_count(clause, value)  `value` when it is a
	//       non-negative integer (a limit:/offset: row count), else raises.
	integer emit_query_runtime_helpers(integer ctx)
		string two_str = string_params2(ctx, "clause", "value")
		string rc = "string __v = value.trim()\n"
		rc = rc + "boolean __ok = __v.length() > 0\n"
		rc = rc + "integer __i = 0\n"
		rc = rc + "while __ok and __i < __v.length()\n"
		rc = rc + "\tstring __ch = __v.substring(__i, __i + 1)\n"
		rc = rc + "\tif __ch < \"0\" or __ch > \"9\"\n"
		rc = rc + "\t\t__ok = false\n"
		rc = rc + "\t__i = __i + 1\n"
		rc = rc + "if not __ok\n"
		rc = rc + "\terror(\"VALIDATION: \" + clause + \": expects a non-negative integer row count\")\n"
		rc = rc + "return __v\n"
		if emit_fn(ctx, "__frame_data_row_count", two_str, _type_string(ctx), rc) != 0
			return 1
		return 0

	// Connection setup and migration auto-apply live in clean-server; this
	// slot has nothing to emit.
	integer emit_server_init_typed(integer ctx, string ctx_json)
		return 0

// ============================================================================
// BLOCK EXPAND ENTRY POINT (typed-emission.md §2.2)
// ============================================================================

functions:
	integer expand_block_typed(integer ctx, string block_name, string attrs_json, string body)
		// data ModelName: block
		if block_name == "data"
			string model_name = extract_attr(attrs_json, "model_name")
			if model_name.length() == 0
				// `data:` without a model name was the v1 connection-config
				// block; configuration now lives in main.cln (DAT-I004).
				return plugin_error(ctx, "FRAME-DATA-E018", "data: block needs a model name (`data User:`). Database connection settings live in main.cln's frame.data: block (spec DAT-I004).")
			string err = validate_data_model(model_name, body)
			if err.length() > 0
				return plugin_error(ctx, "FRAME-DATA-E018", err)
			return expand_data_model(ctx, model_name, body)

		if block_name == "migrate"
			string mattrs = extract_attr(attrs_json, "model_name")
			if mattrs.length() == 0
				mattrs = attrs_json
			string merr = validate_migrate_block(mattrs, body)
			if merr.length() > 0
				return plugin_error(ctx, "FRAME-DATA-E019", merr)
			return expand_migrate_block(ctx, mattrs, body)

		if block_name == "transaction"
			return expand_transaction(ctx, body)

		if block_name == "db.query"
			return expand_raw_query(ctx, body)

		if block_name.startsWith("db.queryAs")
			return expand_typed_query(ctx, block_name, body)

		// Query blocks arrive as "<Model>.<verb>".
		integer dot_pos = block_name.indexOf(".")
		if dot_pos != -1
			string vmodel = block_name.substring(0, dot_pos)
			string verb = block_name.substring(dot_pos + 1, block_name.length())
			if is_query_verb(verb)
				return expand_query(ctx, vmodel, verb, body)
			if verb == "migrate"
				return emit_binding_stmt(ctx, body, vmodel + ".migrate()", "FRAME-DATA-E013")
			// Block-form mutations were removed in v2 (frame-data.ebnf §10).
			if verb == "delete"
				return plugin_error(ctx, "FRAME-DATA-E021",
					vmodel + ".delete: block form is removed under v2. " +
					"For a single row, call Database.delete(entity) (lenient) " +
					"or Database.deleteOrFail(entity) (strict). For bulk delete-by-predicate, " +
					"use db.query with an explicit DELETE ... WHERE statement. See spec DAT-S003/DAT-S004.")
			if verb == "insert"
				return plugin_error(ctx, "FRAME-DATA-E021",
					vmodel + ".insert: block form is removed under v2. " +
					"Construct " + vmodel + " and call Database.save(entity). " +
					"See spec DAT-S001.")
			if verb == "insert_id"
				return plugin_error(ctx, "FRAME-DATA-E021",
					vmodel + ".insert_id: block form is removed under v2. " +
					"Call Database.save(entity) then read entity.id (mutated in place). " +
					"See spec DAT-Q014.")
			if verb == "update"
				return plugin_error(ctx, "FRAME-DATA-E021",
					vmodel + ".update: block form is removed under v2. " +
					"Load with " + vmodel + ".data.<method> (or first:/findOrFail:), mutate fields, " +
					"and call Database.save(entity). See spec DAT-S001.")
			if verb == "upsert"
				return plugin_error(ctx, "FRAME-DATA-E021",
					vmodel + ".upsert: block form is removed under v2. " +
					"Use first: to look up, then construct-or-mutate and Database.save(entity). " +
					"See spec DAT-Q015.")
			return plugin_error(ctx, "FRAME-DATA-E022", "unknown query verb `" + vmodel + "." + verb + ":` — expected find, first, findOrFail, count, exists, paginate or cursor (frame-data.ebnf §5)")

		return plugin_error(ctx, "FRAME-DATA-E022", "frame.data does not handle the block `" + block_name + "`")

// ============================================================================
// VALIDATION / KEYWORD SURFACE
// ============================================================================

functions:
	string validate_block(string block_name, string attributes, string body)
		if block_name == "data"
			return validate_data_model(extract_model_name(attributes), body)
		if block_name == "migrate"
			return validate_migrate_block(attributes, body)
		return ""

	string get_keywords()
		return "[\"data\", \"table\", \"fields\", \"indexes\", \"relations\", \"queries\", \"primary\", \"generated\", \"required\", \"unique\", \"default\", \"as\", \"has_many\", \"has_one\", \"belongs_to\", \"on\", \"find\", \"first\", \"findOrFail\", \"count\", \"exists\", \"paginate\", \"cursor\", \"where\", \"order\", \"asc\", \"desc\", \"limit\", \"offset\", \"include\", \"join\", \"left\", \"right\", \"link\", \"group\", \"having\", \"select\", \"like\", \"page\", \"perPage\", \"after\", \"by\", \"transaction\", \"migrate\", \"up\", \"down\", \"sql\", \"params\", \"db.query\", \"db.queryAs\", \"Database\"]"

// ============================================================================
// SHARED EMISSION HELPERS
// ============================================================================

functions:
	// Emit a plugin diagnostic (severity 2 = error) and return the failure code.
	integer plugin_error(integer ctx, string code, string message)
		_emit_error(ctx, 2, code, message, "{\"start\":0,\"end\":0,\"source\":\"plugin\"}")
		return 1

	// Emit `callee(a1, a2, a3)` as a statement at the block's position.
	integer emit_call3(integer ctx, string callee, integer a1, integer a2, integer a3)
		string args_json = "[" + a1.toString() + "," + a2.toString() + "," + a3.toString() + "]"
		integer arr = _batch_args(ctx, args_json)
		return _emit_statement_into_start(ctx, _batch_stmtCall(ctx, callee, arr))

	// Parse `src` as a statement list (a function or method body). Returns
	// the handle, or 0 with the sticky error set.
	integer body_from_source(integer ctx, string src)
		integer h = _emit_stmt_from_source(ctx, src, 0)
		if _ctx_had_error(ctx) != 0
			return 0
		return h

	// Emit a top-level function whose body is the Clean source `src`.
	// params_json uses type_handle entries; returns 0 on success.
	integer emit_fn(integer ctx, string name, string params_json, integer return_type, string src)
		integer body_h = body_from_source(ctx, src)
		if body_h == 0
			return 1
		_emit_function(ctx, name, params_json, return_type, body_h, 0)
		if _ctx_had_error(ctx) != 0
			return 1
		return 0

	// `[{"name":"<n>","type_handle":<string>}]` for a one-string-param function.
	string string_param(integer ctx, string name)
		return "[{\"name\":\"" + name + "\",\"type_handle\":" + _type_string(ctx).toString() + "}]"

	// Parameter list of a two-string-param function (fresh type handles:
	// a handle is consumed by the declaration that uses it).
	string string_params2(integer ctx, string a, string b)
		return "[{\"name\":\"" + a + "\",\"type_handle\":" + _type_string(ctx).toString() + "},{\"name\":\"" + b + "\",\"type_handle\":" + _type_string(ctx).toString() + "}]"

// ============================================================================
// PLUGIN-TIME STRING HELPERS
// ============================================================================
// Pure string manipulation run at expansion time — no bridge calls.

functions:

	// Returns true when name is a reserved Clean Language keyword.
	boolean is_clean_keyword(string name)
		if name == "return" or name == "if" or name == "else" or name == "then"
			return true
		if name == "iterate" or name == "in" or name == "to" or name == "step"
			return true
		if name == "tests" or name == "error" or name == "function" or name == "functions"
			return true
		if name == "input" or name == "description" or name == "class" or name == "constructor"
			return true
		if name == "is" or name == "and" or name == "or" or name == "not"
			return true
		if name == "true" or name == "false" or name == "none" or name == "null"
			return true
		if name == "default" or name == "onError" or name == "constant" or name == "private"
			return true
		if name == "base" or name == "list" or name == "matrix" or name == "pairs"
			return true
		if name == "integer" or name == "number" or name == "boolean" or name == "string"
			return true
		if name == "void" or name == "any" or name == "import" or name == "from"
			return true
		if name == "as" or name == "later" or name == "background" or name == "start"
			return true
		if name == "print" or name == "break" or name == "continue" or name == "while"
			return true
		if name == "state" or name == "watch" or name == "computed" or name == "screen"
			return true
		if name == "guard" or name == "reset" or name == "require" or name == "rules"
			return true
		if name == "spec" or name == "intent" or name == "source" or name == "build"
			return true
		return false

	// Returns a Clean-safe identifier for a field name.
	string safe_field_name(string name)
		if is_clean_keyword(name)
			return "__" + name
		return name

	// Convert PascalCase to snake_case (for table names).
	string to_snake_case(string name)
		string result = ""
		integer i = 0
		while i < name.length()
			string ch = name.substring(i, i + 1)
			string lower = ch.toLowerCase()
			if ch != lower and i > 0
				result = result + "_"
			result = result + lower
			i = i + 1
		return result

	// Pluralize a snake_case name for standard table naming.
	string pluralize(string name)
		integer len = name.length()
		if len == 0
			return name
		string last = name.substring(len - 1, len)
		if last == "s"
			return name
		if last == "y" and len > 1
			string vowels = "aeiou"
			string prev = name.substring(len - 2, len - 1)
			if vowels.indexOf(prev) == -1
				return name.substring(0, len - 1) + "ies"
			return name + "s"
		if last == "x" or last == "z"
			return name + "es"
		if last == "h" and len > 1
			string prev2 = name.substring(len - 2, len - 1)
			if prev2 == "c" or prev2 == "s"
				return name + "es"
		return name + "s"

	// Strip leading whitespace-glued `:annotation` tokens from a modifier string.
	// Converts `:pk :unique :notnull` into `pk, unique, notnull`.
	// Leaves keyword-value modifiers like `default=now` untouched.
	string canonicalize_annotations(string modifiers)
		modifiers = modifiers.trim()
		if modifiers.length() == 0
			return ""
		string result = ""
		integer pos = 0
		while pos < modifiers.length()
			// Skip whitespace
			while pos < modifiers.length()
				string ch = modifiers.substring(pos, pos + 1)
				if ch != " " and ch != "\t"
					break
				pos = pos + 1
			if pos >= modifiers.length()
				break
			// Strip a single leading ':' if present (annotation form).
			if modifiers.substring(pos, pos + 1) == ":"
				pos = pos + 1
			// Read token until next whitespace.
			integer tok_start = pos
			while pos < modifiers.length()
				string ch2 = modifiers.substring(pos, pos + 1)
				if ch2 == " " or ch2 == "\t"
					break
				pos = pos + 1
			string tok = modifiers.substring(tok_start, pos).trim()
			if tok.length() > 0
				if result.length() > 0
					result = result + ", "
				result = result + tok
		return result

	// Normalize a field line to canonical "type name [= default] [: constraints]" form.
	// Accepts both forms:
	//   - space-form:  "string email :pk :unique"
	//   - colon-form:  "email:string :pk :unique"
	// In either case, trailing ":annotation" tokens (whitespace-glued) are moved
	// into the constraint list.
	string normalize_field_line(string line)
		line = line.trim()
		if line.length() == 0
			return ""

		// Split off any trailing ' :' annotation block first (works for both forms).
		// We look for the LAST run of whitespace-then-colon-then-non-whitespace tokens
		// at the tail of the line and treat that entire tail as annotations.
		string body_part = line
		string tail_annotations = ""
		integer scan = 0
		while scan < line.length()
			// Find next " :" occurrence starting at scan.
			integer sp_colon = line.indexOf(" :", scan)
			if sp_colon == -1
				break
			// Everything before the space is the "current" body_part; everything
			// from sp_colon+1 (starting with ':') to end is tail annotations.
			body_part = line.substring(0, sp_colon).trim()
			tail_annotations = line.substring(sp_colon + 1, line.length()).trim()
			scan = sp_colon + 2

		// If we found annotation tail, canonicalize it.
		string annotations = ""
		if tail_annotations.length() > 0
			annotations = canonicalize_annotations(tail_annotations)

		// Now parse body_part as either colon-form ("name:type modifiers") or
		// space-form ("type name modifiers"/"type name").
		string field_name = ""
		string field_type = ""
		string modifiers = ""

		integer bp_colon = body_part.indexOf(":")
		integer bp_first_space = body_part.indexOf(" ")

		if bp_colon != -1 and (bp_first_space == -1 or bp_colon < bp_first_space)
			// colon-form: "name:type [modifiers]"
			field_name = body_part.substring(0, bp_colon).trim()
			string rest = body_part.substring(bp_colon + 1, body_part.length()).trim()
			integer rest_space = rest.indexOf(" ")
			if rest_space == -1
				field_type = rest
			else
				field_type = rest.substring(0, rest_space).trim()
				modifiers = rest.substring(rest_space + 1, rest.length()).trim()
		else
			// space-form: "type name [modifiers]"
			if bp_first_space == -1
				return ""
			field_type = body_part.substring(0, bp_first_space).trim()
			string rest2 = body_part.substring(bp_first_space + 1, body_part.length()).trim()
			integer rest2_space = rest2.indexOf(" ")
			if rest2_space == -1
				field_name = rest2
			else
				field_name = rest2.substring(0, rest2_space).trim()
				modifiers = rest2.substring(rest2_space + 1, rest2.length()).trim()

		if field_type.length() == 0 or field_name.length() == 0
			return ""

		// Extract `default <value>` from modifiers (v1 keyword-form).
		// An already-canonical line carries it as `= <value>`.
		string default_val = ""
		string constraints = modifiers
		integer def_pos = modifiers.indexOf("default ")
		if modifiers.startsWith("=")
			constraints = ""
			default_val = modifiers.substring(1, modifiers.length()).trim()
		else if def_pos != -1
			constraints = modifiers.substring(0, def_pos).trim()
			default_val = modifiers.substring(def_pos + 8, modifiers.length()).trim()

		// Fold in the tail annotations (comma-joined).
		if annotations.length() > 0
			if constraints.length() > 0
				constraints = constraints + ", " + annotations
			else
				constraints = annotations

		string result = field_type + " " + field_name
		if default_val.length() > 0
			result = result + " = " + default_val
		if constraints.length() > 0
			result = result + " : " + constraints
		return result

	// Extract field names as comma-separated list.
	string extract_field_names(string body)
		string result = ""
		string lines = body
		integer line_start = 0
		while line_start < lines.length()
			integer line_end = lines.indexOf("\n", line_start)
			if line_end == -1
				line_end = lines.length()
			string line = lines.substring(line_start, line_end).trim()
			if line.length() > 0
				string field_name = extract_field_name_from_line(line)
				if field_name.length() > 0
					if result.length() > 0
						result = result + ","
					result = result + field_name
			line_start = line_end + 1
		return result

	// Extract field name from a single line.
	string extract_field_name_from_line(string line)
		line = normalize_field_line(line)
		integer colon_pos = line.indexOf(" : ")
		if colon_pos != -1
			line = line.substring(0, colon_pos)
		integer equals_pos = line.indexOf(" = ")
		if equals_pos != -1
			line = line.substring(0, equals_pos)
		line = line.trim()
		integer space_pos = line.indexOf(" ")
		if space_pos == -1
			return ""
		return line.substring(space_pos + 1, line.length()).trim()

	// Extract field types as comma-separated list (parallel to extract_field_names).
	string extract_field_types(string body)
		string result = ""
		string lines = body
		integer line_start = 0
		while line_start < lines.length()
			integer line_end = lines.indexOf("\n", line_start)
			if line_end == -1
				line_end = lines.length()
			string line = lines.substring(line_start, line_end).trim()
			if line.length() > 0
				string field_type = extract_field_type_from_line(line)
				if field_type.length() > 0
					if result.length() > 0
						result = result + ","
					result = result + field_type
			line_start = line_end + 1
		return result

	// Extract field type from a single line (first word after normalization).
	string extract_field_type_from_line(string line)
		line = normalize_field_line(line)
		integer colon_pos = line.indexOf(" : ")
		if colon_pos != -1
			line = line.substring(0, colon_pos)
		integer equals_pos = line.indexOf(" = ")
		if equals_pos != -1
			line = line.substring(0, equals_pos)
		line = line.trim()
		integer space_pos = line.indexOf(" ")
		if space_pos == -1
			return ""
		string ftype = line.substring(0, space_pos).trim()
		return ftype

	// The SQL column named by a `col="<name>"` constraint (the `as "<name>"`
	// override, DAT-M017) in a constraint list, or "" when there is none.
	string col_constraint(string constraints)
		integer at = constraints.indexOf("col=\"")
		if at == -1
			return ""
		integer close = constraints.indexOf("\"", at + 5)
		if close == -1
			return ""
		return constraints.substring(at + 5, close)

	// The constraint list without its `col="<name>"` entry, so keyword
	// checks never match text inside a column name.
	string without_col_constraint(string constraints)
		integer at = constraints.indexOf("col=\"")
		if at == -1
			return constraints
		integer close = constraints.indexOf("\"", at + 5)
		if close == -1
			return constraints.substring(0, at)
		return constraints.substring(0, at) + constraints.substring(close + 1, constraints.length())

	// The constraint part (after ` : `) of a normalized field line.
	string line_constraints(string normalized)
		integer colon_pos = normalized.indexOf(" : ")
		if colon_pos == -1
			return ""
		return normalized.substring(colon_pos + 3, normalized.length()).trim()

	// True when the comma/space-separated constraint list holds `tok` as a
	// whole entry (`col="..."` is ignored).
	boolean has_constraint(string constraints, string tok)
		string flat = without_col_constraint(constraints).replace(",", " ")
		integer pos = 0
		while pos < flat.length()
			integer sp = flat.indexOf(" ", pos)
			if sp == -1
				sp = flat.length()
			if flat.substring(pos, sp).trim() == tok
				return true
			pos = sp + 1
		return false

	// SQL column names parallel to extract_field_names: the `as "<column>"`
	// override when given (DAT-M017), the field name otherwise.
	string extract_field_columns(string body)
		string result = ""
		integer line_start = 0
		while line_start < body.length()
			integer line_end = body.indexOf("\n", line_start)
			if line_end == -1
				line_end = body.length()
			string line = body.substring(line_start, line_end).trim()
			if line.length() > 0
				string field_name = extract_field_name_from_line(line)
				if field_name.length() > 0
					string col = col_constraint(line_constraints(normalize_field_line(line)))
					if col.length() == 0
						col = field_name
					if result.length() > 0
						result = result + ","
					result = result + col
			line_start = line_end + 1
		return result

	// The entry of `values` at the position of `field` in `field_names`
	// (parallel comma-separated lists), or "".
	string csv_parallel(string field_names, string values, string field)
		integer pos = 0
		integer vpos = 0
		while pos < field_names.length()
			integer comma = field_names.indexOf(",", pos)
			if comma == -1
				comma = field_names.length()
			integer vcomma = values.indexOf(",", vpos)
			if vcomma == -1
				vcomma = values.length()
			if field_names.substring(pos, comma).trim() == field
				return values.substring(vpos, vcomma).trim()
			pos = comma + 1
			vpos = vcomma + 1
		return ""

	// The SQL column of `field`; the field name itself when it is not a
	// declared field (relation names, SQL expressions).
	string column_of(string field_names, string field_columns, string field)
		string col = csv_parallel(field_names, field_columns, field)
		if col.length() == 0
			return field
		return col

	// The primary-key field of a (v1-shaped) body: the field marked
	// `primary`, else `id` (DAT-E002).
	string pk_field_of(string body)
		integer line_start = 0
		while line_start < body.length()
			integer line_end = body.indexOf("\n", line_start)
			if line_end == -1
				line_end = body.length()
			string line = body.substring(line_start, line_end).trim()
			if line.length() > 0
				if has_constraint(line_constraints(normalize_field_line(line)), "pk")
					return extract_field_name_from_line(line)
			line_start = line_end + 1
		return "id"

	// How the primary key gets its value (DAT-E002, DAT-S001):
	//   "auto"     integer key generated by the database
	//   "uuid"     non-integer `generated` key: a UUID v4 set on first save
	//   "assigned" `primary` without `generated`: supplied by the caller
	// A body without a `primary` field has the generated integer key `id`.
	string pk_kind_of(string body, string pk_field, string pk_type)
		boolean explicit_pk = false
		boolean generated = false
		integer line_start = 0
		while line_start < body.length()
			integer line_end = body.indexOf("\n", line_start)
			if line_end == -1
				line_end = body.length()
			string line = body.substring(line_start, line_end).trim()
			if line.length() > 0 and extract_field_name_from_line(line) == pk_field
				string cons = line_constraints(normalize_field_line(line))
				if has_constraint(cons, "pk")
					explicit_pk = true
				if has_constraint(cons, "auto")
					generated = true
			line_start = line_end + 1
		if not explicit_pk
			generated = true
		if pk_type == "integer"
			if generated
				return "auto"
			return "assigned"
		if generated
			return "uuid"
		return "assigned"

	// Count comma-separated fields.
	integer count_fields(string field_names)
		if field_names.length() == 0
			return 0
		integer count = 1
		integer pos = 0
		while pos < field_names.length()
			if field_names.substring(pos, pos + 1) == ","
				count = count + 1
			pos = pos + 1
		return count

// ============================================================================
// DATA BLOCK SUB-BLOCK PARSER (frame-data.ebnf §2)
// ============================================================================
// Semantic rules: DAT-M014..M020.
//
// A `data <T>:` body is a sequence of sub-blocks:
//   table "users"                        -- optional, DAT-M018
//   fields:                              -- required, DAT-M015
//       string email required unique
//       string status default: "pending"
//   indexes:                             -- optional, DAT-M019
//       email unique
//       (status, createdAt)
//   relations:                           -- optional, DAT-M020
//       orders: has_many Order on userId
//   queries:                             -- optional, DAT-A003..A006
//       list<User> byStatus(string status)
//           return find:
//               where:
//                   status == status
//
// The `fields:` lines are rewritten into `<type> <name> [= default]
// [: constraints]` lines for the field helpers above. A body without
// sub-blocks (the v1 bare-field form) is still read as field lines.

functions:
	// Return true if `body` uses the v2 sub-block form. Detection rule:
	// any line trimmed starts with one of `table `, `table\t`, `fields:`,
	// `indexes:`, `relations:`, `queries:`. Bare-field bodies (v1) never
	// contain those keywords at line start, so the check is unambiguous.
	boolean is_v2_sub_block_form(string body)
		integer line_start = 0
		while line_start < body.length()
			integer line_end = body.indexOf("\n", line_start)
			if line_end == -1
				line_end = body.length()
			string line = body.substring(line_start, line_end).trim()
			if line.length() > 0
				if line.startsWith("fields:")
					return true
				if line.startsWith("indexes:")
					return true
				if line.startsWith("relations:")
					return true
				if line.startsWith("queries:")
					return true
				if line.startsWith("table ")
					return true
				if line.startsWith("table\t")
					return true
			line_start = line_end + 1
		return false

	// Return true if a trimmed line begins a v2 sub-block header
	// (used as extract boundary detection).
	boolean is_v2_sub_block_header(string trimmed_line)
		if trimmed_line.startsWith("fields:")
			return true
		if trimmed_line.startsWith("indexes:")
			return true
		if trimmed_line.startsWith("relations:")
			return true
		if trimmed_line.startsWith("queries:")
			return true
		if trimmed_line.startsWith("table ")
			return true
		if trimmed_line.startsWith("table\t")
			return true
		return false

	// Extract the content of a named v2 sub-block (`fields`, `indexes`,
	// `relations`, `queries`). Returns the raw sub-block body (lines below
	// the header up to the next sub-block header or end-of-body). Returns
	// "" if the sub-block is not present. Preserves original indentation
	// so queries: method bodies keep their nesting.
	string extract_v2_sub_block(string body, string sub_block_name)
		string target_header = sub_block_name + ":"
		integer line_start = 0
		integer content_start = -1
		while line_start < body.length()
			integer line_end = body.indexOf("\n", line_start)
			if line_end == -1
				line_end = body.length()
			string line = body.substring(line_start, line_end).trim()
			if content_start == -1
				if line == target_header
					content_start = line_end + 1
			else
				if line.length() > 0 and is_v2_sub_block_header(line)
					return body.substring(content_start, line_start)
			line_start = line_end + 1
		if content_start == -1
			return ""
		return body.substring(content_start, body.length())

	// Extract the `table "..."` declaration value. Returns the unquoted
	// table name, or "" if no `table` line is present. Only the first
	// occurrence is honored.
	string extract_v2_table_line(string body)
		integer line_start = 0
		while line_start < body.length()
			integer line_end = body.indexOf("\n", line_start)
			if line_end == -1
				line_end = body.length()
			string line = body.substring(line_start, line_end).trim()
			if line.startsWith("table ") or line.startsWith("table\t")
				string rest = line.substring(6, line.length()).trim()
				if rest.startsWith("\"") and rest.endsWith("\"") and rest.length() >= 2
					return rest.substring(1, rest.length() - 1)
				return rest
			line_start = line_end + 1
		return ""

	// Enumerate the field names declared inside a `fields:` sub-block body.
	// Each non-empty trimmed line is treated as a field declaration; the
	// leading identifier (before any constraint keyword or `:` or `as`)
	// is the field name. Returns a comma-separated list, or "" when the
	// sub-block is empty.
	string extract_v2_field_names(string fields_body)
		string result = ""
		integer line_start = 0
		while line_start < fields_body.length()
			integer line_end = fields_body.indexOf("\n", line_start)
			if line_end == -1
				line_end = fields_body.length()
			string line = fields_body.substring(line_start, line_end).trim()
			if line.length() > 0
				string field_name = v2_field_line_name(line)
				if field_name.length() > 0
					if result.length() > 0
						result = result + ","
					result = result + field_name
			line_start = line_end + 1
		return result

	// True when `tok` starts a field constraint in a v2 `fields:` line
	// (frame-data.ebnf §2.2 field_constraint). Used to tell the base form
	// `type_ref identifier {constraint}` from the transitional
	// `identifier {constraint}` form.
	boolean is_v2_field_constraint_word(string tok)
		if tok == "primary" or tok == "generated" or tok == "required" or tok == "unique"
			return true
		if tok == "default:" or tok == "default" or tok == "as"
			return true
		return false

	// Return the field name of one v2 `fields:` line, accepting both the base
	// form `type_ref identifier {constraint}` and the transitional
	// `identifier {constraint}` / `identifier: type` forms.
	string v2_field_line_name(string line)
		string first_tok = ""
		string second_tok = ""
		integer pos = 0
		integer len = line.length()
		integer tok_index = 0
		while pos < len and tok_index < 2
			while pos < len
				string ch = line.substring(pos, pos + 1)
				if ch != " " and ch != "\t"
					break
				pos = pos + 1
			integer tok_begin = pos
			while pos < len
				string ch2 = line.substring(pos, pos + 1)
				if ch2 == " " or ch2 == "\t"
					break
				pos = pos + 1
			string tok = line.substring(tok_begin, pos).trim()
			if tok.length() > 0
				if tok_index == 0
					first_tok = tok
				else
					second_tok = tok
				tok_index = tok_index + 1
		if first_tok.length() == 0
			return ""
		if first_tok.endsWith(":")
			return first_tok.substring(0, first_tok.length() - 1).trim()
		if second_tok.length() > 0 and not is_v2_field_constraint_word(second_tok)
			return second_tok
		return first_tok

	// Map a `fields:` constraint keyword (frame-data.ebnf §2.2) to the token
	// the field helpers read: primary -> pk, generated -> auto; `required`
	// (NOT NULL) and `unique` pass through.
	string map_v2_constraint_token(string token)
		if token == "primary"
			return "pk"
		if token == "generated"
			return "auto"
		if token == "required"
			return "required"
		if token == "unique"
			return "unique"
		return token

	// Rewrite one `fields:` line — `<type> <name> {constraint}`, or the
	// transitional `<name> {constraint}` / `<name>: <type>` forms — as
	// `<type> <name> [= <default>] [: <constraints>]`, <constraints> being a
	// comma-separated token list. A line without a type is a `string` field.
	//
	// Constraint parsing:
	//   - Bare tokens (`primary`, `generated`, `required`, `unique`) are mapped
	//     via map_v2_constraint_token and appended to the constraint list.
	//   - `default: <value>` — the value token is captured and emitted as
	//     `= <value>` on the synthesized line (matches v1 default-value form).
	//   - `as "<column_name>"` — captured as a `col="<column_name>"`
	//     constraint: the SQL column of the field (DAT-M017), read back by
	//     extract_field_columns.
	//   - Unknown tokens are dropped with no error — future spec tokens should
	//     add explicit handling here rather than fall through silently.
	// Returns "" for empty or malformed lines (caller filters those out).
	string synthesize_v1_line_from_v2_field(string line)
		line = line.trim()
		if line.length() == 0
			return ""
		string field_name = ""
		string field_type = ""
		string constraints = ""
		string default_val = ""
		integer pos = 0
		integer len = line.length()
		boolean first_after_name = true

		// Skip leading whitespace (defensive; caller already trims).
		while pos < len
			string ch = line.substring(pos, pos + 1)
			if ch != " " and ch != "\t"
				break
			pos = pos + 1

		// Extract the field name (first whitespace-delimited token).
		integer name_start = pos
		while pos < len
			string ch = line.substring(pos, pos + 1)
			if ch == " " or ch == "\t"
				break
			pos = pos + 1
		field_name = line.substring(name_start, pos).trim()
		boolean name_had_colon = false
		if field_name.length() > 0 and field_name.substring(field_name.length() - 1, field_name.length()) == ":"
			field_name = field_name.substring(0, field_name.length() - 1).trim()
			name_had_colon = true
		if field_name.length() == 0
			return ""

		// frame-data.ebnf v2.1.0 base form: `type_ref identifier {constraint}`.
		// When the first token is followed by a token that is not a field
		// constraint keyword, the first token is the type and the second is
		// the field name (`integer id primary generated`). Otherwise the line
		// is the transitional `identifier {constraint}` form.
		if not name_had_colon
			integer peek = pos
			while peek < len
				string pch = line.substring(peek, peek + 1)
				if pch != " " and pch != "\t"
					break
				peek = peek + 1
			integer second_start = peek
			while peek < len
				string pch2 = line.substring(peek, peek + 1)
				if pch2 == " " or pch2 == "\t"
					break
				peek = peek + 1
			string second_tok = line.substring(second_start, peek).trim()
			if second_tok.length() > 0 and not is_v2_field_constraint_word(second_tok)
				field_type = field_name
				field_name = second_tok
				pos = peek
				first_after_name = false

		// Walk the remaining tokens.
		while pos < len
			// Skip whitespace between tokens.
			while pos < len
				string ch = line.substring(pos, pos + 1)
				if ch != " " and ch != "\t"
					break
				pos = pos + 1
			if pos >= len
				break

			// Read one token (up to next whitespace).
			integer tok_start = pos
			while pos < len
				string ch = line.substring(pos, pos + 1)
				if ch == " " or ch == "\t"
					break
				pos = pos + 1
			string tok = line.substring(tok_start, pos).trim()
			if tok.length() == 0
				continue

			// If the first token after the name is a recognized Clean type,
			// use it as the field type instead of stubbing `string`. This
			// supports the colon-form `name: type [constraints]` documented
			// in framework examples. Unknown tokens fall through to
			// constraint mapping.
			if first_after_name and field_type.length() == 0
				first_after_name = false
				if tok == "integer" or tok == "number" or tok == "string" or tok == "boolean" or tok == "datetime" or tok == "date" or tok == "text" or tok == "uuid" or tok == "json"
					field_type = tok
					continue

			if tok == "default:"
				// The next non-whitespace token is the default value.
				while pos < len
					string ch = line.substring(pos, pos + 1)
					if ch != " " and ch != "\t"
						break
					pos = pos + 1
				// A quoted default runs to its closing quote, so it may hold
				// spaces (`default: "in review"`); any other value is one token.
				integer val_start = pos
				if pos < len and line.substring(pos, pos + 1) == "\""
					pos = pos + 1
					boolean closed = false
					while pos < len and not closed
						string qch = line.substring(pos, pos + 1)
						if qch == "\\"
							pos = pos + 2
						else
							pos = pos + 1
							closed = qch == "\""
					if pos > len
						pos = len
				else
					while pos < len
						string ch = line.substring(pos, pos + 1)
						if ch == " " or ch == "\t"
							break
						pos = pos + 1
				default_val = line.substring(val_start, pos).trim()
			else if tok == "as"
				// The next token is the quoted column-name literal.
				while pos < len
					string ch = line.substring(pos, pos + 1)
					if ch != " " and ch != "\t"
						break
					pos = pos + 1
				integer col_start = pos
				while pos < len
					string ch = line.substring(pos, pos + 1)
					if ch == " " or ch == "\t"
						break
					pos = pos + 1
				string col_lit = line.substring(col_start, pos).trim()
				if col_lit.length() > 0
					if constraints.length() > 0
						constraints = constraints + ", "
					constraints = constraints + "col=" + col_lit
			else
				string v1_tok = map_v2_constraint_token(tok)
				if v1_tok.length() > 0
					if constraints.length() > 0
						constraints = constraints + ", "
					constraints = constraints + v1_tok

		string emitted_type = field_type
		if emitted_type.length() == 0
			emitted_type = "string"
		string result = emitted_type + " " + field_name
		if default_val.length() > 0
			result = result + " = " + default_val
		if constraints.length() > 0
			result = result + " : " + constraints
		return result

	// Convert a v2 `fields:` sub-block body into a v1-shape body. Iterates
	// lines, calls synthesize_v1_line_from_v2_field per line, and joins the
	// results with newlines. Empty and malformed lines are skipped.
	string synthesize_v1_body_from_v2_fields(string fields_body)
		string result = ""
		integer line_start = 0
		while line_start < fields_body.length()
			integer line_end = fields_body.indexOf("\n", line_start)
			if line_end == -1
				line_end = fields_body.length()
			string line = fields_body.substring(line_start, line_end).trim()
			if line.length() > 0
				string v1_line = synthesize_v1_line_from_v2_field(line)
				if v1_line.length() > 0
					result = result + v1_line + "\n"
			line_start = line_end + 1
		return result

	// Parse a v2 `queries:` method parameter list into a JSON array suitable
	// for the class-spec methods entry. Input: text between `(` and `)` of
	// a method declaration, e.g. `string status, integer limit`. Output: JSON
	// array `[{"name":"status","type":"string"},{"name":"limit","type":"integer"}]`
	// or `[]` when the parameter list is empty. Each parameter is split by
	// whitespace as `<type> <name>` per core grammar §6.4 parameter form.
	// Malformed parameters (single-token, no space) are skipped silently;
	// the compiler will surface an arity/type error at the call site if the
	// method is ever called with mismatched args.
	string parse_v2_query_params(string params_str)
		string trimmed = params_str.trim()
		if trimmed.length() == 0
			return "[]"
		string result = "["
		boolean first = true
		integer pos = 0
		integer len = trimmed.length()
		while pos < len
			// Find the next comma (parameter separator).
			integer comma_pos = trimmed.indexOf(",", pos)
			integer end_pos = trimmed.length()
			if comma_pos != -1
				end_pos = comma_pos
			string param = trimmed.substring(pos, end_pos).trim()
			if param.length() > 0
				// Split on the first whitespace: `<type> <name>`.
				integer sp = param.indexOf(" ")
				integer tb = param.indexOf("\t")
				integer split_at = param.length()
				if sp != -1 and sp < split_at
					split_at = sp
				if tb != -1 and tb < split_at
					split_at = tb
				if split_at < param.length()
					string ptype = param.substring(0, split_at).trim()
					string pname = param.substring(split_at + 1, param.length()).trim()
					if ptype.length() > 0 and pname.length() > 0
						if not first
							result = result + ","
						result = result + "{\"name\":\"" + pname + "\",\"type\":\"" + ptype + "\"}"
						first = false
			if comma_pos == -1
				pos = trimmed.length()
			else
				pos = comma_pos + 1
		result = result + "]"
		return result

	// Detect a v2 `queries:` method declaration line. A declaration line is a
	// non-empty trimmed line that contains a parenthesized parameter list at
	// its end, i.e. matches `<return_type> <name>(<params>)`. Body lines
	// (indented `return <expr>` continuations) never contain a top-level `(`
	// followed by `)` in that shape, so this heuristic is sufficient.
	boolean is_v2_query_method_decl(string trimmed_line)
		integer paren_open = trimmed_line.indexOf("(")
		integer paren_close = trimmed_line.lastIndexOf(")")
		if paren_open == -1
			return false
		if paren_close == -1
			return false
		if paren_close < paren_open
			return false
		// A declaration line must have at least one word before the `(`
		// (the method name), and something before the name (the return type).
		if paren_open < 3
			return false
		integer first_space = trimmed_line.indexOf(" ")
		if first_space == -1
			return false
		if first_space >= paren_open
			return false
		return true

	// Split a v2 query method declaration line into (return_type, name, params).
	// Input: trimmed line like `list<User> byStatus(string status)`.
	// Output: comma-separated `<return_type>|<name>|<params>` triple string.
	// The `|` separator keeps this parseable by callers without introducing
	// a struct return type. Returns "" for malformed input.
	string split_v2_query_decl(string line)
		integer paren_open = line.indexOf("(")
		integer paren_close = line.lastIndexOf(")")
		if paren_open == -1 or paren_close == -1 or paren_close < paren_open
			return ""
		string params = line.substring(paren_open + 1, paren_close).trim()
		string before_paren = line.substring(0, paren_open).trim()
		// Split before_paren at the LAST whitespace: everything before is the
		// return type (may contain `<`, `>`, `?`), everything after is the
		// method name.
		integer name_start = -1
		integer scan = before_paren.length() - 1
		while scan >= 0
			string ch = before_paren.substring(scan, scan + 1)
			if ch == " " or ch == "\t"
				name_start = scan + 1
				scan = -1
			else
				scan = scan - 1
		if name_start == -1 or name_start >= before_paren.length()
			return ""
		string return_type = before_paren.substring(0, name_start).trim()
		string method_name = before_paren.substring(name_start, before_paren.length()).trim()
		if return_type.length() == 0 or method_name.length() == 0
			return ""
		return return_type + "|" + method_name + "|" + params

	// Walk the `queries:` sub-block body and emit one method-JSON entry per
	// declaration. Each declaration line is followed by one or more indented
	// body lines (the `return <expr>` per DAT-A004). The body text is passed
	// verbatim to _emit_stmt_from_source to produce a body_handle, which is
	// inlined into the class-spec method entry.
	//
	// Returns a string like `,{"kind":"inline",...},{"kind":"inline",...}` —
	// leading comma included so callers can append it directly onto a
	// non-empty methods_json array before the closing `]`. Returns "" when
	// the queries body is empty or contains no valid declarations. Sets sticky
	// error context on parse/emit failure; caller should check _ctx_had_error
	// after this call.
	string emit_queries_methods_json(integer ctx, string queries_body, string model_name)
		string result = ""
		integer line_start = 0
		integer body_len = queries_body.length()
		while line_start < body_len
			integer line_end = queries_body.indexOf("\n", line_start)
			if line_end == -1
				line_end = body_len
			string raw_line = queries_body.substring(line_start, line_end)
			string trimmed = raw_line.trim()
			if trimmed.length() > 0 and is_v2_query_method_decl(trimmed)
				// Parse the declaration line.
				string decl = split_v2_query_decl(trimmed)
				if decl.length() > 0
					integer sep1 = decl.indexOf("|")
					integer sep2 = decl.indexOf("|", sep1 + 1)
					if sep1 != -1 and sep2 != -1
						string return_type = decl.substring(0, sep1)
						string method_name = decl.substring(sep1 + 1, sep2)
						string params_raw = decl.substring(sep2 + 1, decl.length())
						string params_json = parse_v2_query_params(params_raw)

						// Accumulate body lines: everything after the
						// declaration until the next declaration or EOB.
						// Preserve indentation RELATIVE to the first non-empty
						// body line — trimming every line collapses nested
						// sub-blocks (e.g. `where:` inside `return first:`) and
						// the compiler then rejects the fragment because the
						// sub-block content sits at column 0.
						string body_src = ""
						integer body_scan = line_end + 1
						string base_indent = ""
						boolean base_captured = false
						while body_scan < body_len
							integer body_end = queries_body.indexOf("\n", body_scan)
							if body_end == -1
								body_end = body_len
							string body_line_raw = queries_body.substring(body_scan, body_end)
							string body_line_trim = body_line_raw.trim()
							if body_line_trim.length() > 0 and is_v2_query_method_decl(body_line_trim)
								// Next declaration reached — stop.
								body_scan = body_len
							else
								if body_line_trim.length() > 0
									if not base_captured
										// Leading-whitespace prefix of the
										// first non-empty body line becomes
										// the "column 0" of the emitted body.
										integer ip = 0
										while ip < body_line_raw.length()
											string ich = body_line_raw.substring(ip, ip + 1)
											if ich != " " and ich != "\t"
												break
											ip = ip + 1
										base_indent = body_line_raw.substring(0, ip)
										base_captured = true
									// Strip only the base indent; preserve
									// anything deeper. If a line has less
									// indent than base_indent (shouldn't
									// happen inside a queries: method body),
									// fall back to the trimmed form.
									string emit_line = body_line_raw
									if base_indent.length() > 0 and body_line_raw.startsWith(base_indent)
										emit_line = body_line_raw.substring(base_indent.length(), body_line_raw.length())
									else if base_indent.length() > 0
										emit_line = body_line_trim
									body_src = body_src + emit_line + "\n"
								body_scan = body_end + 1

						if body_src.length() > 0
							// The DSL block form (`return E.first: ...`)
							// is legal only at top-level block dispatch —
							// _emit_stmt_from_source parses statement scope
							// and doesn't re-enter plugin expansion. Rewrite
							// the DSL into an equivalent SQL-building
							// statement list before emission.
							string rewritten = rewrite_query_method_body(body_src, model_name)
							string emit_body = body_src
							if rewritten.length() > 0
								emit_body = rewritten
								string first_body_line = body_src.trim()
								integer fbl_end = first_body_line.indexOf("\n")
								if fbl_end != -1
									first_body_line = first_body_line.substring(0, fbl_end).trim()
								if first_body_line.endsWith("find:")
									warn_offset_without_limit(ctx, model_name + "." + method_name, body_src)
							integer body_h = _emit_stmt_from_source(ctx, emit_body, 0)
							if _ctx_had_error(ctx) != 0
								return ""
							if body_h != 0
								result = result + ",{\"kind\":\"inline\",\"name\":\"" + method_name + "\",\"params\":" + params_json + ",\"return_type\":\"" + return_type + "\",\"body_handle\":" + body_h.toString() + "}"
			line_start = line_end + 1
		return result

	// Parse a single v2 `indexes:` entry line into a CREATE INDEX SQL
	// statement. Per DAT-M019: single-field entries (`email`) create
	// single-column indexes; parenthesized tuples (`(status, createdAt)`)
	// create composite indexes; suffix `unique` (`email unique` or
	// `(tenantId, email) unique`) creates a UNIQUE index. Returns "" for
	// empty or malformed lines. Naming convention: `idx_<table>_<c1>_<c2>_...`
	// for regular, `uniq_<table>_<c1>_<c2>_...` for unique. Matches SQL
	// convention seen in most ORMs.
	string generate_index_sql_line(string line, string table_name, string field_names, string field_columns)
		string trimmed = line.trim()
		if trimmed.length() == 0
			return ""
		// Detect trailing `unique` suffix.
		boolean is_unique = false
		if trimmed.endsWith(" unique") or trimmed.endsWith("\tunique")
			is_unique = true
			trimmed = trimmed.substring(0, trimmed.length() - 6).trim()
		else if trimmed == "unique"
			// Bare `unique` line is malformed — no columns.
			return ""
		// Extract column list. Composite form: `(c1, c2, ...)`. Single form:
		// bare identifier.
		string columns = ""
		string cols_for_name = ""
		if trimmed.startsWith("(")
			integer close = trimmed.indexOf(")")
			if close == -1
				return ""
			string inner = trimmed.substring(1, close).trim()
			if inner.length() == 0
				return ""
			// Normalize commas to `, ` in the emitted SQL; underscore-join
			// the same tokens for the index-name suffix.
			integer pos = 0
			boolean first_col = true
			while pos < inner.length()
				integer comma = inner.indexOf(",", pos)
				integer end_pos = inner.length()
				if comma != -1
					end_pos = comma
				string col = column_of(field_names, field_columns, inner.substring(pos, end_pos).trim())
				if col.length() > 0
					if not first_col
						columns = columns + ", "
						cols_for_name = cols_for_name + "_"
					columns = columns + col
					cols_for_name = cols_for_name + col
					first_col = false
				if comma == -1
					pos = inner.length()
				else
					pos = comma + 1
		else
			// Single-column form. Take the first whitespace-delimited token.
			integer sp = trimmed.indexOf(" ")
			integer tb = trimmed.indexOf("\t")
			integer end_pos = trimmed.length()
			if sp != -1 and sp < end_pos
				end_pos = sp
			if tb != -1 and tb < end_pos
				end_pos = tb
			string col = column_of(field_names, field_columns, trimmed.substring(0, end_pos).trim())
			if col.length() == 0
				return ""
			columns = col
			cols_for_name = col
		if columns.length() == 0
			return ""
		string index_prefix = "idx_"
		string keyword = "INDEX"
		if is_unique
			index_prefix = "uniq_"
			keyword = "UNIQUE INDEX"
		string index_name = index_prefix + table_name + "_" + cols_for_name
		return "CREATE " + keyword + " IF NOT EXISTS " + index_name + " ON " + table_name + " (" + columns + ")"

	// Walk the `indexes:` sub-block body and produce a newline-separated
	// list of individual CREATE INDEX SQL statements. Each statement is
	// intended to be executed as its own `_db_execute` call (multi-statement
	// strings are not portable across drivers — SQLite and some Postgres
	// pooled clients reject them). Returns "" when the body is empty or
	// contains no valid entries.
	string generate_indexes_sql_list(string indexes_body, string table_name, string field_names, string field_columns)
		string result = ""
		integer line_start = 0
		integer body_len = indexes_body.length()
		while line_start < body_len
			integer line_end = indexes_body.indexOf("\n", line_start)
			if line_end == -1
				line_end = body_len
			string line = indexes_body.substring(line_start, line_end)
			string sql = generate_index_sql_line(line, table_name, field_names, field_columns)
			if sql.length() > 0
				if result.length() > 0
					result = result + "\n"
				result = result + sql
			line_start = line_end + 1
		return result

	// Parse a single v2 `relations:` entry line into a pipe-separated tuple
	// `<name>|<cardinality>|<target_class>|<fk_column>`. Per DAT-M020 grammar:
	// `<name>: <cardinality> <TargetClass> on <fk_column>`.
	// Cardinality: `has_many`, `has_one`, `belongs_to`.
	// Returns "" for empty or malformed lines. Callers filter on the empty
	// return; validate_data_model reports malformed entries.
	string parse_v2_relation_line(string line)
		string trimmed = line.trim()
		if trimmed.length() == 0
			return ""
		// Split on the first ':' — everything before is the relation name.
		integer colon = trimmed.indexOf(":")
		if colon == -1
			return ""
		string name = trimmed.substring(0, colon).trim()
		if name.length() == 0
			return ""
		string rest = trimmed.substring(colon + 1, trimmed.length()).trim()
		// Cardinality is the first whitespace-delimited token in `rest`.
		integer sp1 = rest.indexOf(" ")
		integer tb1 = rest.indexOf("\t")
		integer end1 = rest.length()
		if sp1 != -1 and sp1 < end1
			end1 = sp1
		if tb1 != -1 and tb1 < end1
			end1 = tb1
		string cardinality = rest.substring(0, end1).trim()
		if cardinality != "has_many" and cardinality != "has_one" and cardinality != "belongs_to"
			return ""
		string after_card = rest.substring(end1, rest.length()).trim()
		// Target class is the next token before `on`.
		integer on_pos = after_card.indexOf(" on ")
		integer on_pos_tab = after_card.indexOf("\ton ")
		integer on_at = on_pos
		if on_pos_tab != -1 and (on_pos == -1 or on_pos_tab < on_pos)
			on_at = on_pos_tab
		if on_at == -1
			return ""
		string target = after_card.substring(0, on_at).trim()
		string fk = after_card.substring(on_at + 4, after_card.length()).trim()
		if target.length() == 0 or fk.length() == 0
			return ""
		return name + "|" + cardinality + "|" + target + "|" + fk

	// Walk the `relations:` sub-block body and produce a newline-separated
	// list of parsed relation tuples (see parse_v2_relation_line). Empty and
	// malformed lines are skipped. Returns "" when the body has no valid
	// entries. Callers iterate the returned list line-by-line.
	string parse_v2_relations_body(string relations_body)
		string result = ""
		integer line_start = 0
		integer body_len = relations_body.length()
		while line_start < body_len
			integer line_end = relations_body.indexOf("\n", line_start)
			if line_end == -1
				line_end = body_len
			string line = relations_body.substring(line_start, line_end)
			string tuple = parse_v2_relation_line(line)
			if tuple.length() > 0
				if result.length() > 0
					result = result + "\n"
				result = result + tuple
			line_start = line_end + 1
		return result

	// For each `belongs_to` relation in the parsed relations list, generate a
	// CREATE INDEX statement on the FK column. Foreign keys should always be
	// indexed for JOIN performance — this is the minimal `relations:`-driven
	// schema mutation the plugin can produce today without cross-class or
	// cross-call state. `has_many` and `has_one` relations do NOT generate
	// indexes on the *current* table because their FK column lives on the
	// target class's table, which the plugin cannot mutate from here.
	//
	// Returns a newline-separated list of CREATE INDEX statements suitable
	// for splicing into build_migrate_body's per-line _db_execute emission.
	// Returns "" when no belongs_to relations exist.
	string generate_relation_fk_indexes_sql(string relations_tuples, string table_name, string field_names, string field_columns)
		string result = ""
		integer line_start = 0
		integer body_len = relations_tuples.length()
		while line_start < body_len
			integer line_end = relations_tuples.indexOf("\n", line_start)
			if line_end == -1
				line_end = body_len
			string tuple = relations_tuples.substring(line_start, line_end)
			// Tuple: <name>|<cardinality>|<target>|<fk>
			integer sep1 = tuple.indexOf("|")
			integer sep2 = tuple.indexOf("|", sep1 + 1)
			integer sep3 = tuple.indexOf("|", sep2 + 1)
			if sep1 != -1 and sep2 != -1 and sep3 != -1
				string cardinality = tuple.substring(sep1 + 1, sep2)
				string fk = column_of(field_names, field_columns, tuple.substring(sep3 + 1, tuple.length()))
				if cardinality == "belongs_to" and fk.length() > 0
					string index_name = "idx_" + table_name + "_" + fk + "_fk"
					string stmt = "CREATE INDEX IF NOT EXISTS " + index_name + " ON " + table_name + " (" + fk + ")"
					if result.length() > 0
						result = result + "\n"
					result = result + stmt
			line_start = line_end + 1
		return result

	// Determine whether a Clean type name is a primitive scalar.
	boolean is_primitive_type(string type_name)
		if type_name == "integer"
			return true
		if type_name == "number"
			return true
		if type_name == "string"
			return true
		if type_name == "text"
			return true
		if type_name == "boolean"
			return true
		if type_name == "datetime"
			return true
		if type_name == "date"
			return true
		if type_name == "uuid"
			return true
		if type_name == "json"
			return true
		return false

	// Map Clean type to SQL column type.
	string clean_type_to_sql(string clean_type)
		if clean_type == "integer"
			return "INTEGER"
		if clean_type == "number"
			return "REAL"
		if clean_type == "string"
			return "TEXT"
		if clean_type == "text"
			return "TEXT"
		if clean_type == "boolean"
			return "BOOLEAN"
		if clean_type == "datetime"
			return "TIMESTAMP"
		if clean_type == "date"
			return "DATE"
		if clean_type == "uuid"
			return "UUID"
		if clean_type == "json"
			return "JSON"
		return "INTEGER"

	// Map Clean constraint to SQL constraint fragment.
	string clean_constraint_to_sql(string constraint)
		string result = ""
		// `required` is a non-null column (frame-data.ebnf §2.2).
		if has_constraint(constraint, "required")
			result = result + " NOT NULL"
		if has_constraint(constraint, "unique")
			result = result + " UNIQUE"
		if without_col_constraint(constraint).indexOf("default=now") != -1
			result = result + " DEFAULT CURRENT_TIMESTAMP"
		return result

	// SQL column definition for one field line (any accepted field form):
	// `<column> <SQL type>[ PRIMARY KEY][ NOT NULL][ UNIQUE][ DEFAULT ...]`.
	// The column is the `as "<column>"` override when given (DAT-M017). A
	// field of a model type is a foreign key `<name>_id`. "" for a line
	// without a type and a name.
	string column_def_sql(string raw_line, boolean pk_inline)
		string line = normalize_field_line(raw_line)
		if line.length() == 0
			return ""
		string constraints = line_constraints(line)
		string col_override = col_constraint(constraints)
		constraints = without_col_constraint(constraints)
		string field_part = line
		integer colon_pos = line.indexOf(" : ")
		if colon_pos != -1
			field_part = line.substring(0, colon_pos).trim()
		integer eq_pos = field_part.indexOf(" = ")
		string default_val = ""
		if eq_pos != -1
			default_val = field_part.substring(eq_pos + 3, field_part.length()).trim()
			field_part = field_part.substring(0, eq_pos).trim()
		integer space_pos = field_part.indexOf(" ")
		if space_pos == -1
			return ""
		string field_type = field_part.substring(0, space_pos).trim()
		string field_name = field_part.substring(space_pos + 1, field_part.length()).trim()
		if is_primitive_type(field_type)
			string col = field_name
			if col_override.length() > 0
				col = col_override
			string def = col + " " + clean_type_to_sql(field_type)
			if pk_inline
				def = def + " PRIMARY KEY"
			def = def + clean_constraint_to_sql(constraints)
			if default_val.length() > 0 and constraints.indexOf("default=") == -1
				string sql_default = default_val
				if sql_default.startsWith("\"") and sql_default.endsWith("\"") and sql_default.length() > 1
					sql_default = sql_default.substring(1, sql_default.length() - 1)
				if sql_default == "true" or sql_default == "false"
					def = def + " DEFAULT " + sql_default
				else
					def = def + " DEFAULT '" + sql_default.replace("'", "''") + "'"
			return def
		string ref_table = pluralize(to_snake_case(field_type))
		string fk_col = field_name + "_id"
		if col_override.length() > 0
			fk_col = col_override
		string fk_def = fk_col + " INTEGER REFERENCES " + ref_table + "(id)"
		if constraints.indexOf("onDelete=cascade") != -1
			fk_def = fk_def + " ON DELETE CASCADE"
		return fk_def + clean_constraint_to_sql(constraints)

	// Column definitions for CREATE TABLE, comma-separated. The primary key
	// `pk_field` is declared inline unless it is a database-generated
	// integer key ("auto"), which migrate() declares itself.
	string generate_field_definitions(string body, string pk_field, string pk_kind)
		string result = ""
		integer line_start = 0
		while line_start < body.length()
			integer line_end = body.indexOf("\n", line_start)
			if line_end == -1
				line_end = body.length()
			string line = body.substring(line_start, line_end).trim()
			if line.length() > 0
				string name = extract_field_name_from_line(line)
				boolean is_pk = name == pk_field
				if not (is_pk and pk_kind == "auto")
					string def = column_def_sql(line, is_pk)
					if def.length() > 0
						if result.length() > 0
							result = result + ", "
						result = result + def
			line_start = line_end + 1
		return result

	// Clean expression for one field value as a JSON parameter: strings go
	// through json.dataToText so quotes, backslashes and newlines stay valid
	// JSON; datetime values travel as {"__type":"epoch_s","value":N}.
	string field_param_expr(string field, string ftype)
		string ref = safe_field_name(field)
		if ftype == "datetime"
			return "\"{\\\"__type\\\":\\\"epoch_s\\\",\\\"value\\\":\" + " + ref + ".toInteger().toString() + \"}\""
		if ftype == "integer" or ftype == "number" or ftype == "boolean"
			return ref + ".toString()"
		return "json.dataToText(" + ref + ")"

	// Source lines appending each field but the primary key `skip_field` to
	// the JSON array in `params`. skip_first: `params` already holds an
	// element, so the first appended value needs a leading comma.
	string generate_field_serialization(string field_names, string field_types, string skip_field, boolean skip_first)
		string result = ""
		integer pos = 0
		integer type_pos = 0
		boolean first_added = false
		while pos < field_names.length()
			integer comma_pos = field_names.indexOf(",", pos)
			if comma_pos == -1
				comma_pos = field_names.length()
			integer type_comma = field_types.indexOf(",", type_pos)
			if type_comma == -1
				type_comma = field_types.length()
			string field = field_names.substring(pos, comma_pos).trim()
			string ftype = field_types.substring(type_pos, type_comma).trim()
			if field != skip_field
				string separator = ""
				if skip_first or first_added
					separator = ", "
				result = result + "params = params + \"" + separator + "\" + " + field_param_expr(field, ftype) + "\n"
				first_added = true
			pos = comma_pos + 1
			type_pos = type_comma + 1
		return result

	// UPDATE SET clause over the columns of every field but the primary key:
	// "col1 = $2, col2 = $3, ..." ($1 is the key).
	string generate_update_set_sql(string field_names, string field_columns, string pk_field)
		string result = ""
		integer pos = 0
		integer cpos = 0
		integer param_idx = 2
		while pos < field_names.length()
			integer comma_pos = field_names.indexOf(",", pos)
			if comma_pos == -1
				comma_pos = field_names.length()
			integer ccomma = field_columns.indexOf(",", cpos)
			if ccomma == -1
				ccomma = field_columns.length()
			string field = field_names.substring(pos, comma_pos).trim()
			if field != pk_field
				if result.length() > 0
					result = result + ", "
				result = result + field_columns.substring(cpos, ccomma).trim() + " = $" + param_idx.toString()
				param_idx = param_idx + 1
			pos = comma_pos + 1
			cpos = ccomma + 1
		return result

// ============================================================================
// DATA MODEL EMISSION (`data M:` → class M + top-level helpers)
// ============================================================================

functions:
	// DAT-M018: `table "x"` names the table; otherwise the snake_case plural
	// of the class name with a trailing `Data` dropped (UserData -> users,
	// frame-data.ebnf §2.1).
	string default_table_name(string model_name)
		string base = model_name
		if base.endsWith("Data") and base.length() > 4
			base = base.substring(0, base.length() - 4)
		return pluralize(to_snake_case(base))

	// The tenant column of a model: a field named `tenantId` or `tenant_id`
	// (DAT-I001), or "" for a model without tenant isolation.
	string tenant_field(string field_names)
		if csv_contains(field_names, "tenantId")
			return "tenantId"
		if csv_contains(field_names, "tenant_id")
			return "tenant_id"
		return ""

	// The class-spec field entries for _emit_class_full (typed-emission.md
	// §3.13), one per field line of `body`: {"name","type","visibility"} plus
	// "default" — the field's `default:` value (frame-data.ebnf §2.2) as
	// Clean expression text, so a new record starts with it (Amendment 14).
	string build_fields_json(string body)
		string result = "["
		boolean first = true
		integer line_start = 0
		while line_start < body.length()
			integer line_end = body.indexOf("\n", line_start)
			if line_end == -1
				line_end = body.length()
			string line = body.substring(line_start, line_end).trim()
			string fname = ""
			if line.length() > 0
				fname = extract_field_name_from_line(line)
			if fname.length() > 0
				string ftype = extract_field_type_from_line(line)
				// Map DSL types to Clean runtime types (same as parse_field_line)
				string clean_ftype = ftype
				if ftype == "datetime" or ftype == "date" or ftype == "text" or ftype == "uuid" or ftype == "json"
					clean_ftype = "string"
				if not first
					result = result + ","
				// Persisted columns are public: callers construct the record,
				// read `entity.id` after Database.save (DAT-E002, DAT-Q014) and
				// mutate fields before re-saving (load-mutate-save, DAT-S001).
				result = result + "{\"name\":\"" + safe_field_name(fname) + "\",\"type\":\"" + clean_ftype + "\",\"visibility\":\"public\""
				// Only text and scalar columns take a Clean default; datetime and
				// other mapped types keep theirs in the column's SQL DEFAULT.
				string def = field_default_from_line(line)
				if def.length() > 0 and ftype == clean_ftype
					result = result + ",\"default\":\"" + lint_json_escape(def) + "\""
				result = result + "}"
				first = false
			line_start = line_end + 1
		result = result + "]"
		return result

	// The default value of a field line (`<type> <name> = <value> [: ...]`
	// after normalization), or "" when it declares none.
	string field_default_from_line(string line)
		string norm = normalize_field_line(line)
		integer colon_pos = norm.indexOf(" : ")
		if colon_pos != -1
			norm = norm.substring(0, colon_pos)
		integer equals_pos = norm.indexOf(" = ")
		if equals_pos == -1
			return ""
		return norm.substring(equals_pos + 3, norm.length()).trim()

	// Statements (at `indent`) giving a tenant-scoped model the session
	// tenant when its tenant field is unset (DAT-I001); "" otherwise.
	string tenant_fill_source(string field_names, string field_types, string indent)
		string tf = tenant_field(field_names)
		if tf.length() == 0
			return ""
		string tref = safe_field_name(tf)
		if field_type_of(field_names, field_types, tf) == "integer"
			return indent + "if " + tref + " == 0\n" + indent + "\t" + tref + " = tenant_getId().toInteger()\n"
		return indent + "if " + tref + " == \"\"\n" + indent + "\t" + tref + " = tenant_getId()\n"

	// "$1, $2, ..., $n".
	string placeholders_sql(integer n)
		string out = ""
		integer i = 1
		while i <= n
			if i > 1
				out = out + ", "
			out = out + "$" + i.toString()
			i = i + 1
		return out

	// Columns of every field but `skip_field`, comma-separated.
	string columns_without(string field_names, string field_columns, string skip_field)
		string result = ""
		integer pos = 0
		integer cpos = 0
		while pos < field_names.length()
			integer comma = field_names.indexOf(",", pos)
			if comma == -1
				comma = field_names.length()
			integer ccomma = field_columns.indexOf(",", cpos)
			if ccomma == -1
				ccomma = field_columns.length()
			string field = field_names.substring(pos, comma).trim()
			if field.length() > 0 and field != skip_field
				if result.length() > 0
					result = result + ", "
				result = result + field_columns.substring(cpos, ccomma).trim()
			pos = comma + 1
			cpos = ccomma + 1
		return result

	// Body of `boolean save()` (DAT-S001), by primary-key kind (pk_kind_of):
	//   auto      key unset (0): INSERT ... RETURNING and store the generated
	//             key; otherwise UPDATE by key.
	//   uuid      key unset (""): set a UUID v4, INSERT; otherwise UPDATE.
	//   assigned  the caller sets the key: UPDATE by key, INSERT when no
	//             row was updated.
	// A tenant-scoped model takes the session tenant when its tenant field
	// is unset, and only updates rows of that tenant (DAT-I001).
	string save_source(string model_name, string table_name, string field_names, string field_types, string field_columns, string pk_field, string pk_kind)
		string pk = safe_field_name(pk_field)
		string pk_col = column_of(field_names, field_columns, pk_field)
		boolean int_pk = field_type_of(field_names, field_types, pk_field) == "integer"
		string other_cols = columns_without(field_names, field_columns, pk_field)
		integer other_count = count_fields(csv_without(field_names, pk_field))
		string set_sql = generate_update_set_sql(field_names, field_columns, pk_field)
		string update_call = ""
		if set_sql.length() > 0
			update_call = "_db_execute(" + clean_str("UPDATE " + table_name + " SET " + set_sql) + " + __" + model_name + "_where(" + clean_str(pk_col + " = $1") + "), __to_update_params())"
		string insert_all_sql = "INSERT INTO " + table_name + " (" + pk_col + ") VALUES ($1)"
		if other_count > 0
			insert_all_sql = "INSERT INTO " + table_name + " (" + pk_col + ", " + other_cols + ") VALUES (" + placeholders_sql(other_count + 1) + ")"
		string insert_all_call = "_db_execute(" + clean_str(insert_all_sql) + ", __to_update_params())"

		string src = ""
		if pk_kind == "auto"
			src = "if " + pk + " == 0\n"
			src = src + tenant_fill_source(field_names, field_types, "\t")
			string insert_sql = "INSERT INTO " + table_name + " DEFAULT VALUES RETURNING " + pk_col
			if other_count > 0
				insert_sql = "INSERT INTO " + table_name + " (" + other_cols + ") VALUES (" + placeholders_sql(other_count) + ") RETURNING " + pk_col
			src = src + "\t" + pk + " = __extract_id(_db_query(" + clean_str(insert_sql) + ", __to_params()))\n"
			src = src + "\treturn " + pk + " > 0\n"
		else if pk_kind == "uuid"
			src = "if " + pk + " == \"\"\n"
			src = src + tenant_fill_source(field_names, field_types, "\t")
			src = src + "\tstring __h = _crypto_random_hex(16)\n"
			src = src + "\tinteger __vi = \"0123456789abcdef\".indexOf(__h.substring(16, 17))\n"
			src = src + "\t" + pk + " = __h.substring(0, 8) + \"-\" + __h.substring(8, 12) + \"-4\" + __h.substring(13, 16) + \"-\" + \"89ab89ab89ab89ab\".substring(__vi, __vi + 1) + __h.substring(17, 20) + \"-\" + __h.substring(20, 32)\n"
			src = src + "\treturn " + insert_all_call + " > 0\n"
		else
			if not int_pk
				src = "if " + pk + " == \"\"\n"
				src = src + "\terror(" + clean_str("VALIDATION: " + model_name + "." + pk_field + " is the primary key and must be set before Database.save") + ")\n"
			src = src + tenant_fill_source(field_names, field_types, "")
			if update_call.length() > 0
				src = src + "if " + update_call + " > 0\n\treturn true\n"
			src = src + "return " + insert_all_call + " > 0\n"
			return src
		if update_call.length() == 0
			return src + "return true\n"
		return src + "return " + update_call + " > 0\n"

	// Body of `boolean delete()` (DAT-S003): lenient — false when no row
	// was removed (or the key was never set).
	string delete_source(string model_name, string table_name, string field_names, string field_types, string field_columns, string pk_field, string pk_kind)
		string pk = safe_field_name(pk_field)
		string pk_type = field_type_of(field_names, field_types, pk_field)
		string src = ""
		if pk_type == "integer"
			if pk_kind == "auto"
				src = "if " + pk + " == 0\n\treturn false\n"
		else
			src = "if " + pk + " == \"\"\n\treturn false\n"
		string pk_col = column_of(field_names, field_columns, pk_field)
		src = src + "return _db_execute(" + clean_str("DELETE FROM " + table_name) + " + __" + model_name + "_where(" + clean_str(pk_col + " = $1") + "), \"[\" + " + field_param_expr(pk_field, pk_type) + " + \"]\") > 0\n"
		return src

	// Body of `boolean migrate()` (DAT-C005): CREATE TABLE IF NOT EXISTS,
	// then one CREATE INDEX per entry of indexes_sql (newline-separated).
	// A database-generated integer key is declared here, per engine.
	string migrate_source(string table_name, string field_defs, string indexes_sql, string pk_col, string pk_kind)
		string src = ""
		if pk_kind == "auto"
			// The generated key is `SERIAL` on Postgres; SQLite only assigns a
			// key to an `INTEGER PRIMARY KEY` column, so probe the engine first.
			src = "string __pk_def = " + clean_str(pk_col + " SERIAL PRIMARY KEY") + "\n"
			src = src + "string __engine_probe = _db_query(\"SELECT sqlite_version() AS v\", \"[]\")\n"
			src = src + "if __engine_probe.indexOf(\"\\\"ok\\\":true\") != -1\n"
			src = src + "\t__pk_def = " + clean_str(pk_col + " INTEGER PRIMARY KEY AUTOINCREMENT") + "\n"
			string defs_tail = ""
			if field_defs.length() > 0
				defs_tail = ", " + field_defs
			src = src + "integer affected = _db_execute(" + clean_str("CREATE TABLE IF NOT EXISTS " + table_name + " (") + " + __pk_def + " + clean_str(defs_tail + ")") + ", \"[]\")\n"
		else
			src = "integer affected = _db_execute(" + clean_str("CREATE TABLE IF NOT EXISTS " + table_name + " (" + field_defs + ")") + ", \"[]\")\n"
		integer line_start = 0
		while line_start < indexes_sql.length()
			integer line_end = indexes_sql.indexOf("\n", line_start)
			if line_end == -1
				line_end = indexes_sql.length()
			string idx_stmt = indexes_sql.substring(line_start, line_end).trim()
			if idx_stmt.length() > 0
				src = src + "_db_execute(" + clean_str(idx_stmt) + ", \"[]\")\n"
			line_start = line_end + 1
		src = src + "return affected >= 0\n"
		return src

	// Comma-separated field list with the `skip_field` entry removed.
	string csv_without(string field_names, string skip_field)
		string result = ""
		integer pos = 0
		while pos < field_names.length()
			integer comma_pos = field_names.indexOf(",", pos)
			if comma_pos == -1
				comma_pos = field_names.length()
			string field = field_names.substring(pos, comma_pos).trim()
			if field.length() > 0 and field != skip_field
				if result.length() > 0
					result = result + ","
				result = result + field
			pos = comma_pos + 1
		return result

	// The declared type of one field (parallel csv lists), or "".
	string field_type_of(string field_names, string field_types, string field)
		integer pos = 0
		integer tpos = 0
		while pos < field_names.length()
			integer comma = field_names.indexOf(",", pos)
			if comma == -1
				comma = field_names.length()
			integer tcomma = field_types.indexOf(",", tpos)
			if tcomma == -1
				tcomma = field_types.length()
			if field_names.substring(pos, comma).trim() == field
				return field_types.substring(tpos, tcomma).trim()
			pos = comma + 1
			tpos = tcomma + 1
		return ""

	// One inline class-spec method entry.
	string method_entry(string name, string params_json, string return_type, integer body_h)
		return "{\"kind\":\"inline\",\"name\":\"" + name + "\",\"params\":" + params_json + ",\"return_type\":\"" + return_type + "\",\"body_handle\":" + body_h.toString() + "}"

	// The methods array of class M: save/delete (Persist), migrate, and the
	// private parameter serializers. Returns "" with the sticky error set on
	// failure.
	string build_methods_json(integer ctx, string model_name, string table_name, string field_names, string field_types, string field_columns, string pk_field, string pk_kind, string field_defs, string indexes_sql)
		string pk_col = column_of(field_names, field_columns, pk_field)
		integer save_h = body_from_source(ctx, save_source(model_name, table_name, field_names, field_types, field_columns, pk_field, pk_kind))
		if save_h == 0
			return ""
		string methods = "[" + method_entry("save", "[]", "boolean", save_h)

		integer del_h = body_from_source(ctx, delete_source(model_name, table_name, field_names, field_types, field_columns, pk_field, pk_kind))
		if del_h == 0
			return ""
		methods = methods + "," + method_entry("delete", "[]", "boolean", del_h)

		integer mig_h = body_from_source(ctx, migrate_source(table_name, field_defs, indexes_sql, pk_col, pk_kind))
		if mig_h == 0
			return ""
		methods = methods + "," + method_entry("migrate", "[]", "boolean", mig_h)

		// __to_params(): INSERT parameters, every field but the key.
		string tp_src = "string params = \"[\"\n" + generate_field_serialization(field_names, field_types, pk_field, false) + "return params + \"]\"\n"
		integer tp_h = body_from_source(ctx, tp_src)
		if tp_h == 0
			return ""
		methods = methods + "," + method_entry("__to_params", "[]", "string", tp_h)

		// __to_update_params(): the key ($1) followed by the other fields.
		string tup_src = "string params = \"[\" + " + field_param_expr(pk_field, field_type_of(field_names, field_types, pk_field)) + "\n" + generate_field_serialization(field_names, field_types, pk_field, true) + "return params + \"]\"\n"
		integer tup_h = body_from_source(ctx, tup_src)
		if tup_h == 0
			return ""
		methods = methods + "," + method_entry("__to_update_params", "[]", "string", tup_h)

		// __extract_id(result): Postgres answers INSERT ... RETURNING with a
		// row (`"<key column>":N`); SQLite reports `"last_insert_id":N`.
		string eid_src = "integer id_pos = result.indexOf(" + clean_str("\"" + pk_col + "\":") + ")\n"
		eid_src = eid_src + "integer key_len = " + (pk_col.length() + 3).toString() + "\n"
		eid_src = eid_src + "if id_pos == -1\n"
		eid_src = eid_src + "\tid_pos = result.indexOf(\"\\\"last_insert_id\\\":\")\n"
		eid_src = eid_src + "\tkey_len = 17\n"
		eid_src = eid_src + "if id_pos == -1\n"
		eid_src = eid_src + "\treturn 0\n"
		eid_src = eid_src + "integer value_start = id_pos + key_len\n"
		eid_src = eid_src + "integer value_end = value_start\n"
		eid_src = eid_src + "while value_end < result.length()\n"
		eid_src = eid_src + "\tstring ch = result.substring(value_end, value_end + 1)\n"
		eid_src = eid_src + "\tif ch == \",\" or ch == \"}\" or ch == \" \"\n"
		eid_src = eid_src + "\t\tbreak\n"
		eid_src = eid_src + "\tvalue_end = value_end + 1\n"
		eid_src = eid_src + "return result.substring(value_start, value_end).toInteger()\n"
		integer eid_h = body_from_source(ctx, eid_src)
		if eid_h == 0
			return ""
		methods = methods + "," + method_entry("__extract_id", "[{\"name\":\"result\",\"type\":\"string\"}]", "integer", eid_h)
		return methods + "]"

	// Clean statements that raise when the _db_query result `json_var`
	// reports a failed query (stdlib §9: database functions raise on query
	// errors instead of answering as if no row matched).
	string raise_on_db_error(string json_var)
		string src = "if json.get(" + json_var + ", \"ok\") == \"false\"\n"
		src = src + "\terror(\"DB_ERROR: \" + json.get(" + json_var + ", \"err.message\"))\n"
		return src

	// Source lines (one tab deep) copying each primitive column of
	// `__row_json` into the matching field of `__row`; a field reads its
	// `as "<column>"` column (DAT-M017).
	string row_field_assignments(string field_names, string field_types, string field_columns)
		string src = ""
		integer fpos = 0
		integer tpos = 0
		while fpos < field_names.length()
			integer comma = field_names.indexOf(",", fpos)
			if comma == -1
				comma = field_names.length()
			integer tcomma = field_types.indexOf(",", tpos)
			if tcomma == -1
				tcomma = field_types.length()
			string field = field_names.substring(fpos, comma).trim()
			string ftype = field_types.substring(tpos, tcomma).trim()
			if is_primitive_type(ftype)
				string col = column_of(field_names, field_columns, field)
				string base = "\t__row." + safe_field_name(field) + " = json.get(__row_json, " + clean_str(col) + ")"
				if ftype == "integer"
					src = src + base + ".toInteger()\n"
				else if ftype == "number"
					src = src + base + ".toNumber()\n"
				else if ftype == "boolean"
					// SQLite stores booleans as 0/1; Postgres returns true/false.
					string bvar = "__b_" + safe_field_name(field)
					src = src + "\tstring " + bvar + " = json.get(__row_json, " + clean_str(col) + ")\n"
					src = src + "\t__row." + safe_field_name(field) + " = (" + bvar + " == \"true\") or (" + bvar + " == \"1\")\n"
				else
					src = src + base + "\n"
			fpos = comma + 1
			tpos = tcomma + 1
		return src

	// Source of __M_cols(sql): rewrites every field name of M that has an
	// `as "<column>"` override (DAT-M017) to its column. Only bare names and
	// names qualified by M's table are rewritten; text inside '...' SQL
	// literals is left alone. "return sql" when M renames no field.
	string cols_source(string model_name, string field_names, string field_columns)
		string renames = ""
		integer pos = 0
		integer cpos = 0
		while pos < field_names.length()
			integer comma = field_names.indexOf(",", pos)
			if comma == -1
				comma = field_names.length()
			integer ccomma = field_columns.indexOf(",", cpos)
			if ccomma == -1
				ccomma = field_columns.length()
			string field = field_names.substring(pos, comma).trim()
			string col = field_columns.substring(cpos, ccomma).trim()
			if field.length() > 0 and col != field
				string kw = "else if"
				if renames.length() == 0
					kw = "if"
				renames = renames + "\t\t\t" + kw + " __w == " + clean_str(field) + "\n\t\t\t\t__w = " + clean_str(col) + "\n"
			pos = comma + 1
			cpos = ccomma + 1
		if renames.length() == 0
			return "return sql\n"
		string letter = "(__ch >= \"a\" and __ch <= \"z\") or (__ch >= \"A\" and __ch <= \"Z\") or __ch == \"_\""
		string word_ch = "(__c2 >= \"a\" and __c2 <= \"z\") or (__c2 >= \"A\" and __c2 <= \"Z\") or (__c2 >= \"0\" and __c2 <= \"9\") or __c2 == \"_\""
		string src = "string __out = \"\"\n"
		src = src + "boolean __inq = false\n"
		src = src + "integer __i = 0\n"
		src = src + "integer __n = sql.length()\n"
		src = src + "string __tdot = __" + model_name + "_table() + \".\"\n"
		src = src + "while __i < __n\n"
		src = src + "\tstring __ch = sql.substring(__i, __i + 1)\n"
		src = src + "\tif __inq\n"
		src = src + "\t\t__out = __out + __ch\n"
		src = src + "\t\tif __ch == \"'\"\n"
		src = src + "\t\t\t__inq = false\n"
		src = src + "\t\t__i = __i + 1\n"
		src = src + "\telse if __ch == \"'\"\n"
		src = src + "\t\t__inq = true\n"
		src = src + "\t\t__out = __out + __ch\n"
		src = src + "\t\t__i = __i + 1\n"
		src = src + "\telse if " + letter + "\n"
		src = src + "\t\tinteger __s = __i\n"
		src = src + "\t\tboolean __scan = true\n"
		src = src + "\t\twhile __i < __n and __scan\n"
		src = src + "\t\t\tstring __c2 = sql.substring(__i, __i + 1)\n"
		src = src + "\t\t\tif " + word_ch + "\n"
		src = src + "\t\t\t\t__i = __i + 1\n"
		src = src + "\t\t\telse\n"
		src = src + "\t\t\t\t__scan = false\n"
		src = src + "\t\tstring __w = sql.substring(__s, __i)\n"
		src = src + "\t\tboolean __own = true\n"
		src = src + "\t\tif __s > 0\n"
		src = src + "\t\t\tif sql.substring(__s - 1, __s) == \".\"\n"
		src = src + "\t\t\t\t__own = __out.endsWith(__tdot)\n"
		src = src + "\t\tif __own\n"
		src = src + renames
		src = src + "\t\t__out = __out + __w\n"
		src = src + "\telse\n"
		src = src + "\t\t__out = __out + __ch\n"
		src = src + "\t\t__i = __i + 1\n"
		src = src + "return __out\n"
		return src

	// Top-level helpers shared by the class and by every query on M:
	//   __M_table()          the table name (DAT-M018)
	//   __M_cols(sql)        renamed field names rewritten to columns (DAT-M017)
	//   __M_cond(w)          w (columns resolved) with the tenant scope (DAT-I001)
	//   __M_where(w)         " WHERE <cond>", or "" when there is no condition
	//   __parse_as_M(json)   rows of a _db_query result as list<M>
	//   __first_as_M(json)   first row or null (DAT-Q001)
	//   __find_or_fail_as_M  first row or NOT_FOUND (DAT-Q002)
	//   __M_count(w) / __M_exists(w)  (DAT-Q004 / DAT-Q003)
	integer emit_model_helpers(integer ctx, string model_name, string table_name, string field_names, string field_types, string field_columns)
		integer t_str = _type_string(ctx)
		if emit_fn(ctx, "__" + model_name + "_table", "[]", t_str, "return " + clean_str(table_name) + "\n") != 0
			return 1

		if emit_fn(ctx, "__" + model_name + "_cols", string_param(ctx, "sql"), _type_string(ctx), cols_source(model_name, field_names, field_columns)) != 0
			return 1

		string tf = tenant_field(field_names)
		string cond_src = "string __w = __" + model_name + "_cols(w)\n"
		if tf.length() > 0
			cond_src = cond_src + "string __t = " + clean_str(table_name + "." + column_of(field_names, field_columns, tf) + " = '") + " + tenant_getId().replace(\"'\", \"''\") + \"'\"\n"
			cond_src = cond_src + "if __w.length() == 0\n\treturn __t\n"
			cond_src = cond_src + "return __t + \" AND (\" + __w + \")\"\n"
		else
			cond_src = cond_src + "return __w\n"
		if emit_fn(ctx, "__" + model_name + "_cond", string_param(ctx, "w"), _type_string(ctx), cond_src) != 0
			return 1

		string where_src = "string __c = __" + model_name + "_cond(w)\n"
		where_src = where_src + "if __c.length() == 0\n\treturn \"\"\n"
		where_src = where_src + "return \" WHERE \" + __c\n"
		if emit_fn(ctx, "__" + model_name + "_where", string_param(ctx, "w"), _type_string(ctx), where_src) != 0
			return 1

		string pa = "list<" + model_name + "> __result = []\n"
		pa = pa + raise_on_db_error("__json")
		pa = pa + "string __pa_data = json.get(__json, \"data\")\n"
		pa = pa + "string __pa_rows = json.get(__pa_data, \"rows\")\n"
		pa = pa + "integer __i = 0\n"
		pa = pa + "string __check = json.get(__pa_rows, \"0\")\n"
		pa = pa + "while __check != \"\"\n"
		pa = pa + "\t" + model_name + " __row = " + model_name + "()\n"
		pa = pa + "\tstring __row_json = json.get(__pa_rows, __i.toString())\n"
		pa = pa + row_field_assignments(field_names, field_types, field_columns)
		pa = pa + "\t__result.add(__row)\n"
		pa = pa + "\t__i = __i + 1\n"
		pa = pa + "\t__check = json.get(__pa_rows, __i.toString())\n"
		pa = pa + "return __result\n"
		integer list_t = _type_array(ctx, _type_class_ref(ctx, model_name))
		if emit_fn(ctx, "__parse_as_" + model_name, string_param(ctx, "__json"), list_t, pa) != 0
			return 1

		string fa = "list<" + model_name + "> __fa_rows = __parse_as_" + model_name + "(__json)\n"
		fa = fa + "if __fa_rows.length() == 0\n\treturn null\n"
		fa = fa + "return __fa_rows[0]\n"
		if emit_fn(ctx, "__first_as_" + model_name, string_param(ctx, "__json"), _type_class_ref(ctx, model_name), fa) != 0
			return 1

		string ff = "list<" + model_name + "> __ff_rows = __parse_as_" + model_name + "(__json)\n"
		ff = ff + "if __ff_rows.length() == 0\n\terror(\"NOT_FOUND\")\n"
		ff = ff + "return __ff_rows[0]\n"
		if emit_fn(ctx, "__find_or_fail_as_" + model_name, string_param(ctx, "__json"), _type_class_ref(ctx, model_name), ff) != 0
			return 1

		string cnt = "string __cnt = _db_query(" + clean_str("SELECT COUNT(*) AS count FROM " + table_name) + " + __" + model_name + "_where(w), \"[]\")\n"
		cnt = cnt + raise_on_db_error("__cnt")
		cnt = cnt + "string __cnt_data = json.get(__cnt, \"data\")\n"
		cnt = cnt + "string __cnt_rows = json.get(__cnt_data, \"rows\")\n"
		cnt = cnt + "string __cnt_row = json.get(__cnt_rows, \"0\")\n"
		cnt = cnt + "if __cnt_row == \"\"\n\treturn 0\n"
		cnt = cnt + "return json.get(__cnt_row, \"count\").toInteger()\n"
		if emit_fn(ctx, "__" + model_name + "_count", string_param(ctx, "w"), _type_integer(ctx), cnt) != 0
			return 1

		string ex = "string __ex = _db_query(" + clean_str("SELECT 1 AS present FROM " + table_name) + " + __" + model_name + "_where(w) + \" LIMIT 1\", \"[]\")\n"
		ex = ex + raise_on_db_error("__ex")
		ex = ex + "string __ex_data = json.get(__ex, \"data\")\n"
		ex = ex + "string __ex_rows = json.get(__ex_data, \"rows\")\n"
		ex = ex + "string __ex_row = json.get(__ex_rows, \"0\")\n"
		ex = ex + "return __ex_row != \"\" and __ex_row != \"null\"\n"
		if emit_fn(ctx, "__" + model_name + "_exists", string_param(ctx, "w"), _type_boolean(ctx), ex) != 0
			return 1
		return 0

	// DAT-Q021 — the per-model pagination result classes and the functions
	// that build them from the host's result envelope:
	//   PagedResult_<M>:  items, totalCount, totalPages, currentPage, perPage,
	//                     hasNext, hasPrev
	//   CursorResult_<M>: items, nextCursor, hasNext, hasPrev, count
	// The host answers _db_paginate with {"ok":..,"data":{"data":[rows],
	// "total","page","per_page","total_pages"}} and _db_cursor_page with
	// {"ok":..,"data":{"data":[rows],"next_cursor","has_more"}}; the rows are
	// materialized through __parse_as_<M>, which reads data.rows.
	integer emit_pagination_classes(integer ctx, string model_name)
		string items_type = "list<" + model_name + ">"
		string paged_name = "PagedResult_" + model_name
		string paged_spec = "{\"name\":\"" + paged_name + "\",\"parent\":null,\"fields\":["
		paged_spec = paged_spec + "{\"name\":\"items\",\"type\":\"" + items_type + "\",\"visibility\":\"public\"}"
		paged_spec = paged_spec + ",{\"name\":\"totalCount\",\"type\":\"integer\",\"visibility\":\"public\"}"
		paged_spec = paged_spec + ",{\"name\":\"totalPages\",\"type\":\"integer\",\"visibility\":\"public\"}"
		paged_spec = paged_spec + ",{\"name\":\"currentPage\",\"type\":\"integer\",\"visibility\":\"public\"}"
		paged_spec = paged_spec + ",{\"name\":\"perPage\",\"type\":\"integer\",\"visibility\":\"public\"}"
		paged_spec = paged_spec + ",{\"name\":\"hasNext\",\"type\":\"boolean\",\"visibility\":\"public\"}"
		paged_spec = paged_spec + ",{\"name\":\"hasPrev\",\"type\":\"boolean\",\"visibility\":\"public\"}"
		paged_spec = paged_spec + "],\"methods\":[]}"
		_emit_class_full(ctx, _batch_stringLit(ctx, paged_spec), 1)
		if _ctx_had_error(ctx) != 0
			return 1

		string cursor_name = "CursorResult_" + model_name
		string cursor_spec = "{\"name\":\"" + cursor_name + "\",\"parent\":null,\"fields\":["
		cursor_spec = cursor_spec + "{\"name\":\"items\",\"type\":\"" + items_type + "\",\"visibility\":\"public\"}"
		cursor_spec = cursor_spec + ",{\"name\":\"nextCursor\",\"type\":\"string\",\"visibility\":\"public\"}"
		cursor_spec = cursor_spec + ",{\"name\":\"hasNext\",\"type\":\"boolean\",\"visibility\":\"public\"}"
		cursor_spec = cursor_spec + ",{\"name\":\"hasPrev\",\"type\":\"boolean\",\"visibility\":\"public\"}"
		cursor_spec = cursor_spec + ",{\"name\":\"count\",\"type\":\"integer\",\"visibility\":\"public\"}"
		cursor_spec = cursor_spec + "],\"methods\":[]}"
		_emit_class_full(ctx, _batch_stringLit(ctx, cursor_spec), 1)
		if _ctx_had_error(ctx) != 0
			return 1

		string pg = paged_name + " __pr = " + paged_name + "()\n"
		pg = pg + raise_on_db_error("__json")
		pg = pg + "string __pr_data = json.get(__json, \"data\")\n"
		pg = pg + "__pr.items = __parse_as_" + model_name + "(\"{\\\"data\\\":{\\\"rows\\\":\" + json.get(__pr_data, \"data\") + \"}}\")\n"
		pg = pg + "__pr.totalCount = json.get(__pr_data, \"total\").toInteger()\n"
		pg = pg + "__pr.totalPages = json.get(__pr_data, \"total_pages\").toInteger()\n"
		pg = pg + "__pr.currentPage = json.get(__pr_data, \"page\").toInteger()\n"
		pg = pg + "__pr.perPage = json.get(__pr_data, \"per_page\").toInteger()\n"
		pg = pg + "__pr.hasNext = __pr.currentPage < __pr.totalPages\n"
		pg = pg + "__pr.hasPrev = __pr.currentPage > 1\n"
		pg = pg + "return __pr\n"
		if emit_fn(ctx, "__paged_as_" + model_name, string_param(ctx, "__json"), _type_class_ref(ctx, paged_name), pg) != 0
			return 1

		string cr = cursor_name + " __cr = " + cursor_name + "()\n"
		cr = cr + raise_on_db_error("__json")
		cr = cr + "string __cr_data = json.get(__json, \"data\")\n"
		cr = cr + "__cr.items = __parse_as_" + model_name + "(\"{\\\"data\\\":{\\\"rows\\\":\" + json.get(__cr_data, \"data\") + \"}}\")\n"
		cr = cr + "string __cr_next = json.get(__cr_data, \"next_cursor\")\n"
		cr = cr + "if __cr_next == \"null\"\n"
		cr = cr + "\t__cr_next = \"\"\n"
		cr = cr + "__cr.nextCursor = __cr_next\n"
		cr = cr + "string __cr_more = json.get(__cr_data, \"has_more\")\n"
		cr = cr + "__cr.hasNext = __cr_more == \"true\" or __cr_more == \"1\"\n"
		cr = cr + "__cr.hasPrev = __after != \"\"\n"
		cr = cr + "__cr.count = __cr.items.length()\n"
		cr = cr + "return __cr\n"
		string cr_params = "[{\"name\":\"__json\",\"type_handle\":" + _type_string(ctx).toString() + "},{\"name\":\"__after\",\"type_handle\":" + _type_string(ctx).toString() + "}]"
		if emit_fn(ctx, "__cursor_as_" + model_name, cr_params, _type_class_ref(ctx, cursor_name), cr) != 0
			return 1
		return 0

functions:
	// Extract the value of a key from a flat JSON object string ("" when absent).
	string extract_attr(string json_str, string key)
		string pattern = "\"" + key + "\":"
		integer pos = json_str.indexOf(pattern)
		if pos == -1
			return ""
		integer val_start = pos + pattern.length()
		// Skip whitespace
		while val_start < json_str.length()
			string ch = json_str.substring(val_start, val_start + 1)
			if ch != " " and ch != "\t"
				break
			val_start = val_start + 1
		if val_start >= json_str.length()
			return ""
		string first_ch = json_str.substring(val_start, val_start + 1)
		if first_ch == "\""
			// String value — scan to closing quote (no escape handling needed for identifiers)
			integer val_end = val_start + 1
			while val_end < json_str.length()
				string ch2 = json_str.substring(val_end, val_end + 1)
				if ch2 == "\""
					break
				val_end = val_end + 1
			return json_str.substring(val_start + 1, val_end)
		// Bare value (true/false/number) — scan to comma, }, or end
		integer val_end2 = val_start
		while val_end2 < json_str.length()
			string ch3 = json_str.substring(val_end2, val_end2 + 1)
			if ch3 == "," or ch3 == "}" or ch3 == " " or ch3 == "\n"
				break
			val_end2 = val_end2 + 1
		return json_str.substring(val_start, val_end2).trim()

	// True when any field line of the (v1-shaped) body declares `id`.
	boolean body_has_id_field(string body)
		integer line_start = 0
		while line_start < body.length()
			integer line_end = body.indexOf("\n", line_start)
			if line_end == -1
				line_end = body.length()
			string line = body.substring(line_start, line_end).trim()
			if line.length() > 0
				string normalized = normalize_field_line(line)
				// normalized shape: "<type> id [ = ...][ : ...]"
				integer space_pos = normalized.indexOf(" ")
				if space_pos != -1
					string rest = normalized.substring(space_pos + 1, normalized.length()).trim()
					integer next_space = rest.indexOf(" ")
					string name = rest
					if next_space != -1
						name = rest.substring(0, next_space).trim()
					if name == "id"
						return true
			line_start = line_end + 1
		return false

	// True when any field line of the (v1-shaped) body is marked `primary`.
	boolean body_has_pk_field(string body)
		integer line_start = 0
		while line_start < body.length()
			integer line_end = body.indexOf("\n", line_start)
			if line_end == -1
				line_end = body.length()
			string line = body.substring(line_start, line_end).trim()
			if line.length() > 0 and has_constraint(line_constraints(normalize_field_line(line)), "pk")
				return true
			line_start = line_end + 1
		return false

	// Expand `data M:` (frame-data.ebnf §2) into class M plus its helpers.
	integer expand_data_model(integer ctx, string model_name, string body)
		_ctx_set_error_context(ctx, "PLUGIN-DATA-MODEL", "expand_data_model for " + model_name)

		// The v2 `fields:` sub-block is rewritten into `<type> <name> [= default]
		// [: constraints]` lines, the shape the field helpers below consume.
		// The original body keeps the table/indexes/relations/queries
		// sub-blocks.
		string orig_v2_body = body
		boolean v2_form = is_v2_sub_block_form(body)
		if v2_form
			string fields_body = extract_v2_sub_block(body, "fields")
			if extract_v2_field_names(fields_body).length() == 0
				return plugin_error(ctx, "FRAME-DATA-E020", "data " + model_name + ": `fields:` sub-block is missing or empty (spec DAT-M015)")
			body = synthesize_v1_body_from_v2_fields(fields_body)

		// A model without a `primary` field has the generated integer key
		// `id` (DAT-E002); declare it when the fields leave it out.
		if not body_has_id_field(body) and not body_has_pk_field(body)
			body = "integer id\n" + body

		string table_name = default_table_name(model_name)
		string declared_table = ""
		if v2_form
			declared_table = extract_v2_table_line(orig_v2_body)
		if declared_table.length() > 0
			table_name = declared_table
		string field_names = extract_field_names(body)
		string field_types = extract_field_types(body)
		string field_columns = extract_field_columns(body)
		string pk_field = pk_field_of(body)
		string pk_kind = pk_kind_of(body, pk_field, field_type_of(field_names, field_types, pk_field))
		string field_defs = generate_field_definitions(body, pk_field, pk_kind)
		string fields_json = build_fields_json(body)

		// indexes: (DAT-M019) plus an index on every belongs_to foreign key
		// (DAT-M020), all created by migrate() after CREATE TABLE.
		string indexes_sql = ""
		if v2_form
			string indexes_body = extract_v2_sub_block(orig_v2_body, "indexes")
			if indexes_body.length() > 0
				indexes_sql = generate_indexes_sql_list(indexes_body, table_name, field_names, field_columns)
			string relations_body = extract_v2_sub_block(orig_v2_body, "relations")
			if relations_body.length() > 0
				string fk_indexes_sql = generate_relation_fk_indexes_sql(parse_v2_relations_body(relations_body), table_name, field_names, field_columns)
				if fk_indexes_sql.length() > 0
					if indexes_sql.length() > 0
						indexes_sql = indexes_sql + "\n"
					indexes_sql = indexes_sql + fk_indexes_sql

		string methods_json = build_methods_json(ctx, model_name, table_name, field_names, field_types, field_columns, pk_field, pk_kind, field_defs, indexes_sql)
		if _ctx_had_error(ctx) != 0 or methods_json.length() == 0
			return 1

		// queries: methods become class methods (DAT-A006).
		if v2_form
			string queries_body = extract_v2_sub_block(orig_v2_body, "queries")
			if queries_body.length() > 0
				string queries_entries = emit_queries_methods_json(ctx, queries_body, model_name)
				if _ctx_had_error(ctx) != 0
					return 1
				if queries_entries.length() > 0
					methods_json = methods_json.substring(0, methods_json.length() - 1) + queries_entries + "]"

		// `cans: ["Persist"]` makes M conform to the capability emitted by
		// emit_module_helpers_typed, so Database.save(m) dispatches to m.save().
		string class_spec = "{\"name\":\"" + model_name + "\""
		class_spec = class_spec + ",\"table_name\":\"" + table_name + "\""
		class_spec = class_spec + ",\"parent\":null"
		class_spec = class_spec + ",\"fields\":" + fields_json
		class_spec = class_spec + ",\"methods\":" + methods_json
		class_spec = class_spec + ",\"cans\":[\"Persist\"]"
		class_spec = class_spec + "}"
		_emit_class_full(ctx, _batch_stringLit(ctx, class_spec), 1)
		if _ctx_had_error(ctx) != 0
			return 1

		if emit_model_helpers(ctx, model_name, table_name, field_names, field_types, field_columns) != 0
			return 1
		if emit_pagination_classes(ctx, model_name) != 0
			return 1
		return 0

// ============================================================================
// QUERY DSL PARSING (frame-data.ebnf §5)
// ============================================================================
// Plugin-time string helpers that turn the clauses of a query body into SQL
// text. Table names are written as {{T:Model}} markers; sql_lit turns the
// final text into Clean source in which every marker is a __Model_table()
// call, so a `table "..."` declaration applies wherever the model is used.

functions:
	// Extract a named sub-block ("where:", "order:", etc.) content from a DSL body.
	// Returns the trimmed body of that sub-block, or "" when not present.
	string extract_subblock(string body, string block_name)
		integer start_pos = body.indexOf(block_name)
		if start_pos == -1
			return ""
		integer content_start = start_pos + block_name.length()
		integer end_pos = body.length()
		integer search_pos = content_start
		while search_pos < body.length()
			if body.substring(search_pos, search_pos + 1) == "\n"
				string after_newline = body.substring(search_pos + 1, body.length()).trim()
				if after_newline.startsWith("where:") or after_newline.startsWith("order:") or after_newline.startsWith("limit:") or after_newline.startsWith("offset:") or after_newline.startsWith("link:") or after_newline.startsWith("join:") or after_newline.startsWith("set:") or after_newline.startsWith("sql:") or after_newline.startsWith("params:") or after_newline.startsWith("up:") or after_newline.startsWith("down:") or after_newline.startsWith("paginate:") or after_newline.startsWith("cursor:") or after_newline.startsWith("select:") or after_newline.startsWith("group:") or after_newline.startsWith("having:") or after_newline.startsWith("include:") or after_newline.startsWith("match:") or after_newline.startsWith("on_insert:")
					end_pos = search_pos
					break
			search_pos = search_pos + 1
		return body.substring(content_start, end_pos).trim()

	// Detect and return the binding header line ("<Type> <name>") that the
	// compiler prepends to VariableDecl+OrmQuery bodies at expander.rs:846.
	// Shape: "<Type> <name> =\n<dsl>". Returns "<Type> <name>" (without
	// the trailing " =") when the header pattern is found; returns "" when
	// the body has no such header (Return-arm and Expression-arm dispatch).
	string extract_binding_line(string body)
		integer nl_pos = body.indexOf("\n")
		if nl_pos == -1
			return ""
		string first_line = body.substring(0, nl_pos)
		if not first_line.endsWith(" =")
			return ""
		// Strip the trailing " =" (2 chars) and check the prefix is a
		// two-token "<Type> <name>" — reject if it embeds any DSL keyword
		// (defensive: a where/join line would never end with " =", but
		// verify shape).
		string prefix = first_line.substring(0, first_line.length() - 2).trim()
		if prefix.length() == 0
			return ""
		integer sp_pos = prefix.indexOf(" ")
		if sp_pos == -1
			return ""
		return prefix

	// If the body starts with a binding header, return the body with that
	// first line removed; otherwise return the body unchanged.
	string strip_binding_line(string body)
		string binding = extract_binding_line(body)
		if binding.length() == 0
			return body
		integer nl_pos = body.indexOf("\n")
		if nl_pos == -1
			return body
		return body.substring(nl_pos + 1, body.length())

	// Simple integer literal check for RHS numeric detection.
	boolean is_numeric(string s)
		if s.length() == 0
			return false
		integer i = 0
		while i < s.length()
			string ch = s.substring(i, i + 1)
			if ch != "0" and ch != "1" and ch != "2" and ch != "3" and ch != "4" and ch != "5" and ch != "6" and ch != "7" and ch != "8" and ch != "9" and ch != "." and ch != "-"
				return false
			i = i + 1
		return true

	// Replace double-quoted string literals with single-quoted SQL strings.
	string sql_quote_strings(string s)
		string result = ""
		integer i = 0
		while i < s.length()
			string ch = s.substring(i, i + 1)
			if ch == "\""
				integer j = i + 1
				string inner = ""
				while j < s.length()
					string c = s.substring(j, j + 1)
					if c == "\""
						break
					inner = inner + c
					j = j + 1
				result = result + "'" + inner + "'"
				if j < s.length()
					i = j + 1
				else
					i = j
			else
				result = result + ch
				i = i + 1
		return result

	// Lower a Clean expression to a SQL fragment when it matches DAT-Q019
	// datetime arithmetic patterns. Returns the original expression unchanged
	// when no pattern matches.
	string lower_datetime_arith(string expr)
		string e = expr.trim()
		if e == "now()" or e == "time.now()"
			return "NOW()"
		if not e.startsWith("time.now().")
			return expr
		string rest = e.substring(11, e.length())
		string op = ""
		string time_unit = ""
		string arg_body = ""
		if rest.startsWith("add_seconds(")
			op = "+"
			time_unit = "seconds"
			arg_body = rest.substring(12, rest.length())
		else if rest.startsWith("add_minutes(")
			op = "+"
			time_unit = "minutes"
			arg_body = rest.substring(12, rest.length())
		else if rest.startsWith("add_hours(")
			op = "+"
			time_unit = "hours"
			arg_body = rest.substring(10, rest.length())
		else if rest.startsWith("add_days(")
			op = "+"
			time_unit = "days"
			arg_body = rest.substring(9, rest.length())
		else if rest.startsWith("subtract_seconds(")
			op = "-"
			time_unit = "seconds"
			arg_body = rest.substring(17, rest.length())
		else if rest.startsWith("subtract_minutes(")
			op = "-"
			time_unit = "minutes"
			arg_body = rest.substring(17, rest.length())
		else if rest.startsWith("subtract_hours(")
			op = "-"
			time_unit = "hours"
			arg_body = rest.substring(15, rest.length())
		else if rest.startsWith("subtract_days(")
			op = "-"
			time_unit = "days"
			arg_body = rest.substring(14, rest.length())
		else
			return expr
		if not arg_body.endsWith(")")
			return expr
		string arg = arg_body.substring(0, arg_body.length() - 1).trim()
		if arg.length() == 0
			return expr
		if is_numeric(arg)
			return "(NOW() " + op + " INTERVAL '" + arg + " " + time_unit + "')"
		return expr

	// Lower a JSON path_identifier (DAT-Q016) on the read side to JSON_EXTRACT.
	// Returns the original token unchanged when no path syntax is present.
	string lower_json_path(string token)
		string t = token.trim()
		integer dot_pos = t.indexOf(".")
		integer brk_pos = t.indexOf("[")
		if dot_pos == -1 and brk_pos == -1
			return token
		integer cut = t.length()
		if dot_pos != -1 and dot_pos < cut
			cut = dot_pos
		if brk_pos != -1 and brk_pos < cut
			cut = brk_pos
		string col = t.substring(0, cut).trim()
		if col.length() == 0
			return token
		string first_ch = col.substring(0, 1)
		if not ((first_ch >= "a" and first_ch <= "z") or (first_ch >= "A" and first_ch <= "Z") or first_ch == "_")
			return token
		string path_suffix = t.substring(cut, t.length())
		string json_path = "$"
		if path_suffix.startsWith(".")
			json_path = json_path + path_suffix
		else if path_suffix.startsWith("[")
			json_path = json_path + path_suffix
		else
			return token
		return "JSON_EXTRACT(" + col + ", '" + json_path + "')"

	// Parse a single condition. Converts Clean operators to SQL and quotes strings.
	string parse_condition(string condition)
		string result = condition
		result = result.replace(" == null", " IS NULL")
		result = result.replace(" == NULL", " IS NULL")
		result = result.replace(" != null", " IS NOT NULL")
		result = result.replace(" != NULL", " IS NOT NULL")
		result = result.replace(" == ", " = ")
		result = result.replace(" != ", " <> ")
		result = result.replace(" and ", " AND ")
		result = result.replace(" or ", " OR ")
		result = sql_quote_strings(result)
		return result

	// Parse where: body into a SQL fragment (AND-joined conditions).
	string parse_where_clause(string where_body)
		string result = ""
		string lines = where_body
		integer line_start = 0
		while line_start < lines.length()
			integer line_end = lines.indexOf("\n", line_start)
			if line_end == -1
				line_end = lines.length()
			string line = lines.substring(line_start, line_end).trim()
			if line.length() > 0
				if result.length() > 0
					result = result + " AND "
				result = result + parse_condition(line)
			line_start = line_end + 1
		return result

	// Parse order: body into a SQL ORDER BY column list.
	string parse_order_clause(string order_body)
		string result = ""
		string lines = order_body
		integer line_start = 0
		while line_start < lines.length()
			integer line_end = lines.indexOf("\n", line_start)
			if line_end == -1
				line_end = lines.length()
			string line = lines.substring(line_start, line_end).trim()
			if line.length() > 0
				if result.length() > 0
					result = result + ", "
				integer dir_pos = line.indexOf(" ")
				if dir_pos != -1
					string field = line.substring(0, dir_pos)
					string direction = line.substring(dir_pos + 1, line.length()).trim().toUpperCase()
					result = result + field + " " + direction
				else
					result = result + line
			line_start = line_end + 1
		return result

	// Parse group: body into a SQL GROUP BY column list.
	string parse_group_clause(string group_body)
		string body = group_body.trim()
		string result = ""
		integer line_start = 0
		while line_start < body.length()
			integer line_end = body.indexOf("\n", line_start)
			if line_end == -1
				line_end = body.length()
			string line = body.substring(line_start, line_end).trim()
			if line.length() > 0
				if result.length() > 0
					result = result + ", "
				result = result + line
			line_start = line_end + 1
		return result

	// Marker for the table of `model`, resolved at run time by sql_lit.
	string table_ref(string model)
		return "{{T:" + model + "}}"

	// A Clean string literal holding `s` verbatim.
	string clean_str(string s)
		string out = s.replace("\\", "\\\\").replace("\"", "\\\"")
		out = out.replace("{", "\\{").replace("}", "\\}")
		out = out.replace("\n", "\\n").replace("\t", "\\t")
		return "\"" + out + "\""

	// Join two Clean string expressions with `+`, dropping empty literals.
	string cat_expr(string a, string b)
		if a.length() == 0 or a == "\"\""
			return b
		if b.length() == 0 or b == "\"\""
			return a
		return a + " + " + b

	// Clean source for SQL text: literal pieces, with every {{T:Model}}
	// marker replaced by a __Model_table() call.
	string sql_lit(string sql)
		string out = ""
		integer pos = 0
		while pos < sql.length()
			integer m = sql.indexOf("{{T:", pos)
			if m == -1
				break
			integer e = sql.indexOf("}}", m)
			if e == -1
				break
			out = cat_expr(out, clean_str(sql.substring(pos, m)))
			out = cat_expr(out, "__" + sql.substring(m + 4, e) + "_table()")
			pos = e + 2
		out = cat_expr(out, clean_str(sql.substring(pos, sql.length())))
		if out.length() == 0
			return "\"\""
		return out

	// Split `s` on `sep` where `sep` is outside double-quoted literals.
	// Parts are newline-separated in the result.
	string split_outside_quotes(string s, string sep)
		string out = ""
		boolean in_str = false
		integer seg_start = 0
		integer i = 0
		while i < s.length()
			string ch = s.substring(i, i + 1)
			if ch == "\""
				in_str = not in_str
				i = i + 1
			else if not in_str and s.substring(i, s.length()).startsWith(sep)
				out = out + s.substring(seg_start, i) + "\n"
				i = i + sep.length()
				seg_start = i
			else
				i = i + 1
		return out + s.substring(seg_start, s.length())

	// Strip one pair of wrapping parentheses: `(a == 1)` -> `a == 1`.
	string strip_parens(string s)
		string t = s.trim()
		while t.startsWith("(") and t.endsWith(")")
			t = t.substring(1, t.length() - 1).trim()
		return t

	// True when `name` is a whole entry of the comma-separated `csv`.
	// (csv_contains, defined with the validators, does the work.)
	boolean is_qualifier(string csv, string name)
		return csv_contains(csv, name)

	// Left-hand side of a where/select item as SQL (DAT-C010): a column, a
	// table-qualified column, `<alias>.<column>` for join aliases and
	// include: relations (listed in `qualifiers`), or a JSON path on a json
	// column (DAT-Q016).
	string qualify_lhs(string lhs, string qualifiers)
		string t = lhs.trim()
		if t.startsWith("{{T:")
			return t
		integer dot = t.indexOf(".")
		integer brk = t.indexOf("[")
		if dot == -1 and brk == -1
			return t
		integer cut = t.length()
		if dot != -1 and dot < cut
			cut = dot
		if brk != -1 and brk < cut
			cut = brk
		if is_qualifier(qualifiers, t.substring(0, cut))
			return t
		return lower_json_path(t)

	// SQL literal for a Clean literal token: a quoted string (with `'`
	// doubled), a number, true/false or null. "" when `tok` is not a literal.
	string sql_literal(string tok)
		string t = tok.trim()
		if t.startsWith("\"") and t.endsWith("\"") and t.length() >= 2
			return "'" + t.substring(1, t.length() - 1).replace("'", "''") + "'"
		if t == "true" or t == "false"
			return t
		if t == "null" or t == "NULL"
			return "NULL"
		if is_numeric(t) and t != "-" and t != "."
			return t
		return ""

	// Clean expression for one comparison `lhs <op> rhs` (frame-data.ebnf
	// §5.1). Literal right-hand sides become SQL literals at plugin time;
	// any other right-hand side is a Clean expression evaluated at run time
	// and quoted as an SQL string with `'` doubled.
	string build_condition_expr(string condition, string qualifiers)
		string cond = strip_parens(condition)
		string op_sql = ""
		integer op_pos = -1
		integer op_len = 0
		list<string> ops = [" == ", " != ", " >= ", " <= ", " > ", " < ", " like ", " in "]
		list<string> sql_ops = ["=", "<>", ">=", "<=", ">", "<", "LIKE", "IN"]
		integer k = 0
		while k < ops.length() and op_pos == -1
			string parts = split_outside_quotes(cond, ops.get(k))
			integer nl_at = parts.indexOf("\n")
			if nl_at != -1
				op_pos = nl_at
				op_sql = sql_ops.get(k)
				op_len = ops.get(k).length()
			k = k + 1
		if op_pos == -1
			// Bare boolean column or other expression without an operator.
			return sql_lit(parse_condition(cond))
		string lhs = qualify_lhs(cond.substring(0, op_pos), qualifiers)
		string rhs = cond.substring(op_pos + op_len, cond.length()).trim()
		string head = lhs + " " + op_sql + " "
		string lowered = lower_datetime_arith(rhs)
		if lowered != rhs
			return sql_lit(head + lowered)
		if rhs == "null" or rhs == "NULL"
			if op_sql == "<>"
				return sql_lit(lhs + " IS NOT NULL")
			return sql_lit(lhs + " IS NULL")
		if op_sql == "IN" and rhs.startsWith("[") and rhs.endsWith("]")
			string items = split_outside_quotes(rhs.substring(1, rhs.length() - 1), ",")
			// Literal items stay SQL text; other items are run-time values.
			string in_expr = ""
			string pending = head + "("
			boolean first_item = true
			integer pos = 0
			while pos <= items.length()
				integer e = items.indexOf("\n", pos)
				if e == -1
					e = items.length()
				string item = items.substring(pos, e).trim()
				if item.length() > 0
					if not first_item
						pending = pending + ", "
					first_item = false
					string lit = sql_literal(item)
					if lit.length() > 0
						pending = pending + lit
					else
						in_expr = cat_expr(in_expr, sql_lit(pending + "'"))
						in_expr = cat_expr(in_expr, "(" + item + ").toString().replace(\"'\", \"''\")")
						pending = "'"
				pos = e + 1
			return cat_expr(in_expr, sql_lit(pending + ")"))
		string lit = sql_literal(rhs)
		if lit.length() > 0
			return sql_lit(head + lit)
		return cat_expr(sql_lit(head + "'"), "(" + rhs + ").toString().replace(\"'\", \"''\") + \"'\"")

	// Clean expression for one where: line: conditions joined by `and` /
	// `or` (DAT-Q009), wrapped in parentheses when `or` is present.
	string build_line_expr(string line, string qualifiers)
		string or_parts = split_outside_quotes(strip_parens(line), " or ")
		string result = ""
		boolean has_or = or_parts.indexOf("\n") != -1
		integer pos = 0
		while pos <= or_parts.length()
			integer e = or_parts.indexOf("\n", pos)
			if e == -1
				e = or_parts.length()
			string and_parts = split_outside_quotes(strip_parens(or_parts.substring(pos, e)), " and ")
			string and_expr = ""
			integer apos = 0
			while apos <= and_parts.length()
				integer ae = and_parts.indexOf("\n", apos)
				if ae == -1
					ae = and_parts.length()
				string c = and_parts.substring(apos, ae).trim()
				if c.length() > 0
					if and_expr.length() > 0
						and_expr = and_expr + " + \" AND \""
					and_expr = cat_expr(and_expr, build_condition_expr(c, qualifiers))
				apos = ae + 1
			if result.length() > 0
				result = result + " + \" OR \""
			result = cat_expr(result, and_expr)
			pos = e + 1
		if has_or
			return "\"(\" + " + result + " + \")\""
		return result

	// Clean expression for a whole where: body (lines AND-ed, DAT-Q009);
	// "\"\"" when the body is empty.
	string build_where_expr(string where_body, string qualifiers)
		string result = ""
		integer line_start = 0
		while line_start < where_body.length()
			integer line_end = where_body.indexOf("\n", line_start)
			if line_end == -1
				line_end = where_body.length()
			string line = where_body.substring(line_start, line_end).trim()
			if line.length() > 0
				if result.length() > 0
					result = result + " + \" AND \""
				result = cat_expr(result, build_line_expr(line, qualifiers))
			line_start = line_end + 1
		if result.length() == 0
			return "\"\""
		return result

	// select: list (frame-data.ebnf §5.8), comma- or line-separated.
	string parse_select_clause(string select_body, string qualifiers)
		string body = select_body.trim().replace("\n", ",")
		string result = ""
		integer pos = 0
		while pos <= body.length()
			integer e = body.indexOf(",", pos)
			if e == -1
				e = body.length()
			string item = body.substring(pos, e).trim()
			if item.length() > 0
				string lhs = item
				string alias = ""
				integer as_pos = item.indexOf(" as ")
				if as_pos != -1
					lhs = item.substring(0, as_pos).trim()
					alias = item.substring(as_pos + 4, item.length()).trim()
				string col = qualify_lhs(lhs, qualifiers)
				if alias.length() > 0
					col = col + " AS " + alias
				if result.length() > 0
					result = result + ", "
				result = result + col
			pos = e + 1
		if result.length() == 0
			return "*"
		return result

	// Entries of a comma- or line-separated list, as a comma-separated list.
	string csv_of(string body)
		string out = ""
		string flat = body.trim().replace("\n", ",")
		integer pos = 0
		while pos <= flat.length()
			integer e = flat.indexOf(",", pos)
			if e == -1
				e = flat.length()
			string item = flat.substring(pos, e).trim()
			if item.length() > 0
				if out.length() > 0
					out = out + ","
				out = out + item
			pos = e + 1
		return out

	// include: relations (DAT-Q008/Q020) as LEFT JOINs. The relation table is
	// the snake_case plural of the relation name; its foreign key column is
	// inferred from the parent's default table name (users -> user_id).
	string parse_include_clause(string include_body, string model_name)
		string names = csv_of(include_body)
		string parent_default = default_table_name(model_name)
		string fk = to_snake_case(parent_default) + "_id"
		if fk.endsWith("s_id")
			fk = fk.substring(0, fk.length() - 4) + "_id"
		string result = ""
		integer pos = 0
		while pos <= names.length()
			integer e = names.indexOf(",", pos)
			if e == -1
				e = names.length()
			string rel = names.substring(pos, e).trim()
			if rel.length() > 0
				string rel_table = pluralize(to_snake_case(rel))
				result = result + " LEFT JOIN " + rel_table + " ON " + rel_table + "." + fk + " = " + table_ref(model_name) + ".id"
			pos = e + 1
		return result

	// link: junction traversal (DAT-Q010/Q011). Each line is
	// `<JunctionModel> <cond>`; a bare `id` in the condition is the primary
	// model's key.
	string parse_link_clause(string link_body, string model_name)
		string base = table_ref(model_name)
		string result = ""
		integer line_start = 0
		while line_start < link_body.length()
			integer line_end = link_body.indexOf("\n", line_start)
			if line_end == -1
				line_end = link_body.length()
			string line = link_body.substring(line_start, line_end).trim()
			integer space_pos = line.indexOf(" ")
			if line.length() > 0 and space_pos != -1
				string join_model = line.substring(0, space_pos)
				string cond = line.substring(space_pos + 1, line.length()).trim()
				cond = cond.replace(" == ", " = ")
				cond = resolve_model_refs(cond, model_name, "")
				cond = cond.replace(join_model + ".", table_ref(join_model) + ".")
				if cond.indexOf(base + ".") == -1
					cond = (" " + cond + " ").replace(" id ", " " + base + ".id ").trim()
				result = result + " JOIN " + table_ref(join_model) + " ON " + cond
			line_start = line_end + 1
		return result

	// Rewrite `<Model>.` references to `<table>.` for the primary model and
	// every model named in a join: body.
	string resolve_model_refs(string sql, string primary_model, string join_body)
		string result = sql
		if primary_model.length() > 0
			result = result.replace(primary_model + ".", table_ref(primary_model) + ".")
		integer line_start = 0
		while line_start < join_body.length()
			integer line_end = join_body.indexOf("\n", line_start)
			if line_end == -1
				line_end = join_body.length()
			string line = join_body.substring(line_start, line_end).trim()
			integer as_pos = line.indexOf(" as ")
			if as_pos != -1 and line.endsWith(":")
				string join_model = line.substring(0, as_pos).trim()
				if join_model != primary_model
					result = result.replace(join_model + ".", table_ref(join_model) + ".")
			line_start = line_end + 1
		return result

	// Aliases declared by a join: body (`Model as alias [left|right]:`).
	string join_aliases(string join_body)
		string out = ""
		integer line_start = 0
		while line_start < join_body.length()
			integer line_end = join_body.indexOf("\n", line_start)
			if line_end == -1
				line_end = join_body.length()
			string line = join_body.substring(line_start, line_end).trim()
			integer as_pos = line.indexOf(" as ")
			if as_pos != -1 and line.endsWith(":")
				string alias = line.substring(as_pos + 4, line.length() - 1).trim()
				if alias.endsWith(" left") or alias.endsWith(" right")
					alias = alias.substring(0, alias.lastIndexOf(" ")).trim()
				if out.length() > 0
					out = out + ","
				out = out + alias
			line_start = line_end + 1
		return out

	// join: entries (frame-data.ebnf §5.6, DAT-Q017):
	//   <Model> as <alias> [left|right]:
	//       on:
	//           <condition>
	string parse_join_clause(string join_body, string primary_model, string qualifiers)
		string result = ""
		integer line_start = 0
		while line_start < join_body.length()
			integer line_end = join_body.indexOf("\n", line_start)
			if line_end == -1
				line_end = join_body.length()
			string line = join_body.substring(line_start, line_end).trim()
			integer as_pos = line.indexOf(" as ")
			if as_pos != -1 and line.endsWith(":")
				string join_model = line.substring(0, as_pos).trim()
				string after_as = line.substring(as_pos + 4, line.length() - 1).trim()
				string join_type = "INNER JOIN"
				string alias = after_as
				if after_as.endsWith(" left")
					join_type = "LEFT JOIN"
					alias = after_as.substring(0, after_as.length() - 5).trim()
				else if after_as.endsWith(" right")
					join_type = "RIGHT JOIN"
					alias = after_as.substring(0, after_as.length() - 6).trim()
				string conds = ""
				integer scan = line_end + 1
				boolean done = false
				while scan < join_body.length() and not done
					integer s_end = join_body.indexOf("\n", scan)
					if s_end == -1
						s_end = join_body.length()
					string s_line = join_body.substring(scan, s_end).trim()
					if s_line.indexOf(" as ") != -1 and s_line.endsWith(":")
						done = true
					else
						if s_line.startsWith("on:")
							s_line = s_line.substring(3, s_line.length()).trim()
						if s_line.length() > 0
							string c = resolve_model_refs(s_line, primary_model, join_body).replace(" == ", " = ")
							if conds.length() > 0
								conds = conds + " AND "
							conds = conds + c
						scan = s_end + 1
				result = result + " " + join_type + " " + table_ref(join_model) + " " + alias + " ON " + conds
				line_start = scan
			else
				line_start = line_end + 1
		return result

	// A value line of a paginate:/cursor: clause: `<name>: <expr>`
	// (frame-data.ebnf §5.3) or the older `<name> <expr>`. "" when absent.
	string extract_paginate_field(string clause_body, string field_name)
		integer line_start = 0
		while line_start < clause_body.length()
			integer line_end = clause_body.indexOf("\n", line_start)
			if line_end == -1
				line_end = clause_body.length()
			string line = clause_body.substring(line_start, line_end).trim()
			if line.startsWith(field_name + ":")
				return line.substring(field_name.length() + 1, line.length()).trim()
			if line.startsWith(field_name + " ") or line.startsWith(field_name + "\t")
				return line.substring(field_name.length() + 1, line.length()).trim()
			line_start = line_end + 1
		return ""

	// True when `s` is a non-empty run of decimal digits.
	boolean is_digits(string s)
		if s.length() == 0
			return false
		integer i = 0
		while i < s.length()
			string ch = s.substring(i, i + 1)
			if ch < "0" or ch > "9"
				return false
			i = i + 1
		return true

	// Clean expression for a LIMIT/OFFSET value: a literal row count stays
	// in the SQL text; any other expression is evaluated at run time
	// (DAT-Q007) and passes through __frame_data_row_count, which raises
	// unless the value is a non-negative integer, so only digits reach SQL.
	string sql_number_expr(string keyword, string value)
		string v = value.trim()
		if is_digits(v)
			return clean_str(" " + keyword + " " + v)
		return clean_str(" " + keyword + " ") + " + __frame_data_row_count(" + clean_str(keyword.toLowerCase()) + ", (" + v + ").toString())"

// ============================================================================
// QUERY EXPRESSIONS (find / first / findOrFail / count / exists / paginate /
// cursor)
// ============================================================================
// Every query verb becomes ONE Clean expression, so the same builder serves
// `T x = M.find: ...`, `return M.find: ...`, a bare query statement, and a
// `return find: ...` body in a data class's queries: sub-block.

functions:
	boolean is_query_verb(string verb)
		return verb == "find" or verb == "first" or verb == "findOrFail" or verb == "count" or verb == "exists" or verb == "paginate" or verb == "cursor"

	// Qualifiers usable as `<q>.<column>` in where:/select: (DAT-C010).
	string query_qualifiers(string dsl_body)
		string q = join_aliases(extract_subblock(dsl_body, "join:"))
		string inc = csv_of(extract_subblock(dsl_body, "include:"))
		if inc.length() > 0
			if q.length() > 0
				q = q + ","
			q = q + inc
		return q

	// Clean expression for the condition of a query (without WHERE), with
	// `<Model>.` references resolved.
	string query_where_expr(string model_name, string dsl_body)
		string where_clause = extract_subblock(dsl_body, "where:")
		if where_clause.length() == 0
			return "\"\""
		string join_clause = extract_subblock(dsl_body, "join:")
		string resolved = resolve_link_refs(resolve_model_refs(where_clause, model_name, join_clause), extract_subblock(dsl_body, "link:"))
		return build_where_expr(resolved, query_qualifiers(dsl_body))

	// Rewrite `<JunctionModel>.` references to its table for every model
	// named in a link: body.
	string resolve_link_refs(string sql, string link_body)
		string result = sql
		integer line_start = 0
		while line_start < link_body.length()
			integer line_end = link_body.indexOf("\n", line_start)
			if line_end == -1
				line_end = link_body.length()
			string line = link_body.substring(line_start, line_end).trim()
			integer sp = line.indexOf(" ")
			if sp > 0
				string m = line.substring(0, sp)
				result = result.replace(m + ".", table_ref(m) + ".")
			line_start = line_end + 1
		return result

	// Clean expression for the full SELECT of find/first/findOrFail.
	string select_sql_expr(string model_name, string dsl_body, boolean single_row)
		string q = query_qualifiers(dsl_body)
		string join_clause = extract_subblock(dsl_body, "join:")
		string link_clause = extract_subblock(dsl_body, "link:")
		string include_clause = extract_subblock(dsl_body, "include:")
		string select_clause = extract_subblock(dsl_body, "select:")
		string group_clause = extract_subblock(dsl_body, "group:")
		string having_clause = extract_subblock(dsl_body, "having:")
		string order_clause = extract_subblock(dsl_body, "order:")
		string limit_clause = extract_subblock(dsl_body, "limit:")
		string offset_clause = extract_subblock(dsl_body, "offset:")

		string projection = "*"
		if select_clause.length() > 0
			projection = parse_select_clause(resolve_model_refs(select_clause, model_name, join_clause), q)
		else if join_clause.length() > 0 or link_clause.length() > 0 or include_clause.length() > 0
			// Rows are materialized as the primary model: keep its columns.
			projection = table_ref(model_name) + ".*"
		string head = "SELECT " + projection + " FROM " + table_ref(model_name)
		if join_clause.length() > 0
			head = head + parse_join_clause(join_clause, model_name, q)
		if link_clause.length() > 0
			head = head + parse_link_clause(link_clause, model_name)
		if include_clause.length() > 0
			head = head + parse_include_clause(include_clause, model_name)
		// __M_cols resolves `as "<column>"` field names (DAT-M017); the
		// condition is resolved inside __M_where.
		string expr = cat_expr(cols_expr(model_name, sql_lit(head)), "__" + model_name + "_where(" + query_where_expr(model_name, dsl_body) + ")")

		string tail = ""
		if group_clause.length() > 0
			tail = tail + " GROUP BY " + parse_group_clause(group_clause)
		if having_clause.length() > 0
			tail = tail + " HAVING " + parse_where_clause(having_clause)
		if order_clause.length() > 0
			tail = tail + " ORDER BY " + parse_order_clause(resolve_model_refs(order_clause, model_name, join_clause))
		if tail.length() > 0
			expr = cat_expr(expr, cols_expr(model_name, sql_lit(tail)))
		if single_row
			expr = cat_expr(expr, "\" LIMIT 1\"")
		else if limit_clause.length() > 0
			expr = cat_expr(expr, sql_number_expr("LIMIT", limit_clause))
		else if offset_clause.length() > 0
			// DAT-Q006: offset without limit returns every remaining row.
			// SQLite rejects OFFSET without LIMIT and Postgres rejects a
			// negative LIMIT, so the "no limit" is the largest BIGINT.
			expr = cat_expr(expr, "\" LIMIT 9223372036854775807\"")
		if offset_clause.length() > 0
			expr = cat_expr(expr, sql_number_expr("OFFSET", offset_clause))
		return expr

	// `__M_cols(<sql expr>)`: field names of M with an `as "<column>"`
	// override resolved to their columns at run time (DAT-M017).
	string cols_expr(string model_name, string sql_expr)
		return "__" + model_name + "_cols(" + sql_expr + ")"

	// JSON where-object for _db_paginate / _db_cursor_page:
	// {"__where": <condition incl. tenant scope>, "__order": <ORDER BY list>}.
	string where_json_expr(string model_name, string dsl_body)
		string expr = "\"{\\\"__where\\\":\" + json.dataToText(__" + model_name + "_cond(" + query_where_expr(model_name, dsl_body) + "))"
		string order_clause = extract_subblock(dsl_body, "order:")
		if order_clause.length() > 0
			expr = expr + " + " + clean_str(",\"__order\":") + " + json.dataToText(" + cols_expr(model_name, clean_str(parse_order_clause(order_clause))) + ")"
		return expr + " + " + clean_str("}")

	// The Clean expression a query verb evaluates to.
	string query_expr(string model_name, string verb, string dsl_body)
		if verb == "find"
			return "__parse_as_" + model_name + "(_db_query(" + select_sql_expr(model_name, dsl_body, false) + ", \"[]\"))"
		if verb == "first"
			return "__first_as_" + model_name + "(_db_query(" + select_sql_expr(model_name, dsl_body, true) + ", \"[]\"))"
		if verb == "findOrFail"
			return "__find_or_fail_as_" + model_name + "(_db_query(" + select_sql_expr(model_name, dsl_body, true) + ", \"[]\"))"
		if verb == "count"
			return "__" + model_name + "_count(" + query_where_expr(model_name, dsl_body) + ")"
		if verb == "exists"
			return "__" + model_name + "_exists(" + query_where_expr(model_name, dsl_body) + ")"
		if verb == "paginate"
			string pclause = extract_subblock(dsl_body, "paginate:")
			string page = extract_paginate_field(pclause, "page")
			if page.length() == 0
				page = "1"
			string per_page = extract_paginate_field(pclause, "perPage")
			if per_page.length() == 0
				per_page = "20"
			return "__paged_as_" + model_name + "(_db_paginate(__" + model_name + "_table(), " + where_json_expr(model_name, dsl_body) + ", " + page + ", " + per_page + "))"
		// cursor
		string cclause = extract_subblock(dsl_body, "cursor:")
		string after = extract_paginate_field(cclause, "after")
		if after.length() == 0
			after = "\"\""
		string per_page_c = extract_paginate_field(cclause, "perPage")
		if per_page_c.length() == 0
			per_page_c = "20"
		// `by: <identifier>` names the cursor column; a quoted name is accepted too.
		string by = extract_paginate_field(cclause, "by")
		if by.length() == 0
			by = "id"
		if not by.startsWith("\"")
			by = clean_str(by)
		by = cols_expr(model_name, by)
		return "__cursor_as_" + model_name + "(_db_cursor_page(__" + model_name + "_table(), " + where_json_expr(model_name, dsl_body) + ", " + per_page_c + ", " + after + ", " + by + "), " + after + ")"

	// Emit `<binding> = <expr>` (or the bare expression when the query has
	// no binding header) at the query's position.
	integer emit_binding_stmt(integer ctx, string body, string expr, string code)
		string binding = extract_binding_line(body)
		string src = expr
		if binding.length() > 0
			src = binding + " = " + expr
		integer h = _emit_stmt_from_source(ctx, src, 0)
		if _ctx_had_error(ctx) != 0 or h == 0
			return plugin_error(ctx, code, "could not build the query statement: " + src)
		if _emit_statement_into_start(ctx, h) != 0
			return plugin_error(ctx, code, "could not place the query statement: " + src)
		return 0

	string query_error_code(string verb)
		if verb == "find"
			return "FRAME-DATA-E003"
		if verb == "first"
			return "FRAME-DATA-E004"
		if verb == "count"
			return "FRAME-DATA-E005"
		if verb == "exists"
			return "FRAME-DATA-E006"
		if verb == "paginate"
			return "FRAME-DATA-E008"
		if verb == "cursor"
			return "FRAME-DATA-E009"
		return "FRAME-DATA-E010"

	// DAT-Q006: a list query with `offset:` but no `limit:` is a likely
	// logic error. (first/findOrFail read one row, so their offset is fine;
	// count/exists/paginate/cursor do not use offset:.)
	boolean offset_without_limit(string dsl_body)
		return extract_subblock(dsl_body, "offset:").length() > 0 and extract_subblock(dsl_body, "limit:").length() == 0

	// Emit the DAT-Q006 warning (FRAME-DATA-W031, severity 1) for a find:
	// query with offset: but no limit:. `model_name` labels the query
	// (`Post`, or `Post.recent` for a queries: method).
	integer warn_offset_without_limit(integer ctx, string model_name, string dsl_body)
		if offset_without_limit(dsl_body)
			_emit_error(ctx, 1, "FRAME-DATA-W031", model_name + ": `find:` has `offset:` without `limit:` — it skips the offset rows and returns every remaining row; add `limit:` (spec DAT-Q006)", "{\"start\":0,\"end\":0,\"source\":\"plugin\"}")
			return 1
		return 0

	// Expand `<Model>.<verb>:` (frame-data.ebnf §5).
	integer expand_query(integer ctx, string model_name, string verb, string body)
		string code = query_error_code(verb)
		_ctx_set_error_context(ctx, code, model_name + "." + verb)
		if verb == "find"
			warn_offset_without_limit(ctx, model_name, strip_binding_line(body))
		return emit_binding_stmt(ctx, body, query_expr(model_name, verb, strip_binding_line(body)), code)

	// A queries: method body `return [<Model>.]<verb>: <dsl>` (DAT-A004) as
	// `return <expr>`. The model-less form binds to the enclosing data class.
	// Returns "" when the body is not a query-DSL return.
	string rewrite_query_method_body(string raw_body, string default_model_name)
		string trimmed = raw_body.trim()
		if not trimmed.startsWith("return ")
			return ""
		integer nl = trimmed.indexOf("\n")
		string header = trimmed
		string dsl_body = ""
		if nl != -1
			header = trimmed.substring(0, nl).trim()
			dsl_body = trimmed.substring(nl + 1, trimmed.length())
		if not header.endsWith(":")
			return ""
		string after_return = header.substring(7, header.length() - 1).trim()
		string model_name = default_model_name
		string verb = after_return
		integer dot = after_return.indexOf(".")
		if dot != -1
			model_name = after_return.substring(0, dot).trim()
			verb = after_return.substring(dot + 1, after_return.length()).trim()
		if model_name.length() == 0 or not is_query_verb(verb)
			return ""
		return "return " + query_expr(model_name, verb, dsl_body) + "\n"

// ============================================================================
// BLOCK ATTRIBUTES
// ============================================================================
// extract_model_name unwraps the attrs value used for both `data ModelName:`
// and `migrate "name":` block heads. Accepts either a bare identifier
// ("AddUsers") or the compiler-formatted JSON envelope ({"AddUsers":true}).

functions:
	string extract_model_name(string raw)
		if not raw.startsWith("{")
			return raw.trim()
		integer first_quote = raw.indexOf("\"")
		if first_quote == -1
			return raw.trim()
		integer second_quote = raw.indexOf("\"", first_quote + 1)
		if second_quote == -1
			return raw.trim()
		return raw.substring(first_quote + 1, second_quote)

// ============================================================================
// BLOCK VALIDATION (validate_block hook, DAT-P005)
// ============================================================================

functions:
	// Extract the column identifiers referenced by a single v2 `indexes:`
	// entry line. Returns a comma-separated list. Handles single-column
	// (`email`), composite (`(status, createdAt)`), and unique-suffixed
	// (`email unique`, `(a, b) unique`) forms. Returns "" for empty or
	// malformed lines; validators treat that as a skip.
	string extract_index_columns(string line)
		string trimmed = line.trim()
		if trimmed.length() == 0
			return ""
		// Strip trailing `unique` if present.
		if trimmed.endsWith(" unique") or trimmed.endsWith("\tunique")
			trimmed = trimmed.substring(0, trimmed.length() - 6).trim()
		else if trimmed == "unique"
			return ""
		// Composite form: `(c1, c2, ...)`.
		if trimmed.startsWith("(")
			integer close = trimmed.indexOf(")")
			if close == -1
				return ""
			string inner = trimmed.substring(1, close).trim()
			if inner.length() == 0
				return ""
			// Normalize whitespace around commas.
			string result = ""
			integer pos = 0
			while pos < inner.length()
				integer comma = inner.indexOf(",", pos)
				integer end_pos = inner.length()
				if comma != -1
					end_pos = comma
				string col = inner.substring(pos, end_pos).trim()
				if col.length() > 0
					if result.length() > 0
						result = result + ","
					result = result + col
				if comma == -1
					pos = inner.length()
				else
					pos = comma + 1
			return result
		// Single-column form: first whitespace-delimited token.
		integer sp = trimmed.indexOf(" ")
		integer tb = trimmed.indexOf("\t")
		integer end_pos = trimmed.length()
		if sp != -1 and sp < end_pos
			end_pos = sp
		if tb != -1 and tb < end_pos
			end_pos = tb
		return trimmed.substring(0, end_pos).trim()

	// Return true if `needle` appears as a whole-token entry in the
	// comma-separated `haystack`. Used by validate_data_model to check
	// index-column-name membership in the fields: names list.
	boolean csv_contains(string haystack, string needle)
		if needle.length() == 0
			return false
		integer pos = 0
		while pos < haystack.length()
			integer comma = haystack.indexOf(",", pos)
			integer end_pos = haystack.length()
			if comma != -1
				end_pos = comma
			string entry = haystack.substring(pos, end_pos).trim()
			if entry == needle
				return true
			if comma == -1
				pos = haystack.length()
			else
				pos = comma + 1
		return false

	// Validate a data ModelName block before expansion. Returns error string
	// on failure, empty string when valid.
	//
	// In the sub-block form DAT-M015 requires a non-empty `fields:`
	// sub-block. Bare-field (v1) bodies are still accepted (transitional
	// field_declaration form, frame-data.ebnf §2.2).
	//
	// Intra-block checks (DAT-P005):
	// - queries: each declaration line parses as `<return_type> <name>(<params>)`.
	// - relations: each entry has valid cardinality (has_many/has_one/belongs_to).
	// - indexes: every referenced column name appears in fields:.
	// These are intra-block checks — no cross-class visibility required.
	// The six F1a diagnostics (E025..E028, W030, I002) live at cln lint time
	// per spec v2.1.2, not here.
	string validate_data_model(string model_name, string body)
		if model_name.length() == 0
			return "data: model name is required"
		if body.trim().length() == 0
			return "data " + model_name + ": at least one field is required"
		if is_v2_sub_block_form(body)
			string fields_body = extract_v2_sub_block(body, "fields")
			if fields_body.trim().length() == 0
				return "data " + model_name + ": `fields:` sub-block is required under v2 (spec DAT-M015)"
			string field_names_csv = extract_v2_field_names(fields_body)
			if field_names_csv.length() == 0
				return "data " + model_name + ": `fields:` sub-block must declare at least one field (spec DAT-M015)"

			// Local queries: check — malformed method declarations.
			// A non-empty trimmed line is either a method declaration (matches
			// the is_v2_query_method_decl heuristic) or a body line (indented
			// continuation). A line that contains `(` but not `)` — or a line
			// with `)` before `(` — is malformed.
			string queries_body = extract_v2_sub_block(body, "queries")
			if queries_body.length() > 0
				integer q_ls = 0
				while q_ls < queries_body.length()
					integer q_le = queries_body.indexOf("\n", q_ls)
					if q_le == -1
						q_le = queries_body.length()
					string q_raw = queries_body.substring(q_ls, q_le)
					string q_line = q_raw.trim()
					if q_line.length() > 0
						integer po = q_line.indexOf("(")
						integer pc = q_line.lastIndexOf(")")
						if po != -1 and pc == -1
							return "data " + model_name + ": queries: line has `(` without matching `)`: `" + q_line + "`"
						if po != -1 and pc != -1 and pc < po
							return "data " + model_name + ": queries: line has `)` before `(`: `" + q_line + "`"
					q_ls = q_le + 1

			// Local relations: check — invalid cardinality or malformed shape.
			string relations_body = extract_v2_sub_block(body, "relations")
			if relations_body.length() > 0
				integer r_ls = 0
				while r_ls < relations_body.length()
					integer r_le = relations_body.indexOf("\n", r_ls)
					if r_le == -1
						r_le = relations_body.length()
					string r_raw = relations_body.substring(r_ls, r_le)
					string r_line = r_raw.trim()
					if r_line.length() > 0
						// Rebuild the cardinality-detection path locally so
						// the error message can name the offending token.
						integer colon = r_line.indexOf(":")
						if colon == -1
							return "data " + model_name + ": relations: entry missing `:` (expected `<name>: <cardinality> <TargetClass> on <fk>`): `" + r_line + "`"
						string rest = r_line.substring(colon + 1, r_line.length()).trim()
						integer sp = rest.indexOf(" ")
						integer tb = rest.indexOf("\t")
						integer end_c = rest.length()
						if sp != -1 and sp < end_c
							end_c = sp
						if tb != -1 and tb < end_c
							end_c = tb
						string card = rest.substring(0, end_c).trim()
						if card != "has_many" and card != "has_one" and card != "belongs_to"
							return "data " + model_name + ": relations: invalid cardinality `" + card + "` (must be `has_many`, `has_one`, or `belongs_to`) in `" + r_line + "`"
						string after_card = rest.substring(end_c, rest.length()).trim()
						integer on_at = after_card.indexOf(" on ")
						if on_at == -1
							on_at = after_card.indexOf("\ton ")
						if on_at == -1
							return "data " + model_name + ": relations: entry missing `on <fk_column>` clause: `" + r_line + "`"
					r_ls = r_le + 1

			// Local indexes: check — column references must exist in fields:.
			string indexes_body = extract_v2_sub_block(body, "indexes")
			if indexes_body.length() > 0
				integer i_ls = 0
				while i_ls < indexes_body.length()
					integer i_le = indexes_body.indexOf("\n", i_ls)
					if i_le == -1
						i_le = indexes_body.length()
					string i_raw = indexes_body.substring(i_ls, i_le)
					string i_line = i_raw.trim()
					if i_line.length() > 0
						string cols_csv = extract_index_columns(i_line)
						if cols_csv.length() > 0
							integer c_ls = 0
							while c_ls < cols_csv.length()
								integer c_comma = cols_csv.indexOf(",", c_ls)
								integer c_end = cols_csv.length()
								if c_comma != -1
									c_end = c_comma
								string col = cols_csv.substring(c_ls, c_end).trim()
								if col.length() > 0 and not csv_contains(field_names_csv, col)
									return "data " + model_name + ": indexes: references column `" + col + "` that is not declared in fields: (in `" + i_line + "`)"
								if c_comma == -1
									c_ls = cols_csv.length()
								else
									c_ls = c_comma + 1
					i_ls = i_le + 1
		return ""

	// Validate a migrate: block before expansion.
	string validate_migrate_block(string attrs, string body)
		string migration_name = attrs.trim()
		if migration_name.length() == 0
			return "migrate: migration name is required (e.g. migrate \"001_create_users\":)"

		if migration_name.startsWith("\"")
			migration_name = migration_name.substring(1, migration_name.length())
		if migration_name.endsWith("\"")
			migration_name = migration_name.substring(0, migration_name.length() - 1)

		migration_name = migration_name.trim()
		if migration_name.length() == 0
			return "migrate: migration name must not be empty"

		string up_content = extract_subblock(body, "up:")
		if up_content.trim().length() == 0
			return "migrate \"" + migration_name + "\": up: block is required and must contain SQL"

		string down_content = extract_subblock(body, "down:")
		if down_content.trim().length() == 0
			return "migrate \"" + migration_name + "\": down: block is required (spec DAT-C007) — add SQL to reverse this migration"

		return ""

// ============================================================================
// TRANSACTION (frame-data.ebnf §6, DAT-T001..T005)
// ============================================================================
// Emitted shape:
//   if not db.begin()
//       error("transaction could not begin")
//   <body>
//   if not db.commit()
//       error("transaction could not commit")
//   onError:
//       db.rollback()
//       error("transaction failed")

functions:
	// Normalize a block body whose first line arrives already trimmed while
	// the following lines keep their indentation. The first line sits at the
	// body's base level, so the second non-blank line is either at the base
	// level or — when the first line opens a block with a trailing `:` — one
	// level deeper. Strip that base indentation from every following line.
	string dedent_block_body(string body)
		integer first_nl = body.indexOf("\n")
		if first_nl == -1
			return body
		string first_line = body.substring(0, first_nl).trim()
		string rest = body.substring(first_nl + 1, body.length())
		// Indentation (in tabs) of the first non-blank following line.
		integer probe = 0
		integer second_indent = -1
		while probe < rest.length() and second_indent == -1
			integer le = rest.indexOf("\n", probe)
			if le == -1
				le = rest.length()
			string ln = rest.substring(probe, le)
			if ln.trim().length() > 0
				integer t = 0
				while t < ln.length() and ln.substring(t, t + 1) == "\t"
					t = t + 1
				second_indent = t
			probe = le + 1
		if second_indent <= 0
			return body
		integer base = second_indent
		if first_line.endsWith(":")
			base = second_indent - 1
		if base <= 0
			return body
		string out = first_line
		integer pos = 0
		while pos < rest.length()
			integer le2 = rest.indexOf("\n", pos)
			if le2 == -1
				le2 = rest.length()
			string ln2 = rest.substring(pos, le2)
			integer strip = 0
			while strip < base and strip < ln2.length() and ln2.substring(strip, strip + 1) == "\t"
				strip = strip + 1
			out = out + "\n" + ln2.substring(strip, ln2.length())
			pos = le2 + 1
		return out

	// True when some line of `body` opens another `transaction:` block.
	boolean has_nested_transaction(string body)
		integer line_start = 0
		while line_start < body.length()
			integer line_end = body.indexOf("\n", line_start)
			if line_end == -1
				line_end = body.length()
			if body.substring(line_start, line_end).trim() == "transaction:"
				return true
			line_start = line_end + 1
		return false

	string build_transaction_src(string body)
		string result = "if not db.begin()\n"
		result = result + "\terror(\"transaction could not begin\")\n"
		result = result + dedent_block_body(body) + "\n"
		result = result + "if not db.commit()\n"
		result = result + "\terror(\"transaction could not commit\")\n"
		result = result + "onError:\n"
		result = result + "\tdb.rollback()\n"
		result = result + "\terror(\"transaction failed\")\n"
		return result

	integer expand_transaction(integer ctx, string body)
		_ctx_set_error_context(ctx, "FRAME-DATA-E014", "expand_transaction")
		// DAT-T003: transactions are flat.
		if has_nested_transaction(body)
			return plugin_error(ctx, "FRAME-DATA-E023", "transaction: blocks cannot be nested — merge the inner block into the outer one (spec DAT-T003)")
		integer stmt = _emit_stmt_from_source(ctx, build_transaction_src(body), 0)
		if _ctx_had_error(ctx) != 0 or stmt == 0
			return plugin_error(ctx, "FRAME-DATA-E014", "expand_transaction failed")
		if _emit_statement_into_start(ctx, stmt) != 0
			return plugin_error(ctx, "FRAME-DATA-E014", "expand_transaction emit failed")
		return 0

// ============================================================================
// RAW QUERIES (frame-data.ebnf §8)
// ============================================================================
//   db.query:        sql: "..."  params: [...]   → _db_query(sql, params JSON)
//   db.queryAs(T):   same, rows materialized as list<T> (DAT-Q012)

functions:
	// Clean expression for `_db_query(<sql>, <params JSON>)` from a raw
	// query body. A list-literal params: value is serialized with
	// json.dataToText.
	string build_raw_query_expr(string body)
		string sql = extract_subblock(body, "sql:")
		string params = extract_subblock(body, "params:").trim()
		if params.length() == 0 or params == "[]"
			params = "\"[]\""
		else if params.startsWith("[")
			params = "json.dataToText(" + params + ")"
		return "_db_query(" + sql + ", " + params + ")"

	integer expand_raw_query(integer ctx, string body)
		_ctx_set_error_context(ctx, "FRAME-DATA-E015", "expand_raw_query")
		return emit_binding_stmt(ctx, body, build_raw_query_expr(strip_binding_line(body)), "FRAME-DATA-E015")

	integer expand_typed_query(integer ctx, string block_name, string body)
		_ctx_set_error_context(ctx, "FRAME-DATA-E016", "expand_typed_query")
		integer paren_start = block_name.indexOf("(")
		integer paren_end = block_name.indexOf(")")
		if paren_start == -1 or paren_end <= paren_start + 1
			return plugin_error(ctx, "FRAME-DATA-E016", "db.queryAs needs a model type: db.queryAs(Model):")
		string type_name = block_name.substring(paren_start + 1, paren_end).trim()
		string expr = "__parse_as_" + type_name + "(" + build_raw_query_expr(strip_binding_line(body)) + ")"
		return emit_binding_stmt(ctx, body, expr, "FRAME-DATA-E016")

// ============================================================================
// MIGRATIONS (frame-data.ebnf §7, DAT-C006/C007)
// ============================================================================
// `migrate "name":` emits __migration_<name>_up()/_down() and registers the
// migration with the host in start: (_db_register_migration), which applies
// pending migrations before the first request.
//
// Each up:/down: line is an SQL string literal or a schema helper call
// (frame-data.ebnf §7 schema_helper_call). Helper arguments are string
// literals, bare words (types, `unique`) or a list of string literals:
//   createTable("t", "<field>", ...)    each "<field>" is a fields: line:
//                                       `<type> <name> {primary|generated|required|unique}`
//   dropTable("t")
//   addColumn("t", "col", <type> {, required | unique | default(<literal>)})
//   dropColumn("t", "col")
//   renameColumn("t", "old", "new")
//   createIndex("t", ["c1", ...] [, unique])    index idx_t_c1_... (uniq_ when unique)
//   dropIndex("t", ["c1", ...] [, unique]) | dropIndex("index_name")
//   addForeignKey("t", "col", "other.col" [, "cascade" | "set null" | "restrict"])
//   dropForeignKey("t", "col")                  constraint fk_t_col
//   execute("<sql>")
// A `primary generated` integer column is engine-specific (SQLite
// INTEGER PRIMARY KEY AUTOINCREMENT, Postgres SERIAL PRIMARY KEY): the SQL
// carries the AUTO_PK_MARKER, replaced at run time after an engine probe.
// addForeignKey/dropForeignKey use ALTER TABLE ... CONSTRAINT, which SQLite
// does not support.

functions:
	string auto_pk_marker()
		return "@@FRAME_DATA_AUTO_PK@@"

	// Split a helper argument list on top-level commas (outside string
	// literals, brackets and parentheses). Arguments are newline-separated
	// in the result.
	string split_helper_args(string args)
		string out = ""
		boolean in_str = false
		integer depth = 0
		integer seg_start = 0
		integer i = 0
		while i < args.length()
			string ch = args.substring(i, i + 1)
			if in_str
				if ch == "\\"
					i = i + 1
				else if ch == "\""
					in_str = false
			else if ch == "\""
				in_str = true
			else if ch == "[" or ch == "("
				depth = depth + 1
			else if ch == "]" or ch == ")"
				depth = depth - 1
			else if ch == "," and depth == 0
				out = out + args.substring(seg_start, i).trim() + "\n"
				seg_start = i + 1
			i = i + 1
		string last = args.substring(seg_start, args.length()).trim()
		if last.length() > 0
			out = out + last
		else if out.endsWith("\n")
			// A trailing comma (`createTable("t", "...",)`) adds no argument.
			out = out.substring(0, out.length() - 1)
		return out

	// Argument `index` (0-based) of a split_helper_args result, or "".
	string helper_arg(string args, integer index)
		integer pos = 0
		integer n = 0
		while pos <= args.length()
			integer e = args.indexOf("\n", pos)
			if e == -1
				e = args.length()
			if n == index
				return args.substring(pos, e).trim()
			n = n + 1
			pos = e + 1
		return ""

	integer helper_arg_count(string args)
		if args.trim().length() == 0
			return 0
		integer n = 1
		integer pos = args.indexOf("\n")
		while pos != -1
			n = n + 1
			pos = args.indexOf("\n", pos + 1)
		return n

	// The text of a string-literal argument, or "" when `arg` is not one.
	string helper_str(string arg)
		string a = arg.trim()
		if a.length() >= 2 and a.startsWith("\"") and a.endsWith("\"")
			return a.substring(1, a.length() - 1).replace("\\\"", "\"")
		return ""

	// True when `name` is a plain SQL identifier (letters, digits, `_`; not
	// starting with a digit), optionally `table.column` when allow_dot.
	boolean is_sql_ident(string name, boolean allow_dot)
		if name.length() == 0
			return false
		integer i = 0
		while i < name.length()
			string ch = name.substring(i, i + 1)
			boolean ok = (ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z") or ch == "_"
			if i > 0 and ch >= "0" and ch <= "9"
				ok = true
			if allow_dot and ch == "." and i > 0 and i < name.length() - 1
				ok = true
			if not ok
				return false
			i = i + 1
		return true

	// An identifier argument (a string literal holding an SQL identifier),
	// or "" when the argument is anything else.
	string helper_ident(string arg)
		string v = helper_str(arg)
		if is_sql_ident(v, false)
			return v
		return ""

	// Column list of a createIndex/dropIndex argument: ["a", "b"] or "a".
	// Returns "a,b", or "" when malformed.
	string helper_columns(string arg)
		string a = arg.trim()
		if a.startsWith("[") and a.endsWith("]")
			string items = split_helper_args(a.substring(1, a.length() - 1))
			string out = ""
			integer n = helper_arg_count(items)
			integer k = 0
			while k < n
				string col = helper_ident(helper_arg(items, k))
				if col.length() == 0
					return ""
				if out.length() > 0
					out = out + ","
				out = out + col
				k = k + 1
			return out
		return helper_ident(a)

	// The SQL literal of a default(<literal>) value, or "" when not a literal.
	string helper_default_sql(string arg)
		string a = arg.trim()
		if not (a.startsWith("default(") and a.endsWith(")"))
			return ""
		return sql_literal(a.substring(8, a.length() - 1))

	// One createTable column: a fields: line `<type> <name> {constraint}`.
	string helper_column_def(string decl)
		string v1 = synthesize_v1_line_from_v2_field(decl)
		if v1.length() == 0
			return "ERR:createTable column `" + decl + "` must be `<type> <name> \{primary|generated|required|unique\}`"
		string ftype = extract_field_type_from_line(v1)
		string fname = extract_field_name_from_line(v1)
		if not is_primitive_type(ftype) or not is_sql_ident(fname, false)
			return "ERR:createTable column `" + decl + "` needs a column type (integer, number, string, text, boolean, datetime, date, uuid, json) and a name"
		string cons = line_constraints(normalize_field_line(v1))
		boolean is_pk = has_constraint(cons, "pk")
		if is_pk and has_constraint(cons, "auto") and ftype == "integer"
			return fname + " " + auto_pk_marker()
		return column_def_sql(v1, is_pk)

	// SQL of one schema helper call (frame-data.ebnf §7), or "ERR:<message>".
	string schema_helper_sql(string callee, string arg_text)
		string args = split_helper_args(arg_text)
		integer n = helper_arg_count(args)
		string t = helper_ident(helper_arg(args, 0))
		string usage = ""
		if callee == "execute"
			string raw = helper_str(helper_arg(args, 0))
			if n != 1 or raw.length() == 0
				return "ERR:execute(\"<sql>\") takes one SQL string literal"
			return raw
		if t.length() == 0
			if callee == "dropIndex" and n == 1
				return "ERR:dropIndex(\"<index name>\") needs an identifier"
			return "ERR:" + callee + "(...) needs a table name string literal as its first argument"
		if callee == "createTable"
			if n < 2
				return "ERR:createTable(\"<table>\", \"<type> <name> ...\", ...) needs at least one column"
			string defs = ""
			integer k = 1
			while k < n
				string decl = helper_str(helper_arg(args, k))
				string def = helper_column_def(decl)
				if def.startsWith("ERR:")
					return def
				if defs.length() > 0
					defs = defs + ", "
				defs = defs + def
				k = k + 1
			return "CREATE TABLE " + t + " (" + defs + ")"
		if callee == "dropTable"
			if n != 1
				return "ERR:dropTable(\"<table>\") takes one argument"
			return "DROP TABLE " + t
		if callee == "addColumn"
			string col = helper_ident(helper_arg(args, 1))
			string ctype = helper_arg(args, 2)
			if helper_str(ctype).length() > 0
				ctype = helper_str(ctype)
			if n < 3 or col.length() == 0 or not is_primitive_type(ctype)
				return "ERR:addColumn(\"<table>\", \"<column>\", <type> \{, required | unique | default(<literal>)\}) — type is one of integer, number, string, text, boolean, datetime, date, uuid, json"
			string sql = "ALTER TABLE " + t + " ADD COLUMN " + col + " " + clean_type_to_sql(ctype)
			integer k2 = 3
			while k2 < n
				string c = helper_arg(args, k2)
				if helper_str(c).length() > 0
					c = helper_str(c)
				if c == "required"
					sql = sql + " NOT NULL"
				else if c == "unique"
					sql = sql + " UNIQUE"
				else
					string dv = helper_default_sql(c)
					if dv.length() == 0
						return "ERR:addColumn constraint `" + c + "` is not one of required, unique, default(<literal>)"
					sql = sql + " DEFAULT " + dv
				k2 = k2 + 1
			return sql
		if callee == "dropColumn"
			string dcol = helper_ident(helper_arg(args, 1))
			if n != 2 or dcol.length() == 0
				return "ERR:dropColumn(\"<table>\", \"<column>\") takes two identifiers"
			return "ALTER TABLE " + t + " DROP COLUMN " + dcol
		if callee == "renameColumn"
			string from_col = helper_ident(helper_arg(args, 1))
			string to_col = helper_ident(helper_arg(args, 2))
			if n != 3 or from_col.length() == 0 or to_col.length() == 0
				return "ERR:renameColumn(\"<table>\", \"<old>\", \"<new>\") takes three identifiers"
			return "ALTER TABLE " + t + " RENAME COLUMN " + from_col + " TO " + to_col
		if callee == "createIndex" or callee == "dropIndex"
			if callee == "dropIndex" and n == 1
				return "DROP INDEX " + t
			string cols = helper_columns(helper_arg(args, 1))
			string flag = helper_arg(args, 2)
			if helper_str(flag).length() > 0
				flag = helper_str(flag)
			if n < 2 or n > 3 or cols.length() == 0 or (n == 3 and flag != "unique")
				return "ERR:" + callee + "(\"<table>\", [\"<column>\", ...] [, unique])"
			string prefix = "idx_"
			string kind = "INDEX "
			if n == 3
				prefix = "uniq_"
				kind = "UNIQUE INDEX "
			string index_name = prefix + t + "_" + cols.replace(",", "_")
			if callee == "dropIndex"
				return "DROP INDEX " + index_name
			return "CREATE " + kind + index_name + " ON " + t + " (" + cols.replace(",", ", ") + ")"
		if callee == "addForeignKey"
			string fk_col = helper_ident(helper_arg(args, 1))
			string ref = helper_str(helper_arg(args, 2))
			integer ref_dot = ref.indexOf(".")
			if n < 3 or n > 4 or fk_col.length() == 0 or not is_sql_ident(ref, true) or ref_dot == -1
				return "ERR:addForeignKey(\"<table>\", \"<column>\", \"<other table>.<column>\" [, \"cascade\" | \"set null\" | \"restrict\"])"
			string fk_sql = "ALTER TABLE " + t + " ADD CONSTRAINT fk_" + t + "_" + fk_col + " FOREIGN KEY (" + fk_col + ") REFERENCES " + ref.substring(0, ref_dot) + " (" + ref.substring(ref_dot + 1, ref.length()) + ")"
			if n == 4
				string action = helper_str(helper_arg(args, 3)).toLowerCase()
				if action == "cascade"
					fk_sql = fk_sql + " ON DELETE CASCADE"
				else if action == "set null"
					fk_sql = fk_sql + " ON DELETE SET NULL"
				else if action == "restrict"
					fk_sql = fk_sql + " ON DELETE RESTRICT"
				else
					return "ERR:addForeignKey on-delete action must be \"cascade\", \"set null\" or \"restrict\""
			return fk_sql
		if callee == "dropForeignKey"
			string dfk = helper_ident(helper_arg(args, 1))
			if n != 2 or dfk.length() == 0
				return "ERR:dropForeignKey(\"<table>\", \"<column>\") takes two identifiers"
			return "ALTER TABLE " + t + " DROP CONSTRAINT fk_" + t + "_" + dfk
		return "ERR:unknown schema helper `" + callee + "`"

	boolean is_schema_helper(string callee)
		return callee == "createTable" or callee == "dropTable" or callee == "addColumn" or callee == "dropColumn" or callee == "renameColumn" or callee == "createIndex" or callee == "dropIndex" or callee == "addForeignKey" or callee == "dropForeignKey" or callee == "execute"

	// The SQL of an up:/down: body. Each line is a string literal (one
	// statement), a schema helper call (one statement), or raw SQL that
	// continues the previous line. Statements are joined with "; ". The
	// result is "ERR:<message>" when a helper call is malformed.
	string migration_sql(string direction_body)
		string out = ""
		integer line_start = 0
		while line_start < direction_body.length()
			integer line_end = direction_body.indexOf("\n", line_start)
			if line_end == -1
				line_end = direction_body.length()
			string line = direction_body.substring(line_start, line_end).trim()
			if line.length() > 0
				boolean statement = false
				integer paren = line.indexOf("(")
				if paren > 0 and not line.startsWith("\"")
					string callee = line.substring(0, paren).trim()
					if is_schema_helper(callee)
						if not line.endsWith(")")
							return "ERR:schema helper `" + callee + "(...)` must be one call on one line: `" + line + "`"
						line = schema_helper_sql(callee, line.substring(paren + 1, line.length() - 1))
						if line.startsWith("ERR:")
							return line
						statement = true
				if line.startsWith("\"") and line.endsWith("\"") and line.length() >= 2
					line = line.substring(1, line.length() - 1).replace("\\\"", "\"")
					statement = true
				string sep = " "
				if statement and out.length() > 0 and not out.endsWith(";")
					sep = "; "
				if out.length() > 0
					out = out + sep
				out = out + line
			line_start = line_end + 1
		return out

	// Clean expression for migration SQL: the literal, with the
	// AUTO_PK_MARKER replaced by the engine's generated-key column type.
	string migration_sql_expr(string sql)
		if sql.indexOf(auto_pk_marker()) == -1
			return clean_str(sql)
		return clean_str(sql) + ".replace(" + clean_str(auto_pk_marker()) + ", __frame_data_auto_pk())"

	integer expand_migrate_block(integer ctx, string attrs, string body)
		_ctx_set_error_context(ctx, "FRAME-DATA-E017", "expand_migrate_block")
		string migration_name = extract_model_name(attrs).replace("\"", "")
		string func_name = migration_name.replace("-", "_").replace(".", "_").replace(" ", "_").replace("/", "_")
		string up_sql = migration_sql(extract_subblock(body, "up:"))
		string down_sql = migration_sql(extract_subblock(body, "down:"))
		if up_sql.startsWith("ERR:")
			return plugin_error(ctx, "FRAME-DATA-E019", "migrate \"" + migration_name + "\": " + up_sql.substring(4, up_sql.length()))
		if down_sql.startsWith("ERR:")
			return plugin_error(ctx, "FRAME-DATA-E019", "migrate \"" + migration_name + "\": " + down_sql.substring(4, down_sql.length()))

		string up_expr = migration_sql_expr(up_sql)
		string down_expr = migration_sql_expr(down_sql)
		if up_expr != clean_str(up_sql) or down_expr != clean_str(down_sql)
			// The generated integer key column type, per engine (see
			// migrate_source). Identical in every migration, so it is
			// emitted per migration under a migration-specific name.
			string pk_src = "string __probe = _db_query(\"SELECT sqlite_version() AS v\", \"[]\")\n"
			pk_src = pk_src + "if __probe.indexOf(\"\\\"ok\\\":true\") != -1\n"
			pk_src = pk_src + "\treturn \"INTEGER PRIMARY KEY AUTOINCREMENT\"\n"
			pk_src = pk_src + "return \"SERIAL PRIMARY KEY\"\n"
			string pk_fn = "__migration_" + func_name + "_auto_pk"
			if emit_fn(ctx, pk_fn, "[]", _type_string(ctx), pk_src) != 0
				return plugin_error(ctx, "FRAME-DATA-E017", "expand_migrate_block key helper emit failed for " + migration_name)
			up_expr = up_expr.replace("__frame_data_auto_pk()", pk_fn + "()")
			down_expr = down_expr.replace("__frame_data_auto_pk()", pk_fn + "()")

		if emit_fn(ctx, "__migration_" + func_name + "_up", "[]", _type_integer(ctx), "return _db_execute(" + up_expr + ", \"[]\")\n") != 0
			return plugin_error(ctx, "FRAME-DATA-E017", "expand_migrate_block up emit failed for " + migration_name)
		if emit_fn(ctx, "__migration_" + func_name + "_down", "[]", _type_integer(ctx), "return _db_execute(" + down_expr + ", \"[]\")\n") != 0
			return plugin_error(ctx, "FRAME-DATA-E017", "expand_migrate_block down emit failed for " + migration_name)

		if up_expr == clean_str(up_sql) and down_expr == clean_str(down_sql)
			emit_call3(ctx, "_db_register_migration", _batch_stringLit(ctx, migration_name), _batch_stringLit(ctx, up_sql), _batch_stringLit(ctx, down_sql))
		else
			string reg = "_db_register_migration(" + clean_str(migration_name) + ", " + up_expr + ", " + down_expr + ")"
			integer reg_h = _emit_stmt_from_source(ctx, reg, 0)
			if _ctx_had_error(ctx) != 0 or reg_h == 0
				return plugin_error(ctx, "FRAME-DATA-E017", "expand_migrate_block could not build the registration of " + migration_name)
			if _emit_statement_into_start(ctx, reg_h) != 0
				return plugin_error(ctx, "FRAME-DATA-E017", "expand_migrate_block could not place the registration of " + migration_name)
		if _ctx_had_error(ctx) != 0
			return plugin_error(ctx, "FRAME-DATA-E017", "expand_migrate_block failed for " + migration_name)
		return 0


// ============================================================================
// CONTRACT 5 PHASE C — lint_project
// ============================================================================
// Emits two cross-file diagnostics that require whole-project visibility:
//
//   FRAME-DATA-I002  info   Data class D declared via `data D:` but no
//                           entity class exposes a `D data` field.
//   FRAME-DATA-E026  error  Entity `data`-linked class has a field name
//                           the paired entity class does not declare, so
//                           writes silently drop the column.
//
// Reference:
//   foundation/spec/framework/contracts/lint-extension.md §2 (exports.lint),
//   §3 (input/output JSON), §4 (_ast_* accessors), §5 (LINT001-003 model).
//
// Lint runs pre-expansion, so `data D:` blocks are still FrameworkBlock
// statements — the class name D lives in attributes.model_name, exposed
// on _ast_list_blocks entries since compiler 0.33.125.

functions:
	// Read the next quoted string that appears after `after` in `src`,
	// starting the search at `from`. Returns "" if either the opening or
	// closing quote is missing. The plugin's JSON scanners use this to
	// walk the accessor output without pulling in a full JSON parser —
	// the accessor emits a stable, escape-free shape that this tolerates.
	string lint_next_quoted(string src, string after, integer pos)
		string tail = src.substring(pos, src.length())
		integer at = tail.indexOf(after)
		if at == -1
			return ""
		integer key_end = at + after.length()
		string rest = tail.substring(key_end, tail.length())
		integer end = rest.indexOf("\"")
		if end == -1
			return ""
		return rest.substring(0, end)

	// Return the byte offset (in `src`) of the character just after the
	// closing `}` that MATCHES the first `{` at or after position `pos`.
	// Tracks nesting depth so nested objects (e.g. `attributes: {...}`
	// inside a block entry) don't cause premature termination. Returns
	// src.length() if unmatched. String literals with escaped braces are
	// not accounted for — the lint accessor JSON never emits `{` or `}`
	// inside a string value, so a simple depth counter is sufficient.
	integer lint_after_next_brace(string src, integer pos)
		integer i = pos
		integer depth = 0
		integer len = src.length()
		while i < len
			string ch = src.substring(i, i + 1)
			if ch == "{"
				depth = depth + 1
			if ch == "}"
				depth = depth - 1
				if depth == 0
					return i + 1
			i = i + 1
		return len

	// The string value of `key` in a JSON object text, with \n, \t, \"
	// and \\ escapes decoded. "" when the key is absent.
	string lint_json_string(string src, string key)
		string pattern = "\"" + key + "\":\""
		integer at = src.indexOf(pattern)
		if at == -1
			return ""
		string out = ""
		integer i = at + pattern.length()
		while i < src.length()
			string ch = src.substring(i, i + 1)
			if ch == "\""
				return out
			if ch == "\\" and i + 1 < src.length()
				string nx = src.substring(i + 1, i + 2)
				if nx == "n"
					out = out + "\n"
				else if nx == "t"
					out = out + "\t"
				else
					out = out + nx
				i = i + 2
			else
				out = out + ch
				i = i + 1
		return out

	// Emit one diagnostic entry (already-serialized JSON object) into the
	// running diagnostics buffer. Handles the leading comma.
	string lint_push(string buf, boolean first, string entry)
		if first
			return buf + entry
		return buf + "," + entry

	// Escape a value going into a JSON string field. Only characters that
	// occur in Clean identifiers, filenames, and short prose messages are
	// considered — diagnostics don't contain user code fragments.
	string lint_json_escape(string s)
		string out = s.replace("\\", "\\\\")
		out = out.replace("\"", "\\\"")
		return out

	// Contract 5 §2 entry point. Called once per project by `cln lint`
	// and by `cln check` after typecheck. Returns a JSON array of
	// diagnostic entries per §3.2, or "[]" for a clean run.
	string lint_project(string input_json)
		// Parse the context handle. §3.1: input is
		//   {"project_ast_handle":N,"compiler_version":"...","config":{...}}
		string handle_str = extract_attr(input_json, "project_ast_handle")
		if handle_str.length() == 0
			return "[]"
		integer handle = handle_str.toInteger()

		// ------------------------------------------------------------------
		// Step 1: walk `data D:` blocks. Collect each declared data-class
		//         name plus its file/line for later diagnostic anchoring.
		// ------------------------------------------------------------------
		string blocks_json = _ast_list_blocks(handle, "data")
		list<string> data_names = []
		list<string> data_files = []
		list<integer> data_lines = []
		// Field names declared by each data block (comma-separated).
		list<string> data_fields = []
		integer bscan = 0
		while bscan < blocks_json.length()
			string tail = blocks_json.substring(bscan, blocks_json.length())
			integer obj_at = tail.indexOf("{")
			if obj_at == -1
				break
			integer obj_start = bscan + obj_at
			integer obj_end = lint_after_next_brace(blocks_json, obj_start)
			string entry = blocks_json.substring(obj_start, obj_end)
			// A `data:` block with no argument (legacy config block) has
			// no model_name — skip it.
			string mname = lint_next_quoted(entry, "\"model_name\":\"", 0)
			if mname.length() > 0
				string mfile = lint_next_quoted(entry, "\"file\":\"", 0)
				string line_str = extract_attr(entry, "line")
				integer mline = 1
				if line_str.length() > 0
					mline = line_str.toInteger()
				data_names.add(mname)
				data_files.add(mfile)
				data_lines.add(mline)
				// Pre-expansion, a data block is not a class yet: its fields
				// come from the block body.
				string content = lint_json_string(entry, "content")
				string fields_body = content
				if is_v2_sub_block_form(content)
					fields_body = extract_v2_sub_block(content, "fields")
				data_fields.add(extract_v2_field_names(fields_body))
			bscan = obj_end

		// ------------------------------------------------------------------
		// Step 2: walk every class in the project. For each class field
		//         literally named "data", record its declared type as a
		//         "referenced" data-class name. Also cache the class's
		//         own field-name set for the E026 check.
		// ------------------------------------------------------------------
		string classes_json = _ast_list_classes(handle)
		list<string> referenced = []
		integer cscan = 0
		string diagnostics = "["
		boolean first_out = true
		while cscan < classes_json.length()
			string ctail = classes_json.substring(cscan, classes_json.length())
			integer cobj_at = ctail.indexOf("{")
			if cobj_at == -1
				break
			integer cobj_start = cscan + cobj_at
			integer cobj_end = lint_after_next_brace(classes_json, cobj_start)
			string centry = classes_json.substring(cobj_start, cobj_end)
			string cname = lint_next_quoted(centry, "\"name\":\"", 0)
			if cname.length() > 0
				string fields_json = _ast_class_fields(handle, cname)
				// Scan each field entry for name + type.
				list<string> ent_field_names = []
				string linked_data_type = ""
				integer fscan = 0
				while fscan < fields_json.length()
					string ftail = fields_json.substring(fscan, fields_json.length())
					integer fobj_at = ftail.indexOf("{")
					if fobj_at == -1
						break
					integer fobj_start = fscan + fobj_at
					integer fobj_end = lint_after_next_brace(fields_json, fobj_start)
					string fentry = fields_json.substring(fobj_start, fobj_end)
					string fname = lint_next_quoted(fentry, "\"name\":\"", 0)
					string ftype = lint_next_quoted(fentry, "\"type\":\"", 0)
					if fname.length() > 0
						ent_field_names.add(fname)
						if fname == "data" and ftype.length() > 0
							referenced.add(ftype)
							linked_data_type = ftype
					fscan = fobj_end

				// FRAME-DATA-E026: if this class links to a data class D,
				// each field name on D must also be a field name on this
				// entity. We walk D's fields and flag any that this class
				// (the entity) doesn't declare.
				if linked_data_type.length() > 0
					string dfile = ""
					integer dline = 1
					string dfields = ""
					integer di = 0
					while di < data_names.length()
						if data_names.get(di) == linked_data_type
							dfile = data_files.get(di)
							dline = data_lines.get(di)
							dfields = data_fields.get(di)
							di = data_names.length()
						else
							di = di + 1
					integer dpos = 0
					while dpos < dfields.length()
						integer dcomma = dfields.indexOf(",", dpos)
						if dcomma == -1
							dcomma = dfields.length()
						string dfname = dfields.substring(dpos, dcomma).trim()
						if dfname.length() > 0 and not ent_field_names.contains(dfname)
							// Anchored at the data block's declaration line
							// (field locations are not exposed to lint).
							string entry_e026 = "{\"code\":\"FRAME-DATA-E026\","
							entry_e026 = entry_e026 + "\"severity\":\"error\","
							entry_e026 = entry_e026 + "\"message\":\"Data class '" + lint_json_escape(linked_data_type) + "' has field '" + lint_json_escape(dfname) + "' but paired entity '" + lint_json_escape(cname) + "' does not declare it; writes silently drop this column.\","
							entry_e026 = entry_e026 + "\"location\":{\"file\":\"" + lint_json_escape(dfile) + "\",\"line\":" + dline.toString() + ",\"column\":1},"
							entry_e026 = entry_e026 + "\"hint\":\"Add '" + lint_json_escape(dfname) + "' to '" + lint_json_escape(cname) + "', or remove it from '" + lint_json_escape(linked_data_type) + "' if it should not be persisted.\"}"
							diagnostics = lint_push(diagnostics, first_out, entry_e026)
							first_out = false
						dpos = dcomma + 1
			cscan = cobj_end

		// ------------------------------------------------------------------
		// Step 3: any data-class name never in `referenced` fires I002.
		// ------------------------------------------------------------------
		integer i = 0
		while i < data_names.length()
			string dname = data_names.get(i)
			boolean is_ref = referenced.contains(dname)
			if is_ref == false
				string entry_i002 = "{\"code\":\"FRAME-DATA-I002\","
				entry_i002 = entry_i002 + "\"severity\":\"info\","
				entry_i002 = entry_i002 + "\"message\":\"Data class '" + lint_json_escape(dname) + "' is declared but never referenced by any entity class.\","
				entry_i002 = entry_i002 + "\"location\":{\"file\":\"" + lint_json_escape(data_files.get(i)) + "\",\"line\":" + data_lines.get(i).toString() + ",\"column\":1},"
				entry_i002 = entry_i002 + "\"hint\":\"Add a '" + lint_json_escape(dname) + " data' field to a paired entity class, or remove this data block if unused.\"}"
				diagnostics = lint_push(diagnostics, first_out, entry_i002)
				first_out = false
			i = i + 1

		diagnostics = diagnostics + "]"
		return diagnostics

