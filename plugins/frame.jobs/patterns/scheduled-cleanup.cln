// Pattern: scheduled-cleanup
// Use when: recurring maintenance tasks must run on a fixed schedule — expiring tokens,
//   archiving old records, purging soft-deleted rows, sending weekly digests.
// Anti-pattern: DON'T check "is it time to clean up?" inside a user-facing endpoint
//   using a timestamp comparison. That approach depends on traffic — if the endpoint
//   is never called in a given window, cleanup silently never runs. It also blocks
//   a real user request while cleanup executes. Use schedule to register a cron job
//   with the server; the runner fires it independently of request traffic.

// Scheduled jobs are `schedule <name> "<cron>":` entries inside jobs:
// (frame-jobs.ebnf §3); the cron expression has 5 fields
// (minute hour day-of-month month day-of-week).

plugins:
	frame.server
	frame.jobs
	frame.data

data Session:
	fields:
		integer id primary generated
		integer userId required
		string token required unique
		integer expiresAt required    // Unix time

data DigestSubscription:
	fields:
		integer id primary generated
		integer userId required
		string email required
		integer subscribedAt default: 0

jobs:
	// Every hour, on the hour: purge expired sessions. A bulk delete by
	// predicate is raw SQL (frame.data Rule A).
	schedule cleanExpiredSessions "0 * * * *":
		integer cutoff = now()
		integer removed = db.execute("DELETE FROM sessions WHERE expiresAt < ?", json.dataToText([cutoff]))
		printl("cleanExpiredSessions removed " + removed.toString() + " sessions")

	// Every Monday at 09:00: hand each subscriber to the mailer job, so a
	// slow SMTP server never holds the schedule up and each email retries
	// on its own.
	schedule weeklyDigest "0 9 * * 1":
		list<DigestSubscription> subscribers = DigestSubscription.find:
			order: subscribedAt asc
		iterate subscriber in subscribers
			queue.enqueue("sendDigest", json.dataToText({email: subscriber.email}))
		printl("weeklyDigest queued " + subscribers.length().toString() + " emails")

	sendDigest:
		retry:
			maxAttempts: 3
			backoff: exponential
			delay: 30
		timeout: 120
		queue: "mailers"
		integer attempt = job.attempt()
		printl("sendDigest attempt " + attempt.toString())
		string args = job.args()
		string recipient = json.get(args, "email")
		boolean ok = email.send(recipient, "Your weekly digest", "<p>Here is what happened this week.</p>", "Here is what happened this week.")
		if ok == false
			job.fail("SMTP rejected: " + email.lastError())
