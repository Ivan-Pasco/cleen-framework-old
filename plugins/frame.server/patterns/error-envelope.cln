// Pattern: error-envelope
// Use when: building any API consumed by web, mobile, or third-party clients
// Anti-pattern: DON'T return ad-hoc error strings or vary the error shape by route.
//   Clients need one shape to handle errors programmatically. Every error uses
//   the envelope {"ok": false, "err": {"code": ..., "message": ...}}
//   (frame-server-semantics.md SRV-I002). The response helpers build it:
//     badRequest(message)      → 400 VALIDATION_ERROR
//     unauthorized()           → 401 AUTH_ERROR
//     forbidden()              → 403 PERMISSION_DENIED
//     notFound(message)        → 404 NOT_FOUND
//     httpError(status, msg)   → <status> HTTP_ERROR
//   Messages are JSON-escaped for you. For an extra member (e.g. the input
//   field that failed) send the envelope yourself with httpStatus(code, json).

plugins:
	frame.server

endpoints:
	POST "/orders":
		string product_id = req.body_field("product_id")
		string quantity = req.body_field("quantity")

		// Validation error that names the failing field
		if product_id.length() == 0
			return httpStatus(400, "{\"ok\":false,\"err\":{\"code\":\"VALIDATION_ERROR\",\"message\":\"product_id is required\",\"field\":\"product_id\"}}")

		integer qty = quantity.toInteger() onError 0
		if qty <= 0
			return badRequest("quantity must be greater than zero")

		// Business rule error — custom uppercase code, same envelope
		if qty > 100
			return httpStatus(422, "{\"ok\":false,\"err\":{\"code\":\"QUANTITY_LIMIT_EXCEEDED\",\"message\":\"Maximum order quantity is 100 units\"}}")

		// Resource not found — consistent 404 shape
		boolean product_exists = false  // would normally query the database
		if product_exists == false
			return notFound("Product not found")

		// Success — {"ok": true, "data": {...}}
		return jsonResponse("{\"ok\":true,\"data\":{\"order_id\":\"ord-123\",\"product_id\":\"" + product_id + "\",\"quantity\":" + qty.toString() + ",\"status\":\"pending\"}}")

	GET "/orders/:id":
		string id = req.param("id")
		if id == "0"
			return notFound("Order not found")
		return jsonResponse("{\"ok\":true,\"data\":{\"order_id\":\"" + id + "\",\"status\":\"shipped\"}}")
