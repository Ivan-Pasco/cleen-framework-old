// Pattern: outbound-webhook
// Use when: your service must notify external systems when events occur
// Anti-pattern: DON'T call http.post inline in the request handler.
//   If the external endpoint is slow or down, your response is blocked and
//   the client times out. Send webhooks asynchronously, retry on failure,
//   and always sign the payload with HMAC so recipients can verify authenticity.

plugins:
	frame.server
	frame.data

// Webhook delivery log — tracks every attempt for retry and auditing.
// Times are Unix seconds (now()); 0 means "not yet".
data WebhookDelivery:
	fields:
		integer id primary generated
		string event_type required          // "order.completed", "user.created", etc.
		string target_url required
		string payload required             // JSON payload sent
		string signature required           // HMAC-SHA256 of payload
		string status required              // "pending", "delivered", "failed"
		integer attempt_count default: 0
		integer last_attempted_at default: 0
		integer delivered_at default: 0
		string error_message default: ""

functions:
	// Queue a webhook for async delivery (call this from your event handlers)
	integer queue_webhook(string event_type, string target_url, string payload)
		WebhookDelivery delivery = WebhookDelivery()
		delivery.event_type = event_type
		delivery.target_url = target_url
		delivery.payload = payload
		delivery.signature = crypto.hmac(payload, env.get("WEBHOOK_SECRET"), "sha256")
		delivery.status = "pending"
		Database.save(delivery)
		return delivery.id

	// Deliver one pending webhook (called by a background job, not a request
	// handler). Sign the payload so recipients can verify authenticity.
	integer deliver_webhook(integer delivery_id)
		WebhookDelivery? foundDelivery = WebhookDelivery.first:
			where:
				id == delivery_id
		WebhookDelivery delivery = foundDelivery!

		string headers = "{\"Content-Type\":\"application/json\",\"X-Webhook-Signature\":\"" + delivery.signature + "\"}"
		http.postWithHeaders(delivery.target_url, delivery.payload, headers)
		integer status_code = http.responseCode()
		delivery.attempt_count = delivery.attempt_count + 1
		delivery.last_attempted_at = now()

		if status_code >= 200 and status_code < 300
			delivery.status = "delivered"
			delivery.delivered_at = now()
			Database.save(delivery)
			return 1

		// Failed — record the error and retry later (up to 5 attempts)
		if delivery.attempt_count >= 5
			delivery.status = "failed"
		delivery.error_message = "HTTP " + status_code.toString()
		Database.save(delivery)
		return 0

endpoints:
	// Example: queue a webhook when an order is completed
	POST "/orders/:id/complete":
		string order_id = req.param("id")

		// ... complete the order ...

		// Queue the notification — do NOT call http.post here
		queue_webhook(
			"order.completed",
			"https://partner.example.com/webhooks",
			"{\"order_id\":\"" + order_id + "\",\"status\":\"completed\"}"
		)

		return jsonResponse("{\"order_id\": \"" + order_id + "\", \"status\": \"completed\"}")
