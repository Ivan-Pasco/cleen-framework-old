// frame.server plugin - HTTP Server DSL
// Provides: endpoints block with inline route modifiers [guard] cache() middleware(),
// server: configuration, routes: redirects/guards, response helpers.
// Spec: foundation/spec/framework/grammar/frame-server.ebnf,
//       foundation/spec/framework/frame-server-semantics.md
// ABI: Plugin Contracts v3 — typed AST emission (typed-emission.md)

// ============================================================================
// TYPED EMISSION BRIDGE DECLARATIONS (Plugin Contracts v3)
// ============================================================================
// foundation/spec/plugins/contracts/typed-emission.md §2.3, §3, §5
//
// These are env imports provided by the compiler's typed-emission sandbox only.
// They MUST NOT appear in plugin.toml [bridge].functions — they are sandbox-internal.
// Count: 22 bridges

external:
	// Statement constructors (typed-emission.md §3.8)
	integer _stmt_call(integer ctx, string callee, string args_json)
	integer _stmt_assign(integer ctx, string target, integer expr_handle)
	// Real let-declaration (the first introduction of a handler local).
	integer _stmt_var_decl(integer ctx, string name, string type_lp, integer expr_handle_or_0)
	integer _stmt_if(integer ctx, integer cond_handle, integer then_block_handle, integer else_block_handle)
	integer _stmt_return(integer ctx, integer expr_handle)
	integer _stmt_block(integer ctx, string stmts_json)
	// Expression constructors (typed-emission.md §3.9)
	integer _expr_string_lit(integer ctx, string value)
	// User-authored expression fragment parsed by the compiler (§3.16).
	integer _emit_expr_from_source(integer ctx, string source, integer origin_offset)
	integer _expr_int_lit(integer ctx, integer value_lo, integer value_hi)
	integer _expr_bool_lit(integer ctx, integer value)
	integer _expr_ident(integer ctx, string name)
	integer _expr_call(integer ctx, string callee, string args_json)
	// _expr_method_call — receiver.method(args). Complements _expr_call.
	// Shipped in cln 0.33.120 (compiler prompt a356a9b0).
	integer _expr_method_call(integer ctx, integer recv_handle, string method, string args_json)
	// _expr_binop takes the operator as an LP-string (e.g. "+", "==") — the
	// compiler's typed-emission bridge routes through map_binary_op(&str).
	integer _expr_binop(integer ctx, string op, integer lhs_handle, integer rhs_handle)
	// Type constructors (typed-emission.md §3.10)
	integer _type_string(integer ctx)
	integer _type_integer(integer ctx)
	integer _type_boolean(integer ctx)
	integer _type_void(integer ctx)
	// Declaration emitters (typed-emission.md §3.1–3.7)
	integer _emit_function(integer ctx, string name, string params_json, integer return_type, integer body_stmt, integer flags)
	integer _emit_statement_into_start(integer ctx, integer stmt_handle)
	integer _emit_error(integer ctx, integer severity, string code, string message, string span)
	// Pass-through bridge for user-authored handler bodies (typed-emission.md §3.11)
	integer _emit_stmt_from_source(integer ctx, string source, integer origin_offset)

// ============================================================================
// V3 LIFECYCLE SLOT — emit_module_helpers_typed (Plugin Contracts v3)
// ============================================================================
// foundation/spec/plugins/contracts/typed-emission.md §7
// foundation/spec/plugins/contracts/lifecycle.md §3.1
//
// Called once per source file that loads frame.server. Emits the response
// helper functions via _emit_function typed calls — no string concatenation
// of Clean source. Type handles are single-consumption (typed-emission.md §4
// clause 2), so every parameter / return type gets a fresh handle.

functions:
	integer emit_module_helpers_typed(integer ctx, string ctx_json)
		// __json_escape first: every error-envelope helper calls it.
		if emit_json_escape(ctx) != 0
			return 1

		// ── JSON / HTML / status responses ──
		integer p1 = _type_string(ctx)
		integer v = respond_expr(ctx, _expr_int_lit(ctx, 200, 0), "application/json", _expr_ident(ctx, "data"))
		if emit_return_helper(ctx, "jsonResponse", "[" + param_entry("data", p1) + "]", _type_string(ctx), v) != 0
			return 1

		p1 = _type_string(ctx)
		integer p2 = _type_integer(ctx)
		v = respond_expr(ctx, _expr_ident(ctx, "status_code"), "application/json", _expr_ident(ctx, "data"))
		if emit_return_helper(ctx, "jsonResponseStatus", "[" + param_entry("data", p1) + "," + param_entry("status_code", p2) + "]", _type_string(ctx), v) != 0
			return 1

		p1 = _type_string(ctx)
		v = respond_expr(ctx, _expr_int_lit(ctx, 200, 0), "text/html", _expr_ident(ctx, "content"))
		if emit_return_helper(ctx, "htmlResponse", "[" + param_entry("content", p1) + "]", _type_string(ctx), v) != 0
			return 1

		// httpStatus(code, body) and its spec name status(code, body)
		// (frame-server.ebnf §4 status_response).
		p1 = _type_integer(ctx)
		p2 = _type_string(ctx)
		v = respond_expr(ctx, _expr_ident(ctx, "code"), "application/json", _expr_ident(ctx, "body"))
		if emit_return_helper(ctx, "httpStatus", "[" + param_entry("code", p1) + "," + param_entry("body", p2) + "]", _type_string(ctx), v) != 0
			return 1
		p1 = _type_integer(ctx)
		p2 = _type_string(ctx)
		v = respond_expr(ctx, _expr_ident(ctx, "code"), "application/json", _expr_ident(ctx, "body"))
		if emit_return_helper(ctx, "status", "[" + param_entry("code", p1) + "," + param_entry("body", p2) + "]", _type_string(ctx), v) != 0
			return 1

		// ── Redirects ──
		// redirect(url, status = 302) — frame-server.ebnf §4 redirect_response
		// takes an optional status code.
		p1 = _type_string(ctx)
		p2 = _type_integer(ctx)
		integer dflt = _expr_int_lit(ctx, 302, 0)
		v = redirect_expr(ctx, _expr_ident(ctx, "status"))
		if emit_return_helper(ctx, "redirect", "[" + param_entry("url", p1) + "," + param_entry_default("status", p2, dflt) + "]", _type_string(ctx), v) != 0
			return 1
		p1 = _type_string(ctx)
		v = redirect_expr(ctx, _expr_int_lit(ctx, 302, 0))
		if emit_return_helper(ctx, "redirectTo", "[" + param_entry("url", p1) + "]", _type_string(ctx), v) != 0
			return 1
		p1 = _type_string(ctx)
		p2 = _type_integer(ctx)
		v = redirect_expr(ctx, _expr_ident(ctx, "status"))
		if emit_return_helper(ctx, "redirectToStatus", "[" + param_entry("url", p1) + "," + param_entry("status", p2) + "]", _type_string(ctx), v) != 0
			return 1

		// ── Error envelopes (frame-server-semantics.md SRV-I002 / SRV-I003) ──
		// notFound / badRequest take an optional message
		// (frame-server.ebnf §4 not_found_response, bad_request_response).
		if emit_envelope_helper(ctx, "notFound", 404, "NOT_FOUND", true, "Resource not found") != 0
			return 1
		if emit_envelope_helper(ctx, "notFoundMsg", 404, "NOT_FOUND", true, "") != 0
			return 1
		if emit_envelope_helper(ctx, "badRequest", 400, "VALIDATION_ERROR", true, "Invalid request") != 0
			return 1
		if emit_envelope_helper(ctx, "unauthorized", 401, "AUTH_ERROR", false, "Authentication required") != 0
			return 1
		if emit_envelope_helper(ctx, "forbidden", 403, "PERMISSION_DENIED", false, "Access denied") != 0
			return 1

		// httpError(status_code, message) — HTTP_ERROR envelope with any status.
		p1 = _type_integer(ctx)
		p2 = _type_string(ctx)
		v = respond_expr(ctx, _expr_ident(ctx, "status_code"), "application/json", envelope_expr(ctx, "HTTP_ERROR", _expr_ident(ctx, "message")))
		if emit_return_helper(ctx, "httpError", "[" + param_entry("status_code", p1) + "," + param_entry("message", p2) + "]", _type_string(ctx), v) != 0
			return 1

		// ── Response headers ──
		p1 = _type_string(ctx)
		p2 = _type_string(ctx)
		if emit_void_helper(ctx, "httpHeader", "[" + param_entry("name", p1) + "," + param_entry("value", p2) + "]", "_http_set_header", "[" + _expr_ident(ctx, "name").toString() + "," + _expr_ident(ctx, "value").toString() + "]") != 0
			return 1
		p1 = _type_string(ctx)
		if emit_void_helper(ctx, "resDownload", "[" + param_entry("filename", p1) + "]", "_res_download", "[" + _expr_ident(ctx, "filename").toString() + "]") != 0
			return 1

		// ── Request accessors ──
		p1 = _type_string(ctx)
		v = _expr_call(ctx, "_req_param", "[" + _expr_ident(ctx, "name").toString() + "]")
		if emit_return_helper(ctx, "param", "[" + param_entry("name", p1) + "]", _type_string(ctx), v) != 0
			return 1
		if emit_return_helper(ctx, "body", "[]", _type_string(ctx), _expr_call(ctx, "_req_body", "[]")) != 0
			return 1
		p1 = _type_string(ctx)
		v = _expr_call(ctx, "_req_header", "[" + _expr_ident(ctx, "name").toString() + "]")
		if emit_return_helper(ctx, "header", "[" + param_entry("name", p1) + "]", _type_string(ctx), v) != 0
			return 1
		if emit_return_helper(ctx, "method", "[]", _type_string(ctx), _expr_call(ctx, "_req_method", "[]")) != 0
			return 1

		// ── Email ──
		// emailSend: an empty from-override uses the configured default sender.
		string mail_params = "[" + param_entry("to", _type_string(ctx)) + "," + param_entry("subject", _type_string(ctx)) + "," + param_entry("html", _type_string(ctx)) + "," + param_entry("text", _type_string(ctx)) + "]"
		v = _expr_call(ctx, "_email_send", "[" + mail_args(ctx) + "," + _expr_string_lit(ctx, "").toString() + "]")
		if emit_return_helper(ctx, "emailSend", mail_params, _type_boolean(ctx), v) != 0
			return 1
		mail_params = "[" + param_entry("to", _type_string(ctx)) + "," + param_entry("subject", _type_string(ctx)) + "," + param_entry("html", _type_string(ctx)) + "," + param_entry("text", _type_string(ctx)) + "," + param_entry("from", _type_string(ctx)) + "]"
		v = _expr_call(ctx, "_email_send", "[" + mail_args(ctx) + "," + _expr_ident(ctx, "from").toString() + "]")
		if emit_return_helper(ctx, "emailSendFrom", mail_params, _type_boolean(ctx), v) != 0
			return 1
		if emit_return_helper(ctx, "emailLastError", "[]", _type_string(ctx), _expr_call(ctx, "_email_last_error", "[]")) != 0
			return 1

		// ── __route_default_body(body) -> string ──
		// Auto-wrap for raw `return X` in route handlers (wrap_returns_with_json):
		// sets Content-Type: application/json and the body, then returns the
		// body so user code composes normally.
		integer ct_name = _expr_string_lit(ctx, "Content-Type")
		integer ct_val = _expr_string_lit(ctx, "application/json")
		integer set_hdr = _stmt_call(ctx, "_res_set_header", "[" + ct_name.toString() + "," + ct_val.toString() + "]")
		integer set_body = _stmt_call(ctx, "_res_body", "[" + _expr_ident(ctx, "body").toString() + "]")
		integer ret_body = _stmt_return(ctx, _expr_ident(ctx, "body"))
		integer rdb_block = _stmt_block(ctx, "[" + set_hdr.toString() + "," + set_body.toString() + "," + ret_body.toString() + "]")
		p1 = _type_string(ctx)
		if _emit_function(ctx, "__route_default_body", "[" + param_entry("body", p1) + "]", _type_string(ctx), rdb_block, 2) != 0
			return 1

		return 0

	// ── Typed-emission building blocks for the module helpers ──

	// One _emit_function parameter entry.
	string param_entry(string name, integer type_handle)
		return "{\"name\":\"" + name + "\",\"type_handle\":" + type_handle.toString() + "}"

	// A parameter with a default value (typed-emission.md §3.1 default_expr_handle).
	string param_entry_default(string name, integer type_handle, integer default_handle)
		return "{\"name\":\"" + name + "\",\"type_handle\":" + type_handle.toString() + ",\"default_expr_handle\":" + default_handle.toString() + "}"

	// `<name>(<params>) -> <ret> { return <value> }`
	integer emit_return_helper(integer ctx, string name, string params_json, integer return_type, integer value)
		integer ret = _stmt_return(ctx, value)
		integer blk = _stmt_block(ctx, "[" + ret.toString() + "]")
		return _emit_function(ctx, name, params_json, return_type, blk, 2)

	// `<name>(<params>) { <callee>(<args>) }` returning void.
	integer emit_void_helper(integer ctx, string name, string params_json, string callee, string args_json)
		integer call = _stmt_call(ctx, callee, args_json)
		integer blk = _stmt_block(ctx, "[" + call.toString() + "]")
		return _emit_function(ctx, name, params_json, _type_void(ctx), blk, 2)

	// `_http_respond(<status>, "<content_type>", <body>)`
	integer respond_expr(integer ctx, integer status, string content_type, integer body)
		integer ct = _expr_string_lit(ctx, content_type)
		return _expr_call(ctx, "_http_respond", "[" + status.toString() + "," + ct.toString() + "," + body.toString() + "]")

	// `_http_redirect(<status>, url)`
	integer redirect_expr(integer ctx, integer status)
		return _expr_call(ctx, "_http_redirect", "[" + status.toString() + "," + _expr_ident(ctx, "url").toString() + "]")

	// `to, subject, html, text` identifier handles for the email helpers.
	string mail_args(integer ctx)
		return _expr_ident(ctx, "to").toString() + "," + _expr_ident(ctx, "subject").toString() + "," + _expr_ident(ctx, "html").toString() + "," + _expr_ident(ctx, "text").toString()

	// `"{\"ok\":false,\"err\":{\"code\":\"<code>\",\"message\":\"" + __json_escape(<message>) + "\"}}"`
	integer envelope_expr(integer ctx, string code, integer message)
		integer esc = _expr_call(ctx, "__json_escape", "[" + message.toString() + "]")
		integer prefix = _expr_string_lit(ctx, "{\"ok\":false,\"err\":{\"code\":\"" + code + "\",\"message\":\"")
		integer suffix = _expr_string_lit(ctx, "\"}}")
		return _expr_binop(ctx, "+", _expr_binop(ctx, "+", prefix, esc), suffix)

	// Error-envelope helper answering <status>. With takes_message the helper
	// has a `message` parameter (defaulting to default_message when that is
	// non-empty); without it the envelope carries default_message.
	integer emit_envelope_helper(integer ctx, string name, integer status, string code, boolean takes_message, string default_message)
		string params = "[]"
		integer message = 0
		if takes_message
			integer p = _type_string(ctx)
			if default_message.length() > 0
				params = "[" + param_entry_default("message", p, _expr_string_lit(ctx, default_message)) + "]"
			else
				params = "[" + param_entry("message", p) + "]"
			message = _expr_ident(ctx, "message")
		else
			message = _expr_string_lit(ctx, default_message)
		integer value = respond_expr(ctx, _expr_int_lit(ctx, status, 0), "application/json", envelope_expr(ctx, code, message))
		return emit_return_helper(ctx, name, params, _type_string(ctx), value)

	// __json_escape(s) — escapes backslash, quote and the control characters
	// that may appear in a message (newline, carriage return, tab) so error
	// envelopes stay valid JSON (SRV-I002).
	integer emit_json_escape(integer ctx)
		integer value = _expr_ident(ctx, "s")
		value = replace_expr(ctx, value, "\\", "\\\\")
		value = replace_expr(ctx, value, "\"", "\\\"")
		value = replace_expr(ctx, value, "\n", "\\n")
		value = replace_expr(ctx, value, "\r", "\\r")
		value = replace_expr(ctx, value, "\t", "\\t")
		integer p = _type_string(ctx)
		return emit_return_helper(ctx, "__json_escape", "[" + param_entry("s", p) + "]", _type_string(ctx), value)

	// `<value>.replace("<needle>", "<replacement>")`
	integer replace_expr(integer ctx, integer value, string needle, string replacement)
		integer n = _expr_string_lit(ctx, needle)
		integer r = _expr_string_lit(ctx, replacement)
		return _expr_method_call(ctx, value, "replace", "[" + n.toString() + "," + r.toString() + "]")

// ============================================================================
// V3 BLOCK EXPAND ENTRY POINT: expand_block_typed
// ============================================================================
// foundation/spec/plugins/contracts/typed-emission.md §2.2
//
// Routes all block types to their typed expansion functions.
// Returns 0 on success, non-zero on error.
//
// The block is validated first. plugin-contract.md §7 has the compiler call
// [exports].validate before expand, but compilers that skip that call would
// otherwise expand malformed headers (unclosed guard lists, bad cache values)
// into wrong code silently — so the check runs here and reports through
// _emit_error.

functions:
	integer expand_block_typed(integer ctx, string block_name, string attrs_json, string body)
		string invalid = validate_block(block_name, attrs_json, body)
		if invalid.length() > 0
			_emit_error(ctx, 2, "FRAME-SERVER-E020", invalid, "{\"start\":0,\"end\":0,\"source\":\"block_body\"}")
			return 1
		if block_name == "endpoints"
			// Compound form `endpoints server:` parses as block_name="endpoints"
			// with a "model_name":"server" attribute (parser boundary lumps the
			// second identifier under model_name — see clean-language-compiler
			// src/parser/token_parser/blocks.rs parse_framework_block). This form
			// stands in for the bare `server:` block in single-block apps like
			// clean-errors: routes are declared inline and the app expects the
			// same dev-capture emission the bare-server path provides. Without
			// this branch, `endpoints server:` apps silently miss the auto-
			// injected GET /_debug/capture route — dashboard #e4c3538d8242.
			if attrs_json.indexOf("\"model_name\":\"server\"") >= 0
				integer ep_err = expand_endpoints_typed(ctx, body)
				if ep_err != 0
					return ep_err
				return emit_dev_capture(ctx)
			return expand_endpoints_typed(ctx, body)
		if block_name == "server"
			return expand_server_typed(ctx, body)
		if block_name == "routes"
			return expand_routes_typed(ctx, body)
		// middleware and error blocks: no expansion needed
		return 0

// ============================================================================
// KEYWORD DISCOVERY EXPORT (not a lifecycle slot)
// ============================================================================

functions:
	string get_keywords()
		return "[\"endpoints\", \"routes\", \"cache\", \"handle\", \"jsonResponse\", \"htmlResponse\", \"redirect\", \"redirectTo\", \"notFound\", \"notFoundMsg\", \"badRequest\", \"unauthorized\", \"forbidden\", \"httpStatus\", \"status\", \"httpHeader\", \"httpError\", \"middleware\", \"param\", \"body\", \"header\", \"method\", \"mail\", \"resDownload\", \"emailSend\", \"emailSendFrom\", \"emailLastError\", \"res.download\", \"email.send\", \"email.sendFrom\", \"email.lastError\", \"LIVE\", \"FEED\", \"live.send\", \"live.broadcast\", \"live.close\", \"live.clientId\", \"live.message\", \"live.roomJoin\", \"live.roomLeave\", \"live.roomBroadcast\", \"live.onMessage\", \"live.onClose\", \"jsonResponseStatus\", \"redirectToStatus\"]"

// ============================================================================
// VALIDATION EXPORT (not a lifecycle slot)
// ============================================================================

functions:
	string validate_block(string block_name, string attributes, string body)
		if block_name == "endpoints"
			return validate_endpoints(body)
		if block_name == "routes"
			return validate_routes(body)
		return ""

// ============================================================================
// ENDPOINTS BLOCK — V3 TYPED EXPANSION
// ============================================================================
// Each route handler is emitted via _emit_function and registered by name with
// an explicit _http_*_route call emitted into start:. User-authored handler
// bodies go through _emit_stmt_from_source (§3.11). Guard/cache/middleware
// preambles are built with typed statement constructors.

functions:
	integer expand_endpoints_typed(integer ctx, string body)
		string remaining = body
		integer method_pos = next_route_pos(remaining)
		while method_pos >= 0
			string method = route_method_at(remaining, method_pos)
			integer path_first_pos = method_pos + method.length() + 1
			integer close_q_pos = remaining.indexOf("\"", path_first_pos + 1)
			string path = remaining.substring(path_first_pos + 1, close_q_pos)

			integer header_start_pos = close_q_pos + 1
			integer header_nl_pos = remaining.indexOf("\n", header_start_pos)
			string header_line = ""
			if header_nl_pos == -1
				header_line = remaining.substring(header_start_pos, remaining.length())
			else
				header_line = remaining.substring(header_start_pos, header_nl_pos)

			// Route ':' is the last ':' on the header line (validate_endpoints
			// guarantees there is one).
			integer colon_pos = header_line.lastIndexOf(":")
			string modifiers = header_line.substring(0, colon_pos).trim()
			string guard_roles = parse_guard_roles(modifiers)
			string cache_arg = parse_cache_arg(modifiers)
			string mw_list = parse_middleware_list(modifiers)

			// Advance past the route ':' — the handler body follows.
			remaining = remaining.substring(header_start_pos + colon_pos + 1, remaining.length())
			string route_id = sanitize_route_id(path)

			integer route_err = 0
			if method == "LIVE"
				route_err = emit_live_route(ctx, path, route_id, route_region(remaining), guard_roles)
			else
				route_err = emit_http_route(ctx, method, path, route_id, route_region(remaining), guard_roles, cache_arg, mw_list)
			if route_err != 0
				return route_err

			method_pos = next_route_pos(remaining)
		return 0

	// GET/POST/PUT/PATCH/DELETE and FEED (SSE) routes: one string-returning
	// handler plus its registration.
	integer emit_http_route(integer ctx, string method, string path, string route_id, string region, string guard_roles, string cache_arg, string mw_list)
		string handler_name = "__route_handler_" + method + "_" + route_id

		// A handler ending in an `html:` block returns that page as text/html
		// (frame-ui.ebnf html_block; SRV-R003). Raw `return X` becomes
		// `return __route_default_body(X)` so `return "hello"` answers JSON;
		// see wrap_returns_with_json for which returns are rewritten.
		string handler_code = trailing_html_block_to_response(reindent_block(region))
		if handler_streams(handler_code) == false
			handler_code = wrap_returns_with_json(handler_code, contains_response_call(handler_code))

		// Preamble: guard, then cache, then middleware (frame-server.ebnf §2
		// modifier order).
		string stmts = ""
		if guard_roles.length() > 0
			stmts = join_handles(stmts, build_guard_stmts(ctx, guard_roles, false))
		if cache_arg.length() > 0
			stmts = join_handles(stmts, build_cache_stmt(ctx, cache_arg).toString())
		if mw_list.length() > 0
			stmts = join_handles(stmts, build_middleware_stmts(ctx, mw_list))

		if handler_code.length() > 0
			integer body_stmt = _emit_stmt_from_source(ctx, handler_code, 0)
			if body_stmt == 0
				_emit_error(ctx, 2, "FRAME-SERVER-E001", "syntax error in handler body for " + method + " " + path, "{\"start\":0,\"end\":0,\"source\":\"block_body\"}")
				return 1
			stmts = join_handles(stmts, body_stmt.toString())

		if stmts.length() == 0
			// No user code and no preamble: answer with the route name.
			integer def_call = _expr_call(ctx, "jsonResponse", "[" + _expr_string_lit(ctx, method + " " + path).toString() + "]")
			stmts = _stmt_return(ctx, def_call).toString()

		// The registration names the handler with a string literal: the
		// _emit_route sugar emits it as a variable, which the checker resolves
		// to a function reference and fails to unify with the `string` third
		// parameter of _http_route (function-registry.toml).
		integer h_err = _emit_function(ctx, handler_name, "[]", _type_string(ctx), _stmt_block(ctx, "[" + stmts + "]"), 2)
		if h_err != 0
			_emit_error(ctx, 2, "FRAME-SERVER-E002", "failed to emit handler function for " + method + " " + path, "{\"start\":0,\"end\":0,\"source\":\"plugin\"}")
			return 1

		string register = "_http_route"
		string reg_method = method
		if method == "FEED"
			// SSE: an HTTP GET whose connection stays open (§FEXT-4.2).
			register = "_http_sse_route"
			reg_method = "GET"
		integer m_expr = _expr_string_lit(ctx, reg_method)
		integer p_expr = _expr_string_lit(ctx, path)
		integer h_expr = _expr_string_lit(ctx, handler_name)
		integer reg = _stmt_call(ctx, register, "[" + m_expr.toString() + "," + p_expr.toString() + "," + h_expr.toString() + "]")
		if _emit_statement_into_start(ctx, reg) != 0
			return 1
		return 0

	// LIVE (WebSocket) routes: the route body is the onConnect handler; the
	// live.onMessage: / live.onClose: sub-blocks are the other two handlers
	// (frame-server.ebnf §3a). The guard runs on connect only.
	integer emit_live_route(integer ctx, string path, string route_id, string region, string guard_roles)
		string connect_name = "__ws_connect_" + route_id
		string message_name = "__ws_message_" + route_id
		string close_name = "__ws_close_" + route_id

		integer connect_end = region.length()
		integer msg_label = region.indexOf("live.onMessage:")
		integer close_label = region.indexOf("live.onClose:")
		if msg_label >= 0 and msg_label < connect_end
			connect_end = msg_label
		if close_label >= 0 and close_label < connect_end
			connect_end = close_label

		if emit_ws_handler_typed(ctx, connect_name, reindent_block(region.substring(0, connect_end)), guard_roles) != 0
			return 1
		if emit_ws_handler_typed(ctx, message_name, live_section(region, "live.onMessage:", "live.onClose:"), "") != 0
			return 1
		if emit_ws_handler_typed(ctx, close_name, live_section(region, "live.onClose:", "live.onMessage:"), "") != 0
			return 1

		integer m_expr = _expr_string_lit(ctx, "GET")
		integer p_expr = _expr_string_lit(ctx, path)
		integer c_expr = _expr_string_lit(ctx, connect_name)
		integer msg_expr = _expr_string_lit(ctx, message_name)
		integer cls_expr = _expr_string_lit(ctx, close_name)
		integer reg = _stmt_call(ctx, "_http_ws_route", "[" + m_expr.toString() + "," + p_expr.toString() + "," + c_expr.toString() + "," + msg_expr.toString() + "," + cls_expr.toString() + "]")
		if _emit_statement_into_start(ctx, reg) != 0
			return 1
		return 0

	// Append a comma-separated handle list to another.
	string join_handles(string acc, string more)
		if more.length() == 0
			return acc
		if acc.length() == 0
			return more
		return acc + "," + more

	// Typed guard statements as a comma-separated handle list:
	//   boolean __auth_ok = false
	//   if _auth_require_role("<role>") == 1: __auth_ok = true     (per role)
	//   if __auth_ok == false: return unauthorized()
	// For void WebSocket handlers (is_void) the failure branch closes the
	// connection instead: _ws_close(_ws_client_id()); return.
	string build_guard_stmts(integer ctx, string roles, boolean is_void)
		integer auth_ok_decl = _stmt_var_decl(ctx, "__auth_ok", "boolean", _expr_bool_lit(ctx, 0))
		string result = auth_ok_decl.toString()

		list<string> role_list = roles.split(",")
		iterate i in 0 to role_list.length() - 1
			string role = role_list[i].trim()
			if role.length() > 0
				integer role_check = _expr_call(ctx, "_auth_require_role", "[" + _expr_string_lit(ctx, role).toString() + "]")
				integer cond = _expr_binop(ctx, "==", role_check, _expr_int_lit(ctx, 1, 0))
				integer set_true = _stmt_assign(ctx, "__auth_ok", _expr_bool_lit(ctx, 1))
				integer role_if = _stmt_if(ctx, cond, _stmt_block(ctx, "[" + set_true.toString() + "]"), 0)
				result = result + "," + role_if.toString()

		integer not_auth = _expr_binop(ctx, "==", _expr_ident(ctx, "__auth_ok"), _expr_bool_lit(ctx, 0))
		string fail_stmts = ""
		if is_void
			integer ws_id_call = _expr_call(ctx, "_ws_client_id", "[]")
			integer ws_close_call = _stmt_call(ctx, "_ws_close", "[" + ws_id_call.toString() + "]")
			fail_stmts = ws_close_call.toString() + "," + _stmt_return(ctx, 0).toString()
		else
			fail_stmts = _stmt_return(ctx, _expr_call(ctx, "unauthorized", "[]")).toString()
		integer fail_if = _stmt_if(ctx, not_auth, _stmt_block(ctx, "[" + fail_stmts + "]"), 0)
		return result + "," + fail_if.toString()

	// The cache() modifier as one statement handle (frame-server.ebnf §3.2).
	// validate_endpoints has already rejected unknown values.
	integer build_cache_stmt(integer ctx, string cache_arg)
		if cache_arg.startsWith("\"")
			string val = cache_arg.substring(1, cache_arg.length() - 1)
			if val == "no-store" or val == "no-cache"
				return _stmt_call(ctx, "_http_no_cache", "[]")
			if val == "public" or val == "private"
				integer hdr_name = _expr_string_lit(ctx, "Cache-Control")
				integer hdr_val = _expr_string_lit(ctx, val)
				return _stmt_call(ctx, "_http_set_header", "[" + hdr_name.toString() + "," + hdr_val.toString() + "]")
			// Duration string: "5m" / "2h" / "1d"
			integer secs = duration_to_seconds(val)
			return _stmt_call(ctx, "_http_set_cache", "[" + _expr_int_lit(ctx, secs, 0).toString() + "]")
		return _stmt_call(ctx, "_http_set_cache", "[" + _expr_int_lit(ctx, cache_arg.toInteger(), 0).toString() + "]")

	// The middleware() modifier (frame-server.ebnf §3.3): each listed function
	// is called in order; a non-empty result short-circuits the request and
	// becomes the response.
	//   string __mw_N = <Name>()
	//   if __mw_N.length() > 0: return __mw_N
	string build_middleware_stmts(integer ctx, string mw_list)
		string result = ""
		list<string> names = mw_list.split(",")
		iterate i in 0 to names.length() - 1
			string name = names[i].trim()
			if name.length() > 0
				string var_name = "__mw_" + i.toString()
				integer decl = _stmt_var_decl(ctx, var_name, "string", _expr_call(ctx, name, "[]"))
				integer len_call = _expr_method_call(ctx, _expr_ident(ctx, var_name), "length", "[]")
				integer cond = _expr_binop(ctx, ">", len_call, _expr_int_lit(ctx, 0, 0))
				integer ret_stmt = _stmt_return(ctx, _expr_ident(ctx, var_name))
				integer mw_if = _stmt_if(ctx, cond, _stmt_block(ctx, "[" + ret_stmt.toString() + "]"), 0)
				result = join_handles(result, decl.toString() + "," + mw_if.toString())
		return result

	// Emit a void WebSocket handler; a non-empty guard_roles adds the guard.
	integer emit_ws_handler_typed(integer ctx, string name, string ws_body, string guard_roles)
		string stmts = ""
		if guard_roles.length() > 0
			stmts = build_guard_stmts(ctx, guard_roles, true)
		if ws_body.length() > 0
			integer body_stmt = _emit_stmt_from_source(ctx, ws_body, 0)
			if body_stmt == 0
				_emit_error(ctx, 2, "FRAME-SERVER-E003", "syntax error in WebSocket handler body for " + name, "{\"start\":0,\"end\":0,\"source\":\"block_body\"}")
				return 1
			stmts = join_handles(stmts, body_stmt.toString())
		integer fn_err = _emit_function(ctx, name, "[]", _type_void(ctx), _stmt_block(ctx, "[" + stmts + "]"), 2)
		if fn_err != 0
			_emit_error(ctx, 2, "FRAME-SERVER-E004", "failed to emit WebSocket handler: " + name, "{\"start\":0,\"end\":0,\"source\":\"plugin\"}")
			return 1
		return 0

// ============================================================================
// SERVER BLOCK — V3 TYPED EXPANSION
// ============================================================================
// Statements are built with typed constructors and emitted into start:.
// All code here is plugin-authored (port, host, static, mail, cors, rate limit,
// global error handler). Statements emitted via _emit_statement_into_start.

functions:
	integer expand_server_typed(integer ctx, string body)
		// Type handles are single-consumption per typed-emission.md §4 clause 2.
		// Every _emit_function / _emit_statement_into_start site below allocates
		// its own fresh handles; no top-level caching.

		string port_str = "3000"
		string host_str = ""
		string static_dir = ""

		string mail_host = "\"\""
		string mail_port = "587"
		string mail_secure = "true"
		string mail_username = "\"\""
		string mail_password = "\"\""
		string mail_from = "\"\""
		boolean has_mail = false

		string cors_origins = ""
		string cors_methods = ""
		string cors_headers = ""
		string cors_max_age = "0"
		string cors_credentials = "false"
		boolean has_cors = false

		string rate_per_window = "0"
		string rate_window_secs = "60"
		boolean has_rate_limit = false

		// server: handle: — only the `any <ident>:` clause is materialised
		// (frame-server.ebnf §1 error_handle_field); typed clauses fall
		// through to the server's default 500.
		string handle_body = ""
		string handle_err_ident = ""
		integer handle_clause_tabs = 0

		string lines = body
		integer line_start = 0
		boolean in_mail_block = false
		boolean in_cors_block = false
		boolean in_rate_limit_block = false
		boolean in_handle_block = false
		boolean in_handle_any_clause = false

		while line_start < lines.length()
			integer line_end = lines.indexOf("\n", line_start)
			if line_end == -1
				line_end = lines.length()

			string line = lines.substring(line_start, line_end)
			string trimmed = line.trim()

			if trimmed == "mail:"
				has_mail = true
				in_mail_block = true
				in_cors_block = false
				in_rate_limit_block = false
				in_handle_block = false
				line_start = line_end + 1
				continue
			if trimmed == "cors:"
				has_cors = true
				in_cors_block = true
				in_mail_block = false
				in_rate_limit_block = false
				in_handle_block = false
				line_start = line_end + 1
				continue
			if trimmed == "rateLimit:"
				has_rate_limit = true
				in_rate_limit_block = true
				in_mail_block = false
				in_cors_block = false
				in_handle_block = false
				line_start = line_end + 1
				continue
			if trimmed == "handle:"
				in_handle_block = true
				in_mail_block = false
				in_cors_block = false
				in_rate_limit_block = false
				in_handle_any_clause = false
				line_start = line_end + 1
				continue

			if in_mail_block
				if trimmed.length() > 0 and not line.startsWith("\t") and not line.startsWith("  ")
					in_mail_block = false
				else
					if trimmed.startsWith("host:")
						mail_host = resolve_server_config_value(trimmed.substring(5, trimmed.length()).trim())
					if trimmed.startsWith("port:")
						mail_port = trimmed.substring(5, trimmed.length()).trim()
					if trimmed.startsWith("secure:")
						mail_secure = trimmed.substring(7, trimmed.length()).trim()
					if trimmed.startsWith("username:")
						mail_username = resolve_server_config_value(trimmed.substring(9, trimmed.length()).trim())
					if trimmed.startsWith("password:")
						mail_password = resolve_server_config_value(trimmed.substring(9, trimmed.length()).trim())
					if trimmed.startsWith("from:")
						mail_from = resolve_server_config_value(trimmed.substring(5, trimmed.length()).trim())
					line_start = line_end + 1
					continue

			if in_cors_block
				if trimmed.length() > 0 and not line.startsWith("\t") and not line.startsWith("  ")
					in_cors_block = false
				else
					if trimmed.startsWith("allowedOrigins:")
						cors_origins = parse_server_list_field(trimmed.substring(15, trimmed.length()).trim())
					if trimmed.startsWith("allowedMethods:")
						cors_methods = parse_server_list_field(trimmed.substring(15, trimmed.length()).trim())
					if trimmed.startsWith("allowedHeaders:")
						cors_headers = parse_server_list_field(trimmed.substring(15, trimmed.length()).trim())
					if trimmed.startsWith("maxAge:")
						cors_max_age = trimmed.substring(7, trimmed.length()).trim()
					if trimmed.startsWith("allowCredentials:")
						cors_credentials = trimmed.substring(17, trimmed.length()).trim()
					line_start = line_end + 1
					continue

			if in_rate_limit_block
				if trimmed.length() > 0 and not line.startsWith("\t") and not line.startsWith("  ")
					in_rate_limit_block = false
				else
					if trimmed.startsWith("perMinute:")
						rate_per_window = trimmed.substring(10, trimmed.length()).trim()
						rate_window_secs = "60"
					if trimmed.startsWith("perSecond:")
						rate_per_window = trimmed.substring(10, trimmed.length()).trim()
						rate_window_secs = "1"
					if trimmed.startsWith("perHour:")
						rate_per_window = trimmed.substring(8, trimmed.length()).trim()
						rate_window_secs = "3600"
					line_start = line_end + 1
					continue

			if in_handle_block
				if trimmed.length() > 0 and not line.startsWith("\t") and not line.startsWith("  ")
					in_handle_block = false
					in_handle_any_clause = false
				else
					if trimmed.length() > 0 and in_handle_any_clause and leading_tabs(line) <= handle_clause_tabs
						// A sibling clause ends the `any` clause body.
						in_handle_any_clause = false
					if trimmed.startsWith("any ") and trimmed.endsWith(":") and handle_err_ident.length() == 0
						handle_err_ident = trimmed.substring(4, trimmed.length() - 1).trim()
						handle_clause_tabs = leading_tabs(line)
						in_handle_any_clause = true
					else if in_handle_any_clause
						handle_body = handle_body + line + "\n"
					line_start = line_end + 1
					continue

			if trimmed.startsWith("port:")
				port_str = trimmed.substring(5, trimmed.length()).trim()

			if trimmed.startsWith("host:")
				host_str = resolve_server_config_value(trimmed.substring(5, trimmed.length()).trim())

			if trimmed.startsWith("static:")
				string dir_val = trimmed.substring(7, trimmed.length()).trim()
				if dir_val.startsWith("\"") and dir_val.length() > 1
					if dir_val.endsWith("\"")
						dir_val = dir_val.substring(1, dir_val.length() - 1)
				static_dir = dir_val

			line_start = line_end + 1

		// Global error handler. clean-server invokes it like a route handler —
		// no arguments, request context in scope — and forwards the error text
		// in the X-Clean-Error request header, so `<ident>.message` reads that
		// header. Without an `any` clause body nothing is registered and the
		// server's default 500 response applies.
		string handle_code = reindent_block(handle_body)
		boolean has_handle = handle_code.length() > 0
		if has_handle
			handle_code = handle_code.replace(handle_err_ident + ".message", "__error_message")
			handle_code = trailing_html_block_to_response(handle_code)
			handle_code = wrap_returns_with_json(handle_code, contains_response_call(handle_code))
			integer gh_body = _emit_stmt_from_source(ctx, handle_code, 0)
			if gh_body == 0
				_emit_error(ctx, 2, "FRAME-SERVER-E005", "syntax error in server: handle: body", "{\"start\":0,\"end\":0,\"source\":\"block_body\"}")
				return 1
			integer hdr_name = _expr_string_lit(ctx, "X-Clean-Error")
			integer read_msg = _stmt_var_decl(ctx, "__error_message", "string", _expr_call(ctx, "_req_header", "[" + hdr_name.toString() + "]"))
			integer gh_block = _stmt_block(ctx, "[" + read_msg.toString() + "," + gh_body.toString() + "]")
			if _emit_function(ctx, "__server_global_error_handler", "[]", _type_string(ctx), gh_block, 2) != 0
				return 1

		// Emit start: statements in correct order

		// _email_configure when mail: block present
		if has_mail
			// resolve_server_config_value yields a Clean expression (a quoted
			// string or `_env_get("NAME")`), so each value is parsed as one.
			integer em_host = _emit_expr_from_source(ctx, mail_host, 0)
			integer em_port = _expr_int_lit(ctx, mail_port.toInteger(), 0)
			// `secure: false` selects a plain (non-TLS) SMTP connection; the
			// default and `secure: true` use TLS.
			integer secure_bit = 1
			if mail_secure == "false"
				secure_bit = 0
			else if mail_secure != "true"
				_emit_error(ctx, 2, "FRAME-SERVER-E006", "server: mail: secure must be true or false, got `" + mail_secure + "`", "{\"start\":0,\"end\":0,\"source\":\"block_body\"}")
				return 1
			integer em_sec = _expr_bool_lit(ctx, secure_bit)
			integer em_user = _emit_expr_from_source(ctx, mail_username, 0)
			integer em_pass = _emit_expr_from_source(ctx, mail_password, 0)
			integer em_from = _emit_expr_from_source(ctx, mail_from, 0)
			integer em_stmt = _stmt_call(ctx, "_email_configure", "[" + em_host.toString() + "," + em_port.toString() + "," + em_sec.toString() + "," + em_user.toString() + "," + em_pass.toString() + "," + em_from.toString() + "]")
			integer em_err = _emit_statement_into_start(ctx, em_stmt)
			if em_err != 0
				return 1

		// _cors_configure when cors: block present
		if has_cors
			integer co_orig = _expr_string_lit(ctx, cors_origins)
			integer co_meth = _expr_string_lit(ctx, cors_methods)
			integer co_hdr = _expr_string_lit(ctx, cors_headers)
			integer co_age = _expr_int_lit(ctx, cors_max_age.toInteger(), 0)
			integer co_cred_val = 0
			if cors_credentials == "true"
				co_cred_val = 1
			integer co_cred = _expr_bool_lit(ctx, co_cred_val)
			integer co_stmt = _stmt_call(ctx, "_cors_configure", "[" + co_orig.toString() + "," + co_meth.toString() + "," + co_hdr.toString() + "," + co_age.toString() + "," + co_cred.toString() + "]")
			integer co_err = _emit_statement_into_start(ctx, co_stmt)
			if co_err != 0
				return 1

		// _rate_limit_configure when rateLimit: block present
		if has_rate_limit
			integer rl_per = _expr_int_lit(ctx, rate_per_window.toInteger(), 0)
			integer rl_win = _expr_int_lit(ctx, rate_window_secs.toInteger(), 0)
			integer rl_strat = _expr_string_lit(ctx, "ip")
			integer rl_stmt = _stmt_call(ctx, "_rate_limit_configure", "[" + rl_per.toString() + "," + rl_win.toString() + "," + rl_strat.toString() + "]")
			integer rl_err = _emit_statement_into_start(ctx, rl_stmt)
			if rl_err != 0
				return 1

		// _http_set_global_error_handler when handle: present
		if has_handle
			integer eh_fn_name = _expr_string_lit(ctx, "__server_global_error_handler")
			integer eh_stmt = _stmt_call(ctx, "_http_set_global_error_handler", "[" + eh_fn_name.toString() + "]")
			integer eh_err = _emit_statement_into_start(ctx, eh_stmt)
			if eh_err != 0
				return 1

		// Dev-mode capture — auto-inject GET /_debug/capture.
		// Requires cln 0.33.71+ (embedded registry includes _dev_snapshot).
		integer dc_err = emit_dev_capture(ctx)
		if dc_err != 0
			return dc_err

		// _http_serve_static when static: present
		if static_dir.length() > 0
			integer st_prefix = _expr_string_lit(ctx, "/")
			integer st_dir = _expr_string_lit(ctx, static_dir)
			integer st_stmt = _stmt_call(ctx, "_http_serve_static", "[" + st_prefix.toString() + "," + st_dir.toString() + "]")
			integer st_err = _emit_statement_into_start(ctx, st_stmt)
			if st_err != 0
				return 1

		// _http_listen_on or _http_listen
		if host_str.length() > 0
			integer ls_host = _emit_expr_from_source(ctx, host_str, 0)
			integer ls_port = _expr_int_lit(ctx, port_str.toInteger(), 0)
			integer ls_stmt = _stmt_call(ctx, "_http_listen_on", "[" + ls_host.toString() + "," + ls_port.toString() + "]")
			integer ls_err = _emit_statement_into_start(ctx, ls_stmt)
			if ls_err != 0
				return 1
		else
			integer l_port = _expr_int_lit(ctx, port_str.toInteger(), 0)
			integer l_stmt = _stmt_call(ctx, "_http_listen", "[" + l_port.toString() + "]")
			integer l_err = _emit_statement_into_start(ctx, l_stmt)
			if l_err != 0
				return 1

		return 0

// ============================================================================
// ROUTES BLOCK — V3 TYPED EXPANSION
// ============================================================================
// Each directive becomes typed statements or a build_state record.
// redirect: directives → _http_redirect_route via _emit_statement_into_start.
// guard: directives → _build_state_set (these are [bridge] functions, unchanged).

functions:
	integer expand_routes_typed(integer ctx, string body)
		list<string> route_lines = body.split("\n")
		iterate li in 0 to route_lines.length() - 1
			string trimmed = route_lines[li].trim()
			if trimmed.length() == 0
				continue
			if trimmed.startsWith("error:")
				continue

			if trimmed.startsWith("guard:")
				// guard: "/pattern" [role,role]
				// Write to build_state — _build_state_set is a [bridge] function, not a typed-emission bridge.
				string g_after = trimmed.substring(6, trimmed.length()).trim()
				integer gq1 = g_after.indexOf("\"")
				if gq1 != -1
					integer gq2 = g_after.indexOf("\"", gq1 + 1)
					if gq2 != -1
						string g_pattern = g_after.substring(gq1 + 1, gq2)
						string g_rest = g_after.substring(gq2 + 1, g_after.length()).trim()
						integer g_ob = g_rest.indexOf("[")
						integer g_cb = g_rest.indexOf("]")
						if g_ob != -1 and g_cb != -1
							string g_roles = g_rest.substring(g_ob + 1, g_cb).replace(" ", "")
							if g_pattern.length() > 0 and g_roles.length() > 0
								string g_record = g_pattern + "|" + g_roles
								string g_existing = _build_state_get("frame.server:guards")
								if g_existing.length() == 0
									_build_state_set("frame.server:guards", g_record)
								else
									_build_state_set("frame.server:guards", g_existing + ";" + g_record)
				continue

			if trimmed.startsWith("redirect:")
				string after = trimmed.substring(9, trimmed.length()).trim()

				integer q1 = after.indexOf("\"")
				if q1 != -1
					integer q2 = after.indexOf("\"", q1 + 1)
					if q2 != -1
						string from_path = after.substring(q1 + 1, q2)

						// frame-server.ebnf §10.1 writes the separator as `→`; `->`
						// is accepted as its ASCII spelling.
						string rest = after.substring(q2 + 1, after.length()).trim()
						if rest.startsWith("->")
							rest = rest.substring(2, rest.length()).trim()
						else if rest.startsWith("→")
							rest = rest.substring(1, rest.length()).trim()

						integer q3 = rest.indexOf("\"")
						if q3 != -1
							integer q4 = rest.indexOf("\"", q3 + 1)
							if q4 != -1
								string to_path = rest.substring(q3 + 1, q4)

								string after_to = rest.substring(q4 + 1, rest.length()).trim()
								// Permanent (301) unless a `[status]` suffix says otherwise
								// (frame-server.ebnf §10.1).
								string status = "301"
								if after_to.startsWith("[")
									integer close_b = after_to.indexOf("]")
									if close_b != -1
										status = after_to.substring(1, close_b).trim()

								// Emit: _http_redirect_route("GET", from_path, to_path, status_code)
								integer rr_m = _expr_string_lit(ctx, "GET")
								integer rr_from = _expr_string_lit(ctx, from_path)
								integer rr_to = _expr_string_lit(ctx, to_path)
								integer rr_sc = _expr_int_lit(ctx, status.toInteger(), 0)
								integer rr_stmt = _stmt_call(ctx, "_http_redirect_route", "[" + rr_m.toString() + "," + rr_from.toString() + "," + rr_to.toString() + "," + rr_sc.toString() + "]")
								integer rr_err = _emit_statement_into_start(ctx, rr_stmt)
								if rr_err != 0
									return 1

		return 0

// ============================================================================
// SHARED DSL PARSING HELPERS
// ============================================================================
// These helpers locate and slice fragments of the DSL body. User-authored
// handler code they return is passed verbatim to _emit_stmt_from_source
// (typed-emission.md §3.11).

functions:
	// sanitize_route_id converts a route path to a valid identifier segment.
	string sanitize_route_id(string path)
		string valid_chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
		string result = ""
		integer i = 0
		while i < path.length()
			string ch = path.substring(i, i + 1)
			if valid_chars.indexOf(ch) >= 0
				result = result + ch
			else
				result = result + "_"
			i = i + 1
		return result

	// Every route method keyword (frame-server.ebnf §2 http_method).
	list<string> route_methods()
		return "GET,POST,PUT,DELETE,PATCH,FEED,LIVE".split(",")

	// Position of the next `METHOD "` route header in text, or -1. A match
	// must start a word, so `INPUT "` or `TARGET "` inside handler code is
	// not taken for a PUT / GET header.
	integer find_method_pos(string text, string method)
		string needle = method + " \""
		integer pos = text.indexOf(needle)
		while pos > 0
			string before = text.substring(pos - 1, pos)
			if before == "\n" or before == "\t" or before == " "
				return pos
			pos = text.indexOf(needle, pos + 1)
		return pos

	// Position of the next route header of any method, or -1.
	integer next_route_pos(string text)
		integer best = -1
		list<string> methods = route_methods()
		iterate i in 0 to methods.length() - 1
			integer p = find_method_pos(text, methods[i])
			if p >= 0 and (best == -1 or p < best)
				best = p
		return best

	// The method keyword of the route header that starts at pos.
	string route_method_at(string text, integer pos)
		list<string> methods = route_methods()
		iterate i in 0 to methods.length() - 1
			string m = methods[i]
			if text.substring(pos, pos + m.length() + 2) == m + " \""
				return m
		return ""

	// The text of the current route's body: everything up to the next route
	// header.
	string route_region(string text)
		integer end_pos = next_route_pos(text)
		if end_pos == -1
			return text
		return text.substring(0, end_pos)

	string parse_guard_roles(string modifiers)
		integer open_b = modifiers.indexOf("[")
		if open_b == -1
			return ""
		integer close_b = modifiers.indexOf("]")
		if close_b == -1
			return ""
		string raw = modifiers.substring(open_b + 1, close_b)
		return raw.replace(" ", "")

	string parse_cache_arg(string modifiers)
		integer cache_p = modifiers.indexOf("cache(")
		if cache_p == -1
			return ""
		string after = modifiers.substring(cache_p + 6, modifiers.length())
		integer close_p = after.indexOf(")")
		if close_p == -1
			return ""
		return after.substring(0, close_p).trim()

	string parse_middleware_list(string modifiers)
		integer mw_p = modifiers.indexOf("middleware(")
		if mw_p == -1
			return ""
		string after = modifiers.substring(mw_p + 11, modifiers.length())
		integer close_p = after.indexOf(")")
		if close_p == -1
			return ""
		return after.substring(0, close_p).replace(" ", "")

	// Duration string to seconds: "5m"→300, "2h"→7200, "1d"→86400.
	integer duration_to_seconds(string val)
		string unit = val.substring(val.length() - 1, val.length())
		integer num = val.substring(0, val.length() - 1).toInteger()
		if unit == "m"
			return num * 60
		if unit == "h"
			return num * 3600
		return num * 86400

	// Count leading tab characters of a line.
	integer leading_tabs(string line)
		integer n = 0
		while n < line.length() and line.substring(n, n + 1) == "\t"
			n = n + 1
		return n

	// When the handler's last statement is an `html:` block, rewrite it to
	// `html var="__route_page":` (assign, no return) and append
	// `return htmlResponse(__route_page)`, so the page is sent as text/html.
	// Without this the block expands to a bare `return __html`, which no
	// response helper wraps, and the route answers with an empty body.
	string trailing_html_block_to_response(string code)
		list<string> lines = code.split("\n")
		integer base = -1
		iterate i in 0 to lines.length() - 1
			string ln = lines[i]
			if ln.trim().length() > 0
				integer t = leading_tabs(ln)
				if base == -1 or t < base
					base = t
		if base == -1
			return code
		integer html_at = -1
		iterate j in 0 to lines.length() - 1
			string lj = lines[j]
			if lj.trim() == "html:" and leading_tabs(lj) == base
				html_at = j
		if html_at == -1
			return code
		// Every later non-empty line must belong to the block (deeper indent).
		boolean trailing = true
		iterate k in html_at + 1 to lines.length() - 1
			string lk = lines[k]
			if lk.trim().length() > 0 and leading_tabs(lk) <= base
				trailing = false
		if trailing == false
			return code
		string indent = tabs_indent(base)
		string out = ""
		iterate q in 0 to lines.length() - 1
			string lq = lines[q]
			if q == html_at
				lq = indent + "html var=\"__route_page\":"
			if q > 0
				out = out + "\n"
			out = out + lq
		return out + "\n" + indent + "return htmlResponse(__route_page)"

	// True when code calls a response helper — a function that writes the
	// HTTP response itself (status, headers, body).
	boolean contains_response_call(string code)
		list<string> helpers = "jsonResponse(,jsonResponseStatus(,htmlResponse(,redirect(,redirectTo(,redirectToStatus(,notFound(,notFoundMsg(,badRequest(,unauthorized(,forbidden(,httpStatus(,httpError(,httpHeader(,status(,json(,html(,error(,render(,renderWith(,resDownload(,__route_default_body(,_http_respond(,_http_redirect(,_http_set_header(,http.respond(,http.redirect(,http.setHeader(,_res_json(,_res_body(,_res_redirect(,_res_status(,_res_set_header(,_res_download(".split(",")
		iterate i in 0 to helpers.length() - 1
			if code.indexOf(helpers[i]) >= 0
				return true
		return false

	// True when the handler drives a stream (FEED / LIVE): it has no single
	// response body to wrap.
	boolean handler_streams(string code)
		return code.indexOf("feed.") >= 0 or code.indexOf("live.") >= 0 or code.indexOf("_sse_") >= 0 or code.indexOf("_ws_") >= 0

	// Returns true when '(' and ')' counts match — skip wrap on continuation lines.
	boolean parens_balanced(string s)
		integer depth = 0
		integer i = 0
		while i < s.length()
			string ch = s.substring(i, i + 1)
			if ch == "("
				depth = depth + 1
			if ch == ")"
				depth = depth - 1
			i = i + 1
		return depth == 0

	// Rewrite `return <expr>` → `return __route_default_body(<expr>)` so a raw
	// value answers as a JSON body. Returns whose expression already calls a
	// response helper are left alone. When the handler sets the response
	// through a helper elsewhere (literal_only), only string-literal returns
	// are rewritten: those are always raw bodies, while another value may
	// carry a response a helper already wrote.
	string wrap_returns_with_json(string code, boolean literal_only)
		if code.indexOf("return ") < 0
			return code
		string result = ""
		list<string> lines = code.split("\n")
		iterate i in 0 to lines.length() - 1
			string line = lines[i]
			integer tabs = leading_tabs(line)
			string stmt = line.substring(tabs, line.length())
			string out = line
			if stmt.startsWith("return ")
				string expr = stmt.substring(7, stmt.length()).trim()
				boolean wrap = expr.length() > 0 and parens_balanced(expr) and contains_response_call(expr) == false
				if literal_only and expr.startsWith("\"") == false
					wrap = false
				if wrap
					out = tabs_indent(tabs) + "return __route_default_body(" + expr + ")"
			if line.length() > 0 or i < lines.length() - 1
				result = result + out + "\n"
		return result

	// A run of depth tab characters.
	string tabs_indent(integer depth)
		string result = ""
		integer d = 0
		while d < depth
			result = result + "\t"
			d = d + 1
		return result

	// Re-indent a section to a zero-tab base, dropping blank and whole-line
	// comment lines. The compiler wraps a fragment under a synthetic `start:`
	// block and prepends one tab per line (grammar.rs parse_single_statement),
	// so any extra leading tab would over-indent the statement and trip
	// SYN001; a comment-only fragment would parse as no statement at all.
	string reindent_block(string section)
		list<string> lines = section.split("\n")
		integer min_tabs = -1
		iterate i in 0 to lines.length() - 1
			string t = lines[i].trim()
			if t.length() > 0 and t.startsWith("//") == false
				integer tabs = leading_tabs(lines[i])
				if min_tabs == -1 or tabs < min_tabs
					min_tabs = tabs
		string result = ""
		iterate j in 0 to lines.length() - 1
			string line = lines[j]
			string trimmed = line.trim()
			if trimmed.length() > 0 and trimmed.startsWith("//") == false
				integer depth = leading_tabs(line) - min_tabs
				if depth < 0
					depth = 0
				result = result + tabs_indent(depth) + trimmed + "\n"
		return result

	// The body of a LIVE sub-block (`live.onMessage:` / `live.onClose:`): the
	// lines after its label, up to the other sub-block's label.
	string live_section(string region, string label, string other_label)
		integer at = region.indexOf(label)
		if at == -1
			return ""
		integer nl = region.indexOf("\n", at)
		if nl == -1
			return ""
		string rest = region.substring(nl + 1, region.length())
		integer other = rest.indexOf(other_label)
		if other >= 0
			rest = rest.substring(0, other)
		return reindent_block(rest)

// ============================================================================
// SERVER CONFIG HELPERS
// ============================================================================

functions:
	string parse_server_list_field(string raw)
		string val = raw
		if val.startsWith("[")
			val = val.substring(1, val.length())
		if val.endsWith("]")
			val = val.substring(0, val.length() - 1)
		val = val.trim()
		if val.length() == 0
			return ""

		string result = ""
		integer i = 0
		boolean in_str = false
		string current = ""
		while i < val.length()
			string ch = val.substring(i, i + 1)
			if ch == "\""
				in_str = not in_str
			else if ch == "," and not in_str
				string trimmed_current = current.trim()
				if result.length() > 0
					result = result + ","
				result = result + trimmed_current
				current = ""
			else
				current = current + ch
			i = i + 1
		string trimmed_tail = current.trim()
		if trimmed_tail.length() > 0
			if result.length() > 0
				result = result + ","
			result = result + trimmed_tail
		return result

	string resolve_server_config_value(string raw)
		if raw.startsWith("env.get(\"")
			integer env_end = raw.indexOf("\")")
			if env_end != -1
				return "_env_get(\"" + raw.substring(9, env_end) + "\")"
		if raw.startsWith("\"") and raw.endsWith("\"")
			return raw
		return "\"" + raw + "\""

	// ────────────────────────────────────────────────────────────────────────
	// DEV-MODE CAPTURE EMISSION (auto-injected by expand_server_typed)
	// ────────────────────────────────────────────────────────────────────────
	// Emits the pass_criteria selector helpers, the __debug_capture_handler
	// function, and the GET /_debug/capture route registration.
	//
	// The helper bodies have loops and branches, so each is written as a
	// Clean source fragment, parsed with _emit_stmt_from_source, and emitted
	// with a typed signature through _emit_function (emit_dc_helper).
	//
	// Canonical source of the emitted text: plugins/frame.server/dev/*.cln.
	// The strings below MUST match those files verbatim.
	integer emit_dev_capture(integer ctx)
		if emit_dc_helper(ctx, "jsonEscapeString", "s", "string", dc_body_jsonEscapeString()) != 0
			return 1
		if emit_dc_helper(ctx, "buildRuntimeCrash", "entry", "string", dc_body_buildRuntimeCrash()) != 0
			return 1
		if emit_dc_helper(ctx, "buildWrongOutput", "entry,regex", "string", dc_body_buildWrongOutput()) != 0
			return 1
		if emit_dc_helper(ctx, "countJsonArrayEntries", "arr", "integer", dc_body_countJsonArrayEntries()) != 0
			return 1
		if emit_dc_helper(ctx, "findMostRecentFailingStatus", "request_log", "integer", dc_body_findMostRecentFailingStatus()) != 0
			return 1
		if emit_dc_helper(ctx, "logsContainWasmTrap", "logs", "boolean", dc_body_logsContainWasmTrap()) != 0
			return 1
		if emit_dc_helper(ctx, "computePassCriteria", "request_log,logs,wrong_output_hint,entry", "string", dc_body_computePassCriteria()) != 0
			return 1
		if emit_dc_helper(ctx, "mergePassCriteriaIntoSnapshot", "snapshot,pass_criteria_json", "string", dc_body_mergePassCriteriaIntoSnapshot()) != 0
			return 1
		if emit_dc_helper(ctx, "__debug_capture_handler", "", "string", dc_body_handler()) != 0
			return 1

		// Register the route: _http_route("GET", "/_debug/capture", "__debug_capture_handler")
		integer rt_m = _expr_string_lit(ctx, "GET")
		integer rt_p = _expr_string_lit(ctx, "/_debug/capture")
		integer rt_h = _expr_string_lit(ctx, "__debug_capture_handler")
		integer rt_stmt = _stmt_call(ctx, "_http_route", "[" + rt_m.toString() + "," + rt_p.toString() + "," + rt_h.toString() + "]")
		if _emit_statement_into_start(ctx, rt_stmt) != 0
			return 1
		return 0

	// Emit one dev-capture function: string parameters named in params_csv
	// (comma-separated, "" for none), a return type of "string", "integer" or
	// "boolean", and body_src parsed as its body.
	integer emit_dc_helper(integer ctx, string name, string params_csv, string return_kind, string body_src)
		integer body_stmt = _emit_stmt_from_source(ctx, body_src, 0)
		if body_stmt == 0
			_emit_error(ctx, 2, "FRAME-SERVER-E010", "dev-capture: syntax error in " + name, "{\"start\":0,\"end\":0,\"source\":\"dev_capture\"}")
			return 1
		string params = ""
		if params_csv.length() > 0
			list<string> names = params_csv.split(",")
			iterate i in 0 to names.length() - 1
				params = join_handles(params, param_entry(names[i], _type_string(ctx)))
		integer ret_type = 0
		if return_kind == "integer"
			ret_type = _type_integer(ctx)
		else if return_kind == "boolean"
			ret_type = _type_boolean(ctx)
		else
			ret_type = _type_string(ctx)
		return _emit_function(ctx, name, "[" + params + "]", ret_type, _stmt_block(ctx, "[" + body_stmt.toString() + "]"), 2)

	// ── Embedded source bodies (mirror of plugins/frame.server/dev/*.cln) ─
	// Any edit here MUST be mirrored in the canonical dev/*.cln files. The
	// helper bodies below are what _emit_stmt_from_source parses, so they
	// are function *bodies* only — the parameter list is declared separately
	// via _emit_function.

	string dc_body_jsonEscapeString()
		string s = ""
		s = s + "string result = \"\\\"\"\n"
		s = s + "integer i = 0\n"
		s = s + "integer n = s.length()\n"
		s = s + "while i < n\n"
		s = s + "\tstring ch = s.substring(i, i + 1)\n"
		s = s + "\tif ch == \"\\\\\"\n"
		s = s + "\t\tresult = result + \"\\\\\\\\\"\n"
		s = s + "\telse if ch == \"\\\"\"\n"
		s = s + "\t\tresult = result + \"\\\\\\\"\"\n"
		s = s + "\telse if ch == \"\\n\"\n"
		s = s + "\t\tresult = result + \"\\\\n\"\n"
		s = s + "\telse if ch == \"\\r\"\n"
		s = s + "\t\tresult = result + \"\\\\r\"\n"
		s = s + "\telse if ch == \"\\t\"\n"
		s = s + "\t\tresult = result + \"\\\\t\"\n"
		s = s + "\telse\n"
		s = s + "\t\tresult = result + ch\n"
		s = s + "\ti = i + 1\n"
		s = s + "return result + \"\\\"\"\n"
		return s

	string dc_body_buildRuntimeCrash()
		return "return \"{\\\"kind\\\":\\\"runtime_crash\\\",\\\"entry\\\":\\\"\" + entry + \"\\\",\\\"expected_status\\\":200}\"\n"

	string dc_body_buildWrongOutput()
		return "return \"{\\\"kind\\\":\\\"wrong_output\\\",\\\"entry\\\":\\\"\" + entry + \"\\\",\\\"expected_stdout_regex\\\":\" + jsonEscapeString(regex) + \"}\"\n"

	string dc_body_countJsonArrayEntries()
		// The fragment parser used by _emit_stmt_from_source folds a statement
		// following an `if X return Y` inside a while body into the then-branch,
		// producing an infinite loop. Explicit else-branch avoids the fold.
		string s = ""
		s = s + "integer i = 0\n"
		s = s + "while i < 200\n"
		s = s + "\tstring idx = i.toString()\n"
		s = s + "\tstring probe = _json_get(arr, idx + \".status\")\n"
		s = s + "\tif probe.length() == 0\n"
		s = s + "\t\treturn i\n"
		s = s + "\telse\n"
		s = s + "\t\ti = i + 1\n"
		s = s + "return 200\n"
		return s

	string dc_body_findMostRecentFailingStatus()
		// See dc_body_countJsonArrayEntries: `if return / fall-through` inside a
		// while body must be rewritten with an explicit else to avoid the
		// fragment-parser fold that produces infinite loops.
		string s = ""
		s = s + "if request_log.length() == 0\n"
		s = s + "\treturn 0\n"
		s = s + "integer count = countJsonArrayEntries(request_log)\n"
		s = s + "if count == 0\n"
		s = s + "\treturn 0\n"
		s = s + "integer i = count - 1\n"
		s = s + "while i >= 0\n"
		s = s + "\tstring idx = i.toString()\n"
		s = s + "\tstring status_str = _json_get(request_log, idx + \".status\")\n"
		s = s + "\tinteger status = status_str.toInteger() onError 0\n"
		s = s + "\tif status >= 500\n"
		s = s + "\t\treturn status\n"
		s = s + "\telse\n"
		s = s + "\t\ti = i - 1\n"
		s = s + "return 0\n"
		return s

	string dc_body_logsContainWasmTrap()
		string s = ""
		s = s + "if logs.contains(\"wasm trap\")\n"
		s = s + "\treturn true\n"
		s = s + "if logs.contains(\"Handler \") and logs.contains(\" failed:\")\n"
		s = s + "\treturn true\n"
		s = s + "return false\n"
		return s

	string dc_body_computePassCriteria()
		string s = ""
		s = s + "if wrong_output_hint.length() > 0\n"
		s = s + "\treturn buildWrongOutput(entry, wrong_output_hint)\n"
		s = s + "if logsContainWasmTrap(logs)\n"
		s = s + "\treturn buildRuntimeCrash(entry)\n"
		s = s + "integer failing_status = findMostRecentFailingStatus(request_log)\n"
		s = s + "if failing_status >= 500\n"
		s = s + "\treturn buildRuntimeCrash(entry)\n"
		s = s + "return \"\"\n"
		return s

	string dc_body_mergePassCriteriaIntoSnapshot()
		string s = ""
		s = s + "if snapshot.length() < 2\n"
		s = s + "\treturn snapshot\n"
		s = s + "string first = snapshot.substring(0, 1)\n"
		s = s + "if first != \"{\"\n"
		s = s + "\treturn snapshot\n"
		s = s + "string rest = snapshot.substring(1, snapshot.length())\n"
		s = s + "return \"{\\\"pass_criteria\\\":\" + pass_criteria_json + \",\" + rest\n"
		return s

	string dc_body_handler()
		string s = ""
		s = s + "string dev_flag = env.get(\"CLEAN_DEV\")\n"
		s = s + "if dev_flag != \"1\"\n"
		s = s + "\treturn http.respond(404, \"text/plain\", \"\")\n"
		s = s + "string snapshot = _dev_snapshot()\n"
		s = s + "if snapshot.length() == 0\n"
		s = s + "\treturn http.respond(404, \"text/plain\", \"\")\n"
		s = s + "string hint = req.query(\"wrong_output_hint\")\n"
		s = s + "string request_log = _json_get(snapshot, \"request_log\")\n"
		s = s + "string logs = _json_get(snapshot, \"last_log_lines\")\n"
		s = s + "string entry = \"app/server/main.cln\"\n"
		s = s + "string pc = computePassCriteria(request_log, logs, hint, entry)\n"
		s = s + "string body = snapshot\n"
		s = s + "if pc.length() > 0\n"
		s = s + "\tbody = mergePassCriteriaIntoSnapshot(snapshot, pc)\n"
		s = s + "return http.respond(200, \"application/json\", body)\n"
		return s

// ============================================================================
// VALIDATION (called from expand_block_typed and the validate export)
// ============================================================================

functions:
	string validate_endpoints(string body)
		if body.trim().length() == 0
			return "endpoints: block is empty"

		list<string> lines = body.split("\n")
		iterate li in 0 to lines.length() - 1
			string trimmed = lines[li].trim()
			if trimmed.length() == 0
				continue
			if route_method_at(trimmed, 0).length() == 0
				continue

			integer last_colon = trimmed.lastIndexOf(":")
			if last_colon == -1
				return "endpoints: route declaration must end with ':'"

			string header = trimmed.substring(0, last_colon).trim()

			integer open_q = header.indexOf("\"")
			if open_q == -1
				return "endpoints: route path must be a quoted string"
			string after_open = header.substring(open_q + 1, header.length())
			integer close_q = after_open.indexOf("\"")
			if close_q == -1
				return "endpoints: route path must be a quoted string"
			string modifiers = after_open.substring(close_q + 1, after_open.length()).trim()

			integer open_b = modifiers.indexOf("[")
			if open_b != -1
				integer close_b = modifiers.indexOf("]")
				if close_b == -1
					return "endpoints: guard role list must be closed with ]"
				integer cache_pos = modifiers.indexOf("cache(")
				integer mw_pos = modifiers.indexOf("middleware(")
				if cache_pos != -1 and cache_pos < open_b
					return "endpoints: [guard] must appear before cache()"
				if mw_pos != -1 and mw_pos < open_b
					return "endpoints: [guard] must appear before middleware()"
				string roles_raw = modifiers.substring(open_b + 1, close_b).replace(" ", "").replace(",", "")
				integer ri = 0
				while ri < roles_raw.length()
					string ch = roles_raw.substring(ri, ri + 1)
					boolean ok = (ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z") or (ch >= "0" and ch <= "9") or ch == "_"
					if not ok
						return "endpoints: guard role names must be valid identifiers (letters, digits, underscore)"
					ri = ri + 1

			integer cache_p = modifiers.indexOf("cache(")
			if cache_p != -1
				string after_cache = modifiers.substring(cache_p + 6, modifiers.length())
				integer close_p = after_cache.indexOf(")")
				if close_p == -1
					return "endpoints: cache() must be closed with )"
				string arg = after_cache.substring(0, close_p).trim()
				if arg.length() == 0
					return "endpoints: cache() requires a value — use an integer (seconds) or \"5m\"/\"2h\"/\"1d\"/\"no-store\""
				boolean cache_ok = false
				if arg.startsWith("\"") and arg.endsWith("\"")
					string val = arg.substring(1, arg.length() - 1)
					if val == "no-store" or val == "no-cache" or val == "public" or val == "private"
						cache_ok = true
					if not cache_ok and val.length() >= 2
						string last = val.substring(val.length() - 1, val.length())
						if (last == "m" or last == "h" or last == "d") and all_digits(val.substring(0, val.length() - 1))
							cache_ok = true
				if not arg.startsWith("\"") and all_digits(arg)
					cache_ok = true
				if not cache_ok
					return "endpoints: invalid cache() value — use integer seconds, or \"no-store\"/\"no-cache\"/\"public\"/\"private\"/\"5m\"/\"2h\"/\"1d\""

			integer mw_p = modifiers.indexOf("middleware(")
			if mw_p != -1
				string after_mw = modifiers.substring(mw_p + 11, modifiers.length())
				integer close_p = after_mw.indexOf(")")
				if close_p == -1
					return "endpoints: middleware() must be closed with )"
				string names = after_mw.substring(0, close_p).replace(" ", "")
				if names.length() == 0
					return "endpoints: middleware() requires at least one function name"
				string name_check = names.replace(",", "")
				integer mi = 0
				while mi < name_check.length()
					string ch = name_check.substring(mi, mi + 1)
					boolean ok = (ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z") or (ch >= "0" and ch <= "9") or ch == "_"
					if not ok
						return "endpoints: middleware function names must be valid identifiers"
					mi = mi + 1

		return ""

	string validate_routes(string body)
		if body.trim().length() == 0
			return "routes: block is empty"

		list<string> lines = body.split("\n")
		iterate li in 0 to lines.length() - 1
			string trimmed = lines[li].trim()
			if trimmed.length() == 0
				continue
			if trimmed.startsWith("error:")
				continue
			if trimmed.startsWith("guard:")
				continue

			if trimmed.startsWith("redirect:")
				string after = trimmed.substring(9, trimmed.length()).trim()
				if after.indexOf("\"") == -1
					return "routes: redirect: directive must specify a quoted from-path"
				if after.indexOf("->") == -1 and after.indexOf("→") == -1
					return "routes: redirect: directive must use the '→' (or '->') separator: redirect: \"/from\" → \"/to\""

		return ""

	// True when s is a non-empty run of decimal digits.
	boolean all_digits(string s)
		if s.length() == 0
			return false
		integer i = 0
		while i < s.length()
			string ch = s.substring(i, i + 1)
			if ch < "0" or ch > "9"
				return false
			i = i + 1
		return true
