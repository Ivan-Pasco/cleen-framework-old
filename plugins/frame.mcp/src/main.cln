// frame.mcp plugin - MCP Server DSL
// Version: 2.0.1
// ABI: Plugin Contracts v3 — typed AST emission (typed-emission.md)
//
// Expands one `mcp "name":` block into:
//   - response helpers callable from handler bodies: mcpJson(value),
//     mcpText(message), mcpError(message, code = "")
//   - one handler function per tool / resource / prompt
//   - the JSON-RPC 2.0 dispatcher __mcp_handle(message) -> response
//     ("" for notifications, which get no response)
//   - the transport loop (stdio or HTTP) in the program start slot
//
// Generated helpers and dispatchers are composed as Clean source and passed
// through _emit_stmt_from_source + _batch_func2 (typed-emission.md §3.11,
// Amendment 12). JSON is parsed at runtime with the json.* builtins, so
// request ids, nested arguments and escaped strings are handled by a real
// JSON parser rather than substring scanning.
//
// Spec: foundation/docs/framework/plugins/mcp.md,
//       foundation/spec/framework/grammar/frame-mcp.ebnf,
//       foundation/spec/framework/frame-mcp-semantics.md

// ============================================================================
// TYPED-EMISSION BRIDGE DECLARATIONS
// ============================================================================
// Env imports from the compiler's typed-emission sandbox — they MUST NOT
// appear in plugin.toml [bridge].functions.

external:
	integer _batch_arrayNew(integer ctx)
	integer _batch_arrayPush(integer ctx, integer array_handle, integer item_handle)
	integer _batch_param(integer ctx, string name, string type_name)
	integer _batch_func2(integer ctx, string name, integer params_array_handle, string return_type, integer body_array_handle_or_0, integer from_source_handle_or_0)
	integer _batch_spec(integer ctx, integer functions_array_handle)
	integer _emit_helpers_batch(integer ctx, integer spec_handle_or_lp, integer flags)
	integer _emit_function(integer ctx, string name, string params_json, integer return_type, integer body_stmt, integer flags)
	integer _type_string(integer ctx)
	integer _emit_expr_from_source(integer ctx, string source, integer origin_offset)
	integer _emit_stmt_from_source(integer ctx, string source, integer origin_offset)
	integer _emit_statement_into_start(integer ctx, integer stmt_handle)
	integer _ctx_had_error(integer ctx)
	integer _ctx_set_error_context(integer ctx, string code, string message)
	integer _emit_error(integer ctx, integer severity, string code, string message, string span)

// ============================================================================
// V3 LIFECYCLE SLOTS
// ============================================================================
// typed-emission.md §7. frame.mcp emits everything from expand_block_typed;
// the module and server slots have nothing to contribute.

functions:
	integer emit_module_helpers_typed(integer ctx, string ctx_json)
		return 0

	integer emit_server_init_typed(integer ctx, string ctx_json)
		return 0

// ============================================================================
// PLUGIN EXPORTS
// ============================================================================

functions:
	integer expand_block_typed(integer ctx, string block_name, string attrs_json, string body)
		if block_name == "mcp"
			return expand_mcp_typed(ctx, attrs_json, body)
		return 0

	string validate_block(string block_name, string attributes, string body)
		if block_name == "mcp"
			return validate_mcp(attributes, body)
		return ""

	string get_keywords()
		return "[\"mcp\", \"tool\", \"resource\", \"prompt\", \"params\", \"args\", \"transport\", \"apiKey\", \"mimeType\", \"version\", \"description\", \"port\", \"host\", \"mcpJson\", \"mcpText\", \"mcpError\"]"

// ============================================================================
// SOURCE COMPOSITION HELPERS
// ============================================================================
// Generated code is written as templates where ' marks a Clean string
// delimiter and ~ marks an escaped quote inside a generated string literal:
//   tpl("return '{~a~:1}'")  ->  return "{\"a\":1}"

functions:
	string tpl(string s)
		string r = s.replace("~", "\\\"")
		return r.replace("'", "\"")

	// Clean string literal (with quotes) whose runtime value is exactly s.
	// Braces are escaped so no {expr} interpolation can occur.
	string clit(string s)
		string r = s.replace("\\", "\\\\")
		r = r.replace("\"", "\\\"")
		r = r.replace("\n", "\\n")
		r = r.replace("\r", "\\r")
		r = r.replace("\t", "\\t")
		r = r.replace("{", "\\{")
		r = r.replace("}", "\\}")
		return "\"" + r + "\""

	// JSON string literal (with quotes) for s.
	string jstr(string s)
		string r = s.replace("\\", "\\\\")
		r = r.replace("\"", "\\\"")
		r = r.replace("\n", "\\n")
		r = r.replace("\r", "\\r")
		r = r.replace("\t", "\\t")
		return "\"" + r + "\""

	// Emit one generated function from Clean source. params is a batch param
	// array. Returns 0 on success, 1 on failure (diagnostic already emitted).
	integer emit_src_function(integer ctx, string name, integer params, string return_type, string source)
		integer body_h = _emit_stmt_from_source(ctx, source, 0)
		if body_h == 0
			_emit_error(ctx, 2, "FRAME-MCP-E002", "frame.mcp: generated function " + name + " failed to parse", "{\"start\":0,\"end\":0,\"source\":\"plugin\"}")
			return 1
		integer fns = _batch_arrayNew(ctx)
		_batch_arrayPush(ctx, fns, _batch_func2(ctx, name, params, return_type, 0, body_h))
		_emit_helpers_batch(ctx, _batch_spec(ctx, fns), 2)
		if _ctx_had_error(ctx) != 0
			return 1
		return 0

	integer p0(integer ctx)
		return _batch_arrayNew(ctx)

	integer p1(integer ctx, string n1, string t1)
		integer a = _batch_arrayNew(ctx)
		_batch_arrayPush(ctx, a, _batch_param(ctx, n1, t1))
		return a

	integer p2(integer ctx, string n1, string t1, string n2, string t2)
		integer a = p1(ctx, n1, t1)
		_batch_arrayPush(ctx, a, _batch_param(ctx, n2, t2))
		return a

	integer p3(integer ctx, string n1, string t1, string n2, string t2, string n3, string t3)
		integer a = p2(ctx, n1, t1, n2, t2)
		_batch_arrayPush(ctx, a, _batch_param(ctx, n3, t3))
		return a

	integer p4(integer ctx, string n1, string t1, string n2, string t2, string n3, string t3, string n4, string t4)
		integer a = p3(ctx, n1, t1, n2, t2, n3, t3)
		_batch_arrayPush(ctx, a, _batch_param(ctx, n4, t4))
		return a

	// Prefix every line of src with one tab (nest it under an if/while).
	string indent1(string src)
		string out = ""
		integer scan = 0
		while scan < src.length()
			integer nl = src.indexOf("\n", scan)
			if nl < 0
				nl = src.length()
			string line = src.substring(scan, nl)
			if line.length() > 0
				out = out + "\t" + line + "\n"
			scan = nl + 1
		return out

// ============================================================================
// DSL PARSING
// ============================================================================
// The compiler hands over the block body dedented to column 0. The parser
// works on a normalized copy in which mcp: members sit at one tab:
// primitive headers `\ttool "name":`, primitive members at two tabs,
// params/args declarations at three.

functions:
	// The line starting at offset `at`, without its newline.
	string line_at(string text, integer at)
		integer nl = text.indexOf("\n", at)
		if nl < 0
			return text.substring(at, text.length())
		return text.substring(at, nl)

	integer next_line(string text, integer at)
		integer nl = text.indexOf("\n", at)
		if nl < 0
			return text.length()
		return nl + 1

	// Number of leading tabs.
	integer tabs(string line)
		integer n = 0
		while n < line.length() and line.substring(n, n + 1) == "\t"
			n = n + 1
		return n

	// Every line of text (newline-terminated) indented one more tab.
	string indent_lines(string text)
		string out = ""
		integer pos = 0
		while pos < text.length()
			out = out + "\t" + line_at(text, pos) + "\n"
			pos = next_line(text, pos)
		return out

	boolean is_blank_or_comment(string line)
		string t = line.trim()
		return t == "" or t.startsWith("//")

	// Primitive kind for a one-tab header line: tool, resource, prompt, or "".
	string primitive_kind(string line)
		if tabs(line) != 1
			return ""
		string t = line.trim()
		if t.startsWith("tool \"")
			return "tool"
		if t.startsWith("resource \"")
			return "resource"
		if t.startsWith("prompt \"")
			return "prompt"
		return ""

	string first_quoted(string s)
		integer open_q = s.indexOf("\"")
		if open_q < 0
			return ""
		integer close_q = s.indexOf("\"", open_q + 1)
		if close_q < 0
			return ""
		return s.substring(open_q + 1, close_q)

	// Value of a `key: value` member; quoted values are unquoted and their
	// \" \\ \n escapes resolved.
	string member_value(string trimmed, string key)
		string v = trimmed.substring(key.length() + 1, trimmed.length()).trim()
		if v.length() >= 2 and v.startsWith("\"") and v.endsWith("\"")
			v = v.substring(1, v.length() - 1)
			v = v.replace("\\\\", "\0")
			v = v.replace("\\\"", "\"")
			v = v.replace("\\n", "\n")
			v = v.replace("\0", "\\")
		return v

	// Re-indent the body so its least-indented lines sit at one tab.
	string normalize_body(string body)
		integer min_tabs = 99
		integer pos = 0
		while pos < body.length()
			string line = line_at(body, pos)
			if line.trim() != "" and tabs(line) < min_tabs
				min_tabs = tabs(line)
			pos = next_line(body, pos)
		if min_tabs == 1 or min_tabs == 99
			return body
		string out = ""
		pos = 0
		while pos < body.length()
			string line = line_at(body, pos)
			if line.trim() == ""
				out = out + "\n"
			else
				out = out + "\t" + line.substring(min_tabs, line.length()) + "\n"
			pos = next_line(body, pos)
		return out

	// Server name from the block attributes. The compiler passes them as
	// JSON ({"model_name":"blog-tools"}); a raw `"blog-tools"` is accepted too.
	string extract_server_name(string attributes)
		string key = "\"model_name\":\""
		integer k = attributes.indexOf(key)
		if k >= 0
			integer close_q = attributes.indexOf("\"", k + key.length())
			if close_q < 0
				return ""
			return attributes.substring(k + key.length(), close_q)
		return first_quoted(attributes)

	// Config section = one-tab lines before the first primitive header,
	// including the two-tab lines of a nested `transport: http:` block.
	string config_section(string body)
		string out = ""
		integer pos = 0
		while pos < body.length()
			string line = line_at(body, pos)
			if primitive_kind(line) != ""
				return out
			out = out + line + "\n"
			pos = next_line(body, pos)
		return out

	// One-tab config value (`version`, `description`, `transport`, `apiKey`).
	string config_value(string body, string key)
		string cfg = config_section(body)
		integer pos = 0
		while pos < cfg.length()
			string line = line_at(cfg, pos)
			if tabs(line) == 1
				string t = line.trim()
				if t.startsWith(key + ":")
					return member_value(t, key)
			pos = next_line(cfg, pos)
		return ""

	// One-tab config value as written in the source (no unquoting) — the
	// apiKey: expression is spliced into generated code verbatim.
	string config_expr(string body, string key)
		string cfg = config_section(body)
		integer pos = 0
		while pos < cfg.length()
			string line = line_at(cfg, pos)
			if tabs(line) == 1
				string t = line.trim()
				if t.startsWith(key + ":")
					return t.substring(key.length() + 1, t.length()).trim()
			pos = next_line(cfg, pos)
		return ""

	boolean has_config(string body, string key)
		string cfg = config_section(body)
		integer pos = 0
		while pos < cfg.length()
			string line = line_at(cfg, pos)
			if tabs(line) == 1 and line.trim().startsWith(key + ":")
				return true
			pos = next_line(cfg, pos)
		return false

	// "stdio" or "http" (stdio when transport: is omitted — MCP-D001).
	string transport_kind(string body)
		string v = config_value(body, "transport")
		if v.startsWith("http")
			return "http"
		if v == "" or v == "stdio"
			return "stdio"
		return "invalid:" + v

	// port / host under `transport: http:`.
	string http_attr(string body, string key)
		string cfg = config_section(body)
		integer pos = 0
		boolean in_http = false
		while pos < cfg.length()
			string line = line_at(cfg, pos)
			integer n = tabs(line)
			string t = line.trim()
			if n == 1
				in_http = t.startsWith("transport:") and t.indexOf("http") > 0
			else if in_http and n >= 2 and t.startsWith(key + ":")
				return member_value(t, key)
			pos = next_line(cfg, pos)
		return ""

	// Text of every primitive block as records terminated by "\0;" with
	// fields separated by "\0,":  kind, name, block_text
	// block_text holds the lines under the header (two tabs and deeper).
	string collect_primitives(string body)
		string out = ""
		integer pos = 0
		while pos < body.length()
			string line = line_at(body, pos)
			string kind = primitive_kind(line)
			pos = next_line(body, pos)
			if kind != ""
				string name = first_quoted(line)
				string block = ""
				boolean going = true
				while going and pos < body.length()
					string bl = line_at(body, pos)
					if bl.trim() != "" and tabs(bl) < 2
						going = false
					else
						block = block + bl + "\n"
						pos = next_line(body, pos)
				out = out + kind + "\0," + name + "\0," + block + "\0;"
		return out

	string record_field(string record, integer index)
		integer at = 0
		integer i = 0
		while i < index
			at = record.indexOf("\0,", at) + 2
			i = i + 1
		integer stop = record.indexOf("\0,", at)
		if stop < 0 or index == 2
			return record.substring(at, record.length())
		return record.substring(at, stop)

	// Header member of a primitive block (`description`, `mimeType`).
	string block_member(string block, string key)
		string head = block_header(block)
		integer pos = 0
		while pos < head.length()
			string line = line_at(head, pos)
			string t = line.trim()
			if tabs(line) == 2 and t.startsWith(key + ":")
				return member_value(t, key)
			pos = next_line(head, pos)
		return ""

	boolean header_line(string line, boolean in_decls)
		if is_blank_or_comment(line)
			return true
		integer n = tabs(line)
		string t = line.trim()
		if n >= 3 and in_decls
			return true
		if n != 2
			return false
		return t.startsWith("description:") or t.startsWith("mimeType:") or t == "params:" or t == "args:"

	// Header lines of a primitive block: description, mimeType, params/args
	// declarations. Everything after the first other line is handler body.
	string block_header(string block)
		string out = ""
		integer pos = 0
		boolean in_decls = false
		while pos < block.length()
			string line = line_at(block, pos)
			if not header_line(line, in_decls)
				return out
			string t = line.trim()
			if tabs(line) == 2 and t != ""
				in_decls = t == "params:" or t == "args:"
			out = out + line + "\n"
			pos = next_line(block, pos)
		return out

	// Handler body: the block minus its header, dedented to column 0.
	string block_handler(string block)
		string head = block_header(block)
		string rest = block.substring(head.length(), block.length())
		string out = ""
		integer pos = 0
		while pos < rest.length()
			string line = line_at(rest, pos)
			integer strip = tabs(line)
			if strip > 2
				strip = 2
			if line.trim() != ""
				out = out + line.substring(strip, line.length()) + "\n"
			pos = next_line(rest, pos)
		return out

	// Which declaration section the block uses: "params", "args", or "".
	string decl_keyword(string block)
		string head = block_header(block)
		if head.indexOf("\n\t\tparams:\n") >= 0 or head.startsWith("\t\tparams:\n")
			return "params"
		if head.indexOf("\n\t\targs:\n") >= 0 or head.startsWith("\t\targs:\n")
			return "args"
		return ""

	// The declaration lines of the params:/args: section, trimmed.
	string block_decl_lines(string block)
		string head = block_header(block)
		string out = ""
		integer pos = 0
		boolean in_decls = false
		while pos < head.length()
			string line = line_at(head, pos)
			string t = line.trim()
			if tabs(line) == 2 and t != ""
				in_decls = t == "params:" or t == "args:"
			else if in_decls and tabs(line) >= 3 and not is_blank_or_comment(line)
				out = out + t + "\n"
			pos = next_line(head, pos)
		return out

	// Declarations as lines `name\0type\0has_default\0default_src`, each
	// written `type name [= default]` (frame-mcp.ebnf param_decl).
	string block_decls(string block)
		string lines = block_decl_lines(block)
		string out = ""
		integer pos = 0
		while pos < lines.length()
			string t = line_at(lines, pos)
			if t != ""
				out = out + parse_decl(t) + "\n"
			pos = next_line(lines, pos)
		return out

	// The part of a declaration before its ` = default`.
	string decl_lhs(string decl)
		integer eq = decl.indexOf(" = ")
		if eq >= 0
			return decl.substring(0, eq).trim()
		return decl

	string parse_decl(string decl)
		string lhs = decl_lhs(decl)
		string def_src = ""
		string has_def = "0"
		integer eq = decl.indexOf(" = ")
		if eq >= 0
			def_src = decl.substring(eq + 3, decl.length()).trim()
			has_def = "1"
		string name = lhs
		string typ = ""
		integer sp = lhs.lastIndexOf(" ")
		if sp > 0
			typ = lhs.substring(0, sp).trim()
			name = lhs.substring(sp + 1, lhs.length()).trim()
		return name + "\0" + typ + "\0" + has_def + "\0" + def_src

	// "" when `decl` is not written `name: type`; otherwise the error that
	// shows the `type name` form to use instead.
	string colon_decl_error(string label, string kw, string decl)
		string lhs = decl_lhs(decl)
		integer colon = lhs.indexOf(":")
		if colon < 0
			return ""
		string name = lhs.substring(0, colon).trim()
		string typ = lhs.substring(colon + 1, lhs.length()).trim()
		string fixed = typ + " " + name
		integer eq = decl.indexOf(" = ")
		if eq >= 0
			fixed = fixed + decl.substring(eq, decl.length())
		return label + " declares `" + decl + "` in " + kw + ": — write the type first, as everywhere in Clean: `" + fixed + "` (frame-mcp.ebnf param_decl)"

	string decl_field(string decl, integer index)
		return record_field_n(decl, index, 4)

	// Field `index` of a \0-separated record with `count` fields; the last
	// field runs to the end of the record.
	string record_field_n(string record, integer index, integer count)
		integer at = 0
		integer i = 0
		while i < index
			at = record.indexOf("\0", at) + 1
			i = i + 1
		integer stop = record.indexOf("\0", at)
		if stop < 0 or index == count - 1
			return record.substring(at, record.length())
		return record.substring(at, stop)

	boolean is_identifier(string s)
		if s.length() == 0
			return false
		integer i = 0
		while i < s.length()
			string ch = s.substring(i, i + 1)
			boolean letter = (ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z") or ch == "_"
			boolean digit = ch >= "0" and ch <= "9"
			if not letter and not (digit and i > 0)
				return false
			i = i + 1
		return true

	// An identifier segment for a primitive name, one to one: letters and
	// digits stay, every other allowed character becomes `_` plus a letter
	// naming it (`-` -> `_d`, `_` -> `_u`, `.` -> `_p`, `/` -> `_s`, ...), so
	// "get-user" and "get_user" get different handlers. "!" when the name
	// has a character outside the table.
	string sanitize_name(string name)
		string specials = name_specials()
		string codes = "sdputxrnqbkalmiecgfowyzhv"
		string result = ""
		integer i = 0
		while i < name.length()
			string ch = name.substring(i, i + 1)
			boolean is_ok = (ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z") or (ch >= "0" and ch <= "9")
			if is_ok
				result = result + ch
			else
				integer k = specials.indexOf(ch)
				if k == -1
					return "!"
				result = result + "_" + codes.substring(k, k + 1)
			i = i + 1
		return result

	// The non-alphanumeric characters a tool/resource/prompt name may use.
	string name_specials()
		return "/-._~!$&'()*+,;=:@%{}[]?#"

// ============================================================================
// HANDLER BODY REWRITE
// ============================================================================
// `params.x` (tools, MCP-T002) and `args.x` (prompts, MCP-P004) become the
// generated locals `__param_x` / `__arg_x`. Rewriting applies to code and to
// {expr} interpolations inside string literals; plain string text is left
// alone. In prompt bodies `{{ expr }}` (MCP-P003) becomes the core `{expr}`
// interpolation.
//
// `mcpJson(value)` becomes `mcpJson(json.encode(value))` so the value is
// serialized where its static type is known; json.encode through an `any`
// parameter loses class layouts (models would serialize wrongly).

functions:
	boolean ident_char(string ch)
		return (ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z") or (ch >= "0" and ch <= "9") or ch == "_"

	string rewrite_body(string src, string accessor, string local_prefix, boolean prompt_templates)
		string out = ""
		string pat = accessor + "."
		boolean in_str = false
		integer depth = 0
		integer parens = 0
		string wraps = ","
		integer i = 0
		integer n = src.length()
		while i < n
			string ch = src.substring(i, i + 1)
			boolean code = not in_str or depth > 0
			boolean at_word = i == 0 or not ident_char(src.substring(i - 1, i))
			if in_str and depth == 0 and ch == "\\" and i + 1 < n
				out = out + src.substring(i, i + 2)
				i = i + 2
			else if in_str and prompt_templates and depth == 0 and src.substring(i, i + 2) == "{{"
				integer close = src.indexOf("}}", i + 2)
				if close < 0
					out = out + ch
					i = i + 1
				else
					string inner = src.substring(i + 2, close).trim()
					out = out + "{" + rewrite_body(inner, accessor, local_prefix, false) + "}"
					i = close + 2
			else if ch == "\""
				if depth == 0
					in_str = not in_str
				out = out + ch
				i = i + 1
			else if in_str and ch == "{"
				depth = depth + 1
				out = out + ch
				i = i + 1
			else if in_str and depth > 0 and ch == "}"
				depth = depth - 1
				out = out + ch
				i = i + 1
			else if code and src.substring(i, i + pat.length()) == pat and at_word
				out = out + local_prefix
				i = i + pat.length()
			else if not in_str and src.substring(i, i + 8) == "mcpJson(" and at_word
				out = out + "mcpJson(json.encode("
				wraps = wraps + parens.toString() + ","
				parens = parens + 1
				i = i + 8
			else if not in_str and ch == "("
				parens = parens + 1
				out = out + ch
				i = i + 1
			else if not in_str and ch == ")"
				parens = parens - 1
				out = out + ch
				string mark = "," + parens.toString() + ","
				if wraps.endsWith(mark)
					out = out + ")"
					wraps = wraps.substring(0, wraps.length() - mark.length() + 1)
				i = i + 1
			else
				out = out + ch
				i = i + 1
		return out

// ============================================================================
// JSON SCHEMA / LIST ENTRIES
// ============================================================================

functions:
	string type_to_json_schema(string clean_type)
		if clean_type == "string"
			return "{\"type\":\"string\"}"
		if clean_type == "integer"
			return "{\"type\":\"integer\"}"
		if clean_type == "number"
			return "{\"type\":\"number\"}"
		if clean_type == "boolean"
			return "{\"type\":\"boolean\"}"
		if clean_type == "any"
			return "{}"
		if clean_type == "list<string>"
			return "{\"type\":\"array\",\"items\":{\"type\":\"string\"}}"
		if clean_type == "list<integer>"
			return "{\"type\":\"array\",\"items\":{\"type\":\"integer\"}}"
		if clean_type == "list<number>"
			return "{\"type\":\"array\",\"items\":{\"type\":\"number\"}}"
		if clean_type == "list<boolean>"
			return "{\"type\":\"array\",\"items\":{\"type\":\"boolean\"}}"
		if clean_type.startsWith("list<")
			return "{\"type\":\"array\"}"
		return "{\"type\":\"object\"}"

	string build_input_schema(string decls)
		string props = ""
		string required = ""
		integer pos = 0
		while pos < decls.length()
			string d = line_at(decls, pos)
			if d != ""
				string name = decl_field(d, 0)
				if props != ""
					props = props + ","
				props = props + jstr(name) + ":" + type_to_json_schema(decl_field(d, 1))
				if decl_field(d, 2) == "0"
					if required != ""
						required = required + ","
					required = required + jstr(name)
			pos = next_line(decls, pos)
		string schema = "{\"type\":\"object\",\"properties\":{" + props + "}"
		if required != ""
			schema = schema + ",\"required\":[" + required + "]"
		return schema + "}"

	string build_prompt_arguments(string decls)
		string entries = ""
		integer pos = 0
		while pos < decls.length()
			string d = line_at(decls, pos)
			if d != ""
				string req = "true"
				if decl_field(d, 2) == "1"
					req = "false"
				if entries != ""
					entries = entries + ","
				entries = entries + "{\"name\":" + jstr(decl_field(d, 0)) + ",\"required\":" + req + "}"
			pos = next_line(decls, pos)
		return "[" + entries + "]"

	string build_capabilities_json(integer tool_count, integer resource_count, integer prompt_count)
		string caps = ""
		if tool_count > 0
			caps = "\"tools\":{\"listChanged\":false}"
		if resource_count > 0
			if caps != ""
				caps = caps + ","
			caps = caps + "\"resources\":{\"subscribe\":false,\"listChanged\":false}"
		if prompt_count > 0
			if caps != ""
				caps = caps + ","
			caps = caps + "\"prompts\":{\"listChanged\":false}"
		return "{" + caps + "}"

	// MCP-D003: explicit mimeType wins; otherwise mcpText() bodies are
	// text/plain and everything else application/json.
	string resource_mime(string block)
		string declared = block_member(block, "mimeType")
		if declared != ""
			return declared
		string handler = block_handler(block)
		if handler.indexOf("mcpText(") >= 0 and handler.indexOf("mcpJson(") < 0
			return "text/plain"
		return "application/json"

// ============================================================================
// GENERATED RUNTIME HELPERS
// ============================================================================

functions:
	integer emit_runtime_helpers(integer ctx)
		// mcpJson(value) — value serialized to compact JSON, carried as the
		// text of an MCP text content block (mcp.md §10). Handler bodies are
		// rewritten to pass json.encode(value) (see rewrite_body).
		string src = tpl("return '{~type~:~text~,~text~:' + json.encode(encoded) + '}'\n")
		if emit_src_function(ctx, "mcpJson", p1(ctx, "encoded", "string"), "string", src) != 0
			return 1

		src = tpl("return '{~type~:~text~,~text~:' + json.encode(message) + '}'\n")
		if emit_src_function(ctx, "mcpText", p1(ctx, "message", "string"), "string", src) != 0
			return 1

		// mcpError(message, code = "") — isError tool result. A code is
		// carried in _meta.errorCode (mcp.md §10).
		src = tpl("string __result = '{~isError~:true,~content~:[{~type~:~text~,~text~:' + json.encode(message) + '}]'\nif code != ''\n\t__result = __result + ',~_meta~:{~errorCode~:' + json.encode(code) + '}'\nreturn __result + '}'\n")
		integer body_h = _emit_stmt_from_source(ctx, src, 0)
		integer str_t1 = _type_string(ctx)
		integer str_t2 = _type_string(ctx)
		integer str_t3 = _type_string(ctx)
		integer def_h = _emit_expr_from_source(ctx, "\"\"", 0)
		if body_h == 0 or def_h == 0
			return plugin_error(ctx, "FRAME-MCP-E002", "frame.mcp: mcpError helper failed to build")
		string params_json = "[{\"name\":\"message\",\"type_handle\":" + str_t1.toString() + "},{\"name\":\"code\",\"type_handle\":" + str_t2.toString() + ",\"default_expr_handle\":" + def_h.toString() + "}]"
		if _emit_function(ctx, "mcpError", params_json, str_t3, body_h, 2) != 0
			return plugin_error(ctx, "FRAME-MCP-E002", "frame.mcp: mcpError helper failed to emit")

		src = tpl("return result.startsWith('{~isError~:true')\n")
		if emit_src_function(ctx, "__mcp_is_error", p1(ctx, "result", "string"), "boolean", src) != 0
			return 1

		src = tpl("return '{~jsonrpc~:~2.0~,~id~:' + id + ',~result~:' + result + '}'\n")
		if emit_src_function(ctx, "__mcp_ok", p2(ctx, "id", "string", "result", "string"), "string", src) != 0
			return 1

		src = tpl("return '{~jsonrpc~:~2.0~,~id~:' + id + ',~error~:{~code~:' + code.toString() + ',~message~:' + json.encode(message) + '}}'\n")
		if emit_src_function(ctx, "__mcp_err", p3(ctx, "id", "string", "code", "integer", "message", "string"), "string", src) != 0
			return 1

		// Message text of an mcpError() result.
		src = tpl("string __text = json.get(result, 'content.0.text')\nreturn __text\n")
		if emit_src_function(ctx, "__mcp_error_text", p1(ctx, "result", "string"), "string", src) != 0
			return 1

		// JSON text of a value: "null" when absent.
		src = tpl("any __value = json.get(data, key)\nreturn json.encode(__value)\n")
		if emit_src_function(ctx, "__mcp_value_json", p2(ctx, "data", "any", "key", "string"), "string", src) != 0
			return 1

		// Validation of one tool param (MCP-T001): "" when acceptable,
		// otherwise the -32602 message.
		src = "string __enc = __mcp_value_json(data, key)\n"
		src = src + tpl("if __enc == 'null'\n\tif required\n\t\treturn 'Missing required param: ' + key\n\treturn ''\n")
		src = src + tpl("string __first = __enc.substring(0, 1)\n")
		src = src + tpl("boolean __numeric = __first == '-' or (__first >= '0' and __first <= '9')\n")
		src = src + tpl("if type == 'string' and __first != '~'\n\treturn 'Param ' + key + ' must be a string'\n")
		src = src + tpl("if type == 'boolean' and __enc != 'true' and __enc != 'false'\n\treturn 'Param ' + key + ' must be a boolean'\n")
		src = src + tpl("if type == 'number' and not __numeric\n\treturn 'Param ' + key + ' must be a number'\n")
		src = src + tpl("if type == 'integer' and (not __numeric or __enc.indexOf('.') >= 0 or __enc.indexOf('e') >= 0 or __enc.indexOf('E') >= 0)\n\treturn 'Param ' + key + ' must be an integer'\n")
		src = src + tpl("if type.startsWith('list') and __first != '['\n\treturn 'Param ' + key + ' must be an array'\n")
		src = src + "return \"\"\n"
		if emit_src_function(ctx, "__mcp_check_param", p4(ctx, "data", "any", "key", "string", "type", "string", "required", "boolean"), "string", src) != 0
			return 1
		return 0

	integer plugin_error(integer ctx, string code, string message)
		_emit_error(ctx, 2, code, message, "{\"start\":0,\"end\":0,\"source\":\"plugin\"}")
		return 1

// ============================================================================
// PER-PRIMITIVE HANDLER EMISSION
// ============================================================================

functions:
	// Statements that bind each declaration to `<prefix><name>`. Values are
	// read from `__data` (decoded arguments object). Optional declarations
	// keep their default expression when the key is absent.
	string binding_source(string decls, string prefix)
		string src = ""
		integer pos = 0
		while pos < decls.length()
			string d = line_at(decls, pos)
			if d != ""
				string name = decl_field(d, 0)
				string typ = decl_field(d, 1)
				string local = prefix + name
				string raw = "__raw_" + name
				string ltype = typ
				string conv = raw
				if typ == "integer"
					conv = raw + ".toInteger()"
				else if typ == "number"
					conv = raw + ".toNumber()"
				else if typ == "boolean"
					conv = raw + " == \"true\""
				else if typ != "string"
					ltype = "any"
				if ltype == "any"
					string init = "json.get(__data, " + clit(name) + ")"
					if decl_field(d, 2) == "1"
						src = src + "any " + local + " = " + decl_field(d, 3) + "\n"
						src = src + "if __mcp_value_json(__data, " + clit(name) + ") != \"null\"\n"
						src = src + "\t" + local + " = " + init + "\n"
					else
						src = src + "any " + local + " = " + init + "\n"
				else if decl_field(d, 2) == "1"
					src = src + ltype + " " + local + " = " + decl_field(d, 3) + "\n"
					src = src + "if __mcp_value_json(__data, " + clit(name) + ") != \"null\"\n"
					src = src + "\tstring " + raw + " = json.get(__data, " + clit(name) + ")\n"
					src = src + "\t" + local + " = " + conv + "\n"
				else
					src = src + "string " + raw + " = json.get(__data, " + clit(name) + ")\n"
					src = src + ltype + " " + local + " = " + conv + "\n"
			pos = next_line(decls, pos)
		return src

	integer emit_handler(integer ctx, string fn_name, string kind, string block, string label)
		string handler = block_handler(block)
		if handler == ""
			return plugin_error(ctx, "FRAME-MCP-E011", kind + " " + label + " has no handler body — it must return a response")
		string decls = block_decls(block)
		string src = ""
		integer params = 0
		if kind == "tool"
			src = "any __data = json.textToData(__args_json)\n" + binding_source(decls, "__param_")
			src = src + rewrite_body(handler, "params", "__param_", false)
			params = p1(ctx, "__args_json", "string")
		else if kind == "prompt"
			src = "any __data = json.textToData(__args_json)\n" + binding_source(decls, "__arg_")
			src = src + rewrite_body(handler, "args", "__arg_", true)
			params = p1(ctx, "__args_json", "string")
		else
			src = rewrite_body(handler, "\0", "", false)
			params = p0(ctx)
		integer body_h = _emit_stmt_from_source(ctx, src, 0)
		if body_h == 0
			return plugin_error(ctx, "FRAME-MCP-E011", "syntax error in " + kind + " handler body for " + label)
		integer fns = _batch_arrayNew(ctx)
		_batch_arrayPush(ctx, fns, _batch_func2(ctx, fn_name, params, "string", 0, body_h))
		_emit_helpers_batch(ctx, _batch_spec(ctx, fns), 2)
		if _ctx_had_error(ctx) != 0
			return plugin_error(ctx, "FRAME-MCP-E010", "frame.mcp: emission failed for " + kind + " " + label)
		return 0

	// Dispatcher case for one tool: validate params, run, wrap the result.
	string tool_case(string name, string fn_name, string decls)
		string body = "string __problem = \"\"\n"
		integer pos = 0
		while pos < decls.length()
			string d = line_at(decls, pos)
			if d != ""
				string req = "true"
				if decl_field(d, 2) == "1"
					req = "false"
				body = body + "if __problem == \"\"\n\t__problem = __mcp_check_param(__data, " + clit(decl_field(d, 0)) + ", " + clit(decl_field(d, 1)) + ", " + req + ")\n"
			pos = next_line(decls, pos)
		body = body + "if __problem != \"\"\n\treturn __mcp_err(id, -32602, __problem)\n"
		body = body + "string __result = " + fn_name + "(arguments)\n"
		body = body + "if __mcp_is_error(__result)\n\treturn __mcp_ok(id, __result)\n"
		body = body + tpl("return __mcp_ok(id, '{~content~:[' + __result + ']}')\n")
		return "if name == " + clit(name) + "\n" + indent1(body)

	string resource_case(string uri, string fn_name, string mime)
		string body = "string __result = " + fn_name + "()\n"
		body = body + "if __mcp_is_error(__result)\n\treturn __mcp_err(id, -32603, __mcp_error_text(__result))\n"
		body = body + "string __text = json.get(__result, \"text\")\n"
		string head = "{\"contents\":[{\"uri\":" + jstr(uri) + ",\"mimeType\":" + jstr(mime) + ",\"text\":"
		body = body + "return __mcp_ok(id, " + clit(head) + " + json.encode(__text) + \"}]}\")\n"
		return "if uri == " + clit(uri) + "\n" + indent1(body)

	string prompt_case(string name, string fn_name, string desc, string decls)
		string body = "string __problem = \"\"\n"
		integer pos = 0
		while pos < decls.length()
			string d = line_at(decls, pos)
			if d != "" and decl_field(d, 2) == "0"
				body = body + "if __problem == \"\" and __mcp_value_json(__data, " + clit(decl_field(d, 0)) + ") == \"null\"\n\t__problem = " + clit("Missing required argument: " + decl_field(d, 0)) + "\n"
			pos = next_line(decls, pos)
		body = body + "if __problem != \"\"\n\treturn __mcp_err(id, -32602, __problem)\n"
		body = body + "string __result = " + fn_name + "(arguments)\n"
		body = body + "if __mcp_is_error(__result)\n\treturn __mcp_err(id, -32603, __mcp_error_text(__result))\n"
		string head = "{\"description\":" + jstr(desc) + ",\"messages\":[{\"role\":\"user\",\"content\":{\"type\":\"text\",\"text\":"
		body = body + "return __mcp_ok(id, " + clit(head) + " + json.encode(__result) + \"}}]}\")\n"
		return "if name == " + clit(name) + "\n" + indent1(body)

// ============================================================================
// MAIN EXPAND
// ============================================================================

functions:
	integer expand_mcp_typed(integer ctx, string attributes, string raw_body)
		string body = normalize_body(raw_body)
		_ctx_set_error_context(ctx, "FRAME-MCP-E001", "frame.mcp expand_mcp_typed failed during typed emission")
		string problem = validate_mcp(attributes, body)
		if problem != ""
			return plugin_error(ctx, "FRAME-MCP-E003", problem)

		string server_name = extract_server_name(attributes)
		string server_version = config_value(body, "version")
		if server_version == ""
			server_version = "1.0.0"
		string server_desc = config_value(body, "description")

		if emit_runtime_helpers(ctx) != 0
			return 1

		string tools_json = ""
		string resources_json = ""
		string prompts_json = ""
		string tool_cases = ""
		string resource_cases = ""
		string prompt_cases = ""
		integer tool_count = 0
		integer resource_count = 0
		integer prompt_count = 0

		string prims = collect_primitives(body)
		integer pos = 0
		while pos < prims.length()
			integer stop = prims.indexOf("\0;", pos)
			string rec = prims.substring(pos, stop)
			pos = stop + 2
			string kind = record_field(rec, 0)
			string name = record_field(rec, 1)
			string block = record_field(rec, 2)
			string desc = block_member(block, "description")
			string decls = block_decls(block)
			if kind == "tool"
				string fn_name = "__mcp_tool_" + sanitize_name(name)
				if emit_handler(ctx, fn_name, kind, block, name) != 0
					return 1
				if tool_count > 0
					tools_json = tools_json + ","
				tools_json = tools_json + "{\"name\":" + jstr(name) + ",\"description\":" + jstr(desc) + ",\"inputSchema\":" + build_input_schema(decls) + "}"
				tool_cases = tool_cases + tool_case(name, fn_name, decls)
				tool_count = tool_count + 1
			else if kind == "resource"
				string fn_name = "__mcp_resource_" + sanitize_name(name)
				if emit_handler(ctx, fn_name, kind, block, name) != 0
					return 1
				string mime = resource_mime(block)
				if resource_count > 0
					resources_json = resources_json + ","
				resources_json = resources_json + "{\"uri\":" + jstr(name) + ",\"name\":" + jstr(name) + ",\"description\":" + jstr(desc) + ",\"mimeType\":" + jstr(mime) + "}"
				resource_cases = resource_cases + resource_case(name, fn_name, mime)
				resource_count = resource_count + 1
			else
				string fn_name = "__mcp_prompt_" + sanitize_name(name)
				if emit_handler(ctx, fn_name, kind, block, name) != 0
					return 1
				if prompt_count > 0
					prompts_json = prompts_json + ","
				prompts_json = prompts_json + "{\"name\":" + jstr(name) + ",\"description\":" + jstr(desc) + ",\"arguments\":" + build_prompt_arguments(decls) + "}"
				prompt_cases = prompt_cases + prompt_case(name, fn_name, desc, decls)
				prompt_count = prompt_count + 1

		// Dispatchers. Each receives the JSON-RPC id (raw JSON text).
		string src = "any __data = json.textToData(arguments)\n" + tool_cases + "return __mcp_err(id, -32602, \"Unknown tool: \" + name)\n"
		if emit_src_function(ctx, "__mcp_call_tool", p3(ctx, "id", "string", "name", "string", "arguments", "string"), "string", src) != 0
			return 1
		src = resource_cases + "return __mcp_err(id, -32002, \"Resource not found: \" + uri)\n"
		if emit_src_function(ctx, "__mcp_read_resource", p2(ctx, "id", "string", "uri", "string"), "string", src) != 0
			return 1
		src = "any __data = json.textToData(arguments)\n" + prompt_cases + "return __mcp_err(id, -32602, \"Unknown prompt: \" + name)\n"
		if emit_src_function(ctx, "__mcp_get_prompt", p3(ctx, "id", "string", "name", "string", "arguments", "string"), "string", src) != 0
			return 1

		string init_tail = "\",\"capabilities\":" + build_capabilities_json(tool_count, resource_count, prompt_count) + ",\"serverInfo\":{\"name\":" + jstr(server_name) + ",\"version\":" + jstr(server_version) + "}"
		if server_desc != ""
			init_tail = init_tail + ",\"instructions\":" + jstr(server_desc)
		init_tail = init_tail + "}"
		if emit_handle_function(ctx, init_tail, "[" + tools_json + "]", "[" + resources_json + "]", "[" + prompts_json + "]") != 0
			return 1

		if has_config(body, "apiKey")
			if emit_api_key_functions(ctx, config_expr(body, "apiKey")) != 0
				return 1
		if emit_transport_loop(ctx, body) != 0
			return 1
		if _ctx_had_error(ctx) != 0
			return plugin_error(ctx, "FRAME-MCP-E001", "expand_mcp_typed: sticky-error tripped during emission")
		return 0

	// __mcp_handle(message) — the JSON-RPC 2.0 entry point. Returns the
	// response JSON, or "" for notifications (requests without an id).
	integer emit_handle_function(integer ctx, string init_tail, string tools_json, string resources_json, string prompts_json)
		string src = "any __req = json.tryTextToData(message)\n"
		src = src + "string __reqtext = json.encode(__req)\n"
		src = src + tpl("if not __reqtext.startsWith('{')\n\treturn __mcp_err('null', -32700, 'Parse error')\n")
		src = src + "any __idv = json.get(__req, \"id\")\n"
		src = src + "string __id = json.encode(__idv)\n"
		src = src + "string __method = json.get(__req, \"method\")\n"
		src = src + tpl("if __id == 'null'\n\treturn ''\n")
		src = src + tpl("if __method == ''\n\treturn __mcp_err(__id, -32600, 'Invalid Request')\n")
		src = src + tpl("if __method == 'initialize'\n\tstring __pv = json.get(__req, 'params.protocolVersion')\n\tif __pv != '2024-11-05' and __pv != '2025-03-26' and __pv != '2025-06-18'\n\t\t__pv = '2024-11-05'\n")
		src = src + "\treturn __mcp_ok(__id, " + tpl("'{~protocolVersion~:~'") + " + __pv + " + clit(init_tail) + ")\n"
		src = src + tpl("if __method == 'ping'\n\treturn __mcp_ok(__id, '\\{\\}')\n")
		src = src + tpl("if __method == 'tools/list'\n\treturn __mcp_ok(__id, ") + clit("{\"tools\":" + tools_json + "}") + ")\n"
		src = src + tpl("if __method == 'resources/list'\n\treturn __mcp_ok(__id, ") + clit("{\"resources\":" + resources_json + "}") + ")\n"
		src = src + tpl("if __method == 'prompts/list'\n\treturn __mcp_ok(__id, ") + clit("{\"prompts\":" + prompts_json + "}") + ")\n"
		src = src + tpl("if __method == 'tools/call' or __method == 'prompts/get'\n")
		src = src + tpl("\tstring __name = json.get(__req, 'params.name')\n")
		src = src + tpl("\tstring __args = json.get(__req, 'params.arguments')\n")
		src = src + tpl("\tif __args == ''\n\t\t__args = '\\{\\}'\n")
		src = src + tpl("\tif not __args.startsWith('{')\n\t\treturn __mcp_err(__id, -32602, 'arguments must be an object')\n")
		src = src + tpl("\tif __method == 'tools/call'\n\t\treturn __mcp_call_tool(__id, __name, __args)\n")
		src = src + "\treturn __mcp_get_prompt(__id, __name, __args)\n"
		src = src + tpl("if __method == 'resources/read'\n\tstring __uri = json.get(__req, 'params.uri')\n\treturn __mcp_read_resource(__id, __uri)\n")
		src = src + tpl("return __mcp_err(__id, -32601, 'Method not found: ' + __method)\n")
		return emit_src_function(ctx, "__mcp_handle", p1(ctx, "message", "string"), "string", src)

	// apiKey: support (HTTP transport only — MCP-B004):
	//   __mcp_api_key()                  the apiKey: expression, evaluated once
	//                                     by the transport loop at startup
	//   __mcp_authorized(header, key)    true when header is `Bearer <key>`
	//                                     and key is not empty
	//   __mcp_unauthorized()             JSON-RPC error answered to a request
	//                                     whose Authorization header is wrong
	integer emit_api_key_functions(integer ctx, string key_expr)
		string src = "string __key = " + key_expr + "\nreturn __key\n"
		if emit_src_function(ctx, "__mcp_api_key", p0(ctx), "string", src) != 0
			return 1
		src = tpl("if key == ''\n\treturn false\nreturn authorization == 'Bearer ' + key\n")
		if emit_src_function(ctx, "__mcp_authorized", p2(ctx, "authorization", "string", "key", "string"), "boolean", src) != 0
			return 1
		src = tpl("return __mcp_err('null', -32001, 'Unauthorized')\n")
		return emit_src_function(ctx, "__mcp_unauthorized", p0(ctx), "string", src)

	// Transport loop in the program start slot.
	//   stdio: read newline-delimited messages until EOF, write responses.
	//   http:  serve, then answer every accepted request exactly once with
	//          _mcp_http_respond (registry: each accept must be followed by
	//          exactly one respond, including notifications).
	integer emit_transport_loop(integer ctx, string body)
		string src = ""
		if transport_kind(body) == "http"
			string port = http_attr(body, "port")
			if port == ""
				port = "3001"
			string host = http_attr(body, "host")
			if host == ""
				host = "localhost"
			string serve = "_mcp_http_serve(" + port.toInteger().toString() + ", " + clit(host) + ")\n"
			serve = serve + "boolean __mcp_serving = true\n"
			serve = serve + "while __mcp_serving\n"
			serve = serve + "\tstring __mcp_in = _mcp_http_accept()\n"
			if has_config(body, "apiKey")
				// The host answers 401 to requests without the key
				// (_mcp_http_require_key); the header is checked again here so
				// no request is dispatched without it. An empty key (unset
				// environment variable) leaves the server stopped rather
				// than open.
				serve = serve + "\tif __mcp_authorized(_mcp_http_header(\"authorization\"), __mcp_key)\n"
				serve = serve + "\t\t_mcp_http_respond(__mcp_handle(__mcp_in))\n"
				serve = serve + "\telse\n"
				serve = serve + "\t\t_mcp_http_respond(__mcp_unauthorized())\n"
				src = "string __mcp_key = __mcp_api_key()\n"
				src = src + "if _mcp_http_require_key(__mcp_key) == 0\n"
				src = src + "\t_mcp_log(\"error\", \"apiKey: is empty (is the environment variable set?) — the MCP HTTP server was not started\")\n"
				src = src + "else\n"
				src = src + indent_lines(serve)
			else
				serve = serve + "\t_mcp_http_respond(__mcp_handle(__mcp_in))\n"
				src = serve
		else
			src = "boolean __mcp_running = true\n"
			src = src + "while __mcp_running\n"
			src = src + "\tstring __mcp_in = _mcp_stdio_read()\n"
			src = src + "\tif __mcp_in.length() == 0\n"
			src = src + "\t\t__mcp_running = false\n"
			src = src + "\telse\n"
			src = src + "\t\tstring __mcp_out = __mcp_handle(__mcp_in)\n"
			src = src + "\t\tif __mcp_out.length() > 0\n"
			src = src + "\t\t\t_mcp_stdio_write(__mcp_out)\n"
		integer stmt = _emit_stmt_from_source(ctx, src, 0)
		if stmt == 0
			return plugin_error(ctx, "FRAME-MCP-E050", "frame.mcp: transport loop failed to parse")
		_emit_statement_into_start(ctx, stmt)
		if _ctx_had_error(ctx) != 0
			return plugin_error(ctx, "FRAME-MCP-E050", "frame.mcp: transport loop emission failed")
		return 0

// ============================================================================
// VALIDATION
// ============================================================================
// Returns "" when the block is valid, otherwise the first error message.

functions:
	string validate_mcp(string attributes, string raw_body)
		string body = normalize_body(raw_body)
		// MCP-B002
		if extract_server_name(attributes) == ""
			return "mcp: block must have a quoted server name: mcp \"my-server\":"

		string transport = transport_kind(body)
		if transport.startsWith("invalid:")
			return "mcp: transport must be stdio or http: (got " + transport.substring(8, transport.length()) + ")"
		if transport == "http"
			string port = http_attr(body, "port")
			if port != ""
				// Text that is not a whole number raises in toInteger().
				string port_back = port.toInteger().toString() onError ""
				if port_back != port
					return "mcp: transport http port must be an integer (got " + port + ")"

		// MCP-B004: apiKey is an HTTP-only setting.
		if has_config(body, "apiKey")
			if transport != "http"
				return "mcp: apiKey: requires transport: http: — stdio servers have no API key authentication (MCP-B004)"
			if config_expr(body, "apiKey") == ""
				return "mcp: apiKey: needs a value — e.g. apiKey: env.get(\"MCP_API_KEY\")"

		// MCP-B006: config fields before primitives; nothing unknown at the top.
		string seen_primitive = ""
		integer pos = 0
		while pos < body.length()
			string line = line_at(body, pos)
			pos = next_line(body, pos)
			if tabs(line) == 1 and not is_blank_or_comment(line)
				string kind = primitive_kind(line)
				string t = line.trim()
				if kind != ""
					seen_primitive = kind
					if not t.endsWith(":")
						return kind + " declaration must end with ':' — " + t
				else
					boolean is_config = t.startsWith("version:") or t.startsWith("description:") or t.startsWith("transport:") or t.startsWith("apiKey:")
					if not is_config
						return "mcp: unknown member '" + t + "' — expected version:, description:, transport:, apiKey:, tool, resource or prompt"
					if seen_primitive != ""
						return "mcp: config field '" + t + "' must appear before the first tool/resource/prompt declaration (MCP-B006)"

		// Per-primitive rules.
		string names = "\0"
		string prims = collect_primitives(body)
		pos = 0
		while pos < prims.length()
			integer stop = prims.indexOf("\0;", pos)
			string rec = prims.substring(pos, stop)
			pos = stop + 2
			string err = validate_primitive(record_field(rec, 0), record_field(rec, 1), record_field(rec, 2), transport)
			if err != ""
				return err
			string name = record_field(rec, 1)
			// MCP-X001: one namespace for all primitive names.
			if names.indexOf("\0" + name + "\0") >= 0
				return "mcp: duplicate name \"" + name + "\" — tool, resource and prompt names must be unique within one mcp: block (MCP-X001)"
			names = names + name + "\0"
		return ""

	string validate_primitive(string kind, string name, string block, string transport)
		string label = kind + " \"" + name + "\""
		if name == ""
			return kind + " declaration must have a quoted name"
		if block_member(block, "description") == ""
			return label + " must have a description: field"

		// MCP-R001
		if kind == "resource"
			integer sep = name.indexOf("://")
			if sep <= 0 or sep + 3 >= name.length() or name.indexOf(" ") >= 0
				return label + " must be a scheme://path URI without spaces (MCP-R001)"
		else if name.indexOf(" ") >= 0
			return label + " name must not contain spaces"
		if sanitize_name(name) == "!"
			return label + " name may only use ASCII letters, digits and " + name_specials()

		string kw = decl_keyword(block)
		// MCP-R002
		if kind == "resource" and kw != ""
			return label + " must not declare " + kw + ": — resources are parameterless; use a tool (MCP-R002)"
		if kind == "tool" and kw == "args"
			return label + " declares its inputs with params:, not args:"
		if kind == "prompt" and kw == "params"
			return label + " declares its inputs with args:, not params:"
		if block_member(block, "mimeType") != "" and kind != "resource"
			return label + " mimeType: is only valid on resources"

		// Declarations are `type name [= default]`; `name: type` is rejected
		// with the form to use.
		string raw_decls = block_decl_lines(block)
		integer rp = 0
		while rp < raw_decls.length()
			string raw = line_at(raw_decls, rp)
			rp = next_line(raw_decls, rp)
			if raw != ""
				string colon_err = colon_decl_error(label, kw, raw)
				if colon_err != ""
					return colon_err

		// Declarations: well-formed, unique, required before optional (MCP-T005).
		string decls = block_decls(block)
		string seen = "\0"
		boolean optional_seen = false
		integer pos = 0
		while pos < decls.length()
			string d = line_at(decls, pos)
			pos = next_line(decls, pos)
			if d != ""
				string pname = decl_field(d, 0)
				string ptype = decl_field(d, 1)
				if not is_identifier(pname) or ptype == ""
					return label + " has a malformed " + kw + " declaration — use type name or type name = default"
				if seen.indexOf("\0" + pname + "\0") >= 0
					return label + " declares " + pname + " twice"
				seen = seen + pname + "\0"
				if decl_field(d, 2) == "1"
					optional_seen = true
					if decl_field(d, 3) == ""
						return label + " " + pname + " has an empty default value"
				else if optional_seen
					return label + " required " + kw + " " + pname + " must be declared before optional ones (MCP-T005)"

		string handler = block_handler(block)
		if handler == ""
			return label + " has no handler body — it must return a response"

		// MCP-X002: transport bridges are plugin-internal.
		if handler.indexOf("_mcp_") >= 0 or handler.indexOf("mcp.stdio_") >= 0 or handler.indexOf("mcp.http_") >= 0 or handler.indexOf("mcp.sse_") >= 0
			return label + " must not call MCP transport bridges directly (MCP-X002) — return mcpJson(), mcpText() or mcpError()"
		// MCP-X003: stdout belongs to the JSON-RPC stream under stdio.
		if transport == "stdio" and (handler.indexOf("print(") >= 0 or handler.indexOf("printl(") >= 0)
			return label + " must not print to stdout under transport: stdio (MCP-X003) — use mcp.log(level, message)"

		// MCP-T003 / MCP-P002: shape of every return statement.
		integer hp = 0
		while hp < handler.length()
			string t = line_at(handler, hp).trim()
			hp = next_line(handler, hp)
			if t.startsWith("return ") or t == "return"
				boolean helper = t.startsWith("return mcpJson(") or t.startsWith("return mcpText(") or t.startsWith("return mcpError(")
				if kind == "prompt"
					if t.startsWith("return mcpJson(") or t.startsWith("return mcpText(")
						return label + " must return the prompt text as a string, not mcpJson()/mcpText() (MCP-P002)"
				else if not helper
					return label + " must return mcpJson(), mcpText() or mcpError() on every path (MCP-T003): " + t
		return ""
