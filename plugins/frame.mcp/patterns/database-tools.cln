// patterns/database-tools.cln
// Pattern: database-tools
// MCP server whose tools, resources and prompts read and write data through
// frame.data. In an app the models live in app/data/models/ and this file in
// app/mcp/; they are declared together here so the pattern compiles on its own.
//
// Use when: AI agents need to list, look up, create or change records.
// Anti-pattern: returning hand-built JSON strings or raw SQL text — return the
//   model values through mcpJson() so every call has a consistent schema.

plugins:
	frame.mcp
	frame.data

data Post:
	fields:
		integer id primary generated
		string title required
		string content required
		boolean published required

data Comment:
	fields:
		integer id primary generated
		integer postId required
		string authorName required
		string body required

mcp "blog-tools":
	version: "1.0.0"
	description: "Blog content tools for AI agents — read, create and publish posts and comments"
	transport: stdio

	tool "list_posts":
		description: "List published posts, newest first. Returns an array of post objects."
		params:
			limit: integer = 10
		list<Post> posts = Post.find:
			where:
				published == true
			order:
				id desc
			limit:
				params.limit
		return mcpJson(posts)

	tool "get_post":
		description: "Get one post by its numeric id. Fails with NOT_FOUND when it does not exist."
		params:
			id: integer
		list<Post> found = Post.find:
			where:
				id == params.id
		if found.length() == 0
			return mcpError("Post not found with id " + params.id.toString(), code: "NOT_FOUND")
		return mcpJson(found[0])

	tool "create_post":
		description: "Create a draft post (published = false). Returns the created post with its id."
		params:
			title: string
			content: string
		Post post = Post()
		post.title = params.title
		post.content = params.content
		post.published = false
		Database.save(post)
		return mcpJson(post)

	tool "publish_post":
		description: "Publish a draft post. Fails when the post does not exist or is already published."
		params:
			id: integer
		list<Post> found = Post.find:
			where:
				id == params.id
		if found.length() == 0
			return mcpError("Post not found with id " + params.id.toString(), code: "NOT_FOUND")
		Post post = found[0]
		if post.published
			return mcpError("Post is already published", code: "ALREADY_PUBLISHED")
		post.published = true
		Database.save(post)
		return mcpJson(post)

	tool "add_comment":
		description: "Add a comment to a post. Returns the created comment."
		params:
			postId: integer
			authorName: string
			body: string
		list<Post> found = Post.find:
			where:
				id == params.postId
		if found.length() == 0
			return mcpError("Post not found with id " + params.postId.toString(), code: "NOT_FOUND")
		Comment comment = Comment()
		comment.postId = params.postId
		comment.authorName = params.authorName
		comment.body = params.body
		Database.save(comment)
		return mcpJson(comment)

	resource "posts://recent":
		description: "The 10 most recent published posts — context about the blog"
		mimeType: "application/json"
		list<Post> posts = Post.find:
			where:
				published == true
			order:
				id desc
			limit:
				10
		return mcpJson(posts)

	resource "stats://posts":
		description: "Number of stored posts as plain text"
		integer total = Post.count
		return mcpText(total.toString() + " posts")

	prompt "summarize_post":
		description: "Prompt for a social media summary of one post"
		args:
			postId: integer
			platform: string = "twitter"
		list<Post> found = Post.find:
			where:
				id == args.postId
		if found.length() == 0
			return mcpError("Post not found with id " + args.postId.toString())
		Post post = found[0]
		return "Summarize this post for {{ args.platform }}:\n\nTitle: {{ post.title }}\n\n{{ post.content }}"
