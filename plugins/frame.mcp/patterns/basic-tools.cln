// patterns/basic-tools.cln
// Pattern: basic-tools
// MCP server with pure computation tools — no database, so no frame.data.
// Use when: tools compute, transform text, or wrap other plugin calls.
// Anti-pattern: adding database queries just to follow a pattern — keep tool
//   bodies simple when nothing needs to persist.

plugins:
	frame.mcp

mcp "math-tools":
	version: "1.0.0"
	description: "Mathematical computation and text generation tools"
	transport: stdio

	tool "add":
		description: "Add two numbers and return the sum"
		params:
			number a
			number b
		return mcpJson(params.a + params.b)

	tool "multiply":
		description: "Multiply two numbers and return the product"
		params:
			number a
			number b
		return mcpJson(params.a * params.b)

	tool "greet":
		description: "Generate a greeting in the requested language (english, spanish, french, german)"
		params:
			string name
			string language = "english"
		if params.language == "spanish"
			return mcpText("Hola, " + params.name + "!")
		if params.language == "french"
			return mcpText("Bonjour, " + params.name + "!")
		if params.language == "german"
			return mcpText("Hallo, " + params.name + "!")
		return mcpText("Hello, " + params.name + "!")

	tool "word_count":
		description: "Count the words in a text string"
		params:
			string text
		integer count = 0
		integer i = 0
		boolean in_word = false
		while i < params.text.length()
			string ch = params.text.substring(i, i + 1)
			boolean is_space = ch == " " or ch == "\t" or ch == "\n" or ch == "\r"
			if not is_space and not in_word
				count = count + 1
				in_word = true
			if is_space
				in_word = false
			i = i + 1
		return mcpJson(count)

	resource "info://supported-languages":
		description: "Languages supported by the greet tool"
		list<string> languages = ["english", "spanish", "french", "german"]
		return mcpJson(languages)

	resource "info://about":
		description: "What this server does, as plain text"
		return mcpText("math-tools adds, multiplies, greets and counts words.")

	prompt "explain_calculation":
		description: "Ask the AI to explain a mathematical concept for an audience level"
		args:
			string concept
			string level = "beginner"
		return "Explain the mathematical concept of '{{ args.concept }}' for a {{ args.level }} audience. Use simple, concrete examples and include one worked example."
