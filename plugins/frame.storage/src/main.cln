// frame.storage plugin - Server-side Filesystem Storage Bridge
// Provides: storage.write / storage.read / storage.exists / storage.delete
//           for persisting binary artifacts (tarballs, uploaded images,
//           generated PDFs, WASM cache) under a host-configured storage root.
// Version: 1.0.0
// ABI: Plugin Contracts v3 — typed AST emission (typed-emission.md)
//
// This is a BRIDGE-ONLY plugin (plugin-contract.md §2.2). There are no
// DSL blocks to expand. All calls resolve via the [aliases] table in
// plugin.toml, which maps storage.* Clean-language names to the underlying
// _fs_* WASM imports that the host runtime implements.
//
// The typed-emission lifecycle slot exists because every plugin declaring
// expansion_version = "3.0.0" must export a typed variant for each lifecycle
// slot it declares. This plugin declares only module_helpers, which emits
// nothing, so it imports no typed-emission bridges.

// ============================================================================
// V3 LIFECYCLE SLOT: emit_module_helpers_typed
// ============================================================================
// foundation/spec/framework/contracts/typed-emission.md §7
// foundation/spec/framework/contracts/lifecycle.md §3.1
//
// frame.storage has no module-scope helpers to emit. The storage.* functions
// are bridge aliases resolved from plugin.toml [aliases]; they need no
// generated wrapper code. Returns 0 = success, emits nothing.

functions:
	integer emit_module_helpers_typed(integer ctx, string ctx_json)
		return 0

// ============================================================================
// KEYWORD DISCOVERY EXPORT
// ============================================================================
// Consumed by the language server for completion. Lists the four public
// dot-notation call sites. There are no block keywords.

functions:
	string get_keywords()
		return "[\"storage.write\", \"storage.read\", \"storage.exists\", \"storage.delete\"]"
