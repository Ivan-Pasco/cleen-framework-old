// Pattern: content-addressed-artifact
// Use when: persisting an uploaded artifact (JSON report, generated document,
//   export) whose canonical name is derived from a hash of its contents.
//   Content addressing gives you automatic deduplication, immutable URLs, and
//   cache-safety without any coordination between concurrent uploaders.
// Anti-pattern: DON'T use a client-supplied filename as the storage path.
//   Client-supplied names cause collisions between users, allow overwrites of
//   other users' artifacts, and open path-traversal escape holes even when the
//   host rejects '..'. Always hash the bytes first and compose the destination
//   path from the hash — client metadata belongs in a database record that
//   points at the hash, not in the filesystem path.
//
// storage.write takes the bytes as a string (frame-storage.ebnf
// bytes_expression), so this pattern reads the body with req.body(), which
// suits text payloads. Raw binary bodies arrive from req.body_bytes() as an
// integer handle (type-system.md §9b), which storage.write's string parameter
// does not accept today.

plugins:
	frame.server
	frame.storage

endpoints:
	POST "/api/v1/artifacts":
		// 1. Request body; the same string is hashed and written, so the
		//    stored bytes are exactly the bytes that were hashed.
		string body = req.body()

		// 2. Reject empty uploads at the app layer. The host also enforces a
		//    per-call write size cap (STORAGE-H003).
		if body.length() == 0
			return badRequest("empty upload")

		// 3. Hash the content. The same lowercase hex hash is both the
		//    storage path and the receipt returned to the client.
		string hash = crypto.hash_sha256(body)

		// 4. Compose the destination from the hash only — never from a
		//    client-supplied filename.
		string dest = "artifacts/" + hash + ".json"

		// 5. Identical bytes always land at the same path, so a duplicate
		//    upload is a no-op (STORAGE-F003).
		if storage.exists(dest)
			return json({sha256: hash, deduplicated: true})

		// 6. Persist. 0 = success; 1=permission, 2=disk full, 3=invalid path,
		//    4=parent not a directory, 5=I/O (STORAGE-F001). The host writes
		//    atomically (tmp + rename), so readers never see a partial file.
		integer rc = storage.write(dest, body)
		if rc != 0
			return status(500, "storage failed with code " + rc.toString())

		return json({sha256: hash, deduplicated: false})
