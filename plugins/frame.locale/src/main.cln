// frame.locale plugin - Internationalization DSL
// Provides: locale block for BCP 47 locale configuration, t() and tc() translation functions,
//           locale.formatNumber, locale.formatCurrency, locale.formatDate helpers
// Version: 1.0.6
// Implements: Frame i18n Specification §16
// ABI: Plugin Contracts v3 — typed AST emission (typed-emission.md)

// ============================================================================
// TYPED EMISSION BRIDGE DECLARATIONS (Plugin Contracts v3)
// ============================================================================
// foundation/spec/plugins/contracts/typed-emission.md §2.3, §3, §5
//
// Only the 4 bridges required by frame.locale's expansion:
//   _stmt_call              — build a call statement (for _i18n_configure)
//   _expr_string_lit        — build a string literal expression (for arguments)
//   _emit_statement_into_start — inject a statement into the start: slot
//   _emit_error             — emit a diagnostic (severity 2 = error)
//
// These are env imports provided by the compiler's typed-emission sandbox only.
// They MUST NOT appear in plugin.toml [bridge].functions — they are sandbox-internal.

external:
	integer _stmt_call(integer ctx, string callee, string args_json)
	integer _expr_string_lit(integer ctx, string value)
	integer _emit_statement_into_start(integer ctx, integer stmt_handle)
	integer _emit_error(integer ctx, integer severity, string code, string message, string span)

// ============================================================================
// V3 LIFECYCLE SLOT: emit_module_helpers_typed
// ============================================================================
// foundation/spec/plugins/contracts/typed-emission.md §7
// foundation/spec/plugins/contracts/lifecycle.md §3.1
//
// frame.locale has no helper functions to emit at module scope. The t() and
// tc() functions are bridge aliases resolved from plugin.toml [aliases]; they
// do not require any module-scope generated code. The Locale type is a plain
// string typedef that the compiler handles inline.
//
// This slot satisfies the v3 atomic-migration requirement (every lifecycle slot
// must export a typed variant when expansion_version = "3.0.0").
// Returns 0 = success; emits nothing.

functions:
	integer emit_module_helpers_typed(integer ctx, string ctx_json)
		return 0

// ============================================================================
// V3 BLOCK EXPAND ENTRY POINT: expand_block_typed
// ============================================================================
// foundation/spec/plugins/contracts/typed-emission.md §2.2
//
// Parameters (LP-string pointers passed by the compiler):
//   ctx        — opaque emission context handle (pass to every bridge)
//   block_name — name of the block being expanded (must equal "locale")
//   attrs_json — JSON block attributes
//   body       — raw DSL body text of the block
//
// Returns 0 on success, non-zero on error.
// All errors are also reported via _emit_error before returning non-zero.

functions:
	integer expand_block_typed(integer ctx, string block_name, string attrs_json, string body)
		if block_name == "locale"
			return expand_locale_typed(ctx, body)
		return 0

// ============================================================================
// KEYWORD DISCOVERY EXPORT
// ============================================================================

functions:
	string get_keywords()
		return "[\"locale\", \"t\", \"tc\", \"locale.current\", \"locale.set\", \"locale.formatNumber\", \"locale.formatCurrency\", \"locale.formatDate\"]"

// ============================================================================
// LOCALE BLOCK TYPED EXPANSION
// ============================================================================

functions:
	// Expand locale: block into typed AST statements injected into start:.
	//
	// Supported fields in DSL body (frame-locale.ebnf §1):
	//   default   = "en"        — default locale BCP 47 tag (default: "en")
	//   fallback  = "en"        — locale tried when a key is missing (default: the default locale)
	//   detection = "header"    — how a request picks its locale: header|cookie|query|manual (default: header)
	//   path      = "app/i18n"  — folder of the translation files <tag>.json (default: app/i18n)
	//
	// V3 emits typed AST directly — no string concatenation into Clean source.
	// Emits one statement into the start: slot via _emit_statement_into_start:
	//   _i18n_configure("en", "en", "header", "app/i18n")
	// The server loads every <tag>.json of the folder, sets the default and
	// fallback locales and selects the detection strategy (HOST_BRIDGE.md).
	integer expand_locale_typed(integer ctx, string body)
		string default_locale = "en"
		string fallback_locale = ""
		string detection = "header"
		string i18n_path = "app/i18n"

		string lines = body
		integer line_start = 0

		while line_start < lines.length()
			integer line_end = lines.indexOf("\n", line_start)
			if line_end == -1
				line_end = lines.length()

			string line = lines.substring(line_start, line_end)
			string trimmed = line.trim()

			if trimmed.startsWith("default")
				string val = extract_field_value(trimmed, "default")
				if val.length() > 0
					default_locale = val

			if trimmed.startsWith("fallback")
				string val = extract_field_value(trimmed, "fallback")
				if val.length() > 0
					fallback_locale = val

			if trimmed.startsWith("detection")
				string val = extract_field_value(trimmed, "detection")
				if val.length() > 0
					detection = val

			if trimmed.startsWith("path")
				string val = extract_field_value(trimmed, "path")
				if val.length() > 0
					i18n_path = val

			line_start = line_end + 1

		if detection != "header" and detection != "cookie" and detection != "query" and detection != "manual"
			_emit_error(ctx, 2, "FRAME-LOCALE-E012", "locale: detection = \"" + detection + "\" is not a detection strategy; use \"header\", \"cookie\", \"query\" or \"manual\" (frame-locale.ebnf §1)", "{\"source\":\"plugin\"}")
			return 1

		if fallback_locale == ""
			fallback_locale = default_locale

		integer default_arg = _expr_string_lit(ctx, default_locale)
		if default_arg == 0
			_emit_error(ctx, 2, "FRAME-LOCALE-E001", "failed to build locale string literal", "{\"source\":\"plugin\"}")
			return 1

		integer fallback_arg = _expr_string_lit(ctx, fallback_locale)
		if fallback_arg == 0
			_emit_error(ctx, 2, "FRAME-LOCALE-E005", "failed to build fallback locale string literal", "{\"source\":\"plugin\"}")
			return 1

		integer detection_arg = _expr_string_lit(ctx, detection)
		if detection_arg == 0
			_emit_error(ctx, 2, "FRAME-LOCALE-E009", "failed to build detection string literal", "{\"source\":\"plugin\"}")
			return 1

		integer path_arg = _expr_string_lit(ctx, i18n_path)
		if path_arg == 0
			_emit_error(ctx, 2, "FRAME-LOCALE-E002", "failed to build path string literal", "{\"source\":\"plugin\"}")
			return 1

		string args = "[" + default_arg.toString() + "," + fallback_arg.toString() + "," + detection_arg.toString() + "," + path_arg.toString() + "]"
		integer configure_stmt = _stmt_call(ctx, "_i18n_configure", args)
		if configure_stmt == 0
			_emit_error(ctx, 2, "FRAME-LOCALE-E003", "failed to build _i18n_configure statement", "{\"source\":\"plugin\"}")
			return 1

		integer emit_result = _emit_statement_into_start(ctx, configure_stmt)
		if emit_result != 0
			_emit_error(ctx, 2, "FRAME-LOCALE-E004", "failed to emit _i18n_configure into start", "{\"source\":\"plugin\"}")
			return 1

		return 0

	// Extract the value from a field line of the form:
	//   key = "value"   → value (without quotes)
	//   key = value     → value (bare)
	// Returns empty string when the field name or separator is missing.
	string extract_field_value(string trimmed, string field_name)
		integer eq_pos = trimmed.indexOf("=")
		if eq_pos == -1
			return ""

		// Verify the text before "=" starts with the expected field name
		string key_part = trimmed.substring(0, eq_pos).trim()
		if key_part != field_name
			return ""

		string raw = trimmed.substring(eq_pos + 1, trimmed.length()).trim()

		// Strip surrounding double-quotes if present
		if raw.startsWith("\"") and raw.length() > 1
			if raw.endsWith("\"")
				return raw.substring(1, raw.length() - 1)

		return raw
