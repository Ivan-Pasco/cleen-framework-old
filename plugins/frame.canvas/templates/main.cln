// Main canvas scene: state, per-frame update, and drawing.

canvasScene: id="main" width=800 height=600 fps=60 background="#1a1a2e"

	state:
		number x = 400.0
		number speed = 120.0

	init:
		// One-time setup: runs after state: is initialised.

	draw:
		canvas.clear color="#1a1a2e"
		canvas.text value="Hello Canvas!" x=x y=300 size=32 color="#ffffff" align="center"

	onFrame: param="dt"
		// dt is the time since the last frame, in seconds.
		x = x + speed * dt
		if x > 700.0 or x < 100.0
			speed = 0.0 - speed
