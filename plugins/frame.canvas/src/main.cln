// frame.canvas plugin — canvas / animation / rendering DSL.
// ABI: Plugin Contracts v3 — typed AST emission (typed-emission.md).
//
// The compiler hands this plugin one `canvasScene:` block at a time (the only
// entry in plugin.toml [handles]). expand_canvas_scene walks the scene body
// and emits:
//
//   - the 12 built-in scene types (frame-canvas.ebnf §29);
//   - one function per handler: _on_frame, _draw, _on_pointer_*, _on_key_*,
//     _on_exit, _on_pause, _on_resume, plus _camera_follow and
//     _anim_states_update when the scene needs them;
//   - _frame_callback(__cv), the per-frame entry point the browser runtime
//     calls: it runs _on_frame, the animState transitions, the camera
//     follow, then _draw;
//   - statements in start: — canvas creation, asset / layer / handler
//     registration, then one block holding the state variables, every
//     animation registration, the camera setup and the init: body, and
//     finally _canvas_request_frame (the runtime loop is continuous, so it is
//     requested once).
//
// State variables live in the runtime's numeric store (_canvas_var_get /
// _canvas_var_set). Every handler loads them into typed locals on entry and
// stores them back on exit — including before each `return`.
//
// DSL lines (canvas.*, audio.*, play tween, ...) become bridge calls built
// with the batch API; every other line is user Clean code passed through
// _emit_stmt_from_source after the DSL expressions inside it (input.*,
// collision.*, scene.get, deltaTime(), ...) are rewritten to bridge calls.

external:
	integer _emit_class_full(integer ctx, integer class_spec_handle_or_lp, integer flags)
	integer _emit_statement_into_start(integer ctx, integer stmt_handle)
	integer _emit_stmt_from_source(integer ctx, string source, integer origin_offset)
	integer _emit_expr_from_source(integer ctx, string source, integer origin_offset)
	integer _emit_error(integer ctx, integer severity, string code, string message, string span)
	integer _ctx_set_error_context(integer ctx, string code, string message)
	integer _ctx_had_error(integer ctx)
	integer _batch_stringLit(integer ctx, string value)
	integer _batch_intLit(integer ctx, integer value_lo, integer value_hi)
	integer _batch_ident(integer ctx, string name)
	integer _batch_call(integer ctx, string callee, integer args_array_handle)
	integer _batch_stmtCall(integer ctx, string callee, integer args_array_handle)
	integer _batch_stmtVarDecl(integer ctx, string name, string type_lp, integer expr_handle)
	integer _batch_stmtBlock(integer ctx, integer stmts_array_handle)
	integer _batch_stmtIf(integer ctx, integer cond_handle, integer then_array_handle, integer else_array_handle)
	integer _batch_stmtWhile(integer ctx, integer cond_handle, integer body_array_handle)
	integer _batch_stmtFor(integer ctx, string iter_var, integer iterable_handle, integer body_array_handle)
	integer _batch_arrayNew(integer ctx)
	integer _batch_arrayPush(integer ctx, integer array_handle, integer item_handle)
	// Contract 5 Phase C — lint AST accessor.
	string _ast_list_blocks(integer handle, string block_name)
	integer _batch_param(integer ctx, string name, string type_name)
	integer _batch_func(integer ctx, string name, integer params_array_handle, string return_type, integer body_array_handle)
	integer _batch_spec(integer ctx, integer functions_array_handle)
	integer _emit_helpers_batch(integer ctx, integer spec_handle_or_lp, integer flags)

// ============================================================================
// EXPORTS (plugin.toml [exports] and [lifecycle])
// ============================================================================

functions:
	// Every declaration frame.canvas produces is per scene, so the module
	// helpers slot has nothing to emit.
	integer emit_module_helpers_typed(integer ctx, string ctx_json)
		return 0

	integer expand_block_typed(integer ctx, string block_name, string attrs_json, string body)
		if block_name.startsWith("canvasScene")
			return expand_canvas_scene(ctx, attrs_json, scene_header(body), scene_sections(body))
		return plugin_error(ctx, "FRAME-CANVAS-E001", "frame.canvas does not expand block '" + block_name + "' (only canvasScene:)")

	string validate_block(string block_name, string attributes, string body)
		if block_name.startsWith("canvasScene")
			return validate_canvas_scene(scene_sections(body))
		return ""

	string get_keywords()
		return "[\"canvasScene\",\"assets\",\"layers\",\"state\",\"animSprite\",\"particles\",\"tween\",\"timeline\",\"animState\",\"path\",\"gradient\",\"customEase\",\"camera\",\"init\",\"draw\",\"onFrame\",\"onPointerDown\",\"onPointerMove\",\"onPointerUp\",\"onKeyDown\",\"onKeyUp\",\"onExit\",\"onPause\",\"onResume\",\"param\",\"image\",\"spritesheet\",\"sound\",\"music\",\"font\",\"src\",\"frameWidth\",\"frameHeight\",\"cols\",\"rows\",\"layer\",\"z\",\"on\",\"canvas\",\"clear\",\"circle\",\"rect\",\"line\",\"triangle\",\"ellipse\",\"text\",\"sprite\",\"save\",\"restore\",\"translate\",\"rotate\",\"scale\",\"beginPath\",\"moveTo\",\"lineTo\",\"curveTo\",\"cubicTo\",\"arc\",\"arcTo\",\"closePath\",\"closed\",\"fill\",\"stroke\",\"group\",\"clip\",\"alpha\",\"shadow\",\"blur\",\"glow\",\"blendMode\",\"sheet\",\"frames\",\"fps\",\"loop\",\"duration\",\"ease\",\"repeat\",\"yoyo\",\"delay\",\"along\",\"orient\",\"onComplete\",\"from\",\"to\",\"at\",\"after\",\"overlap\",\"gap\",\"together\",\"stagger\",\"initial\",\"transitions\",\"when\",\"emitter\",\"overLifetime\",\"forces\",\"lifetime\",\"speed\",\"angle\",\"gravity\",\"drag\",\"wind\",\"turbulence\",\"attractor\",\"rate\",\"burst\",\"linear\",\"radial\",\"stop\",\"followX\",\"followY\",\"smoothing\",\"deadzoneWidth\",\"deadzoneHeight\",\"boundsX\",\"boundsY\",\"boundsWidth\",\"boundsHeight\",\"zoom\",\"play\",\"pause\",\"resume\",\"seek\",\"start\",\"emit\",\"animate\",\"audio\",\"volume\",\"pitch\",\"fadeOut\",\"crossfade\",\"masterVolume\",\"input\",\"collision\",\"scene\",\"change\",\"changeTo\",\"push\",\"pop\",\"set\",\"get\",\"transition\",\"page\",\"value\",\"deltaTime\",\"time\",\"force\",\"current\",\"setPosition\",\"setZoom\",\"shake\",\"intensity\",\"color\",\"gradient\",\"filled\",\"radius\",\"radiusX\",\"radiusY\",\"width\",\"height\",\"cornerRadius\",\"fromX\",\"fromY\",\"toX\",\"toY\",\"size\",\"align\",\"baseline\",\"opacity\",\"tint\",\"tintStrength\",\"flipX\",\"flipY\",\"scaleX\",\"scaleY\",\"rotation\",\"anchorX\",\"anchorY\",\"offsetX\",\"offsetY\",\"mode\",\"path\"]"

// ============================================================================
// SMALL BUILDERS
// ============================================================================

functions:
	integer plugin_error(integer ctx, string code, string message)
		_emit_error(ctx, 2, code, message, "{\"start\":0,\"end\":0,\"source\":\"plugin\"}")
		return 1

	integer sl(integer ctx, string v)
		return _batch_stringLit(ctx, v)

	integer ident(integer ctx, string name)
		return _batch_ident(ctx, name)

	// A user-authored expression (a DSL attribute value), with the DSL
	// expressions inside it rewritten to bridge calls (§3.16).
	integer ue(integer ctx, string source)
		return _emit_expr_from_source(ctx, rewrite_expr(source), 0)

	// A user-authored statement (or block of statements), rewritten the same way (§3.11).
	integer us(integer ctx, string source)
		return _emit_stmt_from_source(ctx, rewrite_expr(source), 0)

	// Expression for attribute `key` of the inline attributes `ia`, or the
	// expression `default_src` when the attribute is absent.
	integer av(integer ctx, string ia, string key, string default_src)
		string src = get_iexpr(ia, key)
		if src == ""
			src = default_src
		return ue(ctx, src)

	// Integer bridge flag (1 / 0) for a boolean-literal attribute such as
	// flipX= or loop= (frame-canvas.ebnf: boolean_literal); absent is 0.
	integer avflag(integer ctx, string ia, string key)
		string src = get_iexpr(ia, key)
		if src == "true"
			return ue(ctx, "1")
		if src != "" and src != "false"
			plugin_error(ctx, "FRAME-CANVAS-E702", key + "= takes true or false, found '" + src + "'")
		return ue(ctx, "0")

	integer call0(integer ctx, string callee)
		return _batch_call(ctx, callee, _batch_arrayNew(ctx))

	integer svardecl(integer ctx, string name, string typ, integer expr)
		return _batch_stmtVarDecl(ctx, name, typ, expr)

	// Statement calls: callee(a1, ..., aN) with N = 0..8.
	integer bcc0(integer ctx, string callee)
		return _batch_stmtCall(ctx, callee, _batch_arrayNew(ctx))

	integer bcc1(integer ctx, string callee, integer a1)
		integer arr = _batch_arrayNew(ctx)
		_batch_arrayPush(ctx, arr, a1)
		return _batch_stmtCall(ctx, callee, arr)

	integer bcc2(integer ctx, string callee, integer a1, integer a2)
		integer arr = _batch_arrayNew(ctx)
		_batch_arrayPush(ctx, arr, a1)
		_batch_arrayPush(ctx, arr, a2)
		return _batch_stmtCall(ctx, callee, arr)

	integer bcc3(integer ctx, string callee, integer a1, integer a2, integer a3)
		integer arr = _batch_arrayNew(ctx)
		_batch_arrayPush(ctx, arr, a1)
		_batch_arrayPush(ctx, arr, a2)
		_batch_arrayPush(ctx, arr, a3)
		return _batch_stmtCall(ctx, callee, arr)

	integer bcc4(integer ctx, string callee, integer a1, integer a2, integer a3, integer a4)
		integer arr = _batch_arrayNew(ctx)
		_batch_arrayPush(ctx, arr, a1)
		_batch_arrayPush(ctx, arr, a2)
		_batch_arrayPush(ctx, arr, a3)
		_batch_arrayPush(ctx, arr, a4)
		return _batch_stmtCall(ctx, callee, arr)

	integer bcc5(integer ctx, string callee, integer a1, integer a2, integer a3, integer a4, integer a5)
		integer arr = _batch_arrayNew(ctx)
		_batch_arrayPush(ctx, arr, a1)
		_batch_arrayPush(ctx, arr, a2)
		_batch_arrayPush(ctx, arr, a3)
		_batch_arrayPush(ctx, arr, a4)
		_batch_arrayPush(ctx, arr, a5)
		return _batch_stmtCall(ctx, callee, arr)

	integer bcc6(integer ctx, string callee, integer a1, integer a2, integer a3, integer a4, integer a5, integer a6)
		integer arr = _batch_arrayNew(ctx)
		_batch_arrayPush(ctx, arr, a1)
		_batch_arrayPush(ctx, arr, a2)
		_batch_arrayPush(ctx, arr, a3)
		_batch_arrayPush(ctx, arr, a4)
		_batch_arrayPush(ctx, arr, a5)
		_batch_arrayPush(ctx, arr, a6)
		return _batch_stmtCall(ctx, callee, arr)

	integer bcc7(integer ctx, string callee, integer a1, integer a2, integer a3, integer a4, integer a5, integer a6, integer a7)
		integer arr = _batch_arrayNew(ctx)
		_batch_arrayPush(ctx, arr, a1)
		_batch_arrayPush(ctx, arr, a2)
		_batch_arrayPush(ctx, arr, a3)
		_batch_arrayPush(ctx, arr, a4)
		_batch_arrayPush(ctx, arr, a5)
		_batch_arrayPush(ctx, arr, a6)
		_batch_arrayPush(ctx, arr, a7)
		return _batch_stmtCall(ctx, callee, arr)

	integer bcc8(integer ctx, string callee, integer a1, integer a2, integer a3, integer a4, integer a5, integer a6, integer a7, integer a8)
		integer arr = _batch_arrayNew(ctx)
		_batch_arrayPush(ctx, arr, a1)
		_batch_arrayPush(ctx, arr, a2)
		_batch_arrayPush(ctx, arr, a3)
		_batch_arrayPush(ctx, arr, a4)
		_batch_arrayPush(ctx, arr, a5)
		_batch_arrayPush(ctx, arr, a6)
		_batch_arrayPush(ctx, arr, a7)
		_batch_arrayPush(ctx, arr, a8)
		return _batch_stmtCall(ctx, callee, arr)

	// Emit one function through the batch spec API.
	integer emit_one_fn(integer ctx, string name, integer params_h, integer body_arr_h)
		integer fns_arr = _batch_arrayNew(ctx)
		_batch_arrayPush(ctx, fns_arr, _batch_func(ctx, name, params_h, "void", body_arr_h))
		_emit_helpers_batch(ctx, _batch_spec(ctx, fns_arr), 2)
		return 0

	// Parameter list [__cv: integer] followed by up to two extra parameters
	// (pass "" for an unused name).
	integer handler_params(integer ctx, string name1, string type1, string name2, string type2)
		integer a = _batch_arrayNew(ctx)
		_batch_arrayPush(ctx, a, _batch_param(ctx, "__cv", "integer"))
		if name1 != ""
			_batch_arrayPush(ctx, a, _batch_param(ctx, name1, type1))
		if name2 != ""
			_batch_arrayPush(ctx, a, _batch_param(ctx, name2, type2))
		return a

// ============================================================================
// TEXT HELPERS
// ============================================================================

functions:
	// Indentation width (leading tabs / spaces) of a raw line.
	integer scene_indent(string line)
		integer i = 0
		while i < line.length()
			string c = line.substring(i, i + 1)
			if c != "\t" and c != " "
				return i
			i = i + 1
		return i

	// End offset (exclusive, at the newline) of the line starting at `pos`.
	integer scene_line_end(string body, integer pos)
		integer nl = body.indexOf("\n", pos)
		if nl == -1
			return body.length()
		return nl

	// First offset at or after `pos` that starts a non-blank line.
	integer scene_skip_blank(string body, integer pos)
		integer p = pos
		while p < body.length()
			integer le = scene_line_end(body, p)
			if body.substring(p, le).trim().length() > 0
				return p
			p = le + 1
		return body.length()

	// Offset just past the child block of the line starting at `pos`: the
	// following lines indented deeper than `ind` (blank lines inside the
	// block belong to it, trailing blank lines do not).
	integer scene_child_end(string body, integer pos, integer ind)
		integer p = scene_line_end(body, pos) + 1
		integer last = p
		while p < body.length()
			integer le = scene_line_end(body, p)
			string ln = body.substring(p, le)
			if ln.trim().length() == 0
				p = le + 1
			else if scene_indent(ln) > ind
				p = le + 1
				last = p
			else
				p = body.length()
		if last > body.length()
			return body.length()
		return last

	// Remove `ind` leading indentation characters from every line of `src`.
	string scene_dedent(string src, integer ind)
		string out = ""
		integer p = 0
		while p < src.length()
			integer le = scene_line_end(src, p)
			string ln = src.substring(p, le)
			if scene_indent(ln) >= ind
				ln = ln.substring(ind, ln.length())
			out = out + ln + "\n"
			p = le + 1
		return out

	// Indentation of the scene's own sub-block headers: that of the first
	// non-blank line of the body.
	integer scene_base_indent(string body)
		integer p = scene_skip_blank(body, 0)
		if p >= body.length()
			return 0
		return scene_indent(body.substring(p, scene_line_end(body, p)))

	// The canvasScene body as the compiler passes it starts with the rest of
	// the header line (`id="x" width=800 ...`) when the header has
	// attributes; the sub-blocks follow.
	boolean starts_with_header_attrs(string body)
		if body.startsWith("\n")
			return false
		string first = body.substring(0, scene_line_end(body, 0)).trim()
		return first != "" and section_rank(first) == -1 and first.indexOf("=") != -1

	string scene_header(string body)
		if starts_with_header_attrs(body)
			return body.substring(0, scene_line_end(body, 0)).trim()
		return ""

	string scene_sections(string body)
		if starts_with_header_attrs(body)
			integer le = scene_line_end(body, 0)
			if le >= body.length()
				return ""
			return body.substring(le + 1, body.length())
		return body

	// True when the trimmed line `t` is a header of sub-block `keyword`
	// (`keyword:`, `keyword "name":`, `keyword param=...:`).
	boolean is_header_of(string t, string keyword)
		return t == keyword + ":" or t.startsWith(keyword + " ") or t.startsWith(keyword + ":")

	// Body (lines indented under it, indentation kept) of the first
	// top-level sub-block `keyword`; "" when absent.
	string extract_scene_subblock(string body, string keyword)
		integer base = scene_base_indent(body)
		integer p = 0
		while p < body.length()
			integer le = scene_line_end(body, p)
			string line = body.substring(p, le)
			string t = line.trim()
			if t.length() > 0 and scene_indent(line) == base and is_header_of(t, keyword)
				integer ce = scene_child_end(body, p, base)
				if ce > le + 1
					return body.substring(le + 1, ce)
				return ""
			p = le + 1
		return ""

	// Header line (trimmed) of the first top-level sub-block `keyword`; "" when absent.
	string extract_scene_header(string body, string keyword)
		integer base = scene_base_indent(body)
		integer p = 0
		while p < body.length()
			integer le = scene_line_end(body, p)
			string line = body.substring(p, le)
			string t = line.trim()
			if t.length() > 0 and scene_indent(line) == base and is_header_of(t, keyword)
				return t
			p = le + 1
		return ""

	// Value of `attr="..."` on a header line, or `default_val`.
	string header_attr(string header, string attr, string default_val)
		string pat = attr + "=\""
		integer pos = header.indexOf(pat)
		if pos == -1
			return default_val
		integer vs = pos + pat.length()
		integer ve = header.indexOf("\"", vs)
		if ve == -1
			return default_val
		return header.substring(vs, ve)

	// Text of the first double-quoted string in `s` at or after `from_pos`; "" when none.
	string first_quoted(string s, integer from_pos)
		integer q1 = s.indexOf("\"", from_pos)
		if q1 == -1
			return ""
		integer q2 = s.indexOf("\"", q1 + 1)
		if q2 == -1
			return ""
		return s.substring(q1 + 1, q2)

	// The rest of `s` after its first double-quoted string.
	string after_quoted(string s)
		integer q1 = s.indexOf("\"")
		if q1 == -1
			return s
		integer q2 = s.indexOf("\"", q1 + 1)
		if q2 == -1
			return ""
		return s.substring(q2 + 1, s.length()).trim()

	// The text after the first `=` of a `key = value` line, without a
	// trailing `//` comment.
	string line_value(string t)
		integer eq = t.indexOf("=")
		if eq == -1
			return ""
		string v = t.substring(eq + 1, t.length())
		integer c = v.indexOf("//")
		if c != -1
			v = v.substring(0, c)
		return v.trim()

	// The word before the first `=` or space of a `key = value` line.
	string line_key(string t)
		integer i = 0
		while i < t.length()
			string c = t.substring(i, i + 1)
			if c == " " or c == "=" or c == "\t"
				return t.substring(0, i)
			i = i + 1
		return t

	// Value of `key = value` in a sub-block body (one attribute per line),
	// or `default_val`.
	string body_attr(string body, string key, string default_val)
		integer p = 0
		while p < body.length()
			integer le = scene_line_end(body, p)
			string t = body.substring(p, le).trim()
			if line_key(t) == key and t.indexOf("=") != -1
				return line_value(t)
			p = le + 1
		return default_val

	// A Clean string literal holding the raw text `s`.
	string clean_str(string s)
		string r = s.replace("\\", "\\\\")
		r = r.replace("\"", "\\\"")
		r = r.replace("{", "\\{")
		r = r.replace("}", "\\}")
		return "\"" + r + "\""

	string json_escape(string s)
		string r = s.replace("\\", "\\\\")
		r = r.replace("\"", "\\\"")
		r = r.replace("\n", "\\n")
		r = r.replace("\t", "\\t")
		return r

	boolean is_ident_char(string c)
		return (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or (c >= "0" and c <= "9") or c == "_"

	// camelCase -> snake_case.
	string snake(string s)
		string out = ""
		integer i = 0
		while i < s.length()
			string c = s.substring(i, i + 1)
			if c >= "A" and c <= "Z"
				out = out + "_" + c.toLowerCase()
			else
				out = out + c
			i = i + 1
		return out

	// Source text of attribute `key` in the inline attributes `ia`: quoted
	// strings keep their quotes and the value runs until the next ` name=`
	// attribute, so it may be an expression with spaces (`radius=size * 2.0`).
	// "" when absent. `key=` only matches at the start of an attribute (so
	// `x=` does not match inside `rx=`), and never `key==`.
	string get_iexpr(string ia, string key)
		string pat = key + "="
		integer pos = -1
		integer search_from = 0
		while search_from <= ia.length() and pos == -1
			integer at = ia.indexOf(pat, search_from)
			if at == -1
				search_from = ia.length() + 1
			else
				boolean at_start = at == 0
				if at > 0
					string prev_char = ia.substring(at - 1, at)
					at_start = prev_char == " " or prev_char == "\t"
				integer after_pos = at + pat.length()
				boolean is_compare = false
				if after_pos < ia.length()
					is_compare = ia.substring(after_pos, after_pos + 1) == "="
				if at_start and is_compare == false
					pos = at
				else
					search_from = at + 1
		if pos == -1
			return ""
		integer vs = pos + pat.length()
		if vs >= ia.length()
			return ""
		// The value runs to the next ` name=` outside string literals, so it
		// may mix literals and operators (`value="Lives: " + lives.toString()`).
		integer ve2 = ia.length()
		integer i = vs
		while i < ia.length()
			string c = ia.substring(i, i + 1)
			if c == "\""
				i = i + 1
				while i < ia.length() and ia.substring(i, i + 1) != "\""
					if ia.substring(i, i + 1) == "\\"
						i = i + 1
					i = i + 1
			else if c == " " and iexpr_attr_starts(ia, i + 1)
				ve2 = i
				i = ia.length()
			i = i + 1
		return ia.substring(vs, ve2).trim()

	// True when an attribute `name=` (not `name==`) starts at `pos` in `ia`.
	boolean iexpr_attr_starts(string ia, integer pos)
		integer i = pos
		while i < ia.length()
			string c = ia.substring(i, i + 1)
			boolean is_name = (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or c == "_" or (i > pos and c >= "0" and c <= "9")
			if c == "="
				if i == pos
					return false
				if i + 1 < ia.length()
					return ia.substring(i + 1, i + 2) != "="
				return true
			if is_name == false
				return false
			i = i + 1
		return false

	// Integer id of an easing name for the _tween_animate / _camera_shake
	// bridges (canvas runtime _easeIdToName order). Unknown names are linear.
	integer ease_id(string name)
		string n = name.replace("\"", "")
		if n == "easeInCubic"
			return 1
		if n == "easeOutCubic"
			return 2
		if n == "easeInOutCubic"
			return 3
		if n == "easeInQuad"
			return 4
		if n == "easeOutQuad"
			return 5
		if n == "easeInOutQuad"
			return 6
		if n == "easeInSine"
			return 7
		if n == "easeOutSine"
			return 8
		if n == "easeInOutSine"
			return 9
		if n == "easeInExpo"
			return 10
		if n == "easeOutExpo"
			return 11
		if n == "easeInOutExpo"
			return 12
		if n == "easeInElastic"
			return 13
		if n == "easeOutElastic"
			return 14
		if n == "easeInOutElastic"
			return 15
		if n == "easeInBounce"
			return 16
		if n == "easeOutBounce"
			return 17
		if n == "easeInOutBounce"
			return 18
		if n == "easeInBack"
			return 19
		if n == "easeOutBack"
			return 20
		if n == "easeInOutBack"
			return 21
		return 0

// ============================================================================
// DSL EXPRESSION REWRITING
// ============================================================================
// Expression forms of the canvas DSL that are not plain Clean calls:
//   deltaTime() / time() / fps()              (frame-canvas.ebnf §27)
//   input.mouseX, input.keyDown("a"), ...     (§22)
//   collision.circles x1=.. y1=.. ...         (§23)
//   scene.get "k" / page.get "k"              (§25, §26)
//   animState.current "fsm"                   (§20)
// rewrite_expr turns each into its bridge call, leaving string literals and
// everything else untouched.

functions:
	string rewrite_expr(string src)
		string out = ""
		integer i = 0
		integer n = src.length()
		while i < n
			string c = src.substring(i, i + 1)
			if c == "\""
				integer j = i + 1
				while j < n and src.substring(j, j + 1) != "\""
					if src.substring(j, j + 1) == "\\"
						j = j + 1
					j = j + 1
				out = out + src.substring(i, j + 1)
				i = j + 1
			else
				boolean boundary = true
				if i > 0
					string prev = src.substring(i - 1, i)
					boundary = is_ident_char(prev) == false and prev != "."
				string rest = src.substring(i, n)
				if boundary and rest.startsWith("deltaTime()")
					out = out + "_canvas_get_delta_time()"
					i = i + 11
				else if boundary and rest.startsWith("time()")
					out = out + "_canvas_get_time()"
					i = i + 6
				else if boundary and rest.startsWith("fps()")
					out = out + "_canvas_get_fps()"
					i = i + 5
				else if boundary and rest.startsWith("input.")
					integer e = word_end(src, i + 6)
					string member = src.substring(i + 6, e)
					string args = ""
					integer after_call = e
					if e < n and src.substring(e, e + 1) == "("
						integer close = matching_paren(src, e)
						args = src.substring(e + 1, close)
						after_call = close + 1
					out = out + input_call(member, args)
					i = after_call
				else if boundary and rest.startsWith("collision.")
					integer e = word_end(src, i + 10)
					string member = src.substring(i + 10, e)
					if e < n and src.substring(e, e + 1) == "("
						out = out + "collision." + member
						i = e
					else
						integer stop_at = attr_region_end(src, e)
						out = out + collision_call(member, src.substring(e, stop_at).trim())
						i = stop_at
				else if boundary and quoted_call_prefix(rest) != ""
					string prefix = quoted_call_prefix(rest)
					integer q1 = src.indexOf("\"", i + prefix.length())
					integer q2 = src.indexOf("\"", q1 + 1)
					out = out + quoted_call_bridge(prefix) + "(" + src.substring(q1, q2 + 1) + ")"
					i = q2 + 1
				else
					out = out + c
					i = i + 1
		return out

	// `scene.get "`, `page.get "`, `animState.current "` prefix of `rest`, or "".
	string quoted_call_prefix(string rest)
		if rest.startsWith("scene.get \"")
			return "scene.get "
		if rest.startsWith("page.get \"")
			return "page.get "
		if rest.startsWith("animState.current \"")
			return "animState.current "
		return ""

	string quoted_call_bridge(string prefix)
		if prefix == "scene.get "
			return "_scene_get"
		if prefix == "page.get "
			return "_page_get"
		return "_anim_state_current"

	// End offset of the identifier starting at `pos`.
	integer word_end(string src, integer pos)
		integer i = pos
		while i < src.length() and is_ident_char(src.substring(i, i + 1))
			i = i + 1
		return i

	// Offset of the `)` matching the `(` at `open` (string-aware).
	integer matching_paren(string src, integer open)
		integer depth = 0
		integer i = open
		while i < src.length()
			string c = src.substring(i, i + 1)
			if c == "\""
				integer j = i + 1
				while j < src.length() and src.substring(j, j + 1) != "\""
					j = j + 1
				i = j
			else if c == "("
				depth = depth + 1
			else if c == ")"
				depth = depth - 1
				if depth == 0
					return i
			i = i + 1
		return src.length()

	// End of a named-attribute region starting at `pos`: the first top-level
	// comparison or logical operator, `)` / `,` closing an enclosing call,
	// or the end of the text.
	integer attr_region_end(string src, integer pos)
		integer depth = 0
		integer i = pos
		while i < src.length()
			string c = src.substring(i, i + 1)
			string rest = src.substring(i, src.length())
			if c == "\""
				integer j = i + 1
				while j < src.length() and src.substring(j, j + 1) != "\""
					j = j + 1
				i = j
			else if c == "("
				depth = depth + 1
			else if c == ")" or c == ","
				if depth == 0
					return i
				if c == ")"
					depth = depth - 1
			else if depth == 0
				if rest.startsWith(" == ") or rest.startsWith(" != ") or rest.startsWith(" < ") or rest.startsWith(" > ") or rest.startsWith(" <= ") or rest.startsWith(" >= ") or rest.startsWith(" and ") or rest.startsWith(" or ")
					return i
			i = i + 1
		return src.length()

	string input_call(string member, string args)
		string a = args.trim()
		if member == "wheelY"
			return "_input_mouse_wheel_y()"
		if member == "lastKey"
			return "_input_get_last_key()"
		if a == "" and (member == "mousePressed" or member == "mouseJustPressed" or member == "mouseJustReleased")
			a = "0"
		return "_input_" + snake(member) + "(" + a + ")"

	// collision.<method> with named attributes -> positional bridge call
	// (frame-canvas.ebnf §23 attribute order).
	string collision_call(string member, string ia)
		string keys = ""
		if member == "circles"
			keys = "x1 y1 r1 x2 y2 r2"
		else if member == "rects"
			keys = "x1 y1 w1 h1 x2 y2 w2 h2"
		else if member == "pointRect"
			keys = "px py rx ry rw rh"
		else if member == "circleRect"
			keys = "cx cy r rx ry rw rh"
		else if member == "pointCircle"
			keys = "px py cx cy r"
		else if member == "rayCircle"
			keys = "ox oy dx dy cx cy r"
		else
			return "collision." + member + " " + ia
		string out = "_collision_" + snake(member) + "("
		integer p = 0
		boolean first = true
		while p < keys.length()
			integer sp = keys.indexOf(" ", p)
			if sp == -1
				sp = keys.length()
			string v = get_iexpr(ia, keys.substring(p, sp))
			if v == ""
				v = "0.0"
			if first == false
				out = out + ", "
			out = out + "(" + v + ")"
			first = false
			p = sp + 1
		return out + ")"

// ============================================================================
// STATE VARIABLES (frame-canvas.ebnf §5, CVS-X008, CVS-S012)
// ============================================================================
// A state line is `type name = expr`. The runtime store holds numbers, so an
// integer travels as a number and a boolean as 1.0 / 0.0.

functions:
	string state_type(string t)
		integer sp = t.indexOf(" ")
		if sp == -1
			return ""
		return t.substring(0, sp)

	string state_name(string t)
		integer sp = t.indexOf(" ")
		if sp == -1
			return ""
		string rest = t.substring(sp + 1, t.length()).trim()
		integer e = word_end(rest, 0)
		return rest.substring(0, e)

	boolean is_state_line(string t)
		return t.length() > 0 and t.startsWith("//") == false and state_name(t) != ""

	// Statement loading the state variable on line `t` into a typed local.
	string state_load_src(string t)
		string ty = state_type(t)
		string nm = state_name(t)
		string getter = "_canvas_var_get(" + clean_str(nm) + ", 0.0)"
		if ty == "integer"
			return "integer " + nm + " = " + getter + ".toInteger()"
		if ty == "boolean"
			return "boolean " + nm + " = " + getter + " != 0.0"
		return "number " + nm + " = " + getter

	// Statement storing the local back into the runtime store.
	string state_save_src(string t)
		string ty = state_type(t)
		string nm = state_name(t)
		string key = clean_str(nm)
		if ty == "integer"
			return "_canvas_var_set(" + key + ", " + nm + ".toNumber())"
		if ty == "boolean"
			return "if " + nm + "\n\t_canvas_var_set(" + key + ", 1.0)\nelse\n\t_canvas_var_set(" + key + ", 0.0)\n"
		return "_canvas_var_set(" + key + ", " + nm + ")"

	// Push one load (mode 0), save (mode 1) or declaration (mode 2) statement
	// per state variable into `arr`.
	integer state_stmts(integer ctx, integer arr, string state_body, integer mode)
		integer p = 0
		while p < state_body.length()
			integer le = scene_line_end(state_body, p)
			string t = state_body.substring(p, le).trim()
			integer c = t.indexOf("//")
			if c > 0
				t = t.substring(0, c).trim()
			if is_state_line(t)
				string src = state_load_src(t)
				if mode == 1
					src = state_save_src(t)
				if mode == 2
					src = t
				_batch_arrayPush(ctx, arr, us(ctx, src))
			p = le + 1
		return 0

	// Type of state variable `name`, or "" when it is not a state variable.
	string state_var_type(string state_body, string name)
		integer p = 0
		while p < state_body.length()
			integer le = scene_line_end(state_body, p)
			string t = state_body.substring(p, le).trim()
			if is_state_line(t) and state_name(t) == name
				return state_type(t)
			p = le + 1
		return ""

// ============================================================================
// SCENE BODY EXPANSION
// ============================================================================

functions:
	// Expand the statements of a handler / draw / init body into `body_arr`.
	// A statement's child block is the following lines indented deeper than
	// it. Recognised forms:
	//   comment lines                      -> nothing
	//   on layer "name":                   -> _layer_begin / child / _layer_end
	//   canvas.<cmd> ... [:]               -> scene_expand_cmd (scoped blocks wrap the child)
	//   DSL statements (play tween, ...)   -> dsl_statement
	//   return                             -> state store + return
	//   while / if / else / iterate        -> batch statements, bodies expanded recursively
	//   anything else                      -> user Clean code (_emit_stmt_from_source)
	// `state_body` is the scene's state: block ("" when the body must not
	// store state, e.g. draw:).
	integer scene_expand_lines(integer ctx, integer body_arr, string body, string state_body)
		integer pos = 0
		integer len = body.length()
		while pos < len
			integer le = scene_line_end(body, pos)
			string line = body.substring(pos, le)
			string t = line.trim()
			integer ind = scene_indent(line)
			integer child_end = scene_child_end(body, pos, ind)
			string child = ""
			if child_end > le + 1
				child = body.substring(le + 1, child_end)
			integer next_pos = le + 1
			if child_end > next_pos
				next_pos = child_end
			if t.startsWith("//")
				t = ""
			if t.length() > 0
				if t.startsWith("on layer ")
					_batch_arrayPush(ctx, body_arr, bcc1(ctx, "_layer_begin", sl(ctx, first_quoted(t, 0))))
					scene_expand_lines(ctx, body_arr, child, state_body)
					_batch_arrayPush(ctx, body_arr, bcc0(ctx, "_layer_end"))
				else if t.startsWith("canvas.")
					scene_expand_canvas(ctx, body_arr, t, child, state_body)
				else if is_dsl_statement(t)
					_batch_arrayPush(ctx, body_arr, dsl_statement(ctx, t, state_body))
				else if t == "return"
					if state_body != ""
						state_stmts(ctx, body_arr, state_body, 1)
					_batch_arrayPush(ctx, body_arr, us(ctx, "return"))
				else if child.trim().length() == 0
					_batch_arrayPush(ctx, body_arr, us(ctx, t))
				else if t.startsWith("while ")
					integer w_arr = _batch_arrayNew(ctx)
					scene_expand_lines(ctx, w_arr, child, state_body)
					_batch_arrayPush(ctx, body_arr, _batch_stmtWhile(ctx, ue(ctx, t.substring(6, t.length()).trim()), w_arr))
				else if t.startsWith("if ")
					next_pos = scene_expand_if(ctx, body_arr, body, pos, ind, t.substring(3, t.length()).trim(), state_body)
				else if t.startsWith("iterate ") and t.indexOf(" in ") != -1
					integer in_at = t.indexOf(" in ")
					string iter_var = t.substring(8, in_at).trim()
					string iterable = t.substring(in_at + 4, t.length()).trim()
					if iterable.indexOf(" to ") != -1
						_batch_arrayPush(ctx, body_arr, range_loop(ctx, iter_var, iterable, child, state_body))
					else
						integer f_arr = _batch_arrayNew(ctx)
						scene_expand_lines(ctx, f_arr, child, state_body)
						_batch_arrayPush(ctx, body_arr, _batch_stmtFor(ctx, iter_var, ue(ctx, iterable), f_arr))
				else
					// Any other block statement is user-authored as a whole.
					_batch_arrayPush(ctx, body_arr, us(ctx, scene_dedent(body.substring(pos, child_end), ind)))
			pos = next_pos
		return 0

	// `iterate v in A to B [step S]` (inclusive) as a while loop — the batch
	// API's stmtFor iterates collections only. The counter advances at the
	// top of each pass so a `continue` in the body cannot skip it:
	//   { integer __it_v = (A) - (S)   integer __end_v = B
	//     while <__it_v + S has not passed __end_v>
	//         __it_v = __it_v + (S)
	//         integer v = __it_v
	//         <body> }
	integer range_loop(integer ctx, string var_name, string iterable, string child, string state_body)
		integer to_at = iterable.indexOf(" to ")
		string from_src = iterable.substring(0, to_at).trim()
		string rest = iterable.substring(to_at + 4, iterable.length()).trim()
		string step_src = "1"
		integer step_at = rest.indexOf(" step ")
		if step_at != -1
			step_src = rest.substring(step_at + 6, rest.length()).trim()
			rest = rest.substring(0, step_at).trim()
		string it = "__it_" + var_name
		string end_name = "__end_" + var_name
		string next_src = it + " + (" + step_src + ")"
		string cond = next_src + " <= " + end_name
		if step_src.startsWith("-")
			cond = next_src + " >= " + end_name
		else if is_int_literal(step_src) == false
			cond = "((" + step_src + ") > 0 and " + next_src + " <= " + end_name + ") or ((" + step_src + ") < 0 and " + next_src + " >= " + end_name + ")"
		integer seq = _batch_arrayNew(ctx)
		_batch_arrayPush(ctx, seq, us(ctx, "integer " + it + " = (" + from_src + ") - (" + step_src + ")"))
		_batch_arrayPush(ctx, seq, us(ctx, "integer " + end_name + " = " + rest))
		integer w_arr = _batch_arrayNew(ctx)
		_batch_arrayPush(ctx, w_arr, us(ctx, it + " = " + next_src))
		_batch_arrayPush(ctx, w_arr, us(ctx, "integer " + var_name + " = " + it))
		scene_expand_lines(ctx, w_arr, child, state_body)
		_batch_arrayPush(ctx, seq, _batch_stmtWhile(ctx, ue(ctx, cond), w_arr))
		return _batch_stmtBlock(ctx, seq)

	boolean is_int_literal(string s)
		if s.length() == 0
			return false
		integer i = 0
		while i < s.length()
			string c = s.substring(i, i + 1)
			if c < "0" or c > "9"
				return false
			i = i + 1
		return true

	// The `if` (or `else if`) header line at `pos` (indentation `ind`) with
	// condition `cond`, plus its `else if` / `else` siblings at the same
	// indentation. Pushes one if statement and returns the offset after the chain.
	integer scene_expand_if(integer ctx, integer body_arr, string body, integer pos, integer ind, string cond, string state_body)
		integer le = scene_line_end(body, pos)
		integer child_end = scene_child_end(body, pos, ind)
		integer then_arr = _batch_arrayNew(ctx)
		if child_end > le + 1
			scene_expand_lines(ctx, then_arr, body.substring(le + 1, child_end), state_body)
		integer next_pos = le + 1
		if child_end > next_pos
			next_pos = child_end
		integer else_arr = 0
		integer sib = scene_skip_blank(body, next_pos)
		if sib < body.length()
			integer sle = scene_line_end(body, sib)
			string sline = body.substring(sib, sle)
			string st = sline.trim()
			if scene_indent(sline) == ind
				if st.startsWith("else if ")
					else_arr = _batch_arrayNew(ctx)
					next_pos = scene_expand_if(ctx, else_arr, body, sib, ind, st.substring(8, st.length()).trim(), state_body)
				else if st == "else"
					integer else_end = scene_child_end(body, sib, ind)
					else_arr = _batch_arrayNew(ctx)
					if else_end > sle + 1
						scene_expand_lines(ctx, else_arr, body.substring(sle + 1, else_end), state_body)
					next_pos = sle + 1
					if else_end > next_pos
						next_pos = else_end
		_batch_arrayPush(ctx, body_arr, _batch_stmtIf(ctx, ue(ctx, cond), then_arr, else_arr))
		return next_pos

	// Run a handler body between a state load and a state store.
	integer handler_body(integer ctx, integer arr, string body, string state_body)
		state_stmts(ctx, arr, state_body, 0)
		scene_expand_lines(ctx, arr, body, state_body)
		state_stmts(ctx, arr, state_body, 1)
		return 0

// ============================================================================
// DRAWING COMMANDS (frame-canvas.ebnf §17, §18)
// ============================================================================

functions:
	// One `canvas.<cmd> attrs` line, with its child block for the scoped
	// forms (group, clip, alpha, shadow, blur, glow, blendMode).
	integer scene_expand_canvas(integer ctx, integer body_arr, string t, string child, string state_body)
		string line = t
		if line.endsWith(":")
			line = line.substring(0, line.length() - 1).trim()
		integer sp = line.indexOf(" ")
		string cmd = line.substring(7, line.length())
		string ia = ""
		if sp != -1
			cmd = line.substring(7, sp)
			ia = line.substring(sp + 1, line.length()).trim()
		integer cv = ident(ctx, "__cv")
		boolean scoped = child.trim().length() > 0
		string end_fn = ""
		if scoped
			if cmd == "group"
				_batch_arrayPush(ctx, body_arr, bcc7(ctx, "_canvas_group_begin", cv, av(ctx, ia, "x", "0.0"), av(ctx, ia, "y", "0.0"), av(ctx, ia, "rotation", "0.0"), av(ctx, ia, "scaleX", "1.0"), av(ctx, ia, "scaleY", "1.0"), av(ctx, ia, "alpha", "1.0")))
				end_fn = "_canvas_group_end"
			else if cmd == "clip"
				if get_iexpr(ia, "path") != ""
					_batch_arrayPush(ctx, body_arr, bcc2(ctx, "_canvas_clip_path", cv, av(ctx, ia, "path", "\"\"")))
				else if get_iexpr(ia, "radius") != ""
					_batch_arrayPush(ctx, body_arr, bcc4(ctx, "_canvas_clip_circle", cv, av(ctx, ia, "x", "0.0"), av(ctx, ia, "y", "0.0"), av(ctx, ia, "radius", "0.0")))
				else
					_batch_arrayPush(ctx, body_arr, bcc5(ctx, "_canvas_clip_rect", cv, av(ctx, ia, "x", "0.0"), av(ctx, ia, "y", "0.0"), av(ctx, ia, "width", "0.0"), av(ctx, ia, "height", "0.0")))
				end_fn = "_canvas_clip_end"
			else if cmd == "alpha"
				_batch_arrayPush(ctx, body_arr, bcc2(ctx, "_canvas_alpha_begin", cv, av(ctx, ia, "value", "1.0")))
				end_fn = "_canvas_alpha_end"
			else if cmd == "shadow"
				_batch_arrayPush(ctx, body_arr, bcc5(ctx, "_canvas_shadow_begin", cv, av(ctx, ia, "blur", "0.0"), av(ctx, ia, "offsetX", "0.0"), av(ctx, ia, "offsetY", "0.0"), av(ctx, ia, "color", "\"rgba(0,0,0,0.5)\"")))
				end_fn = "_canvas_shadow_end"
			else if cmd == "blur"
				_batch_arrayPush(ctx, body_arr, bcc2(ctx, "_canvas_blur_begin", cv, av(ctx, ia, "radius", "0.0")))
				end_fn = "_canvas_blur_end"
			else if cmd == "glow"
				_batch_arrayPush(ctx, body_arr, bcc3(ctx, "_canvas_glow_begin", cv, av(ctx, ia, "color", "\"#ffffff\""), av(ctx, ia, "blur", "10.0")))
				end_fn = "_canvas_glow_end"
			else if cmd == "blendMode"
				_batch_arrayPush(ctx, body_arr, bcc2(ctx, "_canvas_blend_begin", cv, av(ctx, ia, "mode", "\"source-over\"")))
				end_fn = "_canvas_blend_end"
			if end_fn == ""
				return plugin_error(ctx, "FRAME-CANVAS-E701", "canvas." + cmd + " does not take a child block (frame-canvas.ebnf §18)")
			scene_expand_lines(ctx, body_arr, child, state_body)
			_batch_arrayPush(ctx, body_arr, bcc1(ctx, end_fn, ident(ctx, "__cv")))
			return 0
		integer h = scene_expand_cmd(ctx, cmd, ia)
		if h == 0
			return plugin_error(ctx, "FRAME-CANVAS-E700", "unknown drawing command canvas." + cmd + " (frame-canvas.ebnf §17)")
		_batch_arrayPush(ctx, body_arr, h)
		return 0

	// Statement handle for the single-line drawing command `cmd` with inline
	// attributes `ia`; 0 for an unknown command.
	integer scene_expand_cmd(integer ctx, string cmd, string ia)
		integer cv = ident(ctx, "__cv")
		string black = "\"#000000\""
		boolean outline = get_iexpr(ia, "filled") == "false"

		if cmd == "clear"
			if get_iexpr(ia, "color") == ""
				return bcc1(ctx, "_canvas_clear", cv)
			return bcc2(ctx, "_canvas_clear_color", cv, av(ctx, ia, "color", ""))

		if cmd == "circle"
			string r_key = "radius"
			if get_iexpr(ia, "radius") == ""
				r_key = "r"
			if get_iexpr(ia, "gradient") != ""
				return bcc5(ctx, "_canvas_circle_gradient", cv, av(ctx, ia, "x", "0.0"), av(ctx, ia, "y", "0.0"), av(ctx, ia, r_key, "10.0"), av(ctx, ia, "gradient", ""))
			string circle_fn = "_canvas_circle_filled"
			if outline
				circle_fn = "_canvas_circle_outline"
			return bcc5(ctx, circle_fn, cv, av(ctx, ia, "x", "0.0"), av(ctx, ia, "y", "0.0"), av(ctx, ia, r_key, "10.0"), av(ctx, ia, "color", black))

		if cmd == "rect"
			if get_iexpr(ia, "gradient") != ""
				return bcc6(ctx, "_canvas_rect_gradient", cv, av(ctx, ia, "x", "0.0"), av(ctx, ia, "y", "0.0"), av(ctx, ia, "width", "100.0"), av(ctx, ia, "height", "100.0"), av(ctx, ia, "gradient", ""))
			if get_iexpr(ia, "cornerRadius") != ""
				return bcc7(ctx, "_canvas_rect_rounded", cv, av(ctx, ia, "x", "0.0"), av(ctx, ia, "y", "0.0"), av(ctx, ia, "width", "100.0"), av(ctx, ia, "height", "100.0"), av(ctx, ia, "cornerRadius", "0.0"), av(ctx, ia, "color", black))
			string rect_fn = "_canvas_rect_filled"
			if outline
				rect_fn = "_canvas_rect_outline"
			return bcc6(ctx, rect_fn, cv, av(ctx, ia, "x", "0.0"), av(ctx, ia, "y", "0.0"), av(ctx, ia, "width", "100.0"), av(ctx, ia, "height", "100.0"), av(ctx, ia, "color", black))

		if cmd == "line"
			return bcc7(ctx, "_canvas_line", cv, av(ctx, ia, "fromX", "0.0"), av(ctx, ia, "fromY", "0.0"), av(ctx, ia, "toX", "0.0"), av(ctx, ia, "toY", "0.0"), av(ctx, ia, "stroke", "1.0"), av(ctx, ia, "color", black))

		if cmd == "triangle"
			string tri_fn = "_canvas_triangle_filled"
			if outline
				tri_fn = "_canvas_triangle_outline"
			return bcc8(ctx, tri_fn, cv, av(ctx, ia, "x1", "0.0"), av(ctx, ia, "y1", "0.0"), av(ctx, ia, "x2", "0.0"), av(ctx, ia, "y2", "0.0"), av(ctx, ia, "x3", "0.0"), av(ctx, ia, "y3", "0.0"), av(ctx, ia, "color", black))

		if cmd == "ellipse"
			string rx_key = "radiusX"
			if get_iexpr(ia, "radiusX") == ""
				rx_key = "rx"
			string ry_key = "radiusY"
			if get_iexpr(ia, "radiusY") == ""
				ry_key = "ry"
			string ell_fn = "_canvas_ellipse_filled"
			if outline
				ell_fn = "_canvas_ellipse_outline"
			return bcc6(ctx, ell_fn, cv, av(ctx, ia, "x", "0.0"), av(ctx, ia, "y", "0.0"), av(ctx, ia, rx_key, "50.0"), av(ctx, ia, ry_key, "25.0"), av(ctx, ia, "color", black))

		if cmd == "text"
			string value_src = get_iexpr(ia, "value")
			if value_src == ""
				plugin_error(ctx, "FRAME-CANVAS-E703", "canvas.text needs value= (frame-canvas.ebnf §17: canvas.text value=expr x= y= ...)")
				value_src = "\"\""
			if value_src.startsWith("\"") == false
				value_src = "(" + value_src + ").toString()"
			integer value_h = ue(ctx, value_src)
			string font = get_iexpr(ia, "font")
			if font != ""
				// The font bridge takes a CSS font: fold size= into it.
				string size_src = get_iexpr(ia, "size")
				if size_src == ""
					size_src = "16"
				integer font_h = ue(ctx, "(" + size_src + ").toString() + \"px \" + " + font)
				return bcc8(ctx, "_canvas_text_font", cv, value_h, font_h, av(ctx, ia, "x", "0.0"), av(ctx, ia, "y", "0.0"), av(ctx, ia, "color", black), av(ctx, ia, "align", "\"start\""), av(ctx, ia, "baseline", "\"alphabetic\""))
			if get_iexpr(ia, "align") != "" or get_iexpr(ia, "baseline") != ""
				return bcc8(ctx, "_canvas_text_aligned", cv, value_h, av(ctx, ia, "x", "0.0"), av(ctx, ia, "y", "0.0"), av(ctx, ia, "size", "16.0"), av(ctx, ia, "color", black), av(ctx, ia, "align", "\"start\""), av(ctx, ia, "baseline", "\"alphabetic\""))
			return bcc6(ctx, "_canvas_text", cv, value_h, av(ctx, ia, "x", "0.0"), av(ctx, ia, "y", "0.0"), av(ctx, ia, "size", "16.0"), av(ctx, ia, "color", black))

		if cmd == "image"
			if get_iexpr(ia, "opacity") != ""
				return bcc7(ctx, "_canvas_image_opacity", cv, av(ctx, ia, "src", "\"\""), av(ctx, ia, "x", "0.0"), av(ctx, ia, "y", "0.0"), av(ctx, ia, "width", "0.0"), av(ctx, ia, "height", "0.0"), av(ctx, ia, "opacity", "1.0"))
			return bcc6(ctx, "_canvas_image", cv, av(ctx, ia, "src", "\"\""), av(ctx, ia, "x", "0.0"), av(ctx, ia, "y", "0.0"), av(ctx, ia, "width", "0.0"), av(ctx, ia, "height", "0.0"))

		if cmd == "sprite"
			return sprite_cmd(ctx, ia)

		if cmd == "save"
			return bcc1(ctx, "_canvas_save", cv)
		if cmd == "restore"
			return bcc1(ctx, "_canvas_restore", cv)
		if cmd == "translate"
			return bcc3(ctx, "_canvas_translate", cv, av(ctx, ia, "x", "0.0"), av(ctx, ia, "y", "0.0"))
		if cmd == "rotate"
			return bcc2(ctx, "_canvas_rotate", cv, av(ctx, ia, "angle", "0.0"))
		if cmd == "scale"
			return bcc3(ctx, "_canvas_scale", cv, av(ctx, ia, "x", "1.0"), av(ctx, ia, "y", "1.0"))

		// Single-line effect settings (the scoped forms are handled by the caller).
		if cmd == "alpha"
			return bcc2(ctx, "_canvas_set_alpha", cv, av(ctx, ia, "value", "1.0"))
		if cmd == "blendMode"
			return bcc2(ctx, "_canvas_set_blend_mode", cv, av(ctx, ia, "mode", "\"source-over\""))
		if cmd == "shadow"
			return bcc5(ctx, "_canvas_set_shadow", cv, av(ctx, ia, "blur", "0.0"), av(ctx, ia, "offsetX", "0.0"), av(ctx, ia, "offsetY", "0.0"), av(ctx, ia, "color", "\"rgba(0,0,0,0.5)\""))

		// Immediate-mode path API (§17, spec §6.10).
		if cmd == "beginPath"
			return bcc1(ctx, "_canvas_begin_path", cv)
		if cmd == "moveTo"
			return bcc3(ctx, "_canvas_move_to", cv, av(ctx, ia, "x", "0.0"), av(ctx, ia, "y", "0.0"))
		if cmd == "lineTo"
			return bcc3(ctx, "_canvas_line_to", cv, av(ctx, ia, "x", "0.0"), av(ctx, ia, "y", "0.0"))
		if cmd == "curveTo"
			return bcc5(ctx, "_canvas_curve_to", cv, av(ctx, ia, "cpX", "0.0"), av(ctx, ia, "cpY", "0.0"), av(ctx, ia, "x", "0.0"), av(ctx, ia, "y", "0.0"))
		if cmd == "cubicTo"
			return bcc7(ctx, "_canvas_cubic_to", cv, av(ctx, ia, "cp1x", "0.0"), av(ctx, ia, "cp1y", "0.0"), av(ctx, ia, "cp2x", "0.0"), av(ctx, ia, "cp2y", "0.0"), av(ctx, ia, "x", "0.0"), av(ctx, ia, "y", "0.0"))
		if cmd == "arc"
			return bcc6(ctx, "_canvas_arc", cv, av(ctx, ia, "x", "0.0"), av(ctx, ia, "y", "0.0"), av(ctx, ia, "radius", "0.0"), av(ctx, ia, "startAngle", "0.0"), av(ctx, ia, "endAngle", "6.283185307179586"))
		if cmd == "closePath"
			return bcc1(ctx, "_canvas_close_path", cv)
		if cmd == "fill"
			if get_iexpr(ia, "gradient") != ""
				return bcc2(ctx, "_canvas_fill_path_gradient", cv, av(ctx, ia, "gradient", ""))
			return bcc2(ctx, "_canvas_fill_path", cv, av(ctx, ia, "color", black))
		if cmd == "stroke"
			return bcc3(ctx, "_canvas_stroke_path", cv, av(ctx, ia, "color", black), av(ctx, ia, "width", "1.0"))
		return 0

	// canvas.sprite "name" x= y= [clip= | state= | sheet= clip=] [options]
	// (frame-canvas.ebnf §17). scaleX / scaleY / rotation / alpha wrap the
	// draw in a transform group so they compose with the sprite position.
	// anchorX / anchorY (CVS-C006) shift the frame so that x, y name the
	// point at (anchorX, anchorY) of the frame; inside a transform group
	// that point is the rotation / scale pivot.
	integer sprite_cmd(integer ctx, string ia)
		integer cv = ident(ctx, "__cv")
		string name_src = "\"" + first_quoted(ia, 0) + "\""
		string attrs = after_quoted(ia)
		string state_src = get_iexpr(attrs, "state")
		string sheet_src = get_iexpr(attrs, "sheet")
		if sheet_src == "" or state_src != ""
			sheet_src = name_src
		boolean transformed = get_iexpr(attrs, "scaleX") != "" or get_iexpr(attrs, "scaleY") != "" or get_iexpr(attrs, "rotation") != "" or get_iexpr(attrs, "alpha") != ""
		string x_src = "0.0"
		string y_src = "0.0"
		if transformed == false
			x_src = get_iexpr(attrs, "x")
			y_src = get_iexpr(attrs, "y")
			if x_src == ""
				x_src = "0.0"
			if y_src == ""
				y_src = "0.0"
		x_src = sprite_anchor_src(x_src, get_iexpr(attrs, "anchorX"), sheet_src, 0)
		y_src = sprite_anchor_src(y_src, get_iexpr(attrs, "anchorY"), sheet_src, 1)
		integer draw_h = 0
		if state_src != ""
			draw_h = bcc5(ctx, "_sprite_draw_state", cv, ue(ctx, name_src), ue(ctx, state_src), ue(ctx, x_src), ue(ctx, y_src))
		else
			integer arr = _batch_arrayNew(ctx)
			_batch_arrayPush(ctx, arr, cv)
			_batch_arrayPush(ctx, arr, ue(ctx, sheet_src))
			_batch_arrayPush(ctx, arr, av(ctx, attrs, "clip", "0"))
			_batch_arrayPush(ctx, arr, ue(ctx, x_src))
			_batch_arrayPush(ctx, arr, ue(ctx, y_src))
			_batch_arrayPush(ctx, arr, ue(ctx, "0.0"))
			_batch_arrayPush(ctx, arr, ue(ctx, "0.0"))
			string draw_fn = "_sprite_draw"
			if get_iexpr(attrs, "tint") != ""
				draw_fn = "_sprite_draw_tint"
				_batch_arrayPush(ctx, arr, av(ctx, attrs, "tint", "\"\""))
				_batch_arrayPush(ctx, arr, av(ctx, attrs, "tintStrength", "0.5"))
			else if get_iexpr(attrs, "flipX") != "" or get_iexpr(attrs, "flipY") != ""
				draw_fn = "_sprite_draw_flipped"
				_batch_arrayPush(ctx, arr, avflag(ctx, attrs, "flipX"))
				_batch_arrayPush(ctx, arr, avflag(ctx, attrs, "flipY"))
			draw_h = _batch_stmtCall(ctx, draw_fn, arr)
		if transformed == false
			return draw_h
		integer seq = _batch_arrayNew(ctx)
		_batch_arrayPush(ctx, seq, bcc7(ctx, "_canvas_group_begin", ident(ctx, "__cv"), av(ctx, attrs, "x", "0.0"), av(ctx, attrs, "y", "0.0"), av(ctx, attrs, "rotation", "0.0"), av(ctx, attrs, "scaleX", "1.0"), av(ctx, attrs, "scaleY", "1.0"), av(ctx, attrs, "alpha", "1.0")))
		_batch_arrayPush(ctx, seq, draw_h)
		_batch_arrayPush(ctx, seq, bcc1(ctx, "_canvas_group_end", ident(ctx, "__cv")))
		return _batch_stmtBlock(ctx, seq)

	// Source of the sprite position `pos_src` shifted by `anchor_src` times
	// the frame width (axis 0) or height (axis 1) of spritesheet `sheet_src`;
	// `pos_src` unchanged without an anchor.
	string sprite_anchor_src(string pos_src, string anchor_src, string sheet_src, integer axis)
		if anchor_src == ""
			return pos_src
		return "__canvas_sprite_anchor(" + pos_src + ", " + anchor_src + ", " + sheet_src + ", " + axis.toString() + ")"

	// True when the scene uses canvas.sprite anchors anywhere.
	boolean scene_uses_anchors(string body)
		return body.indexOf("anchorX=") != -1 or body.indexOf("anchorY=") != -1

	// __canvas_sprite_anchor(pos, anchor, sheet, axis) -> pos - anchor * frame
	// size of `sheet` on `axis` (0 = frameWidth, 1 = frameHeight), with the
	// frame sizes declared by the scene's spritesheet assets (§3).
	integer emit_sprite_anchor_fn(integer ctx, string assets_body)
		integer arr = _batch_arrayNew(ctx)
		_batch_arrayPush(ctx, arr, us(ctx, "number frameSize = 0.0"))
		integer p = 0
		while p < assets_body.length()
			integer le = scene_line_end(assets_body, p)
			string t = assets_body.substring(p, le).trim()
			if line_key(t) == "spritesheet" and first_quoted(t, 0) != ""
				string ia = after_quoted(t)
				string fw = get_iexpr(ia, "frameWidth")
				string fh = get_iexpr(ia, "frameHeight")
				if fw == ""
					fw = "32"
				if fh == ""
					fh = "32"
				_batch_arrayPush(ctx, arr, us(ctx, "if sheet == " + clean_str(first_quoted(t, 0)) + "\n\tinteger frameW = " + fw + "\n\tinteger frameH = " + fh + "\n\tif axis == 0\n\t\tframeSize = frameW.toNumber()\n\telse\n\t\tframeSize = frameH.toNumber()\n"))
			p = le + 1
		_batch_arrayPush(ctx, arr, us(ctx, "return pos - anchor * frameSize"))
		integer params = _batch_arrayNew(ctx)
		_batch_arrayPush(ctx, params, _batch_param(ctx, "pos", "number"))
		_batch_arrayPush(ctx, params, _batch_param(ctx, "anchor", "number"))
		_batch_arrayPush(ctx, params, _batch_param(ctx, "sheet", "string"))
		_batch_arrayPush(ctx, params, _batch_param(ctx, "axis", "integer"))
		integer fns_arr = _batch_arrayNew(ctx)
		_batch_arrayPush(ctx, fns_arr, _batch_func(ctx, "__canvas_sprite_anchor", params, "number", arr))
		_emit_helpers_batch(ctx, _batch_spec(ctx, fns_arr), 2)
		return 0

// ============================================================================
// DSL STATEMENTS (frame-canvas.ebnf §20, §21, §24, §25, §26)
// ============================================================================

functions:
	boolean is_dsl_statement(string t)
		if t.startsWith("play ") or t.startsWith("pause ") or t.startsWith("stop ") or t.startsWith("resume ") or t.startsWith("seek ")
			return true
		if t.startsWith("start animState ") or t.startsWith("start particles ") or t.startsWith("emit particles ")
			return true
		if t.startsWith("animate ") or t.startsWith("animState.force ")
			return true
		if t.startsWith("audio.") or t.startsWith("camera.") or t.startsWith("page.set ")
			return true
		if t.startsWith("scene.") and t.startsWith("scene.get ") == false
			return true
		return false

	integer dsl_statement(integer ctx, string t, string state_body)
		string name = "\"" + first_quoted(t, 0) + "\""
		string ia = after_quoted(t)
		integer nm = ue(ctx, name)
		// Tweens / timelines / animSprite playback (§20)
		if t.startsWith("play tween ")
			return bcc1(ctx, "_tween_play", nm)
		if t.startsWith("pause tween ")
			return bcc1(ctx, "_tween_pause", nm)
		if t.startsWith("stop tween ")
			return bcc1(ctx, "_tween_stop", nm)
		if t.startsWith("resume tween ")
			return bcc1(ctx, "_tween_resume", nm)
		if t.startsWith("play timeline ")
			return bcc1(ctx, "_timeline_play", nm)
		if t.startsWith("pause timeline ")
			return bcc1(ctx, "_timeline_pause", nm)
		if t.startsWith("stop timeline ")
			return bcc1(ctx, "_timeline_stop", nm)
		if t.startsWith("seek timeline ")
			return bcc2(ctx, "_timeline_seek", nm, av(ctx, ia, "to", "0.0"))
		if t.startsWith("play animSprite ")
			return bcc1(ctx, "_anim_sprite_reset", nm)
		if t.startsWith("start animState ")
			return bcc1(ctx, "_anim_state_start", nm)
		if t.startsWith("animState.force ")
			return bcc2(ctx, "_anim_state_force", nm, av(ctx, ia, "to", "\"\""))
		// Particles (§20)
		if t.startsWith("emit particles ")
			return bcc3(ctx, "_particles_emit", nm, av(ctx, ia, "x", "0.0"), av(ctx, ia, "y", "0.0"))
		if t.startsWith("start particles ")
			return bcc3(ctx, "_particles_start", nm, av(ctx, ia, "x", "0.0"), av(ctx, ia, "y", "0.0"))
		if t.startsWith("stop particles ")
			return bcc1(ctx, "_particles_stop", nm)
		if t.startsWith("animate ")
			return animate_statement(ctx, t, state_body)
		// Audio (§21)
		if t.startsWith("audio.play ")
			return bcc3(ctx, "_audio_play_sound", nm, av(ctx, ia, "volume", "1.0"), av(ctx, ia, "pitch", "1.0"))
		if t.startsWith("audio.masterVolume")
			return bcc1(ctx, "_audio_set_master_volume", av(ctx, ia, "value", "1.0"))
		if t.startsWith("audio.music.play ")
			return bcc3(ctx, "_audio_music_play", nm, avflag_default_on(ctx, ia, "loop"), av(ctx, ia, "volume", "1.0"))
		if t.startsWith("audio.music.stop")
			return bcc1(ctx, "_audio_music_stop", nm)
		if t.startsWith("audio.music.pause")
			return bcc1(ctx, "_audio_music_pause", nm)
		if t.startsWith("audio.music.resume")
			return bcc1(ctx, "_audio_music_resume", nm)
		if t.startsWith("audio.music.fadeOut")
			return bcc2(ctx, "_audio_music_fade_out", nm, av(ctx, ia, "duration", "1.0"))
		if t.startsWith("audio.music.crossfade")
			// `crossfade "from" to="to"` (CVS-I007) or `crossfade "to"` from the current track.
			if get_iexpr(ia, "to") != ""
				return bcc3(ctx, "_audio_music_crossfade", nm, av(ctx, ia, "to", "\"\""), av(ctx, ia, "duration", "1.0"))
			return bcc3(ctx, "_audio_music_crossfade", ue(ctx, "\"\""), nm, av(ctx, ia, "duration", "1.0"))
		// Camera (§24)
		if t.startsWith("camera.setPosition")
			return bcc2(ctx, "_camera_set_position", av(ctx, camera_attrs(t), "x", "0.0"), av(ctx, camera_attrs(t), "y", "0.0"))
		if t.startsWith("camera.setZoom")
			return bcc1(ctx, "_camera_set_zoom", av(ctx, camera_attrs(t), "zoom", "1.0"))
		if t.startsWith("camera.shake")
			integer shake_ease = ue(ctx, ease_id(get_iexpr(camera_attrs(t), "ease")).toString())
			return bcc3(ctx, "_camera_shake", av(ctx, camera_attrs(t), "intensity", "5.0"), av(ctx, camera_attrs(t), "duration", "0.3"), shake_ease)
		// Scenes (§25) and the page bridge (§26)
		if t.startsWith("scene.changeTo ")
			return bcc3(ctx, "_scene_change_animated", nm, av(ctx, ia, "transition", "\"fade\""), av(ctx, ia, "duration", "0.5"))
		if t.startsWith("scene.change ")
			return bcc1(ctx, "_scene_change", nm)
		if t.startsWith("scene.push ")
			return bcc1(ctx, "_scene_push", nm)
		if t.startsWith("scene.pop")
			return bcc0(ctx, "_scene_pop")
		if t.startsWith("scene.set ")
			return bcc2(ctx, "_scene_set", nm, value_as_string(ctx, ia))
		if t.startsWith("page.set ")
			return bcc2(ctx, "_page_set", nm, value_as_string(ctx, ia))
		// Not a DSL form after all: user Clean code.
		return us(ctx, t)

	// Attributes of a camera.<method> line (everything after the method word).
	string camera_attrs(string t)
		integer sp = t.indexOf(" ")
		if sp == -1
			return ""
		return t.substring(sp + 1, t.length()).trim()

	// `value=expr` of a scene.set / page.set line as a string expression.
	integer value_as_string(integer ctx, string ia)
		string v = get_iexpr(ia, "value")
		if v == ""
			v = "\"\""
		if v.startsWith("\"")
			return ue(ctx, v)
		return ue(ctx, "(" + v + ").toString()")

	// Integer flag for an attribute that defaults to on (loop=).
	integer avflag_default_on(integer ctx, string ia, string key)
		if get_iexpr(ia, key) == ""
			return ue(ctx, "1")
		return avflag(ctx, ia, key)

	// animate var [from=] to= duration= [ease=]  (§20). The runtime animates
	// the value in its store, so the local is stored first (and set to from=
	// when given).
	integer animate_statement(integer ctx, string t, string state_body)
		string rest = t.substring(8, t.length()).trim()
		integer e = word_end(rest, 0)
		string var_name = rest.substring(0, e)
		string ia = rest.substring(e, rest.length()).trim()
		integer seq = _batch_arrayNew(ctx)
		string from_src = get_iexpr(ia, "from")
		if from_src != ""
			_batch_arrayPush(ctx, seq, us(ctx, var_name + " = " + from_src))
		string ty = state_var_type(state_body, var_name)
		string current = var_name
		if ty == "integer"
			current = var_name + ".toNumber()"
		if ty != ""
			_batch_arrayPush(ctx, seq, bcc2(ctx, "_canvas_var_set", sl(ctx, var_name), ue(ctx, current)))
		integer ease_h = ue(ctx, ease_id(get_iexpr(ia, "ease")).toString())
		_batch_arrayPush(ctx, seq, bcc4(ctx, "_tween_animate", sl(ctx, var_name), av(ctx, ia, "to", "0.0"), av(ctx, ia, "duration", "1.0"), ease_h))
		return _batch_stmtBlock(ctx, seq)

// ============================================================================
// SCENE-LEVEL DECLARATIONS (assets, layers, animSprite, particles, tween,
// timeline, animState, path, gradient, customEase, camera)
// ============================================================================

functions:
	// Call `fn(ctx, arr, header, body, scene_body)` for every top-level
	// declaration `keyword "name" ...:` of the scene, via declaration_kind.
	integer each_declaration(integer ctx, integer arr, string body, string keyword)
		integer base = scene_base_indent(body)
		integer p = 0
		while p < body.length()
			integer le = scene_line_end(body, p)
			string line = body.substring(p, le)
			string t = line.trim()
			integer nxt = le + 1
			if t.length() > 0 and scene_indent(line) == base and t.startsWith(keyword + " ")
				integer ce = scene_child_end(body, p, base)
				string sub = ""
				if ce > le + 1
					sub = body.substring(le + 1, ce)
				string header = t
				if header.endsWith(":")
					header = header.substring(0, header.length() - 1).trim()
				declaration_kind(ctx, arr, keyword, header, sub, body)
				if ce > nxt
					nxt = ce
			p = nxt
		return 0

	integer declaration_kind(integer ctx, integer arr, string keyword, string header, string sub, string scene_body)
		string name = first_quoted(header, 0)
		string ia = after_quoted(header)
		if keyword == "animSprite"
			return declare_anim_sprite(ctx, arr, name, sub)
		if keyword == "particles"
			return declare_particles(ctx, arr, name, sub)
		if keyword == "tween"
			return declare_tween(ctx, arr, name, sub)
		if keyword == "timeline"
			return declare_timeline(ctx, arr, name, sub, scene_body)
		if keyword == "animState"
			return declare_anim_state(ctx, arr, name, sub)
		if keyword == "path"
			return declare_path(ctx, arr, name, sub)
		if keyword == "gradient"
			return declare_gradient(ctx, arr, name, ia, sub)
		if keyword == "customEase"
			return declare_custom_ease(ctx, arr, name, ia)
		return 0

	// assets: (§3) — one registration per asset line, into start:.
	integer process_assets_body(integer ctx, string body)
		integer p = 0
		while p < body.length()
			integer le = scene_line_end(body, p)
			string t = body.substring(p, le).trim()
			string kind = line_key(t)
			string name = first_quoted(t, 0)
			string ia = after_quoted(t)
			if name != ""
				integer n_h = sl(ctx, name)
				if kind == "image"
					_emit_statement_into_start(ctx, bcc2(ctx, "_asset_preload_image", n_h, av(ctx, ia, "src", "\"\"")))
				else if kind == "spritesheet"
					_emit_statement_into_start(ctx, bcc4(ctx, "_sprite_register_sheet", n_h, av(ctx, ia, "src", "\"\""), av(ctx, ia, "frameWidth", "32"), av(ctx, ia, "frameHeight", "32")))
				else if kind == "sound" or kind == "music"
					_emit_statement_into_start(ctx, bcc2(ctx, "_audio_preload", n_h, av(ctx, ia, "src", "\"\"")))
				else if kind == "font"
					_emit_statement_into_start(ctx, bcc2(ctx, "_font_load", n_h, av(ctx, ia, "src", "\"\"")))
				else
					plugin_error(ctx, "FRAME-CANVAS-E501", "unknown asset kind '" + kind + "' in assets: (expected image, spritesheet, sound, music or font)")
			p = le + 1
		return 0

	// layers: (§4) — `layer "name" z=N`, into start:.
	integer process_layers_body(integer ctx, string body)
		integer p = 0
		while p < body.length()
			integer le = scene_line_end(body, p)
			string t = body.substring(p, le).trim()
			if t.startsWith("layer ")
				_emit_statement_into_start(ctx, bcc2(ctx, "_layer_declare", sl(ctx, first_quoted(t, 0)), av(ctx, after_quoted(t), "z", "0")))
			p = le + 1
		return 0

	// animSprite "name": sheet= frames=a..b fps= loop=  (§9)
	integer declare_anim_sprite(integer ctx, integer arr, string name, string sub)
		string frames = body_attr(sub, "frames", "0..0")
		integer dots = frames.indexOf("..")
		string f_start = frames
		string f_end = frames
		if dots != -1
			f_start = frames.substring(0, dots).trim()
			f_end = frames.substring(dots + 2, frames.length()).trim()
		string loop_src = "1"
		if body_attr(sub, "loop", "true") == "false"
			loop_src = "0"
		_batch_arrayPush(ctx, arr, bcc6(ctx, "_animsprite_define", sl(ctx, name), ue(ctx, body_attr(sub, "sheet", "\"\"")), ue(ctx, f_start), ue(ctx, f_end), ue(ctx, body_attr(sub, "fps", "12.0")), ue(ctx, loop_src)))
		return 0

	// tween "name": one `var [from=] to=` line per variable plus config lines (§6).
	// With along = "path" the two variable lines are the X and Y variables
	// (CVS-A011); orient = true adds the companion angle variable as a third
	// path line (CVS-A012). The runtime assigns path lines in that order.
	integer declare_tween(integer ctx, integer arr, string name, string sub)
		string duration = body_attr(sub, "duration", "0.5")
		string ease = body_attr(sub, "ease", "\"linear\"")
		string repeat_src = body_attr(sub, "repeat", "0")
		string yoyo_src = "0"
		if body_attr(sub, "yoyo", "false") == "true"
			yoyo_src = "1"
		string delay = body_attr(sub, "delay", "0.0")
		string along = body_attr(sub, "along", "\"\"")
		integer p = 0
		while p < sub.length()
			integer le = scene_line_end(sub, p)
			string t = sub.substring(p, le).trim()
			string ia = t.substring(line_key(t).length(), t.length()).trim()
			if is_tween_var_line(t)
				// from= omitted: NaN tells the runtime to start from the
				// variable's value when the tween plays (CVS-A009).
				string from_src = get_iexpr(ia, "from")
				if from_src == ""
					from_src = "math.sqrt(-1.0)"
				_batch_arrayPush(ctx, arr, tween_var_call(ctx, name, line_key(t), from_src, get_iexpr(ia, "to"), duration, ease, repeat_src, yoyo_src, delay, along))
			p = le + 1
		if along != "\"\"" and body_attr(sub, "orient", "false") == "true"
			string angle_var = orient_angle_var(tween_var_name(sub, 0), tween_var_name(sub, 1))
			_batch_arrayPush(ctx, arr, tween_var_call(ctx, name, angle_var, "0.0", "0.0", duration, ease, repeat_src, yoyo_src, delay, along))
		return 0

	integer tween_var_call(integer ctx, string name, string var_name, string from_src, string to_src, string duration, string ease, string repeat_src, string yoyo_src, string delay, string along)
		integer a = _batch_arrayNew(ctx)
		_batch_arrayPush(ctx, a, sl(ctx, name))
		_batch_arrayPush(ctx, a, sl(ctx, var_name))
		_batch_arrayPush(ctx, a, ue(ctx, from_src))
		_batch_arrayPush(ctx, a, ue(ctx, to_src))
		_batch_arrayPush(ctx, a, ue(ctx, duration))
		_batch_arrayPush(ctx, a, ue(ctx, ease))
		_batch_arrayPush(ctx, a, ue(ctx, repeat_src))
		_batch_arrayPush(ctx, a, ue(ctx, yoyo_src))
		_batch_arrayPush(ctx, a, ue(ctx, delay))
		_batch_arrayPush(ctx, a, ue(ctx, along))
		return _batch_stmtCall(ctx, "_tween_define_var", a)

	// True when the trimmed tween line `t` is a variable line `name [from=] to=`.
	boolean is_tween_var_line(string t)
		if t.length() == 0 or t.startsWith("//")
			return false
		return get_iexpr(t.substring(line_key(t).length(), t.length()).trim(), "to") != ""

	// Number of variable lines of a tween body.
	integer tween_var_count(string sub)
		integer n = 0
		integer p = 0
		while p < sub.length()
			integer le = scene_line_end(sub, p)
			if is_tween_var_line(sub.substring(p, le).trim())
				n = n + 1
			p = le + 1
		return n

	// Variable of the `idx`-th variable line of a tween body; "" when absent.
	string tween_var_name(string sub, integer idx)
		integer n = 0
		integer p = 0
		while p < sub.length()
			integer le = scene_line_end(sub, p)
			string t = sub.substring(p, le).trim()
			if is_tween_var_line(t)
				if n == idx
					return line_key(t)
				n = n + 1
			p = le + 1
		return ""

	// Companion angle variable of a path tween with orient = true
	// (CVS-A012): `<base>Angle` for the variables `<base>X` / `<base>Y`
	// (`angle` for `x` / `y`); "" when the names do not follow that pattern.
	string orient_angle_var(string x_name, string y_name)
		if x_name == "x" and y_name == "y"
			return "angle"
		if x_name.length() < 2 or x_name.endsWith("X") == false
			return ""
		string base = x_name.substring(0, x_name.length() - 1)
		if y_name != base + "Y"
			return ""
		return base + "Angle"

	// path "name": moveTo / lineTo / curveTo / arcTo / closePath (§11).
	integer declare_path(integer ctx, integer arr, string name, string sub)
		_batch_arrayPush(ctx, arr, bcc1(ctx, "_path_begin", sl(ctx, name)))
		integer p = 0
		while p < sub.length()
			integer le = scene_line_end(sub, p)
			string t = sub.substring(p, le).trim()
			string op = line_key(t)
			string ia = t.substring(op.length(), t.length()).trim()
			integer n = sl(ctx, name)
			if op == "moveTo"
				_batch_arrayPush(ctx, arr, bcc3(ctx, "_path_move_to", n, av(ctx, ia, "x", "0.0"), av(ctx, ia, "y", "0.0")))
			else if op == "lineTo"
				_batch_arrayPush(ctx, arr, bcc3(ctx, "_path_line_to", n, av(ctx, ia, "x", "0.0"), av(ctx, ia, "y", "0.0")))
			else if op == "curveTo" and get_iexpr(ia, "cp1x") != ""
				_batch_arrayPush(ctx, arr, bcc7(ctx, "_path_cubic_to", n, av(ctx, ia, "cp1x", "0.0"), av(ctx, ia, "cp1y", "0.0"), av(ctx, ia, "cp2x", "0.0"), av(ctx, ia, "cp2y", "0.0"), av(ctx, ia, "x", "0.0"), av(ctx, ia, "y", "0.0")))
			else if op == "curveTo"
				_batch_arrayPush(ctx, arr, bcc5(ctx, "_path_curve_to", n, av(ctx, ia, "cx", "0.0"), av(ctx, ia, "cy", "0.0"), av(ctx, ia, "x", "0.0"), av(ctx, ia, "y", "0.0")))
			else if op == "arcTo"
				_batch_arrayPush(ctx, arr, bcc6(ctx, "_path_arc_to", n, av(ctx, ia, "x", "0.0"), av(ctx, ia, "y", "0.0"), av(ctx, ia, "radius", "0.0"), av(ctx, ia, "startAngle", "0.0"), av(ctx, ia, "endAngle", "6.283185307179586")))
			else if op == "closePath" or (op == "closed" and line_value(t) == "true")
				_batch_arrayPush(ctx, arr, bcc1(ctx, "_path_close", n))
			p = le + 1
		return 0

	// gradient "name" linear x1= y1= x2= y2=: / radial cx= cy= r=:  + stops (§12).
	integer declare_gradient(integer ctx, integer arr, string name, string ia, string sub)
		integer n = sl(ctx, name)
		if ia.startsWith("radial")
			string rattrs = ia.substring(6, ia.length()).trim()
			_batch_arrayPush(ctx, arr, bcc4(ctx, "_gradient_radial", n, av(ctx, rattrs, "cx", "0.0"), av(ctx, rattrs, "cy", "0.0"), av(ctx, rattrs, "r", "100.0")))
		else
			string lattrs = ia
			if lattrs.startsWith("linear")
				lattrs = lattrs.substring(6, lattrs.length()).trim()
			_batch_arrayPush(ctx, arr, bcc5(ctx, "_gradient_linear", n, av(ctx, lattrs, "x1", "0.0"), av(ctx, lattrs, "y1", "0.0"), av(ctx, lattrs, "x2", "100.0"), av(ctx, lattrs, "y2", "0.0")))
		integer p = 0
		while p < sub.length()
			integer le = scene_line_end(sub, p)
			string t = sub.substring(p, le).trim()
			if t.startsWith("stop ")
				string rest = t.substring(5, t.length()).trim()
				integer c_at = rest.indexOf(" color=")
				if c_at != -1
					_batch_arrayPush(ctx, arr, bcc3(ctx, "_gradient_add_stop", sl(ctx, name), ue(ctx, rest.substring(0, c_at).trim()), av(ctx, rest.substring(c_at + 1, rest.length()), "color", "\"#000000\"")))
			p = le + 1
		return 0

	// customEase "name" x1= y1= x2= y2=  (§13)
	integer declare_custom_ease(integer ctx, integer arr, string name, string ia)
		_batch_arrayPush(ctx, arr, bcc5(ctx, "_custom_ease_register", sl(ctx, name), av(ctx, ia, "x1", "0.42"), av(ctx, ia, "y1", "0.0"), av(ctx, ia, "x2", "0.58"), av(ctx, ia, "y2", "1.0")))
		return 0

	// particles "name": (§10) -> _particles_define_json. The JSON is built at
	// run time so attribute values may be expressions. Keys are the runtime's
	// particle config (canvas-bridge.js _spawnParticle).
	integer declare_particles(integer ctx, integer arr, string name, string sub)
		string json = clean_str("{\"name\":" + "\"" + json_escape(name) + "\"")
		integer p = 0
		while p < sub.length()
			integer le = scene_line_end(sub, p)
			string t = sub.substring(p, le).trim()
			string key = line_key(t)
			string v = line_value(t)
			if key == "turbulence"
				string ta = t.substring(key.length(), t.length()).trim()
				json = json_num(json, "turbulenceStrength", get_iexpr(ta, "strength"))
				json = json_num(json, "turbulenceScale", get_iexpr(ta, "scale"))
			else if key == "wind" or key == "attractor"
				string fa = t.substring(key.length(), t.length()).trim()
				json = json_num(json, key + "X", get_iexpr(fa, "x"))
				json = json_num(json, key + "Y", get_iexpr(fa, "y"))
				if key == "attractor"
					json = json_num(json, "attractorStrength", get_iexpr(fa, "strength"))
			else if t.indexOf("=") != -1 and v != "" and t.startsWith("//") == false
				integer arrow = v.indexOf("->")
				integer dots = v.indexOf("..")
				if arrow != -1
					// overLifetime ramp: start -> end
					if key == "size" or key == "alpha"
						json = json_num(json, key + "Start", v.substring(0, arrow))
						json = json_num(json, key + "End", v.substring(arrow + 2, v.length()))
				else if key == "lifetime" or key == "speed" or key == "angle" or key == "size" or key == "radius"
					string jk = key
					if key == "lifetime"
						jk = "life"
					if key == "radius"
						jk = "size"
					if dots != -1
						json = json_num(json, jk + "Min", v.substring(0, dots))
						json = json_num(json, jk + "Max", v.substring(dots + 2, v.length()))
					else
						json = json_num(json, jk + "Min", v)
						json = json_num(json, jk + "Max", v)
				else if key == "rate" or key == "burst" or key == "gravity" or key == "drag"
					json = json_num(json, key, v)
				else if (key == "color" or key == "shape" or key == "image") and v.startsWith("\"")
					json = json + " + " + clean_str(",\"" + key + "\":") + " + " + clean_str("\"" + json_escape(v.substring(1, v.length() - 1)) + "\"")
			p = le + 1
		json = json + " + " + clean_str("}")
		_batch_arrayPush(ctx, arr, bcc2(ctx, "_particles_define_json", sl(ctx, name), ue(ctx, json)))
		return 0

	// Append `,"key":<number>` to a JSON-building expression.
	string json_num(string json, string key, string value_src)
		string v = value_src.trim()
		if v == ""
			v = "0.0"
		return json + " + " + clean_str(",\"" + key + "\":") + " + (" + v + ").toString()"

	// Duration expression of tween `name` declared in the scene, "0.5" when absent.
	string tween_duration(string scene_body, string name)
		integer base = scene_base_indent(scene_body)
		integer p = 0
		while p < scene_body.length()
			integer le = scene_line_end(scene_body, p)
			string line = scene_body.substring(p, le)
			string t = line.trim()
			if scene_indent(line) == base and t.startsWith("tween ") and first_quoted(t, 0) == name
				integer ce = scene_child_end(scene_body, p, base)
				if ce > le + 1
					return body_attr(scene_body.substring(le + 1, ce), "duration", "0.5")
				return "0.5"
			p = le + 1
		return "0.5"

	// timeline "name": steps `at T:` / `after [gap=|overlap=]:` /
	// `together [stagger=]:` holding `tween "name"` and `animate var ...`
	// actions, plus an optional `onComplete:` block of `var = value` lines
	// (§7, spec §13). Registers
	//   {"steps":[{"at":t,"play":"tw"} | {"at":t,"animate":{...}} | {"at":t,"var":"v","set":x}],"duration":d}
	// with step times and values as run-time expressions.
	integer declare_timeline(integer ctx, integer arr, string name, string sub, string scene_body)
		string steps = ""
		string cursor = "0.0"
		string total = "0.0"
		string on_complete = ""
		integer p = 0
		integer sub_base = scene_base_indent(sub)
		while p < sub.length()
			integer le = scene_line_end(sub, p)
			string line = sub.substring(p, le)
			string t = line.trim()
			integer nxt = le + 1
			if t.length() > 0 and scene_indent(line) == sub_base and t.endsWith(":")
				string head = t.substring(0, t.length() - 1).trim()
				integer ce = scene_child_end(sub, p, sub_base)
				if ce > nxt
					nxt = ce
				string step_start = cursor
				string stagger = "0.0"
				if head == "onComplete"
					on_complete = sub.substring(le + 1, ce)
				else
					if head.startsWith("at ")
						step_start = "(" + head.substring(3, head.length()).trim() + ")"
					else if head.startsWith("after")
						string gap = get_iexpr(head, "gap")
						string overlap = get_iexpr(head, "overlap")
						if gap != ""
							step_start = cursor + " + (" + gap + ")"
						if overlap != ""
							step_start = cursor + " - (" + overlap + ")"
					else if head.startsWith("together")
						string st = get_iexpr(head, "stagger")
						if st != ""
							stagger = st
					else
						return plugin_error(ctx, "FRAME-CANVAS-E621", "timeline \"" + name + "\": unknown step '" + head + "' (expected at, after, together or onComplete — frame-canvas.ebnf §7)")
					string step_end = step_start
					integer idx = 0
					integer q = le + 1
					while q < ce
						integer qe = scene_line_end(sub, q)
						string a = sub.substring(q, qe).trim()
						string at = step_start + " + " + idx.toString() + ".0 * (" + stagger + ")"
						string entry = ""
						string length = ""
						if a.startsWith("tween ")
							string tw = first_quoted(a, 0)
							entry = clean_str("{\"at\":") + " + (" + at + ").toString() + " + clean_str(",\"play\":\"" + json_escape(tw) + "\"}")
							length = tween_duration(scene_body, tw)
						else if a.startsWith("animate ")
							entry = timeline_animate_entry(a, at)
							string ia = a.substring(8 + word_end(a.substring(8, a.length()), 0), a.length()).trim()
							string dur = get_iexpr(ia, "duration")
							if dur == ""
								dur = "1.0"
							string delay = get_iexpr(ia, "delay")
							if delay == ""
								delay = "0.0"
							string rep = get_iexpr(ia, "repeat")
							if rep == "" or rep.startsWith("-")
								rep = "0"
							length = "(" + delay + ") + (" + dur + ") * ((" + rep + ") + 1)"
						else if a.length() > 0 and a.startsWith("//") == false
							return plugin_error(ctx, "FRAME-CANVAS-E622", "timeline \"" + name + "\": the canvas runtime plays `tween \"name\"` and `animate` actions, found '" + a + "'")
						if entry != ""
							if steps == ""
								steps = entry
							else
								steps = steps + " + " + clean_str(",") + " + " + entry
							step_end = "math.max(" + step_end + ", " + at + " + " + length + ")"
							idx = idx + 1
						q = qe + 1
					cursor = step_end
					total = "math.max(" + total + ", " + step_end + ")"
			p = nxt
		// onComplete: `var = value` lines run when the timeline ends (spec §13).
		integer c = 0
		while c < on_complete.length()
			integer ce2 = scene_line_end(on_complete, c)
			string a = on_complete.substring(c, ce2).trim()
			if a.indexOf("=") != -1 and a.startsWith("//") == false
				string v = line_value(a)
				if v == "true"
					v = "1"
				if v == "false"
					v = "0"
				string entry = clean_str("{\"at\":") + " + (" + total + ").toString() + " + clean_str(",\"var\":\"" + json_escape(line_key(a)) + "\",\"set\":") + " + (" + v + ").toString() + " + clean_str("}")
				if steps == ""
					steps = entry
				else
					steps = steps + " + " + clean_str(",") + " + " + entry
			c = ce2 + 1
		string json = clean_str("{\"steps\":[")
		if steps != ""
			json = json + " + " + steps
		json = json + " + " + clean_str("],\"duration\":") + " + (" + total + ").toString() + " + clean_str("}")
		_batch_arrayPush(ctx, arr, bcc2(ctx, "_timeline_define_json", sl(ctx, name), ue(ctx, json)))
		return 0

	// One `animate var [from=] to= duration= [ease=] [delay=] [repeat=] [yoyo=]`
	// timeline action as a JSON-building expression.
	string timeline_animate_entry(string a, string at)
		string rest = a.substring(8, a.length()).trim()
		integer e = word_end(rest, 0)
		string var_name = rest.substring(0, e)
		string ia = rest.substring(e, rest.length()).trim()
		string js = clean_str("{\"at\":") + " + (" + at + ").toString() + " + clean_str(",\"animate\":{\"varName\":\"" + json_escape(var_name) + "\"")
		if get_iexpr(ia, "from") != ""
			js = json_num(js, "from", get_iexpr(ia, "from"))
		js = json_num(js, "to", get_iexpr(ia, "to"))
		js = json_num(js, "duration", get_iexpr(ia, "duration"))
		if get_iexpr(ia, "delay") != ""
			js = json_num(js, "delay", get_iexpr(ia, "delay"))
		if get_iexpr(ia, "repeat") != ""
			js = json_num(js, "repeat", get_iexpr(ia, "repeat"))
		if get_iexpr(ia, "yoyo") == "true"
			js = js + " + " + clean_str(",\"yoyo\":true")
		string ease = get_iexpr(ia, "ease")
		if ease.startsWith("\"")
			js = js + " + " + clean_str(",\"ease\":\"" + json_escape(ease.substring(1, ease.length() - 1)) + "\"")
		return js + " + " + clean_str("}}")

	// animState "name": initial= / state "s": (play animSprite "clip") /
	// transitions: (§8). Registers {"initial","clips","onComplete"}; the
	// `when` transitions are evaluated each frame by _anim_states_update.
	integer declare_anim_state(integer ctx, integer arr, string name, string sub)
		string initial = ""
		string clips = ""
		string completes = ""
		string current_state = ""
		integer p = 0
		while p < sub.length()
			integer le = scene_line_end(sub, p)
			string t = sub.substring(p, le).trim()
			if line_key(t) == "initial"
				initial = first_quoted(t, 0)
			else if t.startsWith("state ")
				current_state = first_quoted(t, 0)
			else if t.startsWith("play animSprite ") and current_state != ""
				string entry = "\"" + json_escape(current_state) + "\":\"" + json_escape(first_quoted(t, 0)) + "\""
				if clips == ""
					clips = entry
				else
					clips = clips + "," + entry
			else if t.startsWith("onComplete ") and current_state != ""
				// `onComplete "next"` inside a state block (spec §14).
				string entry = "\"" + json_escape(current_state) + "\":\"" + json_escape(first_quoted(t, 0)) + "\""
				if completes == ""
					completes = entry
				else
					completes = completes + "," + entry
			else if t.startsWith("\"") and t.indexOf(" onComplete ") != -1
				string from_state = first_quoted(t, 0)
				string to_state = first_quoted(t, t.indexOf(" onComplete ") + 11)
				string entry = "\"" + json_escape(from_state) + "\":\"" + json_escape(to_state) + "\""
				if completes == ""
					completes = entry
				else
					completes = completes + "," + entry
			p = le + 1
		string json = "{\"initial\":\"" + json_escape(initial) + "\",\"clips\":{" + clips + "},\"onComplete\":{" + completes + "}}"
		_batch_arrayPush(ctx, arr, bcc2(ctx, "_animstate_define_json", sl(ctx, name), sl(ctx, json)))
		return 0

	// Source of the per-frame `when` transition checks of every animState in
	// the scene; "" when there are none (CVS-A003: first match wins).
	string anim_state_update_src(string body)
		string out = ""
		integer base = scene_base_indent(body)
		integer fsm_idx = 0
		integer p = 0
		while p < body.length()
			integer le = scene_line_end(body, p)
			string line = body.substring(p, le)
			string t = line.trim()
			if scene_indent(line) == base and t.startsWith("animState ")
				string fsm = first_quoted(t, 0)
				integer ce = scene_child_end(body, p, base)
				string cur = "__as" + fsm_idx.toString()
				string chain = ""
				integer q = le + 1
				while q < ce
					integer qe = scene_line_end(body, q)
					string r = body.substring(q, qe).trim()
					integer arrow = r.indexOf("->")
					integer when_at = r.indexOf(" when ")
					if r.startsWith("\"") and arrow != -1 and when_at > arrow
						string from_state = first_quoted(r, 0)
						string to_state = first_quoted(r, arrow)
						string cond = r.substring(when_at + 6, r.length()).trim()
						string kw = "else if "
						if chain == ""
							kw = "if "
						chain = chain + kw + cur + " == " + clean_str(from_state) + " and (" + cond + ")\n\t_anim_state_force(" + clean_str(fsm) + ", " + clean_str(to_state) + ")\n"
					q = qe + 1
				if chain != ""
					out = out + "string " + cur + " = _anim_state_current(" + clean_str(fsm) + ")\n" + chain
					fsm_idx = fsm_idx + 1
			p = le + 1
		return out

// ============================================================================
// SCENE TYPES (frame-canvas.ebnf §29)
// ============================================================================

functions:
	integer emit_scene_type_stub(integer ctx, string class_name)
		string spec = "{\"name\":\"" + class_name + "\",\"parent\":null,\"fields\":[],\"methods\":[]}"
		return _emit_class_full(ctx, _batch_stringLit(ctx, spec), 1)

	integer emit_all_scene_type_stubs(integer ctx)
		emit_scene_type_stub(ctx, "Canvas")
		emit_scene_type_stub(ctx, "Sprite")
		emit_scene_type_stub(ctx, "Sound")
		emit_scene_type_stub(ctx, "Music")
		emit_scene_type_stub(ctx, "Image")
		emit_scene_type_stub(ctx, "Font")
		emit_scene_type_stub(ctx, "Tween")
		emit_scene_type_stub(ctx, "Timeline")
		emit_scene_type_stub(ctx, "AnimState")
		emit_scene_type_stub(ctx, "Particles")
		emit_scene_type_stub(ctx, "Gradient")
		emit_scene_type_stub(ctx, "Path")
		return 0

// ============================================================================
// expand_canvas_scene
// ============================================================================

functions:
	// Value of `param="..."` on the header of sub-block `keyword`.
	string handler_param(string body, string keyword, string default_val)
		return header_attr(extract_scene_header(body, keyword), "param", default_val)

	// Part `idx` (0 or 1) of a "px,py" param list.
	string param_part(string params, integer idx, string default_val)
		string p = params.trim()
		integer comma = p.indexOf(",")
		if comma == -1
			if idx == 0
				return p
			return default_val
		if idx == 0
			return p.substring(0, comma).trim()
		return p.substring(comma + 1, p.length()).trim()

	integer emit_pointer_handler(integer ctx, string fn_name, string register_fn, string body, string keyword, string state_body)
		string sub = extract_scene_subblock(body, keyword)
		if sub.trim().length() == 0
			return 0
		string params = handler_param(body, keyword, "px,py")
		integer arr = _batch_arrayNew(ctx)
		handler_body(ctx, arr, sub, state_body)
		emit_one_fn(ctx, fn_name, handler_params(ctx, param_part(params, 0, "px"), "number", param_part(params, 1, "py"), "number"), arr)
		_emit_statement_into_start(ctx, bcc1(ctx, register_fn, ident(ctx, "__cv")))
		return 0

	// Key handlers receive no arguments from the runtime: the key comes from
	// _canvas_event_key().
	integer emit_key_handler(integer ctx, string fn_name, string register_fn, string body, string keyword, string state_body)
		string sub = extract_scene_subblock(body, keyword)
		if sub.trim().length() == 0
			return 0
		string key_var = param_part(handler_param(body, keyword, "key"), 0, "key")
		integer arr = _batch_arrayNew(ctx)
		_batch_arrayPush(ctx, arr, svardecl(ctx, key_var, "string", call0(ctx, "_canvas_event_key")))
		handler_body(ctx, arr, sub, state_body)
		emit_one_fn(ctx, fn_name, handler_params(ctx, "", "", "", ""), arr)
		_emit_statement_into_start(ctx, bcc1(ctx, register_fn, ident(ctx, "__cv")))
		return 0

	integer emit_lifecycle_handler(integer ctx, string fn_name, string register_fn, string body, string keyword, string state_body)
		string sub = extract_scene_subblock(body, keyword)
		if sub.trim().length() == 0
			return 0
		integer arr = _batch_arrayNew(ctx)
		handler_body(ctx, arr, sub, state_body)
		emit_one_fn(ctx, fn_name, handler_params(ctx, "", "", "", ""), arr)
		_emit_statement_into_start(ctx, bcc1(ctx, register_fn, ident(ctx, "__cv")))
		return 0

	integer expand_canvas_scene(integer ctx, string attrs_json, string header, string body)
		_ctx_set_error_context(ctx, "FRAME-CANVAS-E400", "frame.canvas canvasScene expansion failed")
		string problem = validate_canvas_scene(body)
		if problem != ""
			return plugin_error(ctx, "FRAME-CANVAS-E410", problem)
		string state_body = extract_scene_subblock(body, "state")
		string frame_body = extract_scene_subblock(body, "onFrame")
		string draw_body = extract_scene_subblock(body, "draw")
		string camera_body = extract_scene_subblock(body, "camera")
		string dt_name = handler_param(body, "onFrame", "dt")

		emit_all_scene_type_stubs(ctx)

		// --- start: canvas, assets, layers -------------------------------
		integer init_call = _batch_call(ctx, "_canvas_init", canvas_init_args(ctx, attrs_json, header))
		_emit_statement_into_start(ctx, svardecl(ctx, "__cv", "integer", init_call))
		_emit_statement_into_start(ctx, bcc2(ctx, "_canvas_set_fps", ident(ctx, "__cv"), _batch_intLit(ctx, int_attr(attrs_json, header, "fps", 60), 0)))
		process_assets_body(ctx, extract_scene_subblock(body, "assets"))
		process_layers_body(ctx, extract_scene_subblock(body, "layers"))
		if scene_uses_anchors(body)
			emit_sprite_anchor_fn(ctx, extract_scene_subblock(body, "assets"))

		// --- per-frame functions ---------------------------------------------
		integer fcb = _batch_arrayNew(ctx)
		_batch_arrayPush(ctx, fcb, svardecl(ctx, dt_name, "number", call0(ctx, "_canvas_get_delta_time")))
		if frame_body.trim().length() > 0
			integer f_arr = _batch_arrayNew(ctx)
			handler_body(ctx, f_arr, frame_body, state_body)
			emit_one_fn(ctx, "_on_frame", handler_params(ctx, dt_name, "number", "", ""), f_arr)
			_batch_arrayPush(ctx, fcb, bcc2(ctx, "_on_frame", ident(ctx, "__cv"), ident(ctx, dt_name)))
		string transitions = anim_state_update_src(body)
		if transitions != ""
			integer t_arr = _batch_arrayNew(ctx)
			state_stmts(ctx, t_arr, state_body, 0)
			_batch_arrayPush(ctx, t_arr, us(ctx, transitions))
			emit_one_fn(ctx, "_anim_states_update", handler_params(ctx, "", "", "", ""), t_arr)
			_batch_arrayPush(ctx, fcb, bcc1(ctx, "_anim_states_update", ident(ctx, "__cv")))
		string follow_x = body_attr(camera_body, "followX", "")
		string follow_y = body_attr(camera_body, "followY", "")
		if follow_x != "" or follow_y != ""
			if follow_x == ""
				follow_x = "0.0"
			if follow_y == ""
				follow_y = "0.0"
			// The camera follows its target expressions every frame.
			integer c_arr = _batch_arrayNew(ctx)
			state_stmts(ctx, c_arr, state_body, 0)
			_batch_arrayPush(ctx, c_arr, bcc3(ctx, "_camera_set_follow", ue(ctx, follow_x), ue(ctx, follow_y), ue(ctx, body_attr(camera_body, "smoothing", "0.08"))))
			emit_one_fn(ctx, "_camera_follow", handler_params(ctx, "", "", "", ""), c_arr)
			_batch_arrayPush(ctx, fcb, bcc1(ctx, "_camera_follow", ident(ctx, "__cv")))
		if draw_body.trim().length() > 0
			// draw: never mutates state (CVS-X002): load only.
			integer d_arr = _batch_arrayNew(ctx)
			state_stmts(ctx, d_arr, state_body, 0)
			scene_expand_lines(ctx, d_arr, draw_body, "")
			emit_one_fn(ctx, "_draw", handler_params(ctx, "", "", "", ""), d_arr)
			_batch_arrayPush(ctx, fcb, bcc1(ctx, "_draw", ident(ctx, "__cv")))
		emit_one_fn(ctx, "_frame_callback", handler_params(ctx, "", "", "", ""), fcb)

		// --- event and lifecycle handlers ------------------------------------
		emit_pointer_handler(ctx, "_on_pointer_down", "_canvas_on_pointer_down", body, "onPointerDown", state_body)
		emit_pointer_handler(ctx, "_on_pointer_move", "_canvas_on_pointer_move", body, "onPointerMove", state_body)
		emit_pointer_handler(ctx, "_on_pointer_up", "_canvas_on_pointer_up", body, "onPointerUp", state_body)
		emit_key_handler(ctx, "_on_key_down", "_canvas_on_key_down", body, "onKeyDown", state_body)
		emit_key_handler(ctx, "_on_key_up", "_canvas_on_key_up", body, "onKeyUp", state_body)
		emit_lifecycle_handler(ctx, "_on_exit", "_canvas_on_exit", body, "onExit", state_body)
		emit_lifecycle_handler(ctx, "_on_pause", "_canvas_on_pause", body, "onPause", state_body)
		emit_lifecycle_handler(ctx, "_on_resume", "_canvas_on_resume", body, "onResume", state_body)

		// --- start: one block with the state, registrations, camera and init:
		// State variables are initialised before init: runs (CVS-S012);
		// custom easings are registered before the tweens that name them.
		integer s_arr = _batch_arrayNew(ctx)
		state_stmts(ctx, s_arr, state_body, 2)
		each_declaration(ctx, s_arr, body, "customEase")
		each_declaration(ctx, s_arr, body, "animSprite")
		each_declaration(ctx, s_arr, body, "particles")
		each_declaration(ctx, s_arr, body, "tween")
		each_declaration(ctx, s_arr, body, "timeline")
		each_declaration(ctx, s_arr, body, "animState")
		each_declaration(ctx, s_arr, body, "path")
		each_declaration(ctx, s_arr, body, "gradient")
		camera_setup(ctx, s_arr, camera_body)
		scene_expand_lines(ctx, s_arr, extract_scene_subblock(body, "init"), "")
		state_stmts(ctx, s_arr, state_body, 1)
		_emit_statement_into_start(ctx, _batch_stmtBlock(ctx, s_arr))
		_emit_statement_into_start(ctx, bcc1(ctx, "_canvas_request_frame", ident(ctx, "__cv")))

		if _ctx_had_error(ctx) != 0
			return plugin_error(ctx, "FRAME-CANVAS-E400", "canvasScene expansion failed")
		return 0

	// Arguments of _canvas_init: width, height, id (§2).
	integer canvas_init_args(integer ctx, string attrs_json, string header)
		integer a = _batch_arrayNew(ctx)
		_batch_arrayPush(ctx, a, _batch_intLit(ctx, int_attr(attrs_json, header, "width", 800), 0))
		_batch_arrayPush(ctx, a, _batch_intLit(ctx, int_attr(attrs_json, header, "height", 600), 0))
		_batch_arrayPush(ctx, a, sl(ctx, scene_attr(attrs_json, header, "id", "canvas")))
		return a

	// camera: static configuration (§14); followX/followY run per frame.
	integer camera_setup(integer ctx, integer arr, string camera_body)
		if camera_body.trim().length() == 0
			return 0
		string follow_x = body_attr(camera_body, "followX", "")
		string follow_y = body_attr(camera_body, "followY", "")
		if follow_x != "" or follow_y != ""
			if follow_x == ""
				follow_x = "0.0"
			if follow_y == ""
				follow_y = "0.0"
			_batch_arrayPush(ctx, arr, bcc3(ctx, "_camera_set_follow", ue(ctx, follow_x), ue(ctx, follow_y), ue(ctx, body_attr(camera_body, "smoothing", "0.08"))))
		string dzw = body_attr(camera_body, "deadzoneWidth", "")
		string dzh = body_attr(camera_body, "deadzoneHeight", "")
		if dzw != "" or dzh != ""
			if dzw == ""
				dzw = "0.0"
			if dzh == ""
				dzh = "0.0"
			_batch_arrayPush(ctx, arr, bcc2(ctx, "_camera_set_deadzone", ue(ctx, dzw), ue(ctx, dzh)))
		if body_attr(camera_body, "boundsWidth", "") != ""
			_batch_arrayPush(ctx, arr, bcc4(ctx, "_camera_set_bounds", ue(ctx, body_attr(camera_body, "boundsX", "0.0")), ue(ctx, body_attr(camera_body, "boundsY", "0.0")), ue(ctx, body_attr(camera_body, "boundsWidth", "0.0")), ue(ctx, body_attr(camera_body, "boundsHeight", "0.0"))))
		if body_attr(camera_body, "zoom", "") != ""
			_batch_arrayPush(ctx, arr, bcc1(ctx, "_camera_set_zoom", ue(ctx, body_attr(camera_body, "zoom", "1.0"))))
		return 0

	// Attribute lookup in the compiler's attrs JSON ({"key":"value",...}).
	string get_attr(string attrs, string key, string default_value)
		string pattern = "\"" + key + "\""
		integer pos = attrs.indexOf(pattern)
		if pos == -1
			return default_value
		integer colon = attrs.indexOf(":", pos + pattern.length())
		if colon == -1
			return default_value
		string rest = attrs.substring(colon + 1, attrs.length()).trim()
		if rest.startsWith("\"")
			integer close = rest.indexOf("\"", 1)
			if close == -1
				return default_value
			return rest.substring(1, close)
		integer e = 0
		while e < rest.length() and rest.substring(e, e + 1) != "," and rest.substring(e, e + 1) != "}"
			e = e + 1
		return rest.substring(0, e).trim()

	// A canvasScene attribute (§2): from the compiler's attrs JSON, else from
	// the header line `id="x" width=800 ...`.
	string scene_attr(string attrs_json, string header, string key, string default_value)
		string v = get_attr(attrs_json, key, "")
		if v != ""
			return v
		v = get_iexpr(header, key)
		if v == ""
			return default_value
		if v.startsWith("\"") and v.endsWith("\"") and v.length() >= 2
			return v.substring(1, v.length() - 1)
		return v

	integer int_attr(string attrs, string header, string key, integer fallback)
		string v = scene_attr(attrs, header, key, "")
		if v == ""
			return fallback
		if v == "0"
			return 0
		integer n = v.toInteger()
		if n == 0
			return fallback
		return n

// ============================================================================
// VALIDATION (validate_block)
// ============================================================================

functions:
	// Canonical position of a top-level sub-block header (CVS-S010), or -1
	// when `t` is not a sub-block header. Event handlers share one position.
	integer section_rank(string t)
		if is_header_of(t, "assets")
			return 1
		if is_header_of(t, "layers")
			return 2
		if is_header_of(t, "state")
			return 3
		if t.startsWith("animSprite ")
			return 4
		if t.startsWith("particles ")
			return 5
		if t.startsWith("tween ")
			return 6
		if t.startsWith("timeline ")
			return 7
		if t.startsWith("animState ")
			return 8
		if t.startsWith("path ")
			return 9
		if t.startsWith("gradient ")
			return 10
		if t.startsWith("customEase ")
			return 11
		if is_header_of(t, "camera")
			return 12
		if is_header_of(t, "init")
			return 13
		if is_header_of(t, "draw")
			return 14
		if is_header_of(t, "onFrame")
			return 15
		if is_header_of(t, "onPointerDown") or is_header_of(t, "onPointerMove") or is_header_of(t, "onPointerUp") or is_header_of(t, "onKeyDown") or is_header_of(t, "onKeyUp")
			return 16
		if is_header_of(t, "onExit")
			return 17
		if is_header_of(t, "onPause")
			return 18
		if is_header_of(t, "onResume")
			return 19
		return -1

	// True when `t` starts an animation-control expression (CVS-X003).
	boolean is_animation_control(string t)
		return t.startsWith("play tween ") or t.startsWith("play timeline ") or t.startsWith("start animState ") or t.startsWith("animate ")

	string validate_canvas_scene(string body)
		integer base = scene_base_indent(body)
		integer prev_rank = 0
		string prev_header = ""
		integer p = 0
		while p < body.length()
			integer le = scene_line_end(body, p)
			string line = body.substring(p, le)
			string t = line.trim()
			if t.length() > 0 and scene_indent(line) == base and t.startsWith("//") == false
				integer rank = section_rank(t)
				if rank == -1
					return "canvasScene: '" + t + "' is not a scene sub-block (frame-canvas.ebnf §2)"
				if rank < prev_rank
					return "canvasScene: '" + t + "' must come before '" + prev_header + "' (CVS-S010) — order: assets, layers, state, animSprite, particles, tween, timeline, animState, path, gradient, customEase, camera, init, draw, onFrame, event handlers, onExit, onPause, onResume"
				prev_rank = rank
				prev_header = t
			p = le + 1

		// CVS-X008 — state variables: integer / number / boolean, with an initial value.
		string state_body = extract_scene_subblock(body, "state")
		p = 0
		while p < state_body.length()
			integer le = scene_line_end(state_body, p)
			string t = state_body.substring(p, le).trim()
			if t.length() > 0 and t.startsWith("//") == false
				string ty = state_type(t)
				if ty == "string"
					return "canvasScene: state variable '" + state_name(t) + "' is a string; the canvas state store (_canvas_var_get/_canvas_var_set) holds numbers, so state: supports integer, number and boolean"
				if ty != "integer" and ty != "number" and ty != "boolean"
					return "canvasScene: state line '" + t + "' must be `integer|number|boolean name = value` (CVS-X008)"
				if t.indexOf("=") == -1
					return "canvasScene: state variable '" + state_name(t) + "' needs an initial value (CVS-X008)"
			p = le + 1

		// CVS-X001 — no drawing in init:.
		string init_body = extract_scene_subblock(body, "init")
		if init_body.indexOf("canvas.") != -1
			return "canvasScene: init: must not contain canvas.* drawing calls (CVS-X001) — draw in draw:"

		// CVS-X002 / CVS-X003 — draw: neither mutates state nor starts animations.
		string draw_body = extract_scene_subblock(body, "draw")
		p = 0
		while p < draw_body.length()
			integer le = scene_line_end(draw_body, p)
			string t = draw_body.substring(p, le).trim()
			string target = line_key(t)
			if t.indexOf(" = ") != -1 and state_var_type(state_body, target) != ""
				return "canvasScene: draw: must not assign state variable '" + target + "' (CVS-X002) — move state changes to onFrame:"
			if is_animation_control(t)
				return "canvasScene: draw: must not start animations ('" + t + "', CVS-X003) — use init: or an event handler"
			p = le + 1

		string tween_problem = validate_tweens(body, state_body)
		if tween_problem != ""
			return tween_problem

		// CVS-C006 — anchors are fractions of a spritesheet frame.
		string assets_body = extract_scene_subblock(body, "assets")
		p = 0
		while p < body.length()
			integer le = scene_line_end(body, p)
			string t = body.substring(p, le).trim()
			if t.startsWith("canvas.sprite ") and scene_uses_anchors(t)
				string attrs = after_quoted(t)
				string frame_name = first_quoted(t, 0)
				if get_iexpr(attrs, "sheet") != "" and get_iexpr(attrs, "state") == ""
					frame_name = first_quoted(get_iexpr(attrs, "sheet"), 0)
				if is_spritesheet_asset(assets_body, frame_name) == false
					return "canvasScene: canvas.sprite anchorX= / anchorY= need a spritesheet asset: '" + frame_name + "' is not declared as `spritesheet` in assets: (anchors are fractions of the frame size, CVS-C006)"
			p = le + 1
		return ""

	// True when the scene body declares `keyword "name"` at sub-block level
	// (tween, timeline, animState, particles, path, gradient, customEase, ...).
	boolean scene_declares(string body, string keyword, string name)
		integer base = scene_base_indent(body)
		integer p = 0
		while p < body.length()
			integer le = scene_line_end(body, p)
			string line = body.substring(p, le)
			string t = line.trim()
			if scene_indent(line) == base and t.startsWith(keyword + " ") and first_quoted(t, 0) == name
				return true
			p = le + 1
		return false

	// Tween declarations (§6): variables are state variables (CVS-A008);
	// a path tween names a declared path (CVS-X006) and animates exactly its
	// X and Y variables (CVS-A011); orient = true needs the companion angle
	// variable in state: (CVS-A012).
	string validate_tweens(string body, string state_body)
		integer base = scene_base_indent(body)
		integer p = 0
		while p < body.length()
			integer le = scene_line_end(body, p)
			string line = body.substring(p, le)
			string t = line.trim()
			integer nxt = le + 1
			if scene_indent(line) == base and t.startsWith("tween ")
				string name = first_quoted(t, 0)
				integer ce = scene_child_end(body, p, base)
				string sub = ""
				if ce > le + 1
					sub = body.substring(le + 1, ce)
				if ce > nxt
					nxt = ce
				integer i = 0
				integer count = tween_var_count(sub)
				while i < count
					string v = tween_var_name(sub, i)
					if state_var_type(state_body, v) == ""
						return "canvasScene: tween \"" + name + "\" animates '" + v + "', which is not declared in state: (CVS-A008)"
					i = i + 1
				string along = first_quoted(body_attr(sub, "along", ""), 0)
				boolean orient = body_attr(sub, "orient", "false") == "true"
				if along != ""
					if scene_declares(body, "path", along) == false
						return "canvasScene: tween \"" + name + "\" has along = \"" + along + "\", but no path \"" + along + "\" is declared in this scene (CVS-X006)"
					if count != 2
						return "canvasScene: tween \"" + name + "\" follows path \"" + along + "\", so it takes exactly two variable lines, the X then the Y variable (CVS-A011); found " + count.toString()
					if orient
						string angle_var = orient_angle_var(tween_var_name(sub, 0), tween_var_name(sub, 1))
						if angle_var == ""
							return "canvasScene: tween \"" + name + "\" has orient = true: its variables must be named <name>X / <name>Y (or x / y) so the angle variable <name>Angle (or angle) can be found (CVS-A012)"
						if state_var_type(state_body, angle_var) == ""
							return "canvasScene: tween \"" + name + "\" has orient = true, which sets the angle variable '" + angle_var + "': declare it in state: (CVS-A012)"
				else if orient
					return "canvasScene: tween \"" + name + "\" has orient = true without along = \"path\" (CVS-A012: orient rotates along a path)"
			p = nxt
		return ""

	// True when assets: declares `spritesheet "name"`.
	boolean is_spritesheet_asset(string assets_body, string name)
		integer p = 0
		while p < assets_body.length()
			integer le = scene_line_end(assets_body, p)
			string t = assets_body.substring(p, le).trim()
			if line_key(t) == "spritesheet" and first_quoted(t, 0) == name
				return true
			p = le + 1
		return false

// ============================================================================
// LINT (Contract 5 Phase C — FRAME-CANVAS-E040)
// ============================================================================
// Reports a canvasScene whose canvas.save / canvas.restore calls do not
// balance (CVS-X007).
// Spec: foundation/spec/framework/contracts/lint-extension.md §2.

functions:
	// Occurrences of `canvas.<word>` as a whole command in `content`.
	integer canvas_count_cmd(string content, string word)
		string pat = "canvas." + word
		integer count = 0
		integer pos = content.indexOf(pat)
		while pos != -1
			integer after = pos + pat.length()
			if after >= content.length() or is_ident_char(content.substring(after, after + 1)) == false
				count = count + 1
			pos = content.indexOf(pat, after)
		return count

	// JSON string value of `"key":"..."` in `src` (escape-aware), unescaped
	// enough for counting: `\"` and `\\` are kept as-is.
	string json_string_field(string src, string key)
		string pat = "\"" + key + "\":\""
		integer at = src.indexOf(pat)
		if at == -1
			return ""
		integer i = at + pat.length()
		integer start_pos = i
		while i < src.length()
			string c = src.substring(i, i + 1)
			if c == "\\"
				i = i + 2
			else if c == "\""
				return src.substring(start_pos, i)
			else
				i = i + 1
		return src.substring(start_pos, src.length())

	string json_bare_field(string src, string key)
		string pattern = "\"" + key + "\":"
		integer at = src.indexOf(pattern)
		if at == -1
			return ""
		integer start_pos = at + pattern.length()
		integer end_pos = start_pos
		while end_pos < src.length()
			string ch = src.substring(end_pos, end_pos + 1)
			if ch == "," or ch == "}" or ch == " "
				break
			end_pos = end_pos + 1
		return src.substring(start_pos, end_pos)

	// Offset just past the `}` closing the object that opens at `pos` (string-aware).
	integer json_object_end(string src, integer pos)
		integer i = pos
		integer depth = 0
		while i < src.length()
			string ch = src.substring(i, i + 1)
			if ch == "\""
				i = i + 1
				while i < src.length() and src.substring(i, i + 1) != "\""
					if src.substring(i, i + 1) == "\\"
						i = i + 1
					i = i + 1
			else if ch == "{"
				depth = depth + 1
			else if ch == "}"
				depth = depth - 1
				if depth == 0
					return i + 1
			i = i + 1
		return src.length()

	string lint_project(string input_json)
		string handle_str = json_bare_field(input_json, "project_ast_handle")
		if handle_str.length() == 0
			return "[]"
		string blocks_json = _ast_list_blocks(handle_str.toInteger(), "canvasScene")
		string diagnostics = ""
		integer scan = blocks_json.indexOf("{")
		while scan != -1
			integer obj_end = json_object_end(blocks_json, scan)
			string entry = blocks_json.substring(scan, obj_end)
			string content = json_string_field(entry, "content")
			integer saves = canvas_count_cmd(content, "save")
			integer restores = canvas_count_cmd(content, "restore")
			if saves != restores
				integer line_no = 1
				string line_str = json_bare_field(entry, "line")
				if line_str.length() > 0
					line_no = line_str.toInteger()
				string missing = "restore"
				integer count = saves - restores
				if count < 0
					missing = "save"
					count = restores - saves
				string d = "{\"code\":\"FRAME-CANVAS-E040\",\"severity\":\"error\",\"message\":\"canvasScene has unbalanced canvas transform stack: " + saves.toString() + " canvas.save vs " + restores.toString() + " canvas.restore (CVS-X007).\",\"location\":{\"file\":\"" + json_string_field(entry, "file") + "\",\"line\":" + line_no.toString() + ",\"column\":1},\"hint\":\"Add " + count.toString() + " canvas." + missing + " so every save has a matching restore.\"}"
				if diagnostics == ""
					diagnostics = d
				else
					diagnostics = diagnostics + "," + d
			scan = blocks_json.indexOf("{", obj_end)
		return "[" + diagnostics + "]"
