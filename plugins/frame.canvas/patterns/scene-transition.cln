// Pattern: scene-transition
// Use when: navigating between game screens (menu → game, game-over, level → level)
// Anti-pattern: DON'T use scene.change for abrupt cuts between scenes.
//   An instant scene swap is jarring. Use scene.changeTo with a transition
//   (fade, slide) for smoothness. Use scene.set / scene.get to pass data
//   (score, level number, selected character) to the incoming scene.
//   Each scene lives in its own file (CVS-S011): this is app/canvas/game.cln;
//   the "menu" and "game-over" scenes are their own canvasScene: files.

plugins:
	frame.canvas

canvasScene: width=800 height=600 fps=60 id="game"

	state:
		integer level = 1
		integer score = 0
		number playerX = 400.0
		number bannerAlpha = 0.0

	tween "levelBanner":
		bannerAlpha from=1.0 to=0.0
		duration = 1.2
		ease = "easeInQuad"

	init:
		// Read the data the previous scene passed with scene.set
		level = scene.get "level".toInteger()
		score = scene.get "score".toInteger()
		play tween "levelBanner"

	draw:
		canvas.clear color="#1a1a2e"
		canvas.text value="Level {level}  Score: {score}" x=10 y=30 size=18 color="white"
		canvas.alpha value=bannerAlpha:
			canvas.text value="LEVEL {level}" x=400 y=250 size=48 color="white" align="center"
		canvas.rect x=playerX y=500 width=40 height=40 color="#3b82f6"

	onKeyDown: param="key"
		if key == "Escape"
			// Back to the menu with a slide transition
			scene.changeTo "menu" transition="slide" duration=0.4
			return

		// Level complete: pass the next level's data, then fade into it
		if key == "Enter"
			scene.set "level" value=level + 1
			scene.set "score" value=score + 100
			scene.changeTo "game" transition="fade" duration=0.3
			return

		if key == "q"
			scene.set "score" value=score
			scene.changeTo "game-over" transition="fade" duration=0.5
