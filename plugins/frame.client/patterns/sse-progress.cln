// Pattern: sse-progress
// Use when: a component tracks progress of a long-running server operation:
//           file import, batch job, report generation
// Anti-pattern: polling with repeated api.get() calls every N seconds, or writing
//               new EventSource(...) in a <script> tag — feed.open() handles
//               reconnection, and feed.on() routes named events to Clean handlers.
// Target: browser (compile with --target browser).

plugins:
	frame.ui
	frame.client

start:
	integer s = ui.updateElement("#import-host", renderImport())

state:
	integer feedId = 0

functions:
	string renderImport()
		html:
			<div class="import-progress">
				<button id="import-start" onclick="startImport">Start import</button>
				<div class="progress-track"><div class="progress-fill"></div></div>
				<p id="import-message"></p>
			</div>

	// One POST starts the job; progress then arrives as server-sent events.
	void startImport()
		showMessage("Starting...")
		later res = api.post("/api/import/start", "{}")
		if res.ok
			string jobId = res.json("jobId")
			// Unnamed "message" events go to onProgress; named events get feed.on.
			feedId = feed.open("/api/import/progress?job=" + jobId, "onProgress", "onFeedError")
			integer h = feed.on(feedId, "complete", "onComplete")
		else
			showMessage("Could not start the import (" + res.status.toString() + ")")

	// Each event's data is the percentage, e.g. "42".
	void onProgress()
		string percent = feed.data()
		integer s = ui.setStyle(".progress-fill", "width", percent + "%")
		showMessage(percent + "% complete")

	void onComplete()
		integer s = ui.setStyle(".progress-fill", "width", "100%")
		showMessage("Import complete")
		stopFeed()

	void onFeedError()
		showMessage("Connection lost, reconnecting...")

	void stopFeed()
		if feedId > 0
			integer closed = feed.close(feedId)
			feedId = 0

	void showMessage(string text)
		integer s = ui.updateElement("#import-message", text)
