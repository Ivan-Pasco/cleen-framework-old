// Pattern: send-mutation
// Use when: a button triggers a single API mutation — delete, archive, publish,
//           toggle — and you need pending/success/error state without a manual handler
// Anti-pattern: writing a manual void deleteTask() handler for every button — the
//               pending flag, double-click guard, ok check and error string are the
//               same every time. Declare a send: block in the page's .client.cln
//               companion file instead; with: serializes body fields, {varName} in
//               the URL fills a path parameter.
// File: app/ui/web/pages/task-detail.client.cln   Target: browser (--target browser).

plugins:
	frame.ui
	frame.client

start:
	// The server-rendered page carries the record id: <article id="task" data-id="42">
	taskId = ui.getAttr("#task", "data-id")
	integer s = ui.updateElement("#task-actions", renderActions())

state:
	string taskId = ""
	string archiveReason = ""

// Each send: block generates <name>Pending, <name>Success, <name>Error and a
// void <name>() that guards double clicks, sends the request and runs the callback.
send: deleteTask delete "/api/tasks/{taskId}"
	on success: emit "taskRemoved"
	on error: emit "actionFailed"

// with: archiveReason sends {"archiveReason":"<current value>"} as the body.
send: archiveTask patch "/api/tasks/{taskId}/archive"
	with: archiveReason
	on success: emit "taskArchived"
	on error: emit "actionFailed"

functions:
	// The buttons call the generated functions directly.
	string renderActions()
		html:
			<div class="task-actions">
				<button onclick="deleteTask">Delete</button>
				<input id="archive-reason" placeholder="Reason" onchange="reasonChanged">
				<button onclick="archiveTask">Archive</button>
				<p id="task-status"></p>
			</div>

	void reasonChanged()
		archiveReason = ui.eventValue()

	void taskRemoved()
		ui.navigate("/tasks")

	void taskArchived()
		showStatus("Archived")

	// The generated <name>Error strings hold the failure message.
	void actionFailed()
		string message = deleteTaskError
		if message == ""
			message = archiveTaskError
		showStatus(message)

	void showStatus(string text)
		integer s = ui.updateElement("#task-status", text)
