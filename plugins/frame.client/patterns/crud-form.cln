// Pattern: crud-form
// Use when: a component creates or updates a record via an API call with form data
// Anti-pattern: calling fetch() / XMLHttpRequest directly, passing a handler name to
//               api.post, or reading each field and building the JSON by hand —
//               api.submit(formSelector, url, method) collects the form as JSON
//               automatically (repeated fields as arrays, files as multipart).
// Target: browser (compile with --target browser).

plugins:
	frame.ui
	frame.client

start:
	integer s = ui.updateElement("#user-form-host", renderForm())

functions:
	// The form markup. onsubmit.prevent stops the browser's own submit and
	// calls the Clean function saveUser instead — no JavaScript.
	string renderForm()
		html:
			<form id="user-form" onsubmit.prevent="saveUser">
				<input name="name" type="text" placeholder="Name">
				<input name="email" type="email" placeholder="Email">
				<button type="submit">Save</button>
				<p id="user-form-status"></p>
			</form>

	// api.submit sends every field of #user-form as a JSON body. `later`
	// awaits the response; the statements after it run when it arrives.
	void saveUser()
		showStatus("Saving...")
		later res = api.submit("#user-form", "/api/users", "POST")
		if res.ok
			showStatus("Saved")
		else
			string message = res.json("message")
			if message == ""
				message = "Save failed (" + res.status.toString() + ")"
			showStatus(message)

	void showStatus(string text)
		integer s = ui.updateElement("#user-form-status", text)
