// Page routes and the registration form handler.
// /dashboard is registered by frame.ui from the dashboard.cln page companion.

endpoints:
	GET "/":
		return render("index")

	GET "/register":
		return render("register")

	// Form post from register.html (application/x-www-form-urlencoded).
	POST "/register":
		any form = json.tryTextToData(req.form())
		if form == null
			return badRequest("Invalid form")
		if form.username == null or form.email == null or form.password == null or form.password_confirm == null
			return badRequest("All fields are required")

		string username = form.username.toString()
		string email = form.email.toString()
		string password = form.password.toString()
		if username.length() < 3
			return badRequest("Username must be at least 3 characters")
		if password.length() < 8
			return badRequest("Password must be at least 8 characters")
		if password != form.password_confirm.toString()
			return badRequest("Passwords do not match")

		User user = User()
		user.username = username
		user.email = email
		user.password_hash = auth.hashPassword(password)
		user.is_active = true
		if not Database.save(user)
			return badRequest("An account with that email already exists")

		redirect("/dashboard", 303)
		return ""
