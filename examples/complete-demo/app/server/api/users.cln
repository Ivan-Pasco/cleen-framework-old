// User API endpoints with database operations

endpoints:
	GET "/api/users":
		list<User> users = User.find:
			order:
				id desc
			limit:
				50
		// Never send password_hash to the client.
		list<any> rows = []
		iterate u in users
			rows.add({ "id": u.id, "email": u.email, "username": u.username, "is_active": u.is_active })
		return json(rows)

	POST "/api/users":
		any body = json.tryTextToData(body())
		if body == none
			return badRequest("Invalid JSON")

		any emailField = body.email
		any usernameField = body.username
		any passwordField = body.password

		if emailField == none
			return badRequest("Email is required")
		if usernameField == none
			return badRequest("Username is required")
		if passwordField == none
			return badRequest("Password is required")

		string email = emailField.toString()
		string username = usernameField.toString()
		string password = passwordField.toString()

		// Fixed: was a `User.insert:` block; frame-data v2 writes through
		// `Database.save(entity)` and fills the generated id (DAT-S001, DAT-E002).
		User user = User()
		user.email = email
		user.username = username
		user.password_hash = auth.hashPassword(password)
		user.is_active = true
		if not Database.save(user)
			return badRequest("Insert failed")

		return json({ "ok": true, "id": user.id, "email": email, "username": username })

	GET "/api/users/:id":
		string userId = param("id")
		if userId == ""
			return badRequest("User ID required")

		User? foundUser = User.first:
			where:
				id == userId.toInteger()

		if foundUser == none
			return notFound()
		User user = foundUser!

		return json({ "id": user.id, "email": user.email, "username": user.username, "is_active": user.is_active })

	DELETE "/api/users/:id":
		string userId = param("id")
		// Fixed: was a `User.delete:` block; frame-data v2 deletes a loaded
		// entity with `Database.delete(entity)` (DAT-S001).
		User? foundUser = User.first:
			where:
				id == userId.toInteger()
		if foundUser == none
			return notFound()
		User user = foundUser!
		Database.delete(user)
		return json({ "ok": true, "message": "User deleted" })

	POST "/api/users/login":
		any body = json.tryTextToData(body())
		if body == none
			return badRequest("Invalid JSON")

		any emailField = body.email
		any passwordField = body.password

		if emailField == none
			return badRequest("Email required")
		if passwordField == none
			return badRequest("Password required")

		string loginEmail = emailField.toString()
		string password = passwordField.toString()

		User? foundUser = User.first:
			where:
				email == loginEmail
				is_active == true
		onError:
			return unauthorized()
		if foundUser == none
			return unauthorized()
		User user = foundUser!

		if not auth.verifyPassword(password, user.password_hash)
			return unauthorized()

		return json({ "ok": true, "user": { "id": user.id, "email": user.email, "username": user.username } })
