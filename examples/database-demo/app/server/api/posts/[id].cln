// Single post API
// Fixed: was `Post.update:` / `Post.delete:` block mutations, frame-data.ebnf
// v2 requires load-mutate-save and `Database.delete(entity)` (DAT-S001,
// DAT-S003). `first` returns the record or none (DAT-Q001).

endpoints:
	GET "/api/posts/:id":
		integer postId = param("id").toInteger()
		Post? foundPost = Post.first:
			where:
				id == postId
		if foundPost == none
			return notFound()
		Post post = foundPost!
		return jsonResponse("\{\"ok\": true, \"post\": " + json.dataToText(post) + "\}")

	PUT "/api/posts/:id":
		integer postId = param("id").toInteger()
		Post? foundPost = Post.first:
			where:
				id == postId
		if foundPost == none
			return notFound()
		Post post = foundPost!
		post.title = body()
		Database.save(post)
		return jsonResponse("\{\"ok\": true, \"message\": \"post updated\", \"id\": " + postId.toString() + "\}")

	DELETE "/api/posts/:id":
		integer postId = param("id").toInteger()
		Post? foundPost = Post.first:
			where:
				id == postId
		if foundPost == none
			return notFound()
		Post post = foundPost!
		Database.delete(post)
		return jsonResponse("\{\"ok\": true, \"message\": \"post deleted\", \"id\": " + postId.toString() + "\}")
