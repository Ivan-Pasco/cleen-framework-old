// Projects API

endpoints:
	GET "/api/projects" [user, admin]:
		list<Project> projects = Project.find:
			order: name asc
		return json({ok: true, projects: projects})

	POST "/api/projects" [user, admin]:
		Project project = Project()
		project.name = body()
		Database.save(project)
		return jsonResponse("{\"ok\": true, \"message\": \"project created\"}")

	GET "/api/projects/:id" [user, admin]:
		integer projectId = param("id").toInteger()
		Project? project = Project.first:
			where:
				id == projectId
		onError:
			return notFound()
		return json({ok: true, project: project})

	PUT "/api/projects/:id" [user, admin]:
		integer projectId = param("id").toInteger()
		Project? foundProject = Project.first:
			where:
				id == projectId
		onError:
			return notFound()
		if foundProject == none
			return notFound()
		Project project = foundProject!
		project.name = body()
		Database.save(project)
		return jsonResponse("{\"ok\": true, \"message\": \"project updated\", \"id\": " + projectId.toString() + "}")

	DELETE "/api/projects/:id" [user, admin]:
		integer projectId = param("id").toInteger()
		Project? foundProject = Project.first:
			where:
				id == projectId
		onError:
			return notFound()
		if foundProject == none
			return notFound()
		Project project = foundProject!
		Database.delete(project)
		return jsonResponse("{\"ok\": true, \"message\": \"project deleted\", \"id\": " + projectId.toString() + "}")
