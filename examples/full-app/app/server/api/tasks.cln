// Tasks API

endpoints:
	GET "/api/tasks" [user, admin]:
		list<Task> tasks = Task.find:
			order: status asc
		return json({ok: true, tasks: tasks})

	POST "/api/tasks" [user, admin]:
		Task task = Task()
		task.status = "pending"
		task.assignee_id = auth.userId()
		task.title = body()
		Database.save(task)
		return jsonResponse("{\"ok\": true, \"message\": \"task created\"}")

	GET "/api/tasks/:id" [user, admin]:
		integer taskId = param("id").toInteger()
		Task? task = Task.first:
			where:
				id == taskId
		onError:
			return notFound()
		return json({ok: true, task: task})

	PUT "/api/tasks/:id" [user, admin]:
		integer taskId = param("id").toInteger()
		Task? foundTask = Task.first:
			where:
				id == taskId
		onError:
			return notFound()
		if foundTask == none
			return notFound()
		Task task = foundTask!
		task.status = body()
		Database.save(task)
		return jsonResponse("{\"ok\": true, \"message\": \"task updated\", \"id\": " + taskId.toString() + "}")

	DELETE "/api/tasks/:id" [user, admin]:
		integer taskId = param("id").toInteger()
		Task? foundTask = Task.first:
			where:
				id == taskId
		onError:
			return notFound()
		if foundTask == none
			return notFound()
		Task task = foundTask!
		Database.delete(task)
		return jsonResponse("{\"ok\": true, \"message\": \"task deleted\", \"id\": " + taskId.toString() + "}")
