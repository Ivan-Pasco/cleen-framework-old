// Todo API - Authentication Configuration
// Session-based authentication with role-based access control, and the
// login flow that POST /auth/login runs with auth.login().

auth:
	session:
		cookie = "todo.sid"
		sameSite = "Lax"
		secure = true
		httpOnly = true
		path = "/"
		timeoutMinutes = 60

	jwt:
		enabled = false

	roles:
		admin: ["users:read", "users:write", "todos:read", "todos:write", "todos:delete"]
		user: ["todos:read", "todos:write"]

// The login flow: read the submitted email and password, look the user up,
// and hand frame.auth the password, the stored hash ("" when there is no
// such user), the user id and the session claims. auth.login() verifies the
// password and, when it matches, starts a new session and sets its cookie.
login:
	any bodyData = json.tryTextToData(body())
	string loginEmail = ""
	string submitted = ""
	if bodyData != null
		if bodyData.email != null
			loginEmail = bodyData.email.toString()
		if bodyData.password != null
			submitted = bodyData.password.toString()
	list<User> found = User.find:
		where:
			email == loginEmail
	string stored = ""
	integer foundId = 0
	string foundRole = ""
	if found.length() > 0
		stored = found[0].password_hash
		foundId = found[0].id
		foundRole = found[0].role
	password = submitted
	hash = stored
	userId = foundId
	claims = "{\"role\":\"" + foundRole + "\"}"
