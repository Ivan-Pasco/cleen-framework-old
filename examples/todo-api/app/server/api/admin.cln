// Admin Endpoints
// User management for administrators

endpoints:
	GET "/admin/users" [admin]:
		// Project only public columns so password hashes never leave the server.
		list<User> results = User.find:
			select: id, email, name, role, created_at
			order: created_at desc

		return json({ok: true, data: results})

	DELETE "/admin/users/:id" [admin]:
		integer userId = param("id").toInteger()
		if userId <= 0
			return badRequest("User ID required")

		User user = User.first:
			where:
				id == userId
		onError:
			return notFound()

		// Delete the user's todos first, then the user
		list<Todo> owned = Todo.find:
			where:
				owner_id == userId
		Database.deleteAll(owned)
		Database.delete(user)

		return jsonResponse("{\"ok\":true,\"message\":\"User deleted\"}")
