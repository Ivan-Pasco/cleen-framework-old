// Authentication Endpoints
// Register, login, logout, and session management

endpoints:
	POST "/auth/register":
		any bodyData = json.tryTextToData(body())
		if bodyData == none
			return badRequest("Invalid JSON")

		any emailField = bodyData.email
		any passwordField = bodyData.password
		any nameField = bodyData.name

		if emailField == none
			return badRequest("Email required")
		if passwordField == none
			return badRequest("Password required")

		User user = User()
		user.email = emailField.toString()
		user.password_hash = auth.hashPassword(passwordField.toString())
		user.name = ""
		if nameField != none
			user.name = nameField.toString()
		user.role = "user"
		Database.save(user)

		return jsonResponse("{\"ok\":true,\"message\":\"User registered\",\"id\":" + user.id.toString() + "}")

	// The login: block in app/auth/auth.cln reads the credentials and
	// checks them; auth.login() returns "" when they are wrong.
	POST "/auth/login":
		if auth.login() == ""
			return unauthorized()
		return jsonResponse("{\"ok\":true,\"user\":" + auth.getCurrentUser() + "}")

	POST "/auth/logout" [user, admin]:
		auth.session.destroy()
		return jsonResponse("{\"ok\":true,\"message\":\"Logged out\"}")

	GET "/auth/me" [user, admin]:
		string session = auth.getCurrentUser()
		return jsonResponse("{\"ok\":true,\"user\":" + session + "}")
