// Todo Endpoints
// CRUD operations for todo items, scoped to the signed-in owner

endpoints:
	GET "/todos" [user, admin]:
		integer userId = auth.userId()

		list<Todo> results = Todo.find:
			where:
				owner_id == userId
			order: created_at desc

		return json({ok: true, data: results})

	GET "/todos/:id" [user, admin]:
		integer todoId = param("id").toInteger()
		integer userId = auth.userId()

		Todo? item = Todo.first:
			where:
				id == todoId
				owner_id == userId
		onError:
			return notFound()

		return json({ok: true, data: item})

	POST "/todos" [user, admin]:
		any bodyData = json.tryTextToData(body())
		if bodyData == none
			return badRequest("Invalid JSON")

		any titleField = bodyData.title
		if titleField == none
			return badRequest("Title is required")

		Todo item = Todo()
		item.title = titleField.toString()
		item.details = ""
		item.priority = 0
		item.owner_id = auth.userId()

		any descField = json.get(bodyData, "description")
		if descField != none
			item.details = descField.toString()

		any prioField = bodyData.priority
		if prioField != none
			item.priority = prioField.toInteger() onError return badRequest("priority must be a whole number")

		Database.save(item)

		return jsonResponse("{\"ok\":true,\"id\":" + item.id.toString() + "}")

	DELETE "/todos/:id" [user, admin]:
		integer todoId = param("id").toInteger()
		integer userId = auth.userId()

		Todo? foundItem = Todo.first:
			where:
				id == todoId
				owner_id == userId
		onError:
			return notFound()
		if foundItem == none
			return notFound()
		Todo item = foundItem!

		Database.delete(item)

		return jsonResponse("{\"ok\":true}")

	PATCH "/todos/:id/toggle" [user, admin]:
		integer todoId = param("id").toInteger()
		integer userId = auth.userId()

		Todo? foundItem = Todo.first:
			where:
				id == todoId
				owner_id == userId
		onError:
			return notFound()
		if foundItem == none
			return notFound()
		Todo item = foundItem!

		if item.completed == 1
			item.completed = 0
		else
			item.completed = 1
		Database.save(item)

		return jsonResponse("{\"ok\":true}")
