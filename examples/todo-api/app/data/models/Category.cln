// Category Model
// For organizing todos

data Category:
	fields:
		integer id primary generated
		string name required
		string color default: "#3B82F6"
		integer owner_id

	relations:
		owner: belongs_to User on owner_id

// Junction table linking todos to categories (many-to-many)
data TodoCategory:
	table "todo_categories"
	fields:
		integer id primary generated
		integer todo_id required
		integer category_id required

	indexes:
		(todo_id, category_id) unique
