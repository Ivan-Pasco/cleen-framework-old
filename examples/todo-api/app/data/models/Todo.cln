// Todo Model
// Todo item with user relationship.
// `description` is a reserved keyword (grammar.ebnf §1.2), so the field is
// named `details` and mapped onto the `description` column.

data Todo:
	fields:
		integer id primary generated
		string title required
		string details default: "" as "description"
		integer completed default: 0
		integer priority default: 0
		integer owner_id
		string created_at
		string updated_at
		string due_date

	indexes:
		owner_id

	relations:
		owner: belongs_to User on owner_id
