// Single user API

endpoints:
	GET "/api/users/:id" [admin]:
		integer userId = param("id").toInteger()
		User user = User.first:
			where:
				id == userId
		onError:
			return notFound()
		return json({ok: true, user: {id: user.id, name: user.name, email: user.email, role: user.role, active: user.active}})

	PUT "/api/users/:id" [admin]:
		integer userId = param("id").toInteger()
		User user = User.first:
			where:
				id == userId
		onError:
			return notFound()
		user.name = body()
		Database.save(user)
		return jsonResponse("{\"ok\": true, \"message\": \"user updated\", \"id\": " + userId.toString() + "}")

	DELETE "/api/users/:id" [admin]:
		integer userId = param("id").toInteger()
		User user = User.first:
			where:
				id == userId
		onError:
			return notFound()
		Database.delete(user)
		return jsonResponse("{\"ok\": true, \"message\": \"user deleted\", \"id\": " + userId.toString() + "}")
