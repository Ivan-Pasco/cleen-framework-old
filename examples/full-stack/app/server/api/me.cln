// Current user endpoints

endpoints:
	GET "/api/me" [user, admin]:
		string session = auth.getCurrentUser()
		return jsonResponse("{\"ok\": true, \"user\": " + session + "}")

	PUT "/api/me" [user, admin]:
		integer userId = auth.userId()
		User? foundUser = User.first:
			where:
				id == userId
		onError:
			return notFound()
		if foundUser == none
			return notFound()
		User user = foundUser!
		user.name = body()
		Database.save(user)
		return jsonResponse("{\"ok\": true, \"message\": \"profile updated\"}")
