// Login endpoint

endpoints:
	POST "/api/login":
		any data = json.tryTextToData(body())
		if data == none
			return badRequest("Invalid JSON")
		string loginEmail = data.email.toString()
		string password = data.password.toString()
		User? foundUser = User.first:
			where:
				email == loginEmail
		onError:
			return jsonResponse("{\"ok\": false, \"error\": \"invalid credentials\"}")
		if foundUser == none
			return jsonResponse("{\"ok\": false, \"error\": \"invalid credentials\"}")
		User user = foundUser!
		if not auth.verifyPassword(password, user.password_hash)
			return jsonResponse("{\"ok\": false, \"error\": \"invalid credentials\"}")
		// auth.setSession stores the session and sets the session cookie.
		auth.setSession("{\"user_id\":" + user.id.toString() + ",\"role\":\"" + user.role + "\"}")
		return jsonResponse("{\"ok\": true, \"message\": \"logged in\"}")
