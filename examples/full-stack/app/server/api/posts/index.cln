// Posts API

endpoints:
	GET "/api/posts":
		list<Post> posts = Post.find:
			where:
				published == true
			order: created_at desc
		return json({ok: true, posts: posts})

	POST "/api/posts" [user, admin]:
		Post post = Post()
		post.user_id = auth.userId()
		post.content = body()
		post.published = false
		Database.save(post)
		return jsonResponse("{\"ok\": true, \"message\": \"post created\"}")
