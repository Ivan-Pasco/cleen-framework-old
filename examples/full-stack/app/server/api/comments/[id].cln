// Single comment API

endpoints:
	DELETE "/api/comments/:id" [user, admin]:
		integer commentId = param("id").toInteger()
		Comment comment = Comment.first:
			where:
				id == commentId
		onError:
			return notFound()
		Database.delete(comment)
		return jsonResponse("{\"ok\": true, \"message\": \"comment deleted\", \"id\": " + commentId.toString() + "}")
