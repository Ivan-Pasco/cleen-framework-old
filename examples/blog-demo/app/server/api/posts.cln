// Posts API endpoints

endpoints:
	GET "/api/posts":
		list<Post> posts = Post.find:
			order: created_at desc
		return json({ok: true, posts: posts})

	GET "/api/posts/:slug":
		string postSlug = param("slug")
		Post? post = Post.first:
			where:
				slug == postSlug
		onError:
			return notFound()
		return json({ok: true, post: post})
