// Single Todo API

endpoints:
	GET "/api/todos/:id":
		integer todoId = param("id").toInteger()

		Todo? foundItem = Todo.first:
			where:
				id == todoId
		onError:
			return notFound()
		if foundItem == none
			return notFound()
		Todo item = foundItem!

		return json(item)

	PUT "/api/todos/:id":
		integer todoId = param("id").toInteger()

		any bodyData = json.tryTextToData(body())
		if bodyData == none
			return badRequest("Invalid JSON")

		Todo? foundItem = Todo.first:
			where:
				id == todoId
		onError:
			return notFound()
		if foundItem == none
			return notFound()
		Todo item = foundItem!

		any titleField = bodyData.title
		any descField = json.get(bodyData, "description")
		any completedField = bodyData.completed

		if titleField != none
			item.title = titleField.toString()
		if descField != none
			item.details = descField.toString()
		if completedField != none
			item.completed = completedField.toInteger()

		Database.save(item)

		return jsonResponse("{\"ok\":true}")

	DELETE "/api/todos/:id":
		integer todoId = param("id").toInteger()

		Todo? foundItem = Todo.first:
			where:
				id == todoId
		onError:
			return notFound()
		if foundItem == none
			return notFound()
		Todo item = foundItem!

		Database.delete(item)

		return jsonResponse("{\"ok\":true}")
