// PostCard component
// Tag: <post-card title="..." excerpt="..." author="..." date="...">

component: tag="post-card"
	inputs:
		title: string = ""
		excerpt: string = ""
		author: string = ""
		date: string = ""

	html:
		<article class="post-card">
			<h2>{title}</h2>
			<p>{excerpt}</p>
			<span>By {author} on {date}</span>
		</article>
