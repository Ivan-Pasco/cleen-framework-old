// Single post endpoints

endpoints:
	GET "/api/posts/:id":
		integer postId = param("id").toInteger()
		Post post = Post.first:
			where:
				id == postId
		onError:
			return notFound()
		return json({ok: true, post: post})

	PUT "/api/posts/:id" [user, admin, editor]:
		integer postId = param("id").toInteger()
		Post post = Post.first:
			where:
				id == postId
		onError:
			return notFound()
		any data = json.tryTextToData(body())
		if data == null
			return badRequest("Invalid JSON")
		if data.title != null
			post.title = data.title.toString()
		if data.content != null
			post.content = data.content.toString()
		Database.save(post)
		return jsonResponse("{\"ok\": true}")

	DELETE "/api/posts/:id" [user, admin, editor]:
		integer postId = param("id").toInteger()
		Post post = Post.first:
			where:
				id == postId
		onError:
			return notFound()
		Database.delete(post)
		return jsonResponse("{\"ok\": true}")
