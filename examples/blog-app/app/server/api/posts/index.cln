// Posts collection endpoints

endpoints:
	GET "/api/posts":
		list<Post> posts = Post.find:
			where:
				published == true
			order: created_at desc
		return json({ok: true, posts: posts})

	POST "/api/posts" [user, admin, editor]:
		any data = json.tryTextToData(body())
		if data == null
			return badRequest("Invalid JSON")
		if data.title == null or data.content == null or data.slug == null
			return badRequest("Title, content, and slug are required")
		Post post = Post()
		post.author_id = auth.userId()
		post.title = data.title.toString()
		post.content = data.content.toString()
		post.slug = data.slug.toString()
		post.published = false
		post.views = 0
		Database.save(post)
		return jsonResponse("{\"ok\": true}")
