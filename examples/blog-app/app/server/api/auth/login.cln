// Login endpoint

endpoints:
	POST "/api/auth/login":
		any data = json.tryTextToData(body())
		if data == null
			return badRequest("Invalid JSON")
		if data.email == null or data.password == null
			return badRequest("Email and password are required")
		string loginEmail = data.email.toString()
		string password = data.password.toString()
		User user = User.first:
			where:
				email == loginEmail
		onError:
			return unauthorized()
		if not auth.verifyPassword(password, user.password_hash)
			return unauthorized()
		string token = auth.session.create(user.id, "{\"role\": \"" + user.role + "\"}")
		return jsonResponse("{\"ok\": true, \"token\": \"" + token + "\"}")
