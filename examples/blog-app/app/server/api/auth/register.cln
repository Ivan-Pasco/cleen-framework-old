// Register endpoint

endpoints:
	POST "/api/auth/register":
		any data = json.tryTextToData(body())
		if data == null
			return badRequest("Invalid JSON")
		if data.email == null or data.password == null or data.name == null
			return badRequest("Email, password, and name are required")
		string newEmail = data.email.toString()
		boolean taken = User.exists:
			where:
				email == newEmail
		if taken
			return badRequest("An account with that email already exists")
		User user = User()
		user.email = newEmail
		user.password_hash = auth.hashPassword(data.password.toString())
		user.name = data.name.toString()
		user.role = "user"
		Database.save(user)
		// auth.setSession stores the session and sets the session cookie.
		auth.setSession("{\"user_id\":" + user.id.toString() + ",\"role\":\"user\"}")
		return jsonResponse("{\"ok\": true}")
