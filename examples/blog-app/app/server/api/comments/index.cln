// Comments collection endpoints

endpoints:
	GET "/api/comments":
		// No post_id: no post selected, so no comments. A post_id that is not
		// a whole number is a bad request.
		string rawPostId = req.query("post_id")
		if rawPostId == ""
			list<Comment> noComments = []
			return json({ok: true, comments: noComments})
		integer postId = rawPostId.toInteger() onError return badRequest("post_id must be a whole number")
		list<Comment> comments = Comment.find:
			where:
				post_id == postId
			order: created_at asc
		return json({ok: true, comments: comments})

	POST "/api/comments" [user, admin]:
		any data = json.tryTextToData(body())
		if data == none
			return badRequest("Invalid JSON")
		if data.post_id == none or data.body == none
			return badRequest("post_id and body are required")
		Comment comment = Comment()
		comment.post_id = data.post_id.toInteger() onError return badRequest("post_id must be a whole number")
		comment.author_id = auth.userId()
		comment.body = data.body.toString()
		Database.save(comment)
		return jsonResponse("{\"ok\": true}")
