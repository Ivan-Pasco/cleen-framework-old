// Single comment endpoints

endpoints:
	DELETE "/api/comments/:id" [user, admin]:
		integer commentId = param("id").toInteger()
		Comment? foundComment = Comment.first:
			where:
				id == commentId
		onError:
			return notFound()
		if foundComment == none
			return notFound()
		Comment comment = foundComment!
		Database.delete(comment)
		return jsonResponse("{\"ok\": true}")
