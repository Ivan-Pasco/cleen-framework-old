// Current user profile endpoints

endpoints:
	GET "/api/me" [user, admin]:
		string session = auth.getCurrentUser()
		return jsonResponse("{\"ok\": true, \"user\": " + session + "}")

	PUT "/api/me" [user, admin]:
		any data = json.tryTextToData(body())
		if data == null
			return badRequest("Invalid JSON")
		integer userId = auth.userId()
		User user = User.first:
			where:
				id == userId
		onError:
			return notFound()
		if data.name != null
			user.name = data.name.toString()
		if data.bio != null
			user.bio = data.bio.toString()
		Database.save(user)
		return json({ok: true, user: {id: user.id, email: user.email, name: user.name, bio: user.bio, role: user.role}})
