// Articles API endpoints

endpoints:
	GET "/api/articles":
		list<Article> articles = Article.find:
			order: created_at desc
		return json({ok: true, articles: articles})

	GET "/api/articles/:slug":
		string articleSlug = param("slug")
		Article? article = Article.first:
			where:
				slug == articleSlug
		onError:
			return notFound()
		return json({ok: true, article: article})
