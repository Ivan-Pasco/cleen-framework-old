// User profile endpoints

endpoints:
	GET "/api/profile" [user, admin]:
		integer userId = auth.userId()
		User user = User.first:
			where:
				id == userId
		onError:
			return notFound()
		return json({ok: true, user: {id: user.id, email: user.email, name: user.name, role: user.role}})

	PUT "/api/profile" [user, admin]:
		integer userId = auth.userId()
		any data = json.tryTextToData(body())
		if data == null
			return badRequest("Invalid JSON")
		User user = User.first:
			where:
				id == userId
		onError:
			return notFound()
		user.name = data.name.toString()
		Database.save(user)
		return jsonResponse("{\"ok\": true, \"message\": \"profile updated\"}")
