// Single post endpoints

endpoints:
	GET "/api/posts/:id":
		integer postId = param("id").toInteger()
		Post? post = Post.first:
			where:
				id == postId
		onError:
			return notFound()
		return json({ok: true, post: post})

	PUT "/api/posts/:id" [user, admin]:
		integer postId = param("id").toInteger()
		any data = json.tryTextToData(body())
		if data == none
			return badRequest("Invalid JSON")
		Post? foundPost = Post.first:
			where:
				id == postId
		onError:
			return notFound()
		if foundPost == none
			return notFound()
		Post post = foundPost!
		if post.user_id != auth.userId()
			return unauthorized()
		post.content = data.content.toString()
		Database.save(post)
		return jsonResponse("{\"ok\": true, \"message\": \"post updated\", \"id\": " + postId.toString() + "}")

	DELETE "/api/posts/:id" [user, admin]:
		integer postId = param("id").toInteger()
		Post? foundPost = Post.first:
			where:
				id == postId
		onError:
			return notFound()
		if foundPost == none
			return notFound()
		Post post = foundPost!
		if post.user_id != auth.userId()
			return unauthorized()
		Database.delete(post)
		return jsonResponse("{\"ok\": true, \"message\": \"post deleted\", \"id\": " + postId.toString() + "}")
