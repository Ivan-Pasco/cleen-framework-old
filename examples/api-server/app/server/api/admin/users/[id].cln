// Admin user management endpoint

endpoints:
	DELETE "/api/admin/users/:id" [admin]:
		integer userId = param("id").toInteger()
		User? foundUser = User.first:
			where:
				id == userId
		onError:
			return notFound()
		if foundUser == none
			return notFound()
		User user = foundUser!
		Database.delete(user)
		return jsonResponse("{\"ok\": true, \"message\": \"user deleted\", \"id\": " + userId.toString() + "}")
