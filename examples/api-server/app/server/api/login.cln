// Login endpoint

endpoints:
	POST "/api/login":
		any data = json.tryTextToData(body())
		if data == null
			return badRequest("Invalid JSON")
		string loginEmail = data.email.toString()
		string password = data.password.toString()

		User user = User.first:
			where:
				email == loginEmail
		onError:
			return unauthorized()

		if not auth.verifyPassword(password, user.password_hash)
			return unauthorized()

		string token = auth.jwt.sign("{\"sub\": " + user.id.toString() + ", \"role\": \"" + user.role + "\"}")
		return jsonResponse("{\"ok\": true, \"token\": \"" + token + "\"}")
