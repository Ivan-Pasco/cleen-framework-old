// API server entry — server and auth configuration.

plugins:
	frame.server
	frame.data
	frame.auth

server:
	port: 3000

auth:
	jwt:
		enabled = true
		secret = env.get("JWT_SECRET")
		alg = "HS256"
		ttlMinutes = 60

start:
	User userSchema = User()
	userSchema.migrate()
	Post postSchema = Post()
	postSchema.migrate()
	Comment commentSchema = Comment()
	commentSchema.migrate()
	printl("API server ready on port 3000")
